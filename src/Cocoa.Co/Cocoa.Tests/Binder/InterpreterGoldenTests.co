// 鑷妇娴嬭瘯锛欼nterpreter 姹傚€奸粍閲戜覆锛堥樁娈?7 澧為噺浜?M5-a1锛夆€斺€旂敱 GoldenGenerator 鎹曡幏鑷妇渚ц緭鍑虹敓鎴愶紝鍕挎墜鏀广€俓n// 13 鏉?bound 璇枡 鈫?`杩斿洖鍊糩\n杈撳嚭]` 閫愬瓧鑺傛瘮瀵癸紙瀵归綈 C# Evaluator 璇箟锛夈€俓n
using Cocoa.CodeAnalysis.Syntax
using Cocoa.CodeAnalysis.Binding
using Cocoa.CodeGen

namespace Cocoa.CodeAnalysis.Tests
{
    class InterpreterGoldenTests
    {
        public static function Run(r: TestRunner): void
        {
            RunInterp(r, Corpus0(), Expected0(), "InterpreterGolden/bound-0")
            RunInterp(r, Corpus1(), Expected1(), "InterpreterGolden/bound-1")
            RunInterp(r, Corpus2(), Expected2(), "InterpreterGolden/bound-2")
            RunInterp(r, Corpus3(), Expected3(), "InterpreterGolden/bound-3")
            RunInterp(r, Corpus4(), Expected4(), "InterpreterGolden/bound-4")
            RunInterp(r, Corpus5(), Expected5(), "InterpreterGolden/bound-5")
            RunInterp(r, Corpus6(), Expected6(), "InterpreterGolden/bound-6")
            RunInterp(r, Corpus7(), Expected7(), "InterpreterGolden/bound-7")
            RunInterp(r, Corpus8(), Expected8(), "InterpreterGolden/bound-8")
            RunInterp(r, Corpus9(), Expected9(), "InterpreterGolden/bound-9")
            RunInterp(r, Corpus10(), Expected10(), "InterpreterGolden/bound-10")
            RunInterp(r, Corpus11(), Expected11(), "InterpreterGolden/bound-11")
            RunInterp(r, Corpus12(), Expected12(), "InterpreterGolden/bound-12")
        }

        private static function RunInterp(r: TestRunner, source: string, expected: string, label: string): void
        {
            let b = Binder.Create(source)
            b.BindCompilationUnit()
            let interp = InterpreterBackend.FromBinder(b)
            let value = interp.EvaluateMain()
            var sb = value.Format()
            let outText = interp.Output()
            if outText.Length > 0
            {
                sb = sb + "\n" + outText
            }

            r.CheckEqual(expected, sb, label)
        }

        private static function Corpus0(): string
        {
            return "function Main(): i32\n{\n    let x = 1\n    let y = x + 2 * 3\n    return y\n}\n"
        }

        private static function Expected0(): string
        {
            return "7"
        }

        private static function Corpus1(): string
        {
            return "function Main(): i32\n{\n    let a = -5\n    let b = !(1 == 2)\n    return a\n}\n"
        }

        private static function Expected1(): string
        {
            return "-5"
        }

        private static function Corpus2(): string
        {
            return "function Add(a: i32, b: i32): i32\n{\n    return a + b\n}\n\nfunction Main(): i32\n{\n    return Add(1, 2)\n}\n"
        }

        private static function Expected2(): string
        {
            return "3"
        }

        private static function Corpus3(): string
        {
            return "function Main(): i32\n{\n    var n = 10\n    if n > 0\n    {\n        return 1\n    }\n\n    return 0\n}\n"
        }

        private static function Expected3(): string
        {
            return "1"
        }

        private static function Corpus4(): string
        {
            return "function F(n: i32): i32\n{\n    var result = 0\n    if n > 0\n    {\n        result = 1\n    }\n    else\n    {\n        result = 2\n    }\n\n    return result\n}\n\nfunction Main(): i32\n{\n    return F(2)\n}\n"
        }

        private static function Expected4(): string
        {
            return "1"
        }

        private static function Corpus5(): string
        {
            return "function Main(): i32\n{\n    var t = 0\n    var i = 3\n    while i > 0\n    {\n        t = t + i\n        i = i - 1\n    }\n\n    return t\n}\n"
        }

        private static function Expected5(): string
        {
            return "6"
        }

        private static function Corpus6(): string
        {
            return "function Main(): i32\n{\n    var t = 0\n    do\n    {\n        t = t + 5\n    }\n    while t < 10\n\n    return t\n}\n"
        }

        private static function Expected6(): string
        {
            return "10"
        }

        private static function Corpus7(): string
        {
            return "function Main(): i32\n{\n    var sum = 0\n    for var i = 0 to 4\n    {\n        sum = sum + i\n    }\n\n    return sum\n}\n"
        }

        private static function Expected7(): string
        {
            return "10"
        }

        private static function Corpus8(): string
        {
            return "function Main(): i32\n{\n    var result = 0\n    var i = 0\n    while i < 10\n    {\n        if i > 5\n        {\n            result = result + i\n        }\n\n        i = i + 1\n    }\n\n    return result\n}\n"
        }

        private static function Expected8(): string
        {
            return "30"
        }

        private static function Corpus9(): string
        {
            return "function Main(): i32\n{\n    var sum = 0\n    var i = 0\n    while i < 10\n    {\n        if i == 5\n        {\n            break\n        }\n\n        sum = sum + i\n        i = i + 1\n    }\n\n    return sum\n}\n"
        }

        private static function Expected9(): string
        {
            return "10"
        }

        private static function Corpus10(): string
        {
            return "function Main(): i32\n{\n    var sum = 0\n    var i = 0\n    while i < 10\n    {\n        i = i + 1\n        if i % 2 == 0\n        {\n            continue\n        }\n\n        sum = sum + i\n    }\n\n    return sum\n}\n"
        }

        private static function Expected10(): string
        {
            return "25"
        }

        private static function Corpus11(): string
        {
            return "function Main(): i32\n{\n    var sum = 0\n    for var i = 0 to 10 step 2\n    {\n        sum = sum + i\n    }\n\n    return sum\n}\n"
        }

        private static function Expected11(): string
        {
            return "30"
        }

        private static function Corpus12(): string
        {
            return "function Main(): i32\n{\n    var sum = 0\n    for var i = 0 to 3\n    {\n        var j = 0\n        while j < i\n        {\n            sum = sum + 1\n            j = j + 1\n        }\n    }\n\n    return sum\n}\n"
        }

        private static function Expected12(): string
        {
            return "6"
        }

    }
}
