using Cocoa.CodeAnalysis.Syntax
using Cocoa.CodeAnalysis.Binding

namespace Cocoa.CodeAnalysis.Tests
{
    class BinderGoldenTests
    {
        public static function Run(r: TestRunner): void
        {
            RunSymbols(r, Symbol0Corpus(), Symbol0Expected(), "BinderGolden/symbol-0")
            RunSymbols(r, Symbol1Corpus(), Symbol1Expected(), "BinderGolden/symbol-1")
            RunSymbols(r, Symbol2Corpus(), Symbol2Expected(), "BinderGolden/symbol-2")
            RunSymbols(r, Symbol3Corpus(), Symbol3Expected(), "BinderGolden/symbol-3")
            RunSymbols(r, Symbol4Corpus(), Symbol4Expected(), "BinderGolden/symbol-4")
            RunSymbols(r, Symbol5Corpus(), Symbol5Expected(), "BinderGolden/symbol-5")
            RunSymbols(r, Symbol6Corpus(), Symbol6Expected(), "BinderGolden/symbol-6")
            RunSymbols(r, Symbol7Corpus(), Symbol7Expected(), "BinderGolden/symbol-7")
            RunSymbols(r, Symbol8Corpus(), Symbol8Expected(), "BinderGolden/symbol-8")
            RunSymbols(r, Symbol9Corpus(), Symbol9Expected(), "BinderGolden/symbol-9")
            RunSymbols(r, Symbol10Corpus(), Symbol10Expected(), "BinderGolden/symbol-10")
            RunSymbols(r, Symbol11Corpus(), Symbol11Expected(), "BinderGolden/symbol-11")
            RunSymbols(r, Symbol12Corpus(), Symbol12Expected(), "BinderGolden/symbol-12")
            RunSymbols(r, Symbol13Corpus(), Symbol13Expected(), "BinderGolden/symbol-13")
            RunSymbols(r, Symbol14Corpus(), Symbol14Expected(), "BinderGolden/symbol-14")
            RunDiags(r, Invalid0Corpus(), Invalid0Expected(), "BinderGolden/invalid-0")
            RunDiags(r, Invalid1Corpus(), Invalid1Expected(), "BinderGolden/invalid-1")
            RunDiags(r, Invalid2Corpus(), Invalid2Expected(), "BinderGolden/invalid-2")
            RunDiags(r, Invalid3Corpus(), Invalid3Expected(), "BinderGolden/invalid-3")
            RunDiags(r, Invalid4Corpus(), Invalid4Expected(), "BinderGolden/invalid-4")
            RunDiags(r, Invalid5Corpus(), Invalid5Expected(), "BinderGolden/invalid-5")
            RunDiags(r, Invalid6Corpus(), Invalid6Expected(), "BinderGolden/invalid-6")
            RunDiags(r, Invalid7Corpus(), Invalid7Expected(), "BinderGolden/invalid-7")
            RunDiags(r, Invalid8Corpus(), Invalid8Expected(), "BinderGolden/invalid-8")
            RunBound(r, Bound0Corpus(), Bound0Expected(), "BinderGolden/bound-0")
            RunBound(r, Bound1Corpus(), Bound1Expected(), "BinderGolden/bound-1")
            RunBound(r, Bound2Corpus(), Bound2Expected(), "BinderGolden/bound-2")
            RunBound(r, Bound3Corpus(), Bound3Expected(), "BinderGolden/bound-3")
            RunBound(r, Bound4Corpus(), Bound4Expected(), "BinderGolden/bound-4")
            RunBound(r, Bound5Corpus(), Bound5Expected(), "BinderGolden/bound-5")
            RunBound(r, Bound6Corpus(), Bound6Expected(), "BinderGolden/bound-6")
            RunBound(r, Bound7Corpus(), Bound7Expected(), "BinderGolden/bound-7")
            RunBound(r, Bound8Corpus(), Bound8Expected(), "BinderGolden/bound-8")
            RunBound(r, Bound9Corpus(), Bound9Expected(), "BinderGolden/bound-9")
            RunBound(r, Bound10Corpus(), Bound10Expected(), "BinderGolden/bound-10")
            RunBound(r, Bound11Corpus(), Bound11Expected(), "BinderGolden/bound-11")
            RunBound(r, Bound12Corpus(), Bound12Expected(), "BinderGolden/bound-12")
        }

        private static function RunSymbols(r: TestRunner, source: string, expected: string, label: string): void
        {
            let b = Binder.Create(source)
            b.BindCompilationUnit()
            var sb = b.DescribeSymbols()
            var d = 0
            while d < b.DiagnosticCount()
            {
                sb = sb + b.DiagnosticAt(d) + "\n"
                d = d + 1
            }
            if sb.Length > 0
            {
                sb = sb.substring(0, sb.Length - 1)
            }

            r.CheckEqual(expected, sb, label)
        }

        private static function RunDiags(r: TestRunner, source: string, expected: string, label: string): void
        {
            let b = Binder.Create(source)
            b.BindCompilationUnit()
            var sb = ""
            var d = 0
            while d < b.DiagnosticCount()
            {
                sb = sb + b.DiagnosticAt(d) + "\n"
                d = d + 1
            }
            if sb.Length > 0
            {
                sb = sb.substring(0, sb.Length - 1)
            }

            r.CheckEqual(expected, sb, label)
        }

        private static function RunBound(r: TestRunner, source: string, expected: string, label: string): void
        {
            let b = Binder.Create(source)
            b.BindCompilationUnit()
            var sb = b.DescribeBoundTrees()
            if sb.Length > 0
            {
                sb = sb.substring(0, sb.Length - 1)
            }

            r.CheckEqual(expected, sb, label)
        }

        private static function Symbol0Corpus(): string
        {
            return "function Main(): i32\n{\n    return 1\n}\n"
        }

        private static function Symbol0Expected(): string
        {
            return "function Main(): int\nmain: Main"
        }

        private static function Symbol1Corpus(): string
        {
            return "function Add(a: i32, b: i32): i32\n{\n    return a + b\n}\n\nfunction Main(): i32\n{\n    return Add(1, 2)\n}\n"
        }

        private static function Symbol1Expected(): string
        {
            return "function Add(a: int, b: int): int\nfunction Main(): int\nmain: Main"
        }

        private static function Symbol2Corpus(): string
