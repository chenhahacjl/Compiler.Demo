            return "@ident @class @if _private public function class interface struct enum namespace using static var let const\nabstract as base break case cdecl continue default else false for foreach get set property event delegate\nconstructor import in is internal new null nameof out override partial params protected readonly ref sealed\nstep switch this virtual when while return stdcall syscall to true do extends extern where facade throw try\ncatch finally and or not lock checked unchecked yield field\n"
        }

