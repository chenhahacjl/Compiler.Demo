        private static function EdgeCommentsCorpus(): string
        {
            return "// line\n/* block */\n/// doc\n/* unterminated\n"
        }

        private static function EdgeCommentsExpected(): string
        {
            return "EOF 44 0 5:1"
        }

        private static function EdgeKeywordsCorpus(): string
