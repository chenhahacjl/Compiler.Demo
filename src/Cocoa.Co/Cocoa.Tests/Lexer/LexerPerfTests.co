// 自举测试：Lexer 计数 + 1MB 性能（阶段 7 增量五 M5-b0）——移植自 Cocoa.Cs/LexerPerformanceTests。
// Run()：默认套件内适中语料（~1000 token），Evaluator/native 都快。
// RunPerf()→100k 行（1MB）→500k token，仅 native 计时门禁（Main --perf 门控）。
// Evaluator 字节码解释器跑 1MB 太慢；用 System.Text.StringBuilder（SDK，O(n)）构建，避免 O(n²)
using Cocoa.CodeAnalysis.Syntax
using System.Text

namespace Cocoa.CodeAnalysis.Tests
{
    class LexerPerfTests
    {
        public static function Run(r: TestRunner): void
        {
            RunCount(r, 2000, 10000, "LexerPerf/count-small")
        }

        public static function RunPerf(r: TestRunner): void
        {
            RunCount(r, 100000, 500000, "LexerPerf/count-1mb")
        }

        private static function RunCount(r: TestRunner, lines: i32, expectedTokens: i32, label: string): void
        {
            let corpus = BuildCorpus(lines)
            let lex = Lexer.Create(corpus)
            var count = 0
            while true
            {
                let t = lex.Next()
                if t.Kind() == "EOF"
                {
                    break
                }

                count = count + 1
            }

            r.CheckEqualI32(expectedTokens, count, label)
        }

        private static function BuildCorpus(n: i32): string
        {
            let sb = new System.Text.StringBuilder()
            var i = 0
            while i < n
            {
                sb.Append("x = x + 1\n")
                i = i + 1
            }

            return sb.ToString()
        }
    }
}
