// 自举测试：IlEmitter 常量折叠（阶段 7 增量五 M5-a3）——
// 驱动 co Binder → IlEmitter → IlAssembler，断言 let 常量传播 + i32/bool 折叠的逐字节 hex。
// 期望值由 C# 差分（IlEmitterDifferentialTests，21 语料逐字节一致）锁定。

using Cocoa.CodeAnalysis.Syntax
using Cocoa.CodeAnalysis.Binding
using Cocoa.CodeGen

namespace Cocoa.CodeAnalysis.Tests
{
    class IlEmitterSelfHostedTests
    {
        public static function Run(r: TestRunner): void
        {
            CheckFold(r, "function Main(): i32\n{\n    let x = 1\n    return x + 2\n}\n", "2001000000fe0e000020030000002a", "IlEmitter/fold-const-arith")
            CheckFold(r, "function Main(): i32\n{\n    let a = 1\n    let b = 2\n    return a * b\n}\n", "2001000000fe0e00002002000000fe0e010020020000002a", "IlEmitter/fold-const-mul")
            CheckFold(r, "function F(n: i32): i32\n{\n    let c = true\n    if c\n    {\n        return 1\n    }\n    return 0\n}\n", "17fe0e00000020010000002a", "IlEmitter/fold-bool-cond")
            CheckFold(r, "function Main(): i32\n{\n    let x = 5\n    return -x\n}\n", "2005000000fe0e000020fbffffff2a", "IlEmitter/fold-neg")
            CheckFold(r, "function Main(): i32\n{\n    if 1 < 2\n    {\n        return 7\n    }\n    return 8\n}\n", "0020070000002a", "IlEmitter/fold-literal-compare")
        }

        private static function CheckFold(r: TestRunner, source: string, expected: string, label: string): void
        {
            let b = Binder.Create(source)
            b.BindCompilationUnit()
            let asm = new IlAssembler()
            let em = new IlEmitter()
            var tn = new string[1]
            var tv = new i32[1]
            var tr = new bool[1]
            em.SetMethods(tn, tv, tr)
            let body = b.GetFunctionBody(0)
            var pn = new string[8]
            let pc = b.GetFunctionParamCount(0)
            var i = 0
            while i < pc
            {
                pn[i] = b.GetFunctionParamName(0, i)
                i = i + 1
            }

            em.EmitFunction(asm, body, pn, pc)
            r.CheckEqual(expected, asm.Assemble(), label)
        }
    }
}