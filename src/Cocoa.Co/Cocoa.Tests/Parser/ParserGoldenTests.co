            RunSource(r, Valid32Corpus(), Valid32Expected(), "ParserGolden/valid-32")
            RunSource(r, Valid33Corpus(), Valid33Expected(), "ParserGolden/valid-33")
            RunSource(r, Valid34Corpus(), Valid34Expected(), "ParserGolden/valid-34")
            RunSource(r, Valid35Corpus(), Valid35Expected(), "ParserGolden/valid-35")
            RunSource(r, Valid36Corpus(), Valid36Expected(), "ParserGolden/valid-36")
            RunSource(r, Valid37Corpus(), Valid37Expected(), "ParserGolden/valid-37")
            RunSource(r, Valid38Corpus(), Valid38Expected(), "ParserGolden/valid-38")
            RunSource(r, Invalid0Corpus(), Invalid0Expected(), "ParserGolden/invalid-0")
            RunSource(r, Invalid1Corpus(), Invalid1Expected(), "ParserGolden/invalid-1")
            RunSource(r, Invalid2Corpus(), Invalid2Expected(), "ParserGolden/invalid-2")
            RunSource(r, Invalid3Corpus(), Invalid3Expected(), "ParserGolden/invalid-3")
            RunSource(r, Invalid4Corpus(), Invalid4Expected(), "ParserGolden/invalid-4")
            RunSource(r, Invalid5Corpus(), Invalid5Expected(), "ParserGolden/invalid-5")
        }

        private static function RunSource(r: TestRunner, source: string, expected: string, label: string): void
        {
            let p = Parser.Create(source)
            let root = p.ParseCompilationUnit()
            var sb = root.Dump()
            var i = 0
            while i < p.DiagnosticCount()
            {
                sb = sb + "\n" + p.DiagnosticAt(i)
                i = i + 1
            }

            r.CheckEqual(expected, sb, label)
        }

        private static function Valid0Corpus(): string
        {
            return "function Main(): i32\n{\n    return 1\n}\n"
        }

        private static function Valid0Expected(): string
        {
            return "(CompilationUnit (FunctionDeclaration (FunctionKeyword \"function\") (IdentifierToken \"Main\") (OpenParenthesisToken \"(\") (CloseParenthesisToken \")\") (TypeClause (ColonToken \":\") (IdentifierToken \"i32\")) (BlockStatement (OpenBraceToken \"{\") (ReturnStatement (ReturnKeyword \"return\") (LiteralExpression (NumberToken \"1\"))) (CloseBraceToken \"}\"))) (EndOfFileToken \"\"))"
        }

