using Cocoa.CodeAnalysis.Syntax

namespace Cocoa.CodeAnalysis.Tests
{
    class ParserGoldenTests
    {
        public static function Run(r: TestRunner): void
        {
            RunSource(r, Valid0Corpus(), Valid0Expected(), "ParserGolden/valid-0")
            RunSource(r, Valid1Corpus(), Valid1Expected(), "ParserGolden/valid-1")
            RunSource(r, Valid2Corpus(), Valid2Expected(), "ParserGolden/valid-2")
            RunSource(r, Valid3Corpus(), Valid3Expected(), "ParserGolden/valid-3")
