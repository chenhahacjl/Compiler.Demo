// Cocoa mini-Lexer —— 自举翻译第 ⑦ 步开工（mini-Lexer 里程碑，阶段 7 增量一）：
// 词法器覆盖核心 token 面（对齐自举缺口分析 §6 验收口径，M7-a1 起对齐 LexerBase/CocoaSyntaxFacts）：
//   标识符/关键字（@verbatim 标识符）、数字（十进制/0x/0b/含指数 double/_ 分隔/后缀 u·ul·l·f）、
//   字符串（转义 + verbatim @"…" + raw """…""" + 插值 $"…"/$@"…"/@$"…"）、字符字面量、
//   注释（// 与 /* */，/// 视作 // 记入 trivia 差异清单）、运算符/标点（三/两/单字符最长匹配）、
//   错误 token（非法字符/未终止字符串·字符）、EOF，并携带行号/列号。
// M7-a0：输出从格式化字符串改为结构化 Token（Kind/Text/Line/Column/Offset）+ Describe() 可读输出。
// M7-a1：token 面补全（对齐 LexerBase.Token/Strings/CharsNumbers）；kind 为：Keyword/Identifier/Number/
//   String/VerbatimString/RawString/InterpolatedString/Char/Symbol/Error/EOF。
// 依赖：string.substring(start, length)（特殊成员，跨三后端）、Char.* 成员面、System.Console。

namespace MiniLexer
{
    /// <summary>结构化 token：kind 为上档大写名，Describe() 输出 `KIND text line:col` 保持可读且稳定。</summary>
    class Token
    {
        private field _kind: string
        private field _text: string
        private field _line: i32
        private field _col: i32
        private field _offset: i32

        public constructor()
        {
            _kind = "EOF"
            _text = ""
            _line = 0
            _col = 0
            _offset = 0
        }

        public static function Create(kind: string, text: string, line: i32, col: i32, offset: i32): Token
        {
            var t = new Token()
            t._kind = kind
            t._text = text
            t._line = line
            t._col = col
            t._offset = offset
            return t
        }

        public function Kind(): string
        {
            return _kind
        }

        public function Text(): string
        {
            return _text
        }

        public function Line(): i32
        {
            return _line
        }

        public function Column(): i32
        {
            return _col
        }

        public function Offset(): i32
        {
            return _offset
        }

        public function Describe(): string
        {
            return _kind + " " + _text + " " + string(_line) + ":" + string(_col)
        }
    }

    class Lexer
    {
        private field _src: string
        private field _pos: i32
        private field _line: i32
        private field _col: i32

        public constructor()
        {
            _src = ""
            _pos = 0
            _line = 1
            _col = 1
        }

        public static function Create(source: string): Lexer
        {
            var lex = new Lexer()
            lex._src = source
            lex._pos = 0
            lex._line = 1
            lex._col = 1
            return lex
        }

        private function AtEnd(): bool
        {
            return _pos >= _src.Length
        }

        private function Current(): char
        {
            return _src[_pos]
        }

        private function Peek(offset: i32): char
        {
            if _pos + offset >= _src.Length
            {
                return char(0)
            }

            return _src[_pos + offset]
        }

        private function Advance(): void
        {
            if AtEnd()
            {
                return
            }

            if _src[_pos] == '\n'
            {
                _line = _line + 1
                _col = 1
            }
            else
            {
                _col = _col + 1
            }

            _pos = _pos + 1
        }

        /// <summary>下一个 token（结构化）；无剩余时返回 `EOF` token。</summary>
        public function Next(): Token
        {
            SkipTrivia()
            if AtEnd()
            {
                return Token.Create("EOF", "", _line, _col, _pos)
            }

            let startLine = _line
            let startCol = _col
            let c = Current()
            if IsIdentStart(c)
            {
                return ReadIdent(startLine, startCol)
            }

            if Char.IsDigit(c)
            {
                return ReadNumber(startLine, startCol)
            }

            if c == '"'
            {
                if Peek(1) == '"' && Peek(2) == '"'
                {
                    return ReadRawString(startLine, startCol)
                }

                return ReadString(startLine, startCol)
            }

            if c == '\''
            {
                return ReadChar(startLine, startCol)
            }

            if c == '@'
            {
                return ReadAt(startLine, startCol)
            }

            if c == '$'
            {
                if Peek(1) == '"'
                {
                    return ReadInterpolated(startLine, startCol, false)
                }

                if Peek(1) == '@' && Peek(2) == '"'
                {
                    return ReadInterpolated(startLine, startCol, true)
                }

                let badStart = _pos
                Advance()
                let badText = _src.substring(badStart, _pos - badStart)
                return Token.Create("Error", badText, startLine, startCol, badStart)
            }

            return ReadSymbol(startLine, startCol)
        }

        /// <summary>@ 前缀：@"…" verbatim / @$"…" verbatim 插值 / @ident verbatim 标识符（恒 Identifier）/ 非法。</summary>
        private function ReadAt(startLine: i32, startCol: i32): Token
        {
            let tokenStart = _pos
            if Peek(1) == '"'
            {
                return ReadVerbatimString(startLine, startCol)
            }

            if Peek(1) == '$' && Peek(2) == '"'
            {
                return ReadInterpolated(startLine, startCol, true)
            }

            if IsIdentStart(Peek(1))
            {
                Advance()
                Advance()
                while !AtEnd()
                {
                    let c = Current()
                    if IsIdentPart(c)
                    {
                        Advance()
                    }
                    else
                    {
                        break
                    }
                }

                let text = _src.substring(tokenStart, _pos - tokenStart)
                return Token.Create("Identifier", text, startLine, startCol, tokenStart)
            }

            Advance()
            let badText = _src.substring(tokenStart, _pos - tokenStart)
            return Token.Create("Error", badText, startLine, startCol, tokenStart)
        }

        private function SkipTrivia(): void
        {
            while !AtEnd()
            {
                let c = Current()
                if c == ' ' || c == '\t' || c == '\r' || c == '\n'
                {
                    Advance()
                }
                else if c == '/' && Peek(1) == '/'
                {
                    while !AtEnd()
                    {
                        let d = Current()
                        if d == '\n'
                        {
                            break
                        }

                        Advance()
                    }
                }
                else if c == '/' && Peek(1) == '*'
                {
                    Advance()
                    Advance()
                    while !AtEnd()
                    {
                        let d = Current()
                        if d == '*' && Peek(1) == '/'
                        {
                            Advance()
                            Advance()
                            break
                        }

                        Advance()
                    }
                }
                else
                {
                    break
                }
            }
        }

        private function IsIdentStart(c: char): bool
        {
            if Char.IsLetter(c)
            {
                return true
            }

            if c == '_'
            {
                return true
            }

            return false
        }

        private function IsIdentPart(c: char): bool
        {
            if Char.IsLetterOrDigit(c)
            {
                return true
            }

            if c == '_'
            {
                return true
            }

            return false
        }

        /// <summary>字母或数字（不含下划线）——数字后缀边界判定对齐 C# char.IsLetterOrDigit。</summary>
        private function IsAlphaNum(c: char): bool
        {
            if Char.IsLetter(c)
            {
                return true
            }

            if Char.IsDigit(c)
            {
                return true
            }

            return false
        }

        /// <summary>十六进制字符判断（内联实现：Char.IsHexDigit 非 .NET 公开成员，避免 IL 重定向缺口）。</summary>
        private function IsHexChar(c: char): bool
        {
            let v = i32(c)
            if v >= 48 && v <= 57
            {
                return true
            }

            if v >= 65 && v <= 70
            {
                return true
            }

            if v >= 97 && v <= 102
            {
                return true
            }

            return false
        }

        private function IsBinaryChar(c: char): bool
        {
            return c == '0' || c == '1'
        }

        private function ReadIdent(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            Advance()
            while !AtEnd()
            {
                let c = Current()
                if IsIdentPart(c)
                {
                    Advance()
                }
                else
                {
                    break
                }
            }

            let text = _src.substring(start, _pos - start)
            if IsKeyword(text)
            {
                return Token.Create("Keyword", text, startLine, startCol, start)
            }

            return Token.Create("Identifier", text, startLine, startCol, start)
        }

        private function ReadNumber(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            var isHex = false
            var isBin = false
            var hasExponent = false
            var first = Current()
            if first == '0' && (Peek(1) == 'x' || Peek(1) == 'X')
            {
                isHex = true
                Advance()
                Advance()
                while !AtEnd()
                {
                    let c = Current()
                    if IsHexChar(c) || c == '_'
                    {
                        Advance()
                    }
                    else
                    {
                        break
                    }
                }
            }
            else if first == '0' && (Peek(1) == 'b' || Peek(1) == 'B')
            {
                isBin = true
                Advance()
                Advance()
                while !AtEnd()
                {
                    let c = Current()
                    if IsBinaryChar(c) || c == '_'
                    {
                        Advance()
                    }
                    else
                    {
                        break
                    }
                }
            }
            else
            {
                while !AtEnd()
                {
                    let c = Current()
                    if Char.IsDigit(c) || c == '_'
                    {
                        Advance()
                    }
                    else
                    {
                        break
                    }
                }

                if !AtEnd()
                {
                    if Current() == '.' && Char.IsDigit(Peek(1))
                    {
                        Advance()
                        while !AtEnd()
                        {
                            let c = Current()
                            if Char.IsDigit(c)
                            {
                                Advance()
                            }
                            else
                            {
                                break
                            }
                        }
                    }
                }

                if !AtEnd()
                {
                    let c = Current()
                    if c == 'e' || c == 'E'
                    {
                        let hasSign = Peek(1) == '+' || Peek(1) == '-'
                        let exponentDigit = hasSign ? Peek(2) : Peek(1)
                        if Char.IsDigit(exponentDigit)
                        {
                            Advance()
                            if hasSign
                            {
                                Advance()
                            }

                            while !AtEnd()
                            {
                                let d = Current()
                                if Char.IsDigit(d)
                                {
                                    Advance()
                                }
                                else
                                {
                                    break
                                }
                            }

                            hasExponent = true
                        }
                    }
                }
            }

            // 类型后缀（6e-M21）：`42L`/`0xFFL`、`1u`/`1U`、`1ul`/`1UL`/`1lu`/`1LU`、`1.0f`/`1e5f`。
            // 仅当后缀后非字母数字时生效，避免吞掉 let / long / ulong / using 等关键字/标识符。
            if !AtEnd()
            {
                let s = Current()
                let p1 = Peek(1)
                let p2 = Peek(2)
                if s == 'u' || s == 'U'
                {
                    if (p1 == 'l' || p1 == 'L') && !IsAlphaNum(p2)
                    {
                        Advance()
                        Advance()
                    }
                    else if !IsAlphaNum(p1)
                    {
                        Advance()
                    }
                }
                else if s == 'l' || s == 'L'
                {
                    if (p1 == 'u' || p1 == 'U') && !IsAlphaNum(p2)
                    {
                        Advance()
                        Advance()
                    }
                    else if !IsAlphaNum(p1)
                    {
                        Advance()
                    }
                }
                else if (s == 'f' || s == 'F') && !IsAlphaNum(p1)
                {
                    Advance()
                }
            }

            let text = _src.substring(start, _pos - start)
            return Token.Create("Number", text, startLine, startCol, start)
        }

        /// <summary>普通字符串 "…"：\ 转义 + "" 转义引号；未终止（换行/结尾）停止但不消费。</summary>
        private function ReadString(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            Advance()
            var done = false
            while !done && !AtEnd()
            {
                let c = Current()
                if c == '"'
                {
                    if Peek(1) == '"'
                    {
                        Advance()
                        Advance()
                    }
                    else
                    {
                        Advance()
                        done = true
                    }
                }
                else if c == '\\'
                {
                    ReadEscape()
                }
                else if c == '\r' || c == '\n'
                {
                    done = true
                }
                else
                {
                    Advance()
                }
            }

            let text = _src.substring(start, _pos - start)
            return Token.Create("String", text, startLine, startCol, start)
        }

        /// <summary>verbatim 字符串 @"…"：不处理 \ 转义，"" 转义引号；允许多行；未终止仅结尾。</summary>
        private function ReadVerbatimString(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            Advance()
            Advance()
            var done = false
            while !done && !AtEnd()
            {
                let c = Current()
                if c == '"'
                {
                    if Peek(1) == '"'
                    {
                        Advance()
                        Advance()
                    }
                    else
                    {
                        Advance()
                        done = true
                    }
                }
                else
                {
                    Advance()
                }
            }

            let text = _src.substring(start, _pos - start)
            return Token.Create("VerbatimString", text, startLine, startCol, start)
        }

        /// <summary>raw 字符串 """…"""：定界符 = 起始最大引号串 N（≥3），同长 N 引号串闭合；不处理转义；未终止仅结尾。</summary>
        private function ReadRawString(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            var delimiter = 0
            while !AtEnd()
            {
                let c = Current()
                if c == '"'
                {
                    delimiter = delimiter + 1
                    Advance()
                }
                else
                {
                    break
                }
            }

            var done = false
            while !done && !AtEnd()
            {
                if Current() == '"'
                {
                    let runStart = _pos
                    var run = 0
                    while !AtEnd()
                    {
                        let c = Current()
                        if c == '"'
                        {
                            run = run + 1
                            Advance()
                        }
                        else
                        {
                            break
                        }
                    }

                    if run >= delimiter
                    {
                        _pos = runStart + delimiter
                        done = true
                    }
                }
                else
                {
                    Advance()
                }
            }

            let text = _src.substring(start, _pos - start)
            return Token.Create("RawString", text, startLine, startCol, start)
        }

        /// <summary>插值字符串 $"…" / $@"…" / @$"…"：{{/}} 转义；洞 {…} 按花括号深度 + 洞内字符串/字符/行注释跳过扫描。</summary>
        private function ReadInterpolated(startLine: i32, startCol: i32, verbatim: bool): Token
        {
            let start = _pos
            Advance()
            if !AtEnd()
            {
                let c = Current()
                if c == '@' || c == '$'
                {
                    Advance()
                }
            }

            Advance()
            var done = false
            while !done && !AtEnd()
            {
                let c = Current()
                if c == '"'
                {
                    if Peek(1) == '"'
                    {
                        Advance()
                        Advance()
                    }
                    else
                    {
                        Advance()
                        done = true
                    }
                }
                else if c == '{'
                {
                    if Peek(1) == '{'
                    {
                        Advance()
                        Advance()
                    }
                    else
                    {
                        Advance()
                        var depth = 1
                        while depth > 0 && !AtEnd()
                        {
                            let h = Current()
                            if h == '{'
                            {
                                depth = depth + 1
                                Advance()
                            }
                            else if h == '}'
                            {
                                depth = depth - 1
                                Advance()
                            }
                            else if h == '"'
                            {
                                Advance()
                                while !AtEnd()
                                {
                                    let d = Current()
                                    if d == '"'
                                    {
                                        Advance()
                                        if Current() != '"'
                                        {
                                            break
                                        }
                                    }
                                    else
                                    {
                                        Advance()
                                    }
                                }
                            }
                            else if h == '\''
                            {
                                Advance()
                                while !AtEnd()
                                {
                                    let d = Current()
                                    if d == '\\'
                                    {
                                        Advance()
                                        if !AtEnd()
                                        {
                                            Advance()
                                        }
                                    }
                                    else if d == '\''
                                    {
                                        Advance()
                                        break
                                    }
                                    else
                                    {
                                        Advance()
                                    }
                                }
                            }
                            else if h == '/' && Peek(1) == '/'
                            {
                                while !AtEnd()
                                {
                                    let d = Current()
                                    if d == '\r' || d == '\n'
                                    {
                                        break
                                    }

                                    Advance()
                                }
                            }
                            else if !verbatim && (h == '\r' || h == '\n')
                            {
                                done = true
                                break
                            }
                            else
                            {
                                Advance()
                            }
                        }
                    }
                }
                else if c == '}'
                {
                    if Peek(1) == '}'
                    {
                        Advance()
                        Advance()
                    }
                    else
                    {
                        Advance()
                    }
                }
                else if c == '\\'
                {
                    if verbatim
                    {
                        Advance()
                    }
                    else
                    {
                        ReadEscape()
                    }
                }
                else if !verbatim && (c == '\r' || c == '\n')
                {
                    done = true
                }
                else
                {
                    Advance()
                }
            }

            let text = _src.substring(start, _pos - start)
            return Token.Create("InterpolatedString", text, startLine, startCol, start)
        }

        /// <summary>字符串内转义（span 精确）：n t r 0 \\ ' " 为 2 字符；u 固定 4 位；x 1~4 位；U 固定 8 位；非法则只消费 \。</summary>
        private function ReadEscape(): void
        {
            Advance()
            if AtEnd()
            {
                return
            }

            let c = Current()
            if c == 'n' || c == 't' || c == 'r' || c == '0' || c == '\\' || c == '\'' || c == '"'
            {
                Advance()
                return
            }

            if c == 'u'
            {
                Advance()
                if IsHexChar(Current()) && IsHexChar(Peek(1)) && IsHexChar(Peek(2)) && IsHexChar(Peek(3))
                {
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                }

                return
            }

            if c == 'x'
            {
                Advance()
                var digits = 0
                while digits < 4 && !AtEnd() && IsHexChar(Current())
                {
                    Advance()
                    digits = digits + 1
                }

                return
            }

            if c == 'U'
            {
                Advance()
                if IsHexChar(Current()) && IsHexChar(Peek(1)) && IsHexChar(Peek(2)) && IsHexChar(Peek(3)) &&
                    IsHexChar(Peek(4)) && IsHexChar(Peek(5)) && IsHexChar(Peek(6)) && IsHexChar(Peek(7))
                {
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                }

                return
            }

            Advance()
        }

        /// <summary>字符字面量 '…'：转义同字符串但非法转义报错；未闭合/空 → Error。</summary>
        private function ReadChar(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            Advance()
            var hasError = false
            if !AtEnd()
            {
                let c = Current()
                if c == '\''
                {
                    hasError = true
                }
                else if c == '\\'
                {
                    if ReadCharEscape()
                    {
                        hasError = true
                    }
                }
                else if c == '\r' || c == '\n'
                {
                    hasError = true
                }
                else
                {
                    Advance()
                }
            }

            if AtEnd() || hasError || Current() != '\''
            {
                let text = _src.substring(start, _pos - start)
                return Token.Create("Error", text, startLine, startCol, start)
            }

            Advance()
            let okText = _src.substring(start, _pos - start)
            return Token.Create("Char", okText, startLine, startCol, start)
        }

        /// <summary>字符内转义：返回是否有错。u 固定 4 位；x 1~4 位；U 固定 8 位；非法不消费内容字符。</summary>
        private function ReadCharEscape(): bool
        {
            Advance()
            if AtEnd()
            {
                return true
            }

            let c = Current()
            if c == 'n' || c == 't' || c == 'r' || c == '0' || c == '\\' || c == '\'' || c == '"'
            {
                Advance()
                return false
            }

            if c == 'u'
            {
                Advance()
                if IsHexChar(Current()) && IsHexChar(Peek(1)) && IsHexChar(Peek(2)) && IsHexChar(Peek(3))
                {
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    return false
                }

                return true
            }

            if c == 'x'
            {
                Advance()
                var digits = 0
                while digits < 4 && !AtEnd() && IsHexChar(Current())
                {
                    Advance()
                    digits = digits + 1
                }

                if digits == 0
                {
                    return true
                }

                return false
            }

            if c == 'U'
            {
                Advance()
                if IsHexChar(Current()) && IsHexChar(Peek(1)) && IsHexChar(Peek(2)) && IsHexChar(Peek(3)) &&
                    IsHexChar(Peek(4)) && IsHexChar(Peek(5)) && IsHexChar(Peek(6)) && IsHexChar(Peek(7))
                {
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    Advance()
                    return false
                }

                return true
            }

            return true
        }

        /// <summary>运算符/标点（三/两/单字符最长匹配）；无法识别 → Error token。</summary>
        private function ReadSymbol(startLine: i32, startCol: i32): Token
        {
            let start = _pos
            let three = ThreeCharSymbol()
            if three.Length > 0
            {
                Advance()
                Advance()
                Advance()
                let text = _src.substring(start, _pos - start)
                return Token.Create("Symbol", text, startLine, startCol, start)
            }

            let two = TwoCharSymbol()
            if two.Length > 0
            {
                Advance()
                Advance()
                let text = _src.substring(start, _pos - start)
                return Token.Create("Symbol", text, startLine, startCol, start)
            }

            let one = OneCharSymbol()
            if one.Length > 0
            {
                Advance()
                let text = _src.substring(start, _pos - start)
                return Token.Create("Symbol", text, startLine, startCol, start)
            }

            Advance()
            let badText = _src.substring(start, _pos - start)
            return Token.Create("Error", badText, startLine, startCol, start)
        }

        private function ThreeCharSymbol(): string
        {
            let a = Current()
            let b = Peek(1)
            let cc = Peek(2)
            if a == '<' && b == '<' && cc == '=' { return "<<=" }
            if a == '>' && b == '>' && cc == '=' { return ">>=" }
            if a == '?' && b == '?' && cc == '=' { return "??=" }
            return ""
        }

        private function TwoCharSymbol(): string
        {
            let a = Current()
            let b = Peek(1)
            if a == '-' && b == '>' { return "->" }
            if a == '.' && b == '.' { return ".." }
            if a == '+' && b == '+' { return "++" }
            if a == '-' && b == '-' { return "--" }
            if a == '+' && b == '=' { return "+=" }
            if a == '-' && b == '=' { return "-=" }
            if a == '*' && b == '=' { return "*=" }
            if a == '/' && b == '=' { return "/=" }
            if a == '%' && b == '=' { return "%=" }
            if a == '^' && b == '=' { return "^=" }
            if a == '&' && b == '=' { return "&=" }
            if a == '|' && b == '=' { return "|=" }
            if a == '=' && b == '=' { return "==" }
            if a == '!' && b == '=' { return "!=" }
            if a == '<' && b == '=' { return "<=" }
            if a == '>' && b == '=' { return ">=" }
            if a == '&' && b == '&' { return "&&" }
            if a == '|' && b == '|' { return "||" }
            if a == '<' && b == '<' { return "<<" }
            if a == '>' && b == '>' { return ">>" }
            if a == '=' && b == '>' { return "=>" }
            if a == '?' && b == '?' { return "??" }
            if a == '?' && b == '.' { return "?." }
            return ""
        }

        private function OneCharSymbol(): string
        {
            let c = Current()
            if c == '+' { return "+" }
            if c == '-' { return "-" }
            if c == '*' { return "*" }
            if c == '/' { return "/" }
            if c == '(' { return "(" }
            if c == ')' { return ")" }
            if c == '[' { return "[" }
            if c == ']' { return "]" }
            if c == '{' { return "{" }
            if c == '}' { return "}" }
            if c == ':' { return ":" }
            if c == ',' { return "," }
            if c == '.' { return "." }
            if c == ';' { return ";" }
            if c == '~' { return "~" }
            if c == '^' { return "^" }
            if c == '&' { return "&" }
            if c == '|' { return "|" }
            if c == '=' { return "=" }
            if c == '!' { return "!" }
            if c == '<' { return "<" }
            if c == '>' { return ">" }
            if c == '%' { return "%" }
            if c == '?' { return "?" }
            return ""
        }

        /// <summary>关键字全集（对齐 CocoaSyntaxFacts.GetKeywordKind，2026-09-13 共 75 个）。</summary>
