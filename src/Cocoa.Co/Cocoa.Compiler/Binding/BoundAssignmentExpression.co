namespace Cocoa.CodeAnalysis.Binding
{
    class BoundAssignmentExpression
    {
        private field _inner: BoundExpression
        private field _variableName: string
        private field _expression: BoundExpression

        public constructor(variableName: string, expression: BoundExpression, type: string)
        {
            _inner = new BoundExpression(BoundNodeKind.AssignmentExpression(), type)
            _variableName = variableName
            _expression = expression
        }

        public function Kind(): i32 { return _inner.Kind() }
        public function Type(): string { return _inner.Type() }
        public function VariableName(): string { return _variableName }
        public function Expression(): BoundExpression { return _expression }
    }
}
