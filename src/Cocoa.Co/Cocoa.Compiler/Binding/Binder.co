// Cocoa 自举 Binder —— 阶段 7 增量三（M9-a0 差分基建 + M9-a1 符号声明面 + M9-a2 诊断面）：
// 自举 Parser 的 Node 树 → 符号（顶层函数 / 全局变量），DescribeSymbols() 与 C# 端
// BinderDifferentialTests.SymbolDump 逐字节一致（M9 差分口径）。
// M9-a1 范围：函数符号（名/参数/返回类型）、全局变量（显式类型 + 字面量 var 推断）、main 判定。
// M9-a2 范围：诊断面（ReportError/DiagnosticCount/DiagnosticAt，`error: ` 前缀对齐 Parser 诊断风格）
//   + 函数体遍历检查：未定义名/未定义函数/调用 arity/未知类型（签名与局部声明）/重复声明
//   （参数/全局/函数/局部）。消息句式对齐 C# GetDiagnostics 文本（不逐字锁定，差分口径为双方言同报错）。
//   Lambda/泛型/Foreach 循环变量收集为宽松处理（M9-a3 起收紧）。
// 依赖：MiniParser（Node/Parser，树结构已由增量二差分锁定）。

using Cocoa.CodeAnalysis.Syntax
using Cocoa.CodeAnalysis.Symbols

namespace Cocoa.CodeAnalysis.Binding
{
    class Binder
    {
        private field _root: Node
        private field _functions: FunctionSymbol[]
        private field _functionCount: i32
        private field _functionNames: string[]
        private field _variables: VariableSymbol[]
        private field _variableCount: i32
        private field _globalNames: string[]
        private field _paramNames: string[]
        private field _paramTypes: string[]
        private field _paramCount: i32
        private field _locals: string[]
        private field _localScopes: i32[]
        private field _scopeDepth: i32
        private field _scopeMarks: i32[]
        private field _localCount: i32
        private field _currentFunction: FunctionSymbol
        private field _boundRoots: Node[]
        private field _diags: string[]
        private field _diagCount: i32
        private field _mainName: string
        private field _labelCount: i32
        private field _loopLabelCount: i32
        private field _loopBreakLabels: string[]
        private field _loopContinueLabels: string[]
        private field _loopDepth: i32
        private field _classNames: string[]
        private field _knownClassNames: string[]
        private field _knownClassCount: i32
        private field _classFieldNames: string[]
        private field _classFieldTypes: string[]
        private field _classFieldOffsets: i32[]
        private field _classFieldCounts: i32[]
        private field _classMethodNames: string[]
        private field _classMethodIndexes: i32[]
        private field _classMethodNodes: Node[]
        private field _classMethodStatic: bool[]
        private field _classMethodOffsets: i32[]
        private field _classMethodCounts: i32[]
        private field _classCount: i32
        private field _currentClass: string
        private field _topLevelIndexes: i32[]
        private field _topLevelCount: i32

        public static function Create(source: string): Binder
        {
            var b = new Binder()
            let parser = Parser.Create(source)
            b._root = parser.ParseCompilationUnit()
            b._functions = new FunctionSymbol[8]
            b._functionCount = 0
            b._functionNames = new string[8]
            b._variables = new VariableSymbol[8]
            b._variableCount = 0
            b._globalNames = new string[8]
            b._paramNames = new string[8]
            b._paramTypes = new string[8]
            b._paramCount = 0
            b._locals = new string[8]
            b._localScopes = new i32[8]
            b._scopeDepth = 0
            b._scopeMarks = new i32[64]
            b._localCount = 0
            b._diags = new string[8]
            b._diagCount = 0
            b._boundRoots = new Node[8]
            b._classNames = new string[8]
            b._knownClassNames = new string[16]
            b._knownClassCount = 0
            b._classFieldNames = new string[8]
            b._classFieldTypes = new string[8]
            b._classFieldOffsets = new i32[8]
            b._classFieldCounts = new i32[8]
            b._classMethodNames = new string[8]
            b._classMethodIndexes = new i32[8]
            b._classMethodNodes = new Node[8]
            b._classMethodStatic = new bool[8]
            b._classMethodOffsets = new i32[8]
            b._classMethodCounts = new i32[8]
            b._classCount = 0
            b._currentClass = ""
            b._topLevelIndexes = new i32[8]
            b._topLevelCount = 0
            b._mainName = "<none>"
            b._loopBreakLabels = new string[8]
            b._loopContinueLabels = new string[8]
            b._loopDepth = 0
            return b
        }

        /// <summary>两遍式绑定：第一遍声明全部顶层符号（前向可见，对齐 C# 全局作用域语义）；
        /// 第二遍做类型/函数体/初始化表达式检查。</summary>
        public function BindCompilationUnit(): void
        {
            WalkClassNames(_root)

            var fiState = new i32[1]
            fiState[0] = 0
            WalkTopMembers(1, fiState)

            fiState[0] = 0
            WalkTopMembers(2, fiState)

            _currentClass = ""

            // M9-a2：main 函数与全局语句互斥（对齐 C# 端规则，声明序无关；
            // C# 在 GlobalScope 与 Program 两阶段各报一次，条数对齐）
            if _variableCount > 0 && _mainName != "<none>"
            {
                ReportError("Cannot declare main function when global statements are used.")
                ReportError("Cannot declare main function when global statements are used.")
            }
        }

                /// <summary>类名预收集（任意深度下钻，含 namespace）：绑定前登记全部类名，供 phase 1 类型存在性检查前向解析。</summary>
        private function WalkClassNames(node: Node): void
        {
            if !(node != null)
            {
                return
            }

            if node.IsToken()
            {
                return
            }

            let k = node.Kind()
            if k == "ClassDeclaration"
            {
                let cn = ClassNameOf(node)
                if cn.Length > 0
                {
                    if _knownClassCount >= _knownClassNames.Length
                    {
                        var kg = new string[_knownClassNames.Length * 2]
                        var ki = 0
                        while ki < _knownClassCount
                        {
                            kg[ki] = _knownClassNames[ki]
                            ki = ki + 1
                        }

                        _knownClassNames = kg
                    }

                    _knownClassNames[_knownClassCount] = cn
                    _knownClassCount = _knownClassCount + 1
                }

                return
            }

            var c = 0
            while c < node.ChildCount()
            {
                let nc = node.Child(c)
                if nc != null ? !nc.IsToken() : false
                {
                    WalkClassNames(nc)
                }

                c = c + 1
            }
        }

        /// <summary>顶层成员遍历（phase 1=声明 / 2=检查），namespace 剥层下钻，保持声明序。</summary>
        private function WalkTopMembers(phase: i32, fiState: i32[]): void
        {
            var i = 0
            while i < _root.ChildCount()
            {
                WalkMember(_root.Child(i), phase, fiState)
                i = i + 1
            }
        }

        private function WalkMember(node: Node, phase: i32, fiState: i32[]): void
        {
            if !(node != null)
            {
                return
            }

            if node.IsToken()
            {
                return
            }

            let k = node.Kind()
            if k == "NamespaceDeclaration"
            {
                var c = 0
                while c < node.ChildCount()
                {
                    let nc = node.Child(c)
                    if nc != null ? !nc.IsToken() : false
                    {
                        WalkMember(nc, phase, fiState)
                    }

                    c = c + 1
                }

                return
            }

            if k == "FunctionDeclaration"
            {
                if phase == 1
                {
                    if _topLevelCount >= _topLevelIndexes.Length
                    {
                        var tg = new i32[_topLevelIndexes.Length * 2]
                        var tk = 0
                        while tk < _topLevelCount
                        {
                            tg[tk] = _topLevelIndexes[tk]
                            tk = tk + 1
                        }

                        _topLevelIndexes = tg
                    }

                    _topLevelIndexes[_topLevelCount] = BindFunction(node)
                    _topLevelCount = _topLevelCount + 1
                }
                else
                {
                    let fi = fiState[0]
                    let topIndex = _topLevelIndexes[fi]
                    CheckFunctionBody(node, _functions[topIndex], topIndex)
                    fiState[0] = fiState[0] + 1
                }

                return
            }

            if k == "ClassDeclaration"
            {
                if phase == 1
                {
                    BindClassDeclaration(node)
                }
                else
                {
                    // 类方法体在 class 收集后按方法序回填（this 已作 param 0）
                    var cm = 0
                    while cm < _classCount
                    {
                        let off = _classMethodOffsets[cm]
                        let cnt = _classMethodCounts[cm]
                        var m = 0
                        while m < cnt
                        {
                            _currentClass = _classNames[cm]
                            CheckFunctionBody(_classMethodNodes[off + m], _functions[_classMethodIndexes[off + m]], _classMethodIndexes[off + m])
                            m = m + 1
                        }

                        cm = cm + 1
                    }
                }

                return
            }

            if k == "GlobalStatement"
            {
                if node.ChildCount() == 1 && node.Child(0).Kind() == "VariableDeclaration"
                {
                    if phase == 1
                    {
                        BindGlobalVariable(node.Child(0))
                    }
                    else
                    {
                        CheckGlobalVariable(node.Child(0))
                    }
                }
            }
        }

        /// <summary>收集类声明：类名 + 实例字段（名/类型）+ 方法（以 `this` 为 param 0 绑成函数，索引记入类）。</summary>
        private function BindClassDeclaration(node: Node): void
        {
            let className = ClassNameOf(node)
            if className.Length == 0
            {
                ReportError("Class declaration missing name.")
                return
            }

            let classIndex = _classCount
            if classIndex >= _classNames.Length
            {
                var bn = new string[_classNames.Length * 2]
                var bo = new i32[_classFieldOffsets.Length * 2]
                var bc = new i32[_classFieldCounts.Length * 2]
                var mo = new i32[_classMethodOffsets.Length * 2]
                var mc = new i32[_classMethodCounts.Length * 2]
                var g = 0
                while g < classIndex
                {
                    bn[g] = _classNames[g]
                    bo[g] = _classFieldOffsets[g]
                    bc[g] = _classFieldCounts[g]
                    mo[g] = _classMethodOffsets[g]
                    mc[g] = _classMethodCounts[g]
                    g = g + 1
                }

                _classNames = bn
                _classFieldOffsets = bo
                _classFieldCounts = bc
                _classMethodOffsets = mo
                _classMethodCounts = mc
            }

            _classNames[classIndex] = className
            // 字段/方法平铺偏移 = 前序类累计
            var fieldRun = 0
            var methodRun = 0
            var p = 0
            while p < classIndex
            {
                fieldRun = fieldRun + _classFieldCounts[p]
                methodRun = methodRun + _classMethodCounts[p]
                p = p + 1
            }

            _classFieldOffsets[classIndex] = fieldRun
            _classFieldCounts[classIndex] = 0
            _classMethodOffsets[classIndex] = methodRun
            _classMethodCounts[classIndex] = 0
            _classCount = _classCount + 1

            _currentClass = className

            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "ClassFieldDeclaration"
                {
                    let fieldName = FieldNameOf(child)
                    let fieldType = FieldTypeOf(child)
                    if fieldName.Length > 0
                    {
                        let fidx = _classFieldOffsets[classIndex] + _classFieldCounts[classIndex]
                        if fidx >= _classFieldNames.Length
                        {
                            var fg = new string[_classFieldNames.Length * 2]
                            var ft = new string[_classFieldTypes.Length * 2]
                            var q = 0
                            while q < fidx
                            {
                                fg[q] = _classFieldNames[q]
                                ft[q] = _classFieldTypes[q]
                                q = q + 1
                            }

                            _classFieldNames = fg
                            _classFieldTypes = ft
                        }

                        _classFieldNames[fidx] = fieldName
                        _classFieldTypes[fidx] = fieldType
                        _classFieldCounts[classIndex] = _classFieldCounts[classIndex] + 1
                    }
                }
                else if k == "FunctionDeclaration"
                {
                    BindClassMethod(child, classIndex)
                }

                i = i + 1
            }

            _currentClass = ""
        }

        /// <summary>类实例方法 → FunctionSymbol（param 0 = `this`，类型为类名）+ 记录函数索引/节点。</summary>
        private function BindClassMethod(node: Node, classIndex: i32): void
        {
            let className = _classNames[classIndex]
            let methodName = MethodNameOf(node)
            let returnType = MethodReturnTypeOf(node)

            let fn = FunctionSymbol.Create(methodName, returnType)
            let isStatic = MethodIsStatic(node)
            if !isStatic
            {
                fn.AddParameter("this", className)
            }

            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "Parameter"
                {
                    fn.AddParameter(ParameterName(child), ParameterType(child))
                }

                i = i + 1
            }

            let methodIndex = _functionCount
            let midx = _classMethodOffsets[classIndex] + _classMethodCounts[classIndex]
            if midx >= _classMethodIndexes.Length
            {
                var mi = new i32[_classMethodIndexes.Length * 2]
                var mn = new Node[_classMethodNodes.Length * 2]
                var mg = new string[_classMethodNames.Length * 2]
                var ms = new bool[_classMethodStatic.Length * 2]
                var g2 = 0
                while g2 < midx
                {
                    mi[g2] = _classMethodIndexes[g2]
                    mn[g2] = _classMethodNodes[g2]
                    mg[g2] = _classMethodNames[g2]
                    ms[g2] = _classMethodStatic[g2]
                    g2 = g2 + 1
                }

                _classMethodIndexes = mi
                _classMethodNodes = mn
                _classMethodNames = mg
                _classMethodStatic = ms
            }

            _classMethodIndexes[midx] = methodIndex
            _classMethodNodes[midx] = node
            _classMethodNames[midx] = methodName
            _classMethodStatic[midx] = isStatic
            _classMethodCounts[classIndex] = _classMethodCounts[classIndex] + 1

            AddFunction(fn, methodName)
        }

        private function BindFunction(node: Node): i32
        {
            // 直接子：[mods...] FunctionKeyword IdentifierToken ( Parameter... ) (TypeClause)? (Block)?
            var name = ""
            var returnType = "void"
            var paramNames = new string[8]
            var paramCount = 0

            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "IdentifierToken"
                {
                    name = child.Text()
                }
                else if k == "Parameter"
                {
                    let pname = ParameterName(child)
                    if IndexOfString(paramNames, paramCount, pname) >= 0
                    {
                        ReportError("A parameter with the name '" + pname + "' already exists.")
                    }
                    else
                    {
                        if paramCount >= paramNames.Length
                        {
                            var bn = new string[paramNames.Length * 2]
                            var j = 0
                            while j < paramCount
                            {
                                bn[j] = paramNames[j]
                                j = j + 1
                            }

                            paramNames = bn
                        }

                        paramNames[paramCount] = pname
                        paramCount = paramCount + 1
                    }
                }
                else if k == "TypeClause" || k == "ArrayTypeClause"
                {
                    returnType = TypeOfClause(child)
                }

                i = i + 1
            }

            // M9-a2：签名未知类型检查（返回类型 + 各参数类型）
            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "TypeClause" || k == "ArrayTypeClause"
                {
                    CheckTypeClause(child)
                }
                else if k == "Parameter"
                {
                    var j = 0
                    while j < child.ChildCount()
                    {
                        let pc = child.Child(j)
                        if pc.Kind() == "TypeClause" || pc.Kind() == "ArrayTypeClause"
                        {
                            CheckTypeClause(pc)
                        }

                        j = j + 1
                    }
                }

                i = i + 1
            }

            if IndexOfString(_functionNames, _functionCount, name) >= 0
            {
                ReportError("'" + name + "' is already declared.")
            }

            let fn = FunctionSymbol.Create(name, returnType)
            CollectFunctionAttributes(node, fn)
            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "Parameter"
                {
                    fn.AddParameter(ParameterName(child), ParameterType(child))
                }

                i = i + 1
            }

            AddFunction(fn, name)
            return _functionCount - 1
        }

        /// <summary>收集函数级 attribute（`(AttributeList (Attribute name (arg...)) ...)`）→ FunctionSymbol。</summary>
        /// <summary>字面量 token 原样文本（实参信息用途；框架只依赖属性名）。</summary>
        private function LiteralText(t: Node): string
        {
            return t.Text()
        }

        private function CollectFunctionAttributes(node: Node, fn: FunctionSymbol): void
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "AttributeList"
                {
                    var j = 0
                    while j < child.ChildCount()
                    {
                        let attr = child.Child(j)
                        if attr.Kind() == "Attribute"
                        {
                            var name = attr.Child(0).Text()
                            var args = ""
                            var first = true
                            var k = 1
                            while k < attr.ChildCount()
                            {
                                let t = attr.Child(k)
                                if t.Kind() != "CommaToken"
                                {
                                    if !first
                                    {
                                        args = args + ","
                                    }

                                    args = args + LiteralText(t)
                                    first = false
                                }

                                k = k + 1
                            }

                            fn.AddAttribute(name, args)
                        }

                        j = j + 1
                    }
                }

                i = i + 1
            }
        }

        private function BindGlobalVariable(node: Node): void
        {
            // (VariableDeclaration (Var|LetKeyword) IdentifierToken (TypeClause)? (EqualsToken expr)?)
            var name = ""
            var type = ""

            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "IdentifierToken"
                {
                    if name == ""
                    {
                        name = child.Text()
                    }
                }
                else if k == "TypeClause" || k == "ArrayTypeClause" || k == "GenericTypeClause"
                {
                    type = TypeOfClause(child)
                }
                else if type == "" && (k == "LiteralExpression" || k == "UnaryExpression")
                {
                    type = InferTypeOfExpression(child)
                }

                i = i + 1
            }

            // M9-a2：重复全局名（第一遍声明期检查）
            if IndexOfString(_globalNames, _variableCount, name) >= 0
            {
                ReportError("'" + name + "' is already declared.")
            }
            else
            {
                if _variableCount >= _globalNames.Length
                {
                    var bigger = new string[_globalNames.Length * 2]
                    var j = 0
                    while j < _variableCount
                    {
                        bigger[j] = _globalNames[j]
                        j = j + 1
                    }

                    _globalNames = bigger
                }

                _globalNames[_variableCount] = name
            }

            AddVariable(VariableSymbol.Create(name, type))
        }

        /// <summary>第二遍：函数体检查（参数名/类型集供体内解析；局部作用域清零；同步构建绑定树）。</summary>
        private function CheckFunctionBody(node: Node, fn: FunctionSymbol, index: i32): void
        {
            _paramNames = new string[fn.ParamCount() + 8]
            _paramTypes = new string[fn.ParamCount() + 8]
            _paramCount = fn.ParamCount()
            var i = 0
            while i < fn.ParamCount()
            {
                _paramNames[i] = fn.ParamName(i)
                _paramTypes[i] = fn.ParamType(i)
                i = i + 1
            }

            _currentFunction = fn
_localCount = 0
            _scopeDepth = 0
            _labelCount = 0
            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "BlockStatement"
                {
                    CheckNode(child)
                    if index >= _boundRoots.Length
                    {
                        var bigger = new Node[_boundRoots.Length * 2]
                        var j = 0
                        while j < _boundRoots.Length
                        {
                            bigger[j] = _boundRoots[j]
                            j = j + 1
                        }

                        _boundRoots = bigger
                    }

                    _boundRoots[index] = LowerBound(BuildBound(child))
                }

                i = i + 1
            }

            _paramCount = 0
        }

        /// <summary>第二遍：全局变量初始化表达式与类型检查（右值此时全局/函数已全部声明）。</summary>
        private function CheckGlobalVariable(node: Node): void
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "TypeClause" || k == "ArrayTypeClause"
                {
                    CheckTypeClause(child)
                }
                else if !child.IsToken() && k != "TypeClause" && k != "ArrayTypeClause" && k != "GenericTypeClause"
                {
                    CheckNode(child)
                }

                i = i + 1
            }
        }

        /// <summary>类型子句 → 规范类型名（对齐 C# TypeSymbol.Name：int/string/void、int[]）。</summary>
        private function TypeOfClause(node: Node): string
        {
            let k = node.Kind()
            if k == "ArrayTypeClause"
            {
                // (ArrayTypeClause colon name (TypeClause 元素) [ ])
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child.Kind() == "TypeClause"
                    {
                        return TypeOfClause(child) + "[]"
                    }

                    i = i + 1
                }

                return CanonicalType(TypeOfIdentifier(node)) + "[]"
            }

            return CanonicalType(TypeOfIdentifier(node))
        }

        /// <summary>Cocoa 简写词汇 → C# 风格规范名（对齐 TypeSymbol 常量构造名）。</summary>
        private function CanonicalType(name: string): string
        {
            if name == "i8" { return "sbyte" }
            if name == "u8" { return "byte" }
            if name == "i16" { return "short" }
            if name == "u16" { return "ushort" }
            if name == "i32" { return "int" }
            if name == "u32" { return "uint" }
            if name == "i64" { return "long" }
            if name == "u64" { return "ulong" }
            if name == "f32" { return "float" }
            if name == "f64" { return "double" }
            return name
        }

        private function TypeOfIdentifier(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "IdentifierToken"
                {
                    return child.Text()
                }

                i = i + 1
            }

            return "?"
        }

        /// <summary>体内声明的局部类型：显式类型子句优先，否则值表达式推断（M9-a3）。</summary>
        private function LocalTypeOfDeclaration(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "TypeClause" || k == "ArrayTypeClause" || k == "GenericTypeClause"
                {
                    return TypeOfClause(child)
                }

                i = i + 1
            }

            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if !child.IsToken() && child.Kind() != "TypeClause" && child.Kind() != "ArrayTypeClause" && child.Kind() != "GenericTypeClause"
                {
                    return InferTypeOfExpression(child)
                }

                i = i + 1
            }

            return "?"
        }

        /// <summary>字面量/一元/二元/名称/调用表达式 → 推断类型名（var 无类型标注时；对齐 C# 绑定）。</summary>
        private function InferTypeOfExpression(node: Node): string
        {
            let k = node.Kind()
            if k == "ParenthesizedExpression"
            {
                var p = 0
                while p < node.ChildCount()
                {
                    let child = node.Child(p)
                    if !child.IsToken()
                    {
                        return InferTypeOfExpression(child)
                    }

                    p = p + 1
                }

                return "?"
            }

            if k == "ObjectCreationExpression"
            {
                // (NewKeyword IdentifierToken ( args )) → 类名
                return node.ChildCount() > 1 ? node.Child(1).Text() : "?"
            }

            if k == "ArrayCreationExpression"
            {
                // (NewKeyword IdentifierToken [ <len> ] ...) → T[]
                return node.ChildCount() > 1 ? node.Child(1).Text() + "[]" : "?"
            }

            if k == "MemberCallExpression"
            {
                // 字符串实例成员返回类型：IndexOf/Length → i32；substring → string（其余 "?"）
                let m = node.ChildCount() > 2 ? node.Child(2).Text() : ""
                if m == "Length" || m == "IndexOf"
                {
                    return "i32"
                }

                if m == "substring"
                {
                    return "string"
                }

                return "?"
            }

            if k == "BinaryExpression"
            {
                // [left, opToken, right]：关系/逻辑 → bool；字符串拼接 → string；数值 → double 参与即 double，否则 int
                var left = "?"
                var right = "?"
                var op = ""                var b = 0
                while b < node.ChildCount()
                {
                    let child = node.Child(b)
                    if child.IsToken()
                    {
                        op = child.Kind()
                    }
                    else if left == "?"
                    {
                        left = InferTypeOfExpression(child)
                    }
                    else
                    {
                        right = InferTypeOfExpression(child)
                    }

                    b = b + 1
                }

                if op == "EqualsEqualsToken" || op == "BangEqualsToken" || op == "LessToken" || op == "GreaterToken" ||
                    op == "LessEqualsToken" || op == "GreaterEqualsToken" || op == "AndKeyword" || op == "OrKeyword"
                {
                    return "bool"
                }

                if left == "string" && right == "string"
                {
                    return "string"
                }

                if left == "double" || right == "double"
                {
                    return "double"
                }

                return "int"
            }

            if k == "NameExpression"
            {
                // 已声明局部 → 参数 → 全局（推断只发生在函数体内，_currentFunction 已设）
                let name = node.Child(0).Text()
                let localType = _currentFunction.LocalTypeOf(name)
                if localType != ""
                {
                    return localType
                }

                var i = 0
                while i < _paramCount
                {
                    if _paramNames[i] == name
                    {
                        return _paramTypes[i]
                    }

                    i = i + 1
                }

                i = 0
                while i < _variableCount
                {
                    if _variables[i].Name() == name
                    {
                        return _variables[i].Type()
                    }

                    i = i + 1
                }

                return "?"
            }

            if k == "CallExpression"
            {
                let callee = node.Child(0).Text()
                if callee == "string"
                {
                    return "string"
                }

                let fi = IndexOfString(_functionNames, _functionCount, callee)
                if fi >= 0
                {
                    return _functions[fi].ReturnType()
                }

                return "?"
            }

            if k == "UnaryExpression"
            {
                // (- expr)：取操作数推断
                var u = 0
                while u < node.ChildCount()
                {
                    let child = node.Child(u)
                    if child.Kind() != "MinusToken" && child.Kind() != "PlusToken" &&
                        child.Kind() != "BangToken" && child.Kind() != "TildeToken"
                    {
                        return InferTypeOfExpression(child)
                    }

                    u = u + 1
                }

                return "?"
            }

            // LiteralExpression：单子 token kind 决定（规范名对齐 C# TypeSymbol.Name）
            if node.ChildCount() == 1
            {
                let t = node.Child(0).Kind()
                if t == "NumberToken"
                {
                    return "int"
                }

                if t == "DoubleToken"
                {
                    return "double"
                }

                if t == "StringToken" || t == "VerbatimStringToken" || t == "RawStringToken"
                {
                    return "string"
                }

                if t == "CharToken"
                {
                    return "char"
                }

                if t == "TrueKeyword" || t == "FalseKeyword"
                {
                    return "bool"
                }
            }

            return "?"
        }

        private function ParameterName(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "IdentifierToken"
                {
                    return child.Text()
                }

                i = i + 1
            }

            return "?"
        }

        private function ClassNameOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                if node.Child(i).Kind() == "IdentifierToken"
                {
                    return node.Child(i).Text()
                }

                i = i + 1
            }

            return ""
        }

        private function FieldNameOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                if node.Child(i).Kind() == "IdentifierToken"
                {
                    return node.Child(i).Text()
                }

                i = i + 1
            }

            return ""
        }

        private function FieldTypeOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let k = node.Child(i).Kind()
                if k == "TypeClause" || k == "ArrayTypeClause" || k == "GenericTypeClause"
                {
                    return TypeOfClause(node.Child(i))
                }

                i = i + 1
            }

            return "int"
        }

        private function MethodNameOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                if node.Child(i).Kind() == "IdentifierToken"
                {
                    return node.Child(i).Text()
                }

                i = i + 1
            }

            return ""
        }

        private function MethodIsStatic(node: Node): bool
        {
            var i = 0
            while i < node.ChildCount()
            {
                if node.Child(i).Kind() == "StaticKeyword"
                {
                    return true
                }

                i = i + 1
            }

            return false
        }

        private function MethodReturnTypeOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let k = node.Child(i).Kind()
                if k == "TypeClause" || k == "ArrayTypeClause" || k == "GenericTypeClause"
                {
                    return TypeOfClause(node.Child(i))
                }

                i = i + 1
            }

            return "void"
        }

        private function ParameterType(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "TypeClause" || child.Kind() == "ArrayTypeClause"
                {
                    return TypeOfClause(child)
                }

                i = i + 1
            }

            return "?"
        }

        private function AddFunction(fn: FunctionSymbol, name: string): i32
        {
            if _functionCount >= _functions.Length
            {
                var bigger = new FunctionSymbol[_functions.Length * 2]
                var bn = new string[_functionNames.Length * 2]
                var i = 0
                while i < _functionCount
                {
                    bigger[i] = _functions[i]
                    bn[i] = _functionNames[i]
                    i = i + 1
                }

                _functions = bigger
                _functionNames = bn
            }

            _functions[_functionCount] = fn
            _functionNames[_functionCount] = name
            _functionCount = _functionCount + 1
            if name == "Main" && _mainName == "<none>"
            {
                _mainName = "Main"
            }
            return _functionCount - 1
        }

        private function AddVariable(v: VariableSymbol): void
        {
            if _variableCount >= _variables.Length
            {
                var bigger = new VariableSymbol[_variables.Length * 2]
                var i = 0
                while i < _variableCount
                {
                    bigger[i] = _variables[i]
                    i = i + 1
                }

                _variables = bigger
            }

            _variables[_variableCount] = v
            _variableCount = _variableCount + 1
        }

        /// <summary>符号表规范化输出（与 C# SymbolDump 同构）：函数行（+ 局部行缩进 2 空格，仅无诊断时）、变量行、main 行。</summary>
        public function DescribeSymbols(): string
        {
            var sb = ""
            var i = 0
            while i < _functionCount
            {
                sb = sb + _functions[i].Describe() + "\n"
                if _diagCount == 0
                {
                    var li = 0
                    while li < _functions[i].LocalCount()
                    {
                        sb = sb + "  " + _functions[i].Local(li).Describe() + "\n"
                        li = li + 1
                    }
                }

                i = i + 1
            }

            i = 0
            while i < _variableCount
            {
                sb = sb + _variables[i].Describe() + "\n"
                i = i + 1
            }

            return sb + "main: " + _mainName + "\n"
        }

        // ── M9-a2：诊断面 + 函数体检查 ──

        /// <summary>诊断行数与逐条访问（`error: ` 前缀，风格对齐自举 Parser 诊断）。</summary>
        public function DiagnosticCount(): i32
        {
            return _diagCount
        }

        public function DiagnosticAt(index: i32): string
        {
            return _diags[index]
        }

        // ── M9-a5：绑定树构建与规范化 dump（复用 MiniParser.Node：kind=绑定节点名、text=载荷、token 子=载荷）──

        /// <summary>绑定树规范化 dump：(Kind 载荷 子...) 单行空格分隔；token 子只出 text；无优先级括号。</summary>
        public function DescribeBoundTrees(): string
        {
            var sb = ""
            var i = 0
            while i < _functionCount
            {
                if _boundRoots[i] != null
                {
                    sb = sb + _functionNames[i] + ": " + BindDump(_boundRoots[i]) + "\n"
                }

                i = i + 1
            }

            return sb
        }

        // --- 结构化绑定树访问器（增量五 M5-a0） ---

        public function GetFunctionCount(): i32
        {
            return _functionCount
        }

        public function GetTopLevelFunctionCount(): i32
        {
            return _topLevelCount
        }

        /// <summary>第 o 个顶层函数的 `_functions` 索引（声明序）。</summary>
        public function GetTopLevelFunctionIndex(ordinal: i32): i32
        {
            return _topLevelIndexes[ordinal]
        }

        /// <summary>函数是否顶层声明（类方法 = false）。</summary>
        public function IsTopLevelFunction(index: i32): bool
        {
            var i = 0
            while i < _topLevelCount
            {
                if _topLevelIndexes[i] == index
                {
                    return true
                }

                i = i + 1
            }

            return false
        }

        public function GetFunctionName(index: i32): string
        {
            return _functionNames[index]
        }

        public function GetFunctionBody(index: i32): Node
        {
            return _boundRoots[index]
        }

        public function GetFunctionParamCount(index: i32): i32
        {
            return _functions[index].ParamCount()
        }

        public function GetFunctionParamName(index: i32, paramIndex: i32): string
        {
            return _functions[index].ParamName(paramIndex)
        }

        public function GetFunctionParamType(index: i32, paramIndex: i32): string
        {
            return _functions[index].ParamType(paramIndex)
        }

        public function GetFunctionReturnType(index: i32): string
        {
            return _functions[index].ReturnType()
        }

        public function GetFunctionLocalCount(index: i32): i32
        {
            return _functions[index].LocalCount()
        }

        public function GetFunctionLocalType(index: i32, localIndex: i32): string
        {
            return _functions[index].Local(localIndex).Type()
        }

        public function GetClassCount(): i32
        {
            return _classCount
        }

        public function GetClassName(index: i32): string
        {
            return _classNames[index]
        }

        public function GetClassFieldCount(index: i32): i32
        {
            return _classFieldCounts[index]
        }

        public function GetClassFieldName(index: i32, fieldIndex: i32): string
        {
            return _classFieldNames[_classFieldOffsets[index] + fieldIndex]
        }

        public function GetClassFieldType(index: i32, fieldIndex: i32): string
        {
            return _classFieldTypes[_classFieldOffsets[index] + fieldIndex]
        }

        public function GetClassMethodCount(index: i32): i32
        {
            return _classMethodCounts[index]
        }

        public function GetClassMethodName(index: i32, methodIndex: i32): string
        {
            return _classMethodNames[_classMethodOffsets[index] + methodIndex]
        }

        public function GetClassMethodIndex(index: i32, methodIndex: i32): i32
        {
            return _classMethodIndexes[_classMethodOffsets[index] + methodIndex]
        }

        public function GetClassMethodIsStatic(index: i32, methodIndex: i32): bool
        {
