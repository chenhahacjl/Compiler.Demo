// Cocoa 自举 Binder —— 阶段 7 增量三（M9-a0 差分基建 + M9-a1 符号声明面 + M9-a2 诊断面）：
// 自举 Parser 的 Node 树 → 符号（顶层函数 / 全局变量），DescribeSymbols() 与 C# 端
// BinderDifferentialTests.SymbolDump 逐字节一致（M9 差分口径）。
// M9-a1 范围：函数符号（名/参数/返回类型）、全局变量（显式类型 + 字面量 var 推断）、main 判定。
// M9-a2 范围：诊断面（ReportError/DiagnosticCount/DiagnosticAt，`error: ` 前缀对齐 Parser 诊断风格）
//   + 函数体遍历检查：未定义名/未定义函数/调用 arity/未知类型（签名与局部声明）/重复声明
//   （参数/全局/函数/局部）。消息句式对齐 C# GetDiagnostics 文本（不逐字锁定，差分口径为双方言同报错）。
//   Lambda/泛型/Foreach 循环变量收集为宽松处理（M9-a3 起收紧）。
// 依赖：MiniParser（Node/Parser，树结构已由增量二差分锁定）。

using MiniParser

namespace MiniBinder
{
    class Binder
    {
        private field _root: Node
        private field _functions: FunctionSymbol[]
        private field _functionCount: i32
        private field _functionNames: string[]
        private field _variables: VariableSymbol[]
        private field _variableCount: i32
        private field _globalNames: string[]
        private field _paramNames: string[]
        private field _paramTypes: string[]
        private field _paramCount: i32
        private field _locals: string[]
        private field _localCount: i32
        private field _currentFunction: FunctionSymbol
        private field _diags: string[]
        private field _diagCount: i32
        private field _mainName: string

        public static function Create(source: string): Binder
        {
            var b = new Binder()
            let parser = MiniParser.Parser.Create(source)
            b._root = parser.ParseCompilationUnit()
            b._functions = new FunctionSymbol[8]
            b._functionCount = 0
            b._functionNames = new string[8]
            b._variables = new VariableSymbol[8]
            b._variableCount = 0
            b._globalNames = new string[8]
            b._paramNames = new string[8]
            b._paramTypes = new string[8]
            b._paramCount = 0
            b._locals = new string[8]
            b._localCount = 0
            b._diags = new string[8]
            b._diagCount = 0
            b._mainName = "<none>"
            return b
        }

        /// <summary>两遍式绑定：第一遍声明全部顶层符号（前向可见，对齐 C# 全局作用域语义）；
        /// 第二遍做类型/函数体/初始化表达式检查。</summary>
        public function BindCompilationUnit(): void
        {
            var i = 0
            while i < _root.ChildCount()
            {
                let member = _root.Child(i)
                let kind = member.Kind()
                if kind == "FunctionDeclaration"
                {
                    BindFunction(member)
                }
                else if kind == "GlobalStatement"
                {
                    // GlobalStatement 包裹的顶层语句：仅 var/let 声明产生全局符号
                    if member.ChildCount() == 1 && member.Child(0).Kind() == "VariableDeclaration"
                    {
                        BindGlobalVariable(member.Child(0))
                    }
                }

                i = i + 1
            }

            var fi = 0
            i = 0
            while i < _root.ChildCount()
            {
                let member = _root.Child(i)
                let kind = member.Kind()
                if kind == "FunctionDeclaration"
                {
                    CheckFunctionBody(member, _functions[fi])
                    fi = fi + 1
                }
                else if kind == "GlobalStatement"
                {
                    if member.ChildCount() == 1 && member.Child(0).Kind() == "VariableDeclaration"
                    {
                        CheckGlobalVariable(member.Child(0))
                    }
                }

                i = i + 1
            }

            // M9-a2：main 函数与全局语句互斥（对齐 C# 端规则，声明序无关；
            // C# 在 GlobalScope 与 Program 两阶段各报一次，条数对齐）
            if _variableCount > 0 && _mainName != "<none>"
            {
                ReportError("Cannot declare main function when global statements are used.")
                ReportError("Cannot declare main function when global statements are used.")
            }
        }

        private function BindFunction(node: Node): void
        {
            // 直接子：[mods...] FunctionKeyword IdentifierToken ( Parameter... ) (TypeClause)? (Block)?
            var name = ""
            var returnType = "void"
            var paramNames = new string[8]
            var paramCount = 0

            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "IdentifierToken"
                {
                    name = child.Text()
                }
                else if k == "Parameter"
                {
                    let pname = ParameterName(child)
                    if IndexOfString(paramNames, paramCount, pname) >= 0
                    {
                        ReportError("A parameter with the name '" + pname + "' already exists.")
                    }
                    else
                    {
                        if paramCount >= paramNames.Length
                        {
                            var bn = new string[paramNames.Length * 2]
                            var j = 0
                            while j < paramCount
                            {
                                bn[j] = paramNames[j]
                                j = j + 1
                            }

                            paramNames = bn
                        }

                        paramNames[paramCount] = pname
                        paramCount = paramCount + 1
                    }
                }
                else if k == "TypeClause" || k == "ArrayTypeClause"
                {
                    returnType = TypeOfClause(child)
                }

                i = i + 1
            }

            // M9-a2：签名未知类型检查（返回类型 + 各参数类型）
            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "TypeClause" || k == "ArrayTypeClause"
                {
                    CheckTypeClause(child)
                }
                else if k == "Parameter"
                {
                    var j = 0
                    while j < child.ChildCount()
                    {
                        let pc = child.Child(j)
                        if pc.Kind() == "TypeClause" || pc.Kind() == "ArrayTypeClause"
                        {
                            CheckTypeClause(pc)
                        }

                        j = j + 1
                    }
                }

                i = i + 1
            }

            if IndexOfString(_functionNames, _functionCount, name) >= 0
            {
                ReportError("'" + name + "' is already declared.")
            }

            let fn = FunctionSymbol.Create(name, returnType)
            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "Parameter"
                {
                    fn.AddParameter(ParameterName(child), ParameterType(child))
                }

                i = i + 1
            }

            AddFunction(fn, name)
        }

        private function BindGlobalVariable(node: Node): void
        {
            // (VariableDeclaration (Var|LetKeyword) IdentifierToken (TypeClause)? (EqualsToken expr)?)
            var name = ""
            var type = ""

            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "IdentifierToken"
                {
                    if name == ""
                    {
                        name = child.Text()
                    }
                }
                else if k == "TypeClause" || k == "ArrayTypeClause" || k == "GenericTypeClause"
                {
                    type = TypeOfClause(child)
                }
                else if type == "" && (k == "LiteralExpression" || k == "UnaryExpression")
                {
                    type = InferTypeOfExpression(child)
                }

                i = i + 1
            }

            // M9-a2：重复全局名（第一遍声明期检查）
            if IndexOfString(_globalNames, _variableCount, name) >= 0
            {
                ReportError("'" + name + "' is already declared.")
            }
            else
            {
                if _variableCount >= _globalNames.Length
                {
                    var bigger = new string[_globalNames.Length * 2]
                    var j = 0
                    while j < _variableCount
                    {
                        bigger[j] = _globalNames[j]
                        j = j + 1
                    }

                    _globalNames = bigger
                }

                _globalNames[_variableCount] = name
            }

            AddVariable(VariableSymbol.Create(name, type))
        }

        /// <summary>第二遍：函数体检查（参数名/类型集供体内解析；局部作用域清零）。</summary>
        private function CheckFunctionBody(node: Node, fn: FunctionSymbol): void
        {
            _paramNames = new string[fn.ParamCount() + 8]
            _paramTypes = new string[fn.ParamCount() + 8]
            _paramCount = fn.ParamCount()
            var i = 0
            while i < fn.ParamCount()
            {
                _paramNames[i] = fn.ParamName(i)
                _paramTypes[i] = fn.ParamType(i)
                i = i + 1
            }

            _currentFunction = fn
            _localCount = 0
            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "BlockStatement"
                {
                    CheckNode(child)
                }

                i = i + 1
            }

            _paramCount = 0
        }

        /// <summary>第二遍：全局变量初始化表达式与类型检查（右值此时全局/函数已全部声明）。</summary>
        private function CheckGlobalVariable(node: Node): void
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "TypeClause" || k == "ArrayTypeClause"
                {
                    CheckTypeClause(child)
                }
                else if !child.IsToken() && k != "TypeClause" && k != "ArrayTypeClause" && k != "GenericTypeClause"
                {
                    CheckNode(child)
                }

                i = i + 1
            }
        }

        /// <summary>类型子句 → 规范类型名（对齐 C# TypeSymbol.Name：int/string/void、int[]）。</summary>
        private function TypeOfClause(node: Node): string
        {
            let k = node.Kind()
            if k == "ArrayTypeClause"
            {
                // (ArrayTypeClause colon name (TypeClause 元素) [ ])
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child.Kind() == "TypeClause"
                    {
                        return TypeOfClause(child) + "[]"
                    }

                    i = i + 1
                }

                return CanonicalType(TypeOfIdentifier(node)) + "[]"
            }

            return CanonicalType(TypeOfIdentifier(node))
        }

        /// <summary>Cocoa 简写词汇 → C# 风格规范名（对齐 TypeSymbol 常量构造名）。</summary>
        private function CanonicalType(name: string): string
        {
            if name == "i8" { return "sbyte" }
            if name == "u8" { return "byte" }
            if name == "i16" { return "short" }
            if name == "u16" { return "ushort" }
            if name == "i32" { return "int" }
            if name == "u32" { return "uint" }
            if name == "i64" { return "long" }
            if name == "u64" { return "ulong" }
            if name == "f32" { return "float" }
            if name == "f64" { return "double" }
            return name
        }

        private function TypeOfIdentifier(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "IdentifierToken"
                {
                    return child.Text()
                }

                i = i + 1
            }

            return "?"
        }

        /// <summary>体内声明的局部类型：显式类型子句优先，否则值表达式推断（M9-a3）。</summary>
        private function LocalTypeOfDeclaration(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                let k = child.Kind()
                if k == "TypeClause" || k == "ArrayTypeClause" || k == "GenericTypeClause"
                {
                    return TypeOfClause(child)
                }

                i = i + 1
            }

            i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if !child.IsToken() && child.Kind() != "TypeClause" && child.Kind() != "ArrayTypeClause" && child.Kind() != "GenericTypeClause"
                {
                    return InferTypeOfExpression(child)
                }

                i = i + 1
            }

            return "?"
        }

        /// <summary>字面量/一元/二元/名称/调用表达式 → 推断类型名（var 无类型标注时；对齐 C# 绑定）。</summary>
        private function InferTypeOfExpression(node: Node): string
        {
            let k = node.Kind()
            if k == "ParenthesizedExpression"
            {
                var p = 0
                while p < node.ChildCount()
                {
                    let child = node.Child(p)
                    if !child.IsToken()
                    {
                        return InferTypeOfExpression(child)
                    }

                    p = p + 1
                }

                return "?"
            }

            if k == "BinaryExpression"
            {
                // [left, opToken, right]：关系/逻辑 → bool；字符串拼接 → string；数值 → double 参与即 double，否则 int
                var left = "?"
                var right = "?"
                var op = ""
                var b = 0
                while b < node.ChildCount()
                {
                    let child = node.Child(b)
                    if child.IsToken()
                    {
                        op = child.Kind()
                    }
                    else if left == "?"
                    {
                        left = InferTypeOfExpression(child)
                    }
                    else
                    {
                        right = InferTypeOfExpression(child)
                    }

                    b = b + 1
                }

                if op == "EqualsEqualsToken" || op == "BangEqualsToken" || op == "LessToken" || op == "GreaterToken" ||
                    op == "LessEqualsToken" || op == "GreaterEqualsToken" || op == "AndKeyword" || op == "OrKeyword"
                {
                    return "bool"
                }

                if left == "string" && right == "string"
                {
                    return "string"
                }

                if left == "double" || right == "double"
                {
                    return "double"
                }

                return "int"
            }

            if k == "NameExpression"
            {
                // 已声明局部 → 参数 → 全局（推断只发生在函数体内，_currentFunction 已设）
                let name = node.Child(0).Text()
                let localType = _currentFunction.LocalTypeOf(name)
                if localType != ""
                {
                    return localType
                }

                var i = 0
                while i < _paramCount
                {
                    if _paramNames[i] == name
                    {
                        return _paramTypes[i]
                    }

                    i = i + 1
                }

                i = 0
                while i < _variableCount
                {
                    if _variables[i].Name() == name
                    {
                        return _variables[i].Type()
                    }

                    i = i + 1
                }

                return "?"
            }

            if k == "CallExpression"
            {
                let callee = node.Child(0).Text()
                let fi = IndexOfString(_functionNames, _functionCount, callee)
                if fi >= 0
                {
                    return _functions[fi].ReturnType()
                }

                return "?"
            }

            if k == "UnaryExpression"
            {
                // (- expr)：取操作数推断
                var u = 0
                while u < node.ChildCount()
                {
                    let child = node.Child(u)
                    if child.Kind() != "MinusToken" && child.Kind() != "PlusToken" &&
                        child.Kind() != "BangToken" && child.Kind() != "TildeToken"
                    {
                        return InferTypeOfExpression(child)
                    }

                    u = u + 1
                }

                return "?"
            }

            // LiteralExpression：单子 token kind 决定（规范名对齐 C# TypeSymbol.Name）
            if node.ChildCount() == 1
            {
                let t = node.Child(0).Kind()
                if t == "NumberToken"
                {
                    return "int"
                }

                if t == "DoubleToken"
                {
                    return "double"
                }

                if t == "StringToken" || t == "VerbatimStringToken" || t == "RawStringToken"
                {
                    return "string"
                }

                if t == "CharToken"
                {
                    return "char"
                }

                if t == "TrueKeyword" || t == "FalseKeyword"
                {
                    return "bool"
                }
            }

            return "?"
        }

        private function ParameterName(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "IdentifierToken"
                {
                    return child.Text()
                }

                i = i + 1
            }

            return "?"
        }

        private function ParameterType(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let child = node.Child(i)
                if child.Kind() == "TypeClause" || child.Kind() == "ArrayTypeClause"
                {
                    return TypeOfClause(child)
                }

                i = i + 1
            }

            return "?"
        }

        private function AddFunction(fn: FunctionSymbol, name: string): void
        {
            if _functionCount >= _functions.Length
            {
                var bigger = new FunctionSymbol[_functions.Length * 2]
                var bn = new string[_functionNames.Length * 2]
                var i = 0
                while i < _functionCount
                {
                    bigger[i] = _functions[i]
                    bn[i] = _functionNames[i]
                    i = i + 1
                }

                _functions = bigger
                _functionNames = bn
            }

            _functions[_functionCount] = fn
            _functionNames[_functionCount] = name
            _functionCount = _functionCount + 1
            if name == "Main" && _mainName == "<none>"
            {
                _mainName = "Main"
            }
        }

        private function AddVariable(v: VariableSymbol): void
        {
            if _variableCount >= _variables.Length
            {
                var bigger = new VariableSymbol[_variables.Length * 2]
                var i = 0
                while i < _variableCount
                {
                    bigger[i] = _variables[i]
                    i = i + 1
                }

                _variables = bigger
            }

            _variables[_variableCount] = v
            _variableCount = _variableCount + 1
        }

        /// <summary>符号表规范化输出（与 C# SymbolDump 同构）：函数行（+ 局部行缩进 2 空格，仅无诊断时）、变量行、main 行。</summary>
        public function DescribeSymbols(): string
        {
            var sb = ""
            var i = 0
            while i < _functionCount
            {
                sb = sb + _functions[i].Describe() + "\n"
                if _diagCount == 0
                {
                    var li = 0
                    while li < _functions[i].LocalCount()
                    {
                        sb = sb + "  " + _functions[i].Local(li).Describe() + "\n"
                        li = li + 1
                    }
                }

                i = i + 1
            }

            i = 0
            while i < _variableCount
            {
                sb = sb + _variables[i].Describe() + "\n"
                i = i + 1
            }

            return sb + "main: " + _mainName + "\n"
        }

        // ── M9-a2：诊断面 + 函数体检查 ──

        /// <summary>诊断行数与逐条访问（`error: ` 前缀，风格对齐自举 Parser 诊断）。</summary>
        public function DiagnosticCount(): i32
        {
            return _diagCount
        }

        public function DiagnosticAt(index: i32): string
        {
            return _diags[index]
        }

        private function ReportError(message: string): void
        {
            if _diagCount >= _diags.Length
            {
                var bigger = new string[_diags.Length * 2]
                var i = 0
                while i < _diagCount
                {
                    bigger[i] = _diags[i]
                    i = i + 1
                }

                _diags = bigger
            }

            _diags[_diagCount] = "error: " + message
            _diagCount = _diagCount + 1
        }

        /// <summary>语句/表达式递归检查：未定义名、未定义函数、调用 arity、未知类型、局部重复声明。</summary>
        private function CheckNode(node: Node): void
        {
            let k = node.Kind()
            if k == "NameExpression"
            {
                let name = node.Child(0).Text()
                if !IsKnownName(name)
                {
                    ReportError("Variable '" + name + "' doesn't exist.")
                }

                return
            }

            if k == "CallExpression"
            {
                // (CallExpression IdentifierToken ( args... ))：实参 = 非 token 子
                let callee = node.Child(0).Text()
                var args = 0
                var i = 1
                while i < node.ChildCount()
                {
                    if !node.Child(i).IsToken()
                    {
                        args = args + 1
                    }

                    i = i + 1
                }

                let fi = IndexOfString(_functionNames, _functionCount, callee)
                if fi < 0
                {
                    ReportError("Function '" + callee + "' doesn't exist.")
                }
                else
                {
                    let expected = _functions[fi].ParamCount()
                    if expected != args
                    {
                        ReportError("Function '" + callee + "' requires " + string(expected) + " arguments but was given " + string(args) + ".")
                    }
                }

                i = 1
                while i < node.ChildCount()
                {
                    if !node.Child(i).IsToken()
                    {
                        CheckNode(node.Child(i))
                    }

                    i = i + 1
                }

                return
            }

            if k == "VariableDeclaration"
            {
                // 体内声明：名入局部作用域（先查重）；类型解析并入局部符号；值表达式下钻
                var name = ""
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child.Kind() == "IdentifierToken" && name == ""
                    {
                        name = child.Text()
                    }

                    i = i + 1
                }

                if name != ""
                {
                    if IndexOfString(_locals, _localCount, name) >= 0 || IndexOfString(_paramNames, _paramCount, name) >= 0
                    {
                        ReportError("'" + name + "' is already declared.")
                    }
                    else
                    {
                        AddLocal(name)
                        _currentFunction.AddLocal(name, LocalTypeOfDeclaration(node))
                    }
                }

                i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck = child.Kind()
                    if ck == "TypeClause" || ck == "ArrayTypeClause"
                    {
                        CheckTypeClause(child)
                    }
                    else if !child.IsToken()
                    {
                        CheckNode(child)
                    }

                    i = i + 1
                }

                return
            }

            if k == "ExpressionStatement"
            {
                // M9-a4：对齐 C# 语句校验——赋值目标未定义时追加 statement 消息（先下钻报 Variable 错，再补报）
                var stmt: Node = null
                var s = 0
                while s < node.ChildCount()
                {
                    let child = node.Child(s)
                    if !child.IsToken()
                    {
                        stmt = child
                    }

                    s = s + 1
                }

                CheckNode(stmt)
                if stmt.Kind() == "AssignmentExpression"
                {
                    var left: Node = null
                    var a = 0
                    while a < stmt.ChildCount()
                    {
                        let child = stmt.Child(a)
                        if !child.IsToken()
                        {
                            left = child
                            break
                        }

                        a = a + 1
                    }

                    if left.Kind() == "NameExpression" && !IsKnownName(left.Child(0).Text())
                    {
                        ReportError("Only assignment and call expressions can be used as a statement.")
                    }
                }

                return
            }

            if k == "LambdaExpression"
            {
                // lambda 参数/闭包作用域：M9-a3 起处理（宽松跳过避免误报）
                return
            }

            if k == "MemberCallExpression" || k == "MemberAccessExpression"
            {
                // receiver（首子）为类型/命名空间名或成员链：M9-a2 无类型面，宽松放行；
                // 仅下钻实参（子链中的实例变量检查随 M9-a3 类型面收紧）
                var i = 1
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        CheckNode(child)
                    }

                    i = i + 1
                }

                return
            }

            if k == "ForeachStatement" || k == "ForRangeStatement"
            {
                // 循环变量宽松入局部（类型名 token 同收，方向安全只漏报不误报；M9-a3 收紧）
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child.Kind() == "IdentifierToken"
                    {
                        AddLocal(child.Text())
                    }

                    i = i + 1
                }
            }

            // 默认：非 token 子下钻；类型子句显式检查（复合子内的类型 token 不触发名字检查）
            var j = 0
            while j < node.ChildCount()
            {
                let child = node.Child(j)
                let ck = child.Kind()
                if child.IsToken()
                {
                    // token 子跳过
                }
                else if ck == "TypeClause" || ck == "ArrayTypeClause"
                {
                    CheckTypeClause(child)
                }
                else
                {
                    CheckNode(child)
                }

                j = j + 1
            }
        }

        /// <summary>类型子句未知类型检查（数组递归元素；泛型放行待 M9-a3）。</summary>
        private function CheckTypeClause(node: Node): void
        {
            let k = node.Kind()
            if k == "GenericTypeClause"
            {
                return
            }

            if k == "ArrayTypeClause"
            {
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck = child.Kind()
                    if ck == "TypeClause" || ck == "ArrayTypeClause"
                    {
                        CheckTypeClause(child)
                    }

                    i = i + 1
                }

                return
            }

            let raw = TypeOfIdentifier(node)
            if !KnownType(CanonicalType(raw))
            {
                ReportError("Type '" + raw + "' doesn't exist.")
            }
        }

        /// <summary>canonical 名是否为已知类型（数组剥 [] 后比对白名单）。</summary>
        private function KnownType(name: string): bool
        {
            var t = name
            if t.Length > 2 && t.substring(t.Length - 2, 2) == "[]"
            {
                t = t.substring(0, t.Length - 2)
            }

            if t == "sbyte" { return true }
            if t == "byte" { return true }
            if t == "short" { return true }
            if t == "ushort" { return true }
            if t == "int" { return true }
            if t == "uint" { return true }
            if t == "long" { return true }
            if t == "ulong" { return true }
            if t == "float" { return true }
            if t == "double" { return true }
            if t == "bool" { return true }
            if t == "char" { return true }
            if t == "string" { return true }
            if t == "object" { return true }
            if t == "void" { return true }
            if t == "decimal" { return true }
            if t == "nint" { return true }
            if t == "nuint" { return true }
            if t == "i128" { return true }
            if t == "u128" { return true }
            if t == "f128" { return true }
            return false
        }

        private function IsKnownName(name: string): bool
        {
            if IndexOfString(_functionNames, _functionCount, name) >= 0
            {
                return true
            }

            if IndexOfString(_globalNames, _variableCount, name) >= 0
            {
                return true
            }

            if IndexOfString(_paramNames, _paramCount, name) >= 0
            {
                return true
            }

            if IndexOfString(_locals, _localCount, name) >= 0
            {
                return true
            }

            return false
        }

        private function AddLocal(name: string): void
        {
            if _localCount >= _locals.Length
            {
                var bigger = new string[_locals.Length * 2]
                var i = 0
                while i < _localCount
                {
                    bigger[i] = _locals[i]
                    i = i + 1
                }

                _locals = bigger
            }

            _locals[_localCount] = name
            _localCount = _localCount + 1
        }

        private static function IndexOfString(items: string[], count: i32, name: string): i32
        {
            var i = 0
            while i < count
            {
                if items[i] == name
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }
    }
}
