        }

        // --- lowering：if/while → label/goto/conditionalgoto（对齐 C# Lowerer 输出） ---

        private function MakeLabel(): string
        {
            _labelCount = _labelCount + 1
            return "Label" + _labelCount.ToString()
        }

        private function MakeLoopLabel(): string
        {
            _loopLabelCount = _loopLabelCount + 1
            return _loopLabelCount.ToString()
        }

        private function PushLoopLabels(breakLabel: string, continueLabel: string): void
        {
            if _loopDepth >= _loopBreakLabels.Length
            {
                var nb = new string[_loopBreakLabels.Length * 2]
                var nc = new string[_loopContinueLabels.Length * 2]
                var i = 0
                while i < _loopDepth
                {
                    nb[i] = _loopBreakLabels[i]
                    nc[i] = _loopContinueLabels[i]
                    i = i + 1
                }

                _loopBreakLabels = nb
                _loopContinueLabels = nc
            }

            _loopBreakLabels[_loopDepth] = breakLabel
            _loopContinueLabels[_loopDepth] = continueLabel
            _loopDepth = _loopDepth + 1
        }

        private function PopLoopLabels(): void
        {
            _loopDepth = _loopDepth - 1
        }

        private function LowerBound(node: Node): Node
        {
            if node.IsToken()
            {
                return node
            }

            return LowerStatement(node)
        }

        private function LowerStatement(node: Node): Node
        {
            if node.IsToken()
            {
                return node
            }

            let k = node.Kind()
            if k == "IfStatement"
            {
                let condition = node.Child(0)
                let thenBlock = node.Child(1)
                let hasElse = node.ChildCount() > 2

                if !hasElse
                {
                    let endLabel = MakeLabel()
                    let result = Node.MakeCompound("BlockStatement")
                    let cg = Node.MakeCompound("ConditionalGotoStatement")
                    cg.Add(MakeToken(endLabel))
                    cg.Add(MakeToken("False"))
                    cg.Add(condition)
                    result.Add(cg)
                    let thenStmts = LowerBlockStmts(thenBlock)
                    var ti = 0
                    while ti < thenStmts.ChildCount()
                    {
                        result.Add(thenStmts.Child(ti))
                        ti = ti + 1
                    }

                    let lb = Node.MakeCompound("LabelStatement")
                    lb.Add(MakeToken(endLabel))
                    result.Add(lb)
                    return result
                }
                else
                {
                    let elseLabel = MakeLabel()
                    let endLabel = MakeLabel()
                    let result = Node.MakeCompound("BlockStatement")
                    let cg = Node.MakeCompound("ConditionalGotoStatement")
                    cg.Add(MakeToken(elseLabel))
                    cg.Add(MakeToken("False"))
                    cg.Add(condition)
                    result.Add(cg)
                    let thenStmts = LowerBlockStmts(thenBlock)
                    var ti = 0
                    while ti < thenStmts.ChildCount()
                    {
                        result.Add(thenStmts.Child(ti))
                        ti = ti + 1
                    }

                    let gt = Node.MakeCompound("GotoStatement")
                    gt.Add(MakeToken(endLabel))
                    result.Add(gt)
                    let lb1 = Node.MakeCompound("LabelStatement")
                    lb1.Add(MakeToken(elseLabel))
                    result.Add(lb1)
                    let elseStmts = LowerBlockStmts(node.Child(2))
                    var ei = 0
                    while ei < elseStmts.ChildCount()
                    {
                        result.Add(elseStmts.Child(ei))
                        ei = ei + 1
                    }

                    let lb2 = Node.MakeCompound("LabelStatement")
                    lb2.Add(MakeToken(endLabel))
                    result.Add(lb2)
                    return result
                }
            }

            if k == "WhileStatement"
            {
                let condition = node.Child(0)
                let body = node.Child(1)
                let bodyLabel = MakeLabel()
                let loopId = MakeLoopLabel()
                let continueLabel = "continue" + loopId
                let breakLabel = "break" + loopId
                let result = Node.MakeCompound("BlockStatement")
                let gt = Node.MakeCompound("GotoStatement")
                gt.Add(MakeToken(continueLabel))
                result.Add(gt)
                let lb1 = Node.MakeCompound("LabelStatement")
                lb1.Add(MakeToken(bodyLabel))
                result.Add(lb1)
                PushLoopLabels(breakLabel, continueLabel)
                let bodyStmts = LowerBlockStmts(body)
                PopLoopLabels()
                var bi = 0
                while bi < bodyStmts.ChildCount()
                {
                    result.Add(bodyStmts.Child(bi))
                    bi = bi + 1
                }

                let lb2 = Node.MakeCompound("LabelStatement")
                lb2.Add(MakeToken(continueLabel))
                result.Add(lb2)
                let cg = Node.MakeCompound("ConditionalGotoStatement")
                cg.Add(MakeToken(bodyLabel))
                cg.Add(MakeToken("True"))
                cg.Add(condition)
                result.Add(cg)
                let lb3 = Node.MakeCompound("LabelStatement")
                lb3.Add(MakeToken(breakLabel))
                result.Add(lb3)
                return result
            }

            if k == "DoWhileStatement"
            {
                let body = node.Child(0)
                let condition = node.Child(1)
                let bodyLabel = MakeLabel()
                let loopId = MakeLoopLabel()
                let continueLabel = "continue" + loopId
                let breakLabel = "break" + loopId
                let result = Node.MakeCompound("BlockStatement")
                let lb1 = Node.MakeCompound("LabelStatement")
                lb1.Add(MakeToken(bodyLabel))
                result.Add(lb1)
                PushLoopLabels(breakLabel, continueLabel)
                let bodyStmts = LowerBlockStmts(body)
                PopLoopLabels()
                var bi = 0
                while bi < bodyStmts.ChildCount()
                {
                    result.Add(bodyStmts.Child(bi))
                    bi = bi + 1
                }

                let lb2 = Node.MakeCompound("LabelStatement")
                lb2.Add(MakeToken(continueLabel))
                result.Add(lb2)
                let cg = Node.MakeCompound("ConditionalGotoStatement")
                cg.Add(MakeToken(bodyLabel))
                cg.Add(MakeToken("True"))
                cg.Add(condition)
                result.Add(cg)
                let lb3 = Node.MakeCompound("LabelStatement")
                lb3.Add(MakeToken(breakLabel))
                result.Add(lb3)
                return result
            }

            if k == "ForRangeStatement"
            {
                // for var i = <lower> to <upper> { <body> }
                // → { var i = <lower>; let upperBound = <upper>; goto condLabel; bodyLabel: <body>; continueLabel: i = i + 1; condLabel: gotoTrue bodyLabel i <= upperBound; breakLabel: }
                let varName = node.Child(0).Text()
                let lowerExpr = node.Child(1)
                let upperExpr = node.Child(2)
                let hasStep = node.ChildCount() > 4
                let body = node.Child(node.ChildCount() - 1)
                let loopId = MakeLoopLabel()
                let continueLabel = "continue" + loopId
                let breakLabel = "break" + loopId
                let condLabel = MakeLabel()
                let bodyLabel = MakeLabel()
                let result = Node.MakeCompound("BlockStatement")
                let varDecl = Node.MakeCompound("VariableDeclaration")
                varDecl.Add(Node.MakeToken("decl", "var"))
                varDecl.Add(Node.MakeToken("name", varName))
                varDecl.Add(lowerExpr)
                result.Add(varDecl)
                let upperDecl = Node.MakeCompound("VariableDeclaration")
                upperDecl.Add(Node.MakeToken("decl", "let"))
                upperDecl.Add(Node.MakeToken("name", "upperBound"))
                upperDecl.Add(upperExpr)
                result.Add(upperDecl)
                let gt = Node.MakeCompound("GotoStatement")
                gt.Add(MakeToken(condLabel))
                result.Add(gt)
                let lb1 = Node.MakeCompound("LabelStatement")
                lb1.Add(MakeToken(bodyLabel))
                result.Add(lb1)
                PushLoopLabels(breakLabel, continueLabel)
                let bodyStmts = LowerBlockStmts(body)
                PopLoopLabels()
                var bi = 0
                while bi < bodyStmts.ChildCount()
                {
                    result.Add(bodyStmts.Child(bi))
                    bi = bi + 1
                }

                let lb2 = Node.MakeCompound("LabelStatement")
                lb2.Add(MakeToken(continueLabel))
                result.Add(lb2)
                let incr = Node.MakeCompound("ExpressionStatement")
                let assign = Node.MakeCompound("AssignmentExpression")
                assign.Add(Node.MakeToken("name", varName))
                let addExpr = Node.MakeCompound("BinaryExpression")
                addExpr.Add(Node.MakeToken("op", "+"))
                let varRef = Node.MakeCompound("VariableExpression")
                varRef.Add(Node.MakeToken("name", varName))
                addExpr.Add(varRef)
                if hasStep
                {
                    addExpr.Add(node.Child(3))
                }
                else
                {
                    let oneLit = Node.MakeCompound("LiteralExpression")
                    oneLit.Add(Node.MakeToken("Number", "1"))
                    addExpr.Add(oneLit)
                }

                assign.Add(addExpr)
                incr.Add(assign)
                result.Add(incr)
                let lb3 = Node.MakeCompound("LabelStatement")
                lb3.Add(MakeToken(condLabel))
                result.Add(lb3)
                let cg = Node.MakeCompound("ConditionalGotoStatement")
                cg.Add(MakeToken(bodyLabel))
                cg.Add(MakeToken("True"))
                let condExpr = Node.MakeCompound("BinaryExpression")
                condExpr.Add(Node.MakeToken("op", "<="))
                let condVarRef = Node.MakeCompound("VariableExpression")
                condVarRef.Add(Node.MakeToken("name", varName))
                condExpr.Add(condVarRef)
                let condUpperRef = Node.MakeCompound("VariableExpression")
                condUpperRef.Add(Node.MakeToken("name", "upperBound"))
                condExpr.Add(condUpperRef)
                cg.Add(condExpr)
                result.Add(cg)
                let lb4 = Node.MakeCompound("LabelStatement")
                lb4.Add(MakeToken(breakLabel))
                result.Add(lb4)
                return result
            }

            if k == "BreakStatement"
            {
                if _loopDepth > 0
                {
                    let result = Node.MakeCompound("GotoStatement")
                    result.Add(MakeToken(_loopBreakLabels[_loopDepth - 1]))
                    return result
                }
            }

            if k == "ContinueStatement"
            {
                if _loopDepth > 0
                {
                    let result = Node.MakeCompound("GotoStatement")
                    result.Add(MakeToken(_loopContinueLabels[_loopDepth - 1]))
                    return result
                }
            }

            if k == "BlockStatement"
            {
                let result = Node.MakeCompound("BlockStatement")
                var bi = 0
                while bi < node.ChildCount()
                {
                    let lowered = LowerStatement(node.Child(bi))
                    if lowered.Kind() == "BlockStatement" && !lowered.IsToken()
                    {
                        var ci = 0
                        while ci < lowered.ChildCount()
                        {
                            result.Add(lowered.Child(ci))
                            ci = ci + 1
                        }
                    }
                    else
                    {
                        result.Add(lowered)
                    }

                    bi = bi + 1
                }

                return result
            }

            return node
        }

        private function LowerBlockStmts(node: Node): Node
        {
            if node.IsToken()
            {
                return node
            }

            let k = node.Kind()
            if k == "BlockStatement"
            {
                let result = Node.MakeCompound("BlockStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let lowered = LowerStatement(node.Child(i))
                    if lowered.Kind() == "BlockStatement" && !lowered.IsToken()
                    {
                        var ci = 0
                        while ci < lowered.ChildCount()
                        {
                            result.Add(lowered.Child(ci))
                            ci = ci + 1
                        }
                    }
                    else
                    {
                        result.Add(lowered)
                    }

                    i = i + 1
                }

                return result
            }

            return LowerStatement(node)
        }

        private function MakeToken(text: string): Node
        {
            return Node.MakeToken("IdentifierToken", text)
        }

        private function BindDump(node: Node): string
        {
            if node.IsToken()
            {
                return node.Text()
            }

            var sb = "(" + node.Kind()
            if node.Text() != ""
            {
                sb = sb + " " + node.Text()
            }

            var i = 0
            while i < node.ChildCount()
            {
                sb = sb + " " + BindDump(node.Child(i))
                i = i + 1
            }

            return sb + ")"
        }

        /// <summary>语法 → 绑定树（首片节点集；不支持类型返回 null——语料与节点集同步扩展）。</summary>
        private function BuildBound(node: Node): Node
        {
            let k = node.Kind()
            if k == "BlockStatement"
            {
                let b = Node.MakeCompound("BlockStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        let built = BuildBound(child)
                        if built != null
                        {
                            b.Add(built)
                        }
                    }

                    i = i + 1
                }

                return b
            }

            if k == "ReturnStatement"
            {
                let r = Node.MakeCompound("ReturnStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        r.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return r
            }

            if k == "ExpressionStatement"
            {
                let e = Node.MakeCompound("ExpressionStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        e.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return e
            }

            if k == "VariableDeclaration"
            {
                let d = Node.MakeCompound("VariableDeclaration")
                d.Add(Node.MakeToken("decl", DeclWordOf(node)))
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck = child.Kind()
                    if ck == "IdentifierToken"
                    {
                        d.Add(Node.MakeToken("name", child.Text()))
                    }
                    else if !child.IsToken() && ck != "TypeClause" && ck != "ArrayTypeClause" && ck != "GenericTypeClause"
                    {
                        let built = BuildBound(child)
                        if built != null
                        {
                            d.Add(built)
                        }
                    }

                    i = i + 1
                }

                return d
            }

            if k == "IfStatement"
            {
                let f = Node.MakeCompound("IfStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child.IsToken() || child.Kind() == "IfKeyword"
                    {
                        i = i + 1
                        continue
                    }

                    if child.Kind() == "ElseClause"
                    {
                        var j = 0
                        while j < child.ChildCount()
                        {
                            let inner = child.Child(j)
                            if !inner.IsToken()
                            {
                                f.Add(BuildBound(inner))
                            }

                            j = j + 1
                        }
                    }
                    else
                    {
                        f.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return f
            }

            if k == "WhileStatement"
            {
                let w = Node.MakeCompound("WhileStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        w.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return w
            }

            if k == "DoWhileStatement"
            {
                let d = Node.MakeCompound("DoWhileStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        d.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return d
            }

            if k == "ForRangeStatement"
            {
                let f = Node.MakeCompound("ForRangeStatement")
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck = child.Kind()
                    if ck == "IdentifierToken"
                    {
                        f.Add(Node.MakeToken("name", child.Text()))
                    }
                    else if !child.IsToken()
                    {
                        f.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return f
            }

            if k == "BreakStatement"
            {
                let b = Node.MakeCompound("BreakStatement")
                b.Add(Node.MakeToken("BreakKeyword", "break"))
                return b
            }

            if k == "ContinueStatement"
            {
                let c = Node.MakeCompound("ContinueStatement")
                c.Add(Node.MakeToken("ContinueKeyword", "continue"))
                return c
            }

            if k == "AssignmentExpression"
            {
                // 元素赋值 a[i] = e → (ElementAssignmentExpression <target> <index> <value>)；
                // 字段写 this.v = e / b.v = e → (MemberAssignmentExpression <target> <name> <value>)；
                // 普通变量 → (AssignmentExpression name <value>)
                if node.Child(0).Kind() == "ElementAccessExpression"
                {
                    let ea = node.Child(0)
                    let e = Node.MakeCompound("ElementAssignmentExpression")
                    let tgt = BuildBound(ea.Child(0))
                    if tgt != null { e.Add(tgt) } else { e.Add(ea.Child(0)) }
                    let idx = BuildBound(ea.Child(2))
                    if idx != null { e.Add(idx) } else { e.Add(ea.Child(2)) }
                    let val = BuildBound(node.Child(2))
                    if val != null { e.Add(val) } else { e.Add(node.Child(2)) }
                    return e
                }

                if node.Child(0).Kind() == "MemberAccessExpression"
                {
                    let ma = node.Child(0)
                    let m = Node.MakeCompound("MemberAssignmentExpression")
                    let tgt = BuildBound(ma.Child(0))
                    if tgt != null { m.Add(tgt) } else { m.Add(ma.Child(0)) }
                    m.Add(Node.MakeToken("name", ma.Child(2).Text()))
                    let val = BuildBound(node.Child(2))
                    if val != null { m.Add(val) } else { m.Add(node.Child(2)) }
                    return m
                }

                let a = Node.MakeCompound("AssignmentExpression")
                let target = node.Child(0)
                a.Add(Node.MakeToken("name", target.Child(0).Text()))
                a.Add(BuildBound(node.Child(2)))
                return a
            }

            if k == "ElementAccessExpression"
            {
                // 元素读 a[i] → (ElementAccessExpression <target> <index>)（目标为变量 → VariableExpression）
                let e = Node.MakeCompound("ElementAccessExpression")
                let tgt = BuildBound(node.Child(0))
                if tgt != null { e.Add(tgt) } else { e.Add(node.Child(0)) }
                let idx = BuildBound(node.Child(2))
                if idx != null { e.Add(idx) } else { e.Add(node.Child(2)) }
                return e
            }

            if k == "ArrayCreationExpression"
            {
                // (NewKeyword IdentifierToken [ <len> ] [ { inits } ]) → (ArrayCreationExpression type <len> [inits...])
                let a = Node.MakeCompound("ArrayCreationExpression")
                a.Add(Node.MakeToken("type", node.Child(1).Text()))
                var i = 3
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        let built = BuildBound(child)
                        if built != null
                        {
                            a.Add(built)
                        }
                        else
                        {
                            a.Add(child)
                        }
                    }

                    i = i + 1
                }

                return a
            }

            if k == "BinaryExpression"
            {
                let b = Node.MakeCompound("BinaryExpression")
                b.Add(Node.MakeToken("op", BinaryGlyphOf(node)))
                b.Add(BuildBound(node.Child(0)))
                b.Add(BuildBound(node.Child(2)))
                return b
            }

            if k == "UnaryExpression"
            {
                let u = Node.MakeCompound("UnaryExpression")
                u.Add(Node.MakeToken("op", UnaryGlyphOf(node)))
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        u.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return u
            }

            if k == "NameExpression"
            {
                let nm = node.Child(0).Text()
                if nm == "this"
                {
                    let th = Node.MakeCompound("ThisExpression")
                    th.Add(Node.MakeToken("type", _currentClass))
                    return th
                }

                let v = Node.MakeCompound("VariableExpression")
                v.Add(Node.MakeToken("name", nm))
                return v
            }

            if k == "CallExpression"
            {
                let c = Node.MakeCompound("CallExpression")
                c.Add(Node.MakeToken("name", node.Child(0).Text()))
                var i = 1
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        c.Add(BuildBound(child))
                    }

                    i = i + 1
                }

                return c
            }

            if k == "ThisExpression"
            {
                let th = Node.MakeCompound("ThisExpression")
                th.Add(Node.MakeToken("type", _currentClass))
                return th
            }

            if k == "ObjectCreationExpression"
            {
                // 解析形状：(NewKeyword IdentifierToken ( args ) )
                let o = Node.MakeCompound("ObjectCreationExpression")
                o.Add(Node.MakeToken("type", node.Child(1).Text()))
                var i = 3
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        let built = BuildBound(child)
                        if built != null
                        {
                            o.Add(built)
                        }
                    }

                    i = i + 1
                }

                return o
            }

            if k == "ThisExpression"
            {
                let t = Node.MakeCompound("ThisExpression")
                t.Add(Node.MakeToken("this", "this"))
                return t
            }

            if k == "LiteralExpression"
            {
                let l = Node.MakeCompound("LiteralExpression")
                l.Add(node.Child(0))
                return l
            }

            if k == "ParenthesizedExpression"
            {
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if !child.IsToken()
                    {
                        return BuildBound(child)
                    }

                    i = i + 1
                }

                return null
            }

            if k == "MemberCallExpression" || k == "MemberAccessExpression"
            {
                let m = Node.MakeCompound(k)
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child.IsToken()
                    {
                        m.Add(child)
                    }
                    else
                    {
                        let built = BuildBound(child)
                        if built != null
                        {
                            m.Add(built)
                        }
                        else
                        {
                            m.Add(child)
                        }
                    }

                    i = i + 1
                }

                return m
            }

            return null
        }

        private function DeclWordOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let k = node.Child(i).Kind()
                if k == "LetKeyword"
                {
                    return "let"
                }

                if k == "VarKeyword"
                {
                    return "var"
                }

                i = i + 1
            }

            return "var"
        }

        private function BinaryGlyphOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let k = node.Child(i).Kind()
                if k == "PlusToken" { return "+" }
                if k == "MinusToken" { return "-" }
                if k == "StarToken" { return "*" }
                if k == "SlashToken" { return "/" }
                if k == "PercentToken" { return "%" }
                if k == "EqualsEqualsToken" { return "==" }
                if k == "BangEqualsToken" { return "!=" }
                if k == "LessToken" { return "<" }
                if k == "LessOrEqualsToken" || k == "LessEqualsToken" { return "<=" }
                if k == "GreaterToken" { return ">" }
                if k == "GreaterOrEqualsToken" || k == "GreaterEqualsToken" { return ">=" }
                if k == "AndKeyword" || k == "AmpersandAmpersandToken" { return "&&" }
                if k == "OrKeyword" || k == "PipePipeToken" { return "||" }
                i = i + 1
            }

            return "?"
        }

        private function UnaryGlyphOf(node: Node): string
        {
            var i = 0
            while i < node.ChildCount()
            {
                let k = node.Child(i).Kind()
                if k == "PlusToken" { return "+" }
                if k == "MinusToken" { return "-" }
                if k == "BangToken" { return "!" }
                if k == "TildeToken" { return "~" }
                i = i + 1
            }

            return "?"
        }

        private function ReportError(message: string): void
        {
            if _diagCount >= _diags.Length
            {
                var bigger = new string[_diags.Length * 2]
                var i = 0
                while i < _diagCount
                {
                    bigger[i] = _diags[i]
                    i = i + 1
                }

                _diags = bigger
            }

            _diags[_diagCount] = "error: " + message
            _diagCount = _diagCount + 1
        }

        private function IsPrimitiveTypeName(t: string): bool
        {
            if t == "sbyte" || t == "byte" || t == "short" || t == "ushort" || t == "int" || t == "uint" { return true }
            if t == "long" || t == "ulong" || t == "float" || t == "double" || t == "bool" || t == "char" { return true }
            if t == "string" || t == "object" || t == "void" { return true }
            if t == "i8" || t == "i16" || t == "i32" || t == "i64" { return true }
            if t == "u8" || t == "u16" || t == "u32" || t == "u64" { return true }
            if t == "r4" || t == "r8" { return true }
            return false
        }

        /// <summary>语句/表达式递归检查：未定义名、未定义函数、调用 arity、未知类型、局部重复声明。</summary>
        private function CheckNode(node: Node): void
        {
            if !(node != null)
            {
                return
            }
let k = node.Kind()
            if k == "BlockStatement"
            {
                // 块作用域：深度 +1 递归；退出截断 _locals 到块入口（兄弟块复用/遮蔽外层合法，同层内重复仍报）
                _scopeMarks[_scopeDepth] = _localCount
                _scopeDepth = _scopeDepth + 1
                var bi = 0
                while bi < node.ChildCount()
                {
                    let bc = node.Child(bi)
                    if bc != null ? !bc.IsToken() : false
                    {
                        CheckNode(bc)
                    }

                    bi = bi + 1
                }

                _scopeDepth = _scopeDepth - 1
                _localCount = _scopeMarks[_scopeDepth]
                return
            }

            if k == "NameExpression"
            {
                let n0 = node.Child(0)
                let name = n0 != null ? n0.Text() : ""
                if !IsKnownName(name)
                {
                    ReportError("Variable '" + name + "' doesn't exist.")
                }

                return
            }

            if k == "CallExpression"
            {
                // (CallExpression IdentifierToken ( args... ))：实参 = 非 token 子
                let cnode = node.Child(0)
                let callee = cnode != null ? cnode.Text() : ""
                var args = 0
                var i = 1
                while i < node.ChildCount()
                {
                    let ac = node.Child(i)
                    if ac != null ? !ac.IsToken() : false
                    {
                        args = args + 1
                    }

                    i = i + 1
                }

                let fi = IndexOfString(_functionNames, _functionCount, callee)
                if fi < 0 && !IsPrimitiveTypeName(callee)
                {
                    ReportError("Function '" + callee + "' doesn't exist.")
                }
                else if fi >= 0
                {
                    var expected = _functions[fi].ParamCount()
                    // 实例类方法（param0 = `this`）裸调用省略接收者 → 期望实参 = 参数数 - 1
                    if expected > 0 && _functions[fi].ParamName(0) == "this"
                    {
                        expected = expected - 1
                    }

                    if expected != args
                    {
                        ReportError("Function '" + callee + "' requires " + string(expected) + " arguments but was given " + string(args) + ".")
                    }
                }

                i = 1
                while i < node.ChildCount()
                {
                    let cn = node.Child(i)
                    if cn != null ? !cn.IsToken() : false
                    {
                        CheckNode(cn)
                    }

                    i = i + 1
                }

                return
            }

            if k == "VariableDeclaration"
            {
                // 体内声明：名入局部作用域（先查重）；类型解析并入局部符号；值表达式下钻
                var name = ""
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let kid = child != null ? child.Kind() : ""
                    if kid == "IdentifierToken" && name == ""
                    {
                        name = child.Text()
                    }

                    i = i + 1
                }

                if name != ""
                {
                    var dup = IndexOfString(_paramNames, _paramCount, name) >= 0
                    var di = 0
                    while di < _localCount
                    {
                        if _locals[di] == name && _localScopes[di] == _scopeDepth
                        {
                            dup = true
                        }

                        di = di + 1
                    }

                    if dup
                    {
                        ReportError("'" + name + "' is already declared.")
                    }
                    else
                    {
                        AddLocal(name)
                        _currentFunction.AddLocal(name, LocalTypeOfDeclaration(node))
                    }
                }

i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck = child != null ? child.Kind() : ""
if ck == "TypeClause" || ck == "ArrayTypeClause"
                    {
                        CheckTypeClause(child)
                    }
                    else if child != null ? !child.IsToken() : false
                    {
                        CheckNode(child)
                    }

                    i = i + 1
                }

                return
            }

            if k == "ExpressionStatement"
            {
                // M9-a4：对齐 C# 语句校验——赋值目标未定义时追加 statement 消息（先下钻报 Variable 错，再补报）
                var stmt: Node = null
                var s = 0
                while s < node.ChildCount()
                {
                    let child = node.Child(s)
                    if child != null ? !child.IsToken() : false
                    {
                        stmt = child
                    }

                    s = s + 1
                }

                CheckNode(stmt)
                if stmt != null ? stmt.Kind() == "AssignmentExpression" : false
                {
                    var left: Node = null
                    var a = 0
                    while a < stmt.ChildCount()
                    {
                        let child = stmt.Child(a)
                        if child != null ? !child.IsToken() : false
                        {
                            left = child
                            break
                        }

                        a = a + 1
                    }

                    let lc0 = left != null ? left.Child(0) : null
                    if left != null && left.Kind() == "NameExpression" && lc0 != null && !IsKnownName(lc0.Text())
                    {
                        ReportError("Only assignment and call expressions can be used as a statement.")
                    }
                }

                return
            }

            if k == "LambdaExpression"
            {
                // lambda 参数/闭包作用域：M9-a3 起处理（宽松跳过避免误报）
                return
            }

            if k == "MemberCallExpression" || k == "MemberAccessExpression"
            {
                // receiver（首子）为类型/命名空间名或成员链：M9-a2 无类型面，宽松放行；
                // 仅下钻实参（子链中的实例变量检查随 M9-a3 类型面收紧）
                var i = 1
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    if child != null ? !child.IsToken() : false
                    {
                        CheckNode(child)
                    }

                    i = i + 1
                }

                return
            }

            if k == "ForeachStatement" || k == "ForRangeStatement"
            {
                // 循环变量宽松入局部（类型名 token 同收，方向安全只漏报不误报；M9-a3 收紧）
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck0 = child != null ? child.Kind() : ""
                    if ck0 == "IdentifierToken"
                    {
                        AddLocal(child.Text())
                    }

                    i = i + 1
                }
            }

            // 默认：非 token 子下钻；类型子句显式检查（复合子内的类型 token 不触发名字检查）
            var j = 0
            while j < node.ChildCount()
            {
                let child = node.Child(j)
                let ck = child != null ? child.Kind() : ""
                if child == null || child.IsToken()
                {
                    // token 子跳过
                }
                else if ck == "TypeClause" || ck == "ArrayTypeClause"
                {
                    CheckTypeClause(child)
                }
                else
                {
                    CheckNode(child)
                }

                j = j + 1
            }
        }

        /// <summary>类型子句未知类型检查（数组递归元素；泛型放行待 M9-a3）。</summary>
        private function CheckTypeClause(node: Node): void
        {
            if !(node != null)
            {
                return
            }

            let k = node.Kind()
            if k == "GenericTypeClause"
            {
                return
            }

            if k == "ArrayTypeClause"
            {
                var i = 0
                while i < node.ChildCount()
                {
                    let child = node.Child(i)
                    let ck = child.Kind()
                    if ck == "TypeClause" || ck == "ArrayTypeClause"
                    {
                        CheckTypeClause(child)
                    }

                    i = i + 1
                }

                return
            }

            let raw = TypeOfIdentifier(node)
            if !KnownType(CanonicalType(raw))
            {
                ReportError("Type '" + raw + "' doesn't exist.")
            }
        }

        /// <summary>canonical 名是否为已知类型（数组剥 [] 后比对白名单）。</summary>
        private function KnownType(name: string): bool
        {
            var t = name
            if t.Length > 2 && t.substring(t.Length - 2, 2) == "[]"
            {
                t = t.substring(0, t.Length - 2)
            }

            if t == "sbyte" { return true }
            if t == "byte" { return true }
            if t == "short" { return true }
            if t == "ushort" { return true }
            if t == "int" { return true }
            if t == "uint" { return true }
            if t == "long" { return true }
            if t == "ulong" { return true }
            if t == "float" { return true }
            if t == "double" { return true }
            if t == "bool" { return true }
            if t == "char" { return true }
            if t == "string" { return true }
            if t == "object" { return true }
            if t == "void" { return true }
            if t == "decimal" { return true }
            if t == "nint" { return true }
            if t == "nuint" { return true }
            if t == "i128" { return true }
            if t == "u128" { return true }
            if t == "f128" { return true }
            // 已声明类名是已知类型（编译器源码签名/字段引用自身类与依赖类；预收集表含前向类）
            var ci = 0
            while ci < _classCount
            {
                if _classNames[ci] == t
                {
                    return true
                }

                ci = ci + 1
            }

            ci = 0
            while ci < _knownClassCount
            {
                if _knownClassNames[ci] == t
                {
                    return true
                }

                ci = ci + 1
            }

            return false
        }

        private function IsKnownName(name: string): bool
        {
            if IndexOfString(_functionNames, _functionCount, name) >= 0
            {
                return true
            }

            if IndexOfString(_globalNames, _variableCount, name) >= 0
            {
                return true
            }

            if IndexOfString(_paramNames, _paramCount, name) >= 0
            {
                return true
            }

            if IndexOfString(_locals, _localCount, name) >= 0
            {
                return true
            }

            // 当前类的实例字段在方法体作用域内（编译器源码直接引用 `_field` 成员）
            if _currentClass != ""
            {
                var ci = 0
                while ci < _classCount
                {
                    if _classNames[ci] == _currentClass
                    {
                        var fi2 = 0
                        while fi2 < _classFieldCounts[ci]
                        {
                            if _classFieldNames[_classFieldOffsets[ci] + fi2] == name
                            {
                                return true
                            }

                            fi2 = fi2 + 1
                        }

                        return false
                    }

                    ci = ci + 1
                }
            }

            return false
        }

        private function AddLocal(name: string): void
        {
            if _localCount >= _locals.Length
            {
                var bigger = new string[_locals.Length * 2]
                var bs = new i32[_localScopes.Length * 2]
                var i = 0
                while i < _localCount
                {
                    bigger[i] = _locals[i]
                    bs[i] = _localScopes[i]
                    i = i + 1
                }

                _locals = bigger
                _localScopes = bs
            }

            _locals[_localCount] = name
            _localScopes[_localCount] = _scopeDepth
            _localCount = _localCount + 1
        }

        private static function IndexOfString(items: string[], count: i32, name: string): i32
        {
            var i = 0
            while i < count
            {
                if items[i] == name
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }
    }
}
