namespace Cocoa.CodeAnalysis.Binding
{
    class BoundBinaryOperator
    {
        private field _opKind: i32
        private field _leftType: string
        private field _rightType: string
        private field _resultType: string

        public constructor(opKind: i32, leftType: string, rightType: string, resultType: string)
        {
            _opKind = opKind
            _leftType = leftType
            _rightType = rightType
            _resultType = resultType
        }

        public function OpKind(): i32 { return _opKind }
        public function LeftType(): string { return _leftType }
        public function RightType(): string { return _rightType }
        public function ResultType(): string { return _resultType }

        public static function Bind(opKind: i32, leftType: string, rightType: string): BoundBinaryOperator
        {
            if leftType == "int" && rightType == "int"
            {
                if opKind == 0 || opKind == 1 || opKind == 2 || opKind == 3 || opKind == 4
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "int")
                }

                if opKind == 10 || opKind == 11 || opKind == 12 || opKind == 13 || opKind == 14 || opKind == 15
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "bool")
                }

                if opKind == 20 || opKind == 21
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "bool")
                }
            }

            if leftType == "double" && rightType == "double"
            {
                if opKind == 0 || opKind == 1 || opKind == 2 || opKind == 3 || opKind == 4
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "double")
                }

                if opKind == 10 || opKind == 11 || opKind == 12 || opKind == 13 || opKind == 14 || opKind == 15
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "bool")
                }
            }

            if leftType == "string" && rightType == "string"
            {
                if opKind == 0
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "string")
                }

                if opKind == 10 || opKind == 11
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "bool")
                }
            }

            if leftType == "bool" && rightType == "bool"
            {
                if opKind == 20 || opKind == 21
                {
                    return new BoundBinaryOperator(opKind, leftType, rightType, "bool")
                }
            }

            return null
        }
    }
}
