namespace Cocoa.CodeAnalysis.Symbols
{
    class TypeSymbol
    {
        private field _name: string
        private field _elementType: TypeSymbol

        public constructor()
        {
            _name = ""
            _elementType = null
        }

        // ── 静态单例（对齐 C# TypeSymbol 22 个）──
        public static function Error(): TypeSymbol { return TypeSymbol.CreateSpecial("?") }
        public static function Any(): TypeSymbol { return TypeSymbol.CreateSpecial("object") }
        public static function Null(): TypeSymbol { return TypeSymbol.CreateSpecial("null") }
        public static function Boolean(): TypeSymbol { return TypeSymbol.CreateSpecial("bool") }
        public static function Int8(): TypeSymbol { return TypeSymbol.CreateSpecial("i8") }
        public static function Int16(): TypeSymbol { return TypeSymbol.CreateSpecial("i16") }
        public static function Int32(): TypeSymbol { return TypeSymbol.CreateSpecial("i32") }
        public static function Int64(): TypeSymbol { return TypeSymbol.CreateSpecial("i64") }
        public static function UInt8(): TypeSymbol { return TypeSymbol.CreateSpecial("u8") }
        public static function UInt16(): TypeSymbol { return TypeSymbol.CreateSpecial("u16") }
        public static function UInt32(): TypeSymbol { return TypeSymbol.CreateSpecial("u32") }
        public static function UInt64(): TypeSymbol { return TypeSymbol.CreateSpecial("u64") }
        public static function Float(): TypeSymbol { return TypeSymbol.CreateSpecial("f32") }
        public static function Double(): TypeSymbol { return TypeSymbol.CreateSpecial("f64") }
        public static function Char(): TypeSymbol { return TypeSymbol.CreateSpecial("char") }
        public static function String(): TypeSymbol { return TypeSymbol.CreateSpecial("string") }
        public static function Void(): TypeSymbol { return TypeSymbol.CreateSpecial("void") }

        private static function CreateSpecial(name: string): TypeSymbol
        {
            var t = new TypeSymbol()
            t._name = name
            t._elementType = null
            return t
        }

        public static function Create(name: string): TypeSymbol
        {
            var t = new TypeSymbol()
            t._name = name
            t._elementType = null
            return t
        }

        public static function ArrayOf(elementType: TypeSymbol): TypeSymbol
        {
            var t = new TypeSymbol()
            t._name = elementType._name + "[]"
            t._elementType = elementType
            return t
        }

        public function Name(): string
        {
            return _name
        }

        public function ElementType(): TypeSymbol
        {
            return _elementType
        }

        public function IsArray(): bool
        {
            return _elementType != null
        }

        public function IsPrimitiveValueType(): bool
        {
            return _name == "i32" || _name == "i64" || _name == "f64" ||
                   _name == "bool" || _name == "char" || _name == "i8" ||
                   _name == "i16" || _name == "u8" || _name == "u16" ||
                   _name == "u32" || _name == "u64" || _name == "f32"
        }

        public function IsValueType(): bool
        {
            return IsPrimitiveValueType()
        }

        public function IsInteger(): bool
        {
            return _name == "i8" || _name == "i16" || _name == "i32" ||
                   _name == "i64" || _name == "u8" || _name == "u16" ||
                   _name == "u32" || _name == "u64"
        }

        public function IsFloat(): bool
        {
            return _name == "f32" || _name == "f64"
        }

        public function IsNumeric(): bool
        {
            return IsInteger() || IsFloat()
        }

        public function Describe(): string
        {
            return _name
        }
    }
}
