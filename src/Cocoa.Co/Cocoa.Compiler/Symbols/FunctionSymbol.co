// Cocoa 自举函数符号 —— 阶段 7 增量三（M9-a1）：名/参数/返回类型；Describe() 与 C# SymbolDump 函数行同构。

namespace Cocoa.CodeAnalysis.Symbols
{
    class FunctionSymbol
    {
        private field _name: string
        private field _paramNames: string[]
        private field _paramTypes: string[]
        private field _paramCount: i32
        private field _returnType: string
        private field _locals: LocalVariableSymbol[]
        private field _localCount: i32
        private field _attributeNames: string[]
        private field _attributeArgs: string[]
        private field _attributeCount: i32

        public static function Create(name: string, returnType: string): FunctionSymbol
        {
            var f = new FunctionSymbol()
            f._name = name
            f._returnType = returnType
            f._paramNames = new string[8]
            f._paramTypes = new string[8]
            f._paramCount = 0
            f._locals = new LocalVariableSymbol[8]
            f._localCount = 0
            f._attributeNames = new string[8]
            f._attributeArgs = new string[8]
            f._attributeCount = 0
            return f
        }

        public function AddParameter(name: string, type: string): void
        {
            if _paramCount >= _paramNames.Length
            {
                var biggerNames = new string[_paramNames.Length * 2]
                var biggerTypes = new string[_paramTypes.Length * 2]
                var i = 0
                while i < _paramCount
                {
                    biggerNames[i] = _paramNames[i]
                    biggerTypes[i] = _paramTypes[i]
                    i = i + 1
                }

                _paramNames = biggerNames
                _paramTypes = biggerTypes
            }

            _paramNames[_paramCount] = name
            _paramTypes[_paramCount] = type
            _paramCount = _paramCount + 1
        }

        public function ParamCount(): i32
        {
            return _paramCount
        }

        public function Name(): string
        {
            return _name
        }

        public function ParamName(index: i32): string
        {
            return _paramNames[index]
        }

        public function ParamType(index: i32): string
        {
            return _paramTypes[index]
        }

        public function ReturnType(): string
        {
            return _returnType
        }

        public function AddLocal(name: string, type: string): void
        {
            if _localCount >= _locals.Length
            {
                var bigger = new LocalVariableSymbol[_locals.Length * 2]
                var j = 0
                while j < _localCount
                {
                    bigger[j] = _locals[j]
                    j = j + 1
                }

                _locals = bigger
            }

            _locals[_localCount] = LocalVariableSymbol.Create(name, true, type)
            _localCount = _localCount + 1
        }

        public function LocalCount(): i32
        {
            return _localCount
        }

        public function Local(index: i32): LocalVariableSymbol
        {
            return _locals[index]
        }

        public function LocalTypeOf(name: string): string
        {
            var i = 0
            while i < _localCount
            {
                if _locals[i].Name() == name
                {
                    return _locals[i].Type()
                }

                i = i + 1
            }

            return ""
        }

        public function AddAttribute(name: string, argText: string): void
        {
            if _attributeCount >= _attributeNames.Length
            {
                var bn = new string[_attributeNames.Length * 2]
                var ba = new string[_attributeArgs.Length * 2]
                var i = 0
                while i < _attributeCount
                {
                    bn[i] = _attributeNames[i]
                    ba[i] = _attributeArgs[i]
                    i = i + 1
                }

                _attributeNames = bn
                _attributeArgs = ba
            }

            _attributeNames[_attributeCount] = name
            _attributeArgs[_attributeCount] = argText
            _attributeCount = _attributeCount + 1
        }

        public function AttributeCount(): i32
        {
            return _attributeCount
        }

        public function AttributeName(index: i32): string
        {
            return _attributeNames[index]
        }

        public function AttributeArgText(index: i32): string
        {
            return _attributeArgs[index]
        }

        public function Describe(): string
        {
            var sb = "function " + _name + "("
            var i = 0
            while i < _paramCount
            {
                if i > 0
                {
                    sb = sb + ", "
                }

                sb = sb + _paramNames[i] + ": " + _paramTypes[i]
                i = i + 1
            }

            return sb + "): " + _returnType
        }
    }
}
