// Cocoa 自举 CodeGen · IL 发射器（阶段 7 增量五 M5-a3）——
// 绑定树（自举 Binder Node 树）→ IL 指令序列（写入 IlAssembler）。
// 支持：字面量 / 变量（参数 Ldarg / 局部 Ldloc/Stloc）/ 算术与比较二元 / 一元 / 返回 / 声明 /
// 控制流（Label→Nop、Goto→Br、ConditionalGoto→Brtrue/Brfalse）。
// 对齐 C# IlEmitter：长形式 + 比较序列（!=→Ceq,Ldc_I4_0,Ceq 等）；常量折叠为后续扩展。

using Cocoa.CodeAnalysis.Syntax

namespace Cocoa.CodeGen
{
    class IlEmitter
    {
        private field _assembler: IlAssembler
        private field _paramNames: string[]
        private field _paramCount: i32
        private field _localNames: string[]
        private field _localCount: i32
private field _labelNames: string[]
        private field _labelIndexes: i32[]
        private field _labelCount: i32
        private field _pendingBranches: i32[]
        private field _pendingNames: string[]
private field _pendingCount: i32
        private field _statementReachable: bool[]
        private field _methodNames: string[]
        private field _methodTokens: i32[]
        private field _methodReturnsValue: bool[]
        private field _methodCount: i32
        private field _error: string
        private field _constantNames: string[]
        private field _constantValues: Value[]
        private field _constantCount: i32
        private field _bclNames: string[]
        private field _bclTokens: i32[]
        private field _bclCount: i32
        private field _usTexts: string[]
        private field _usTokens: i32[]
        private field _usCount: i32
        private field _classMethodKeys: string[]
        private field _classMethodTokens: i32[]
        private field _classMethodReturns: bool[]
        private field _classMethodTypeKeys: string[]
        private field _classMethodTypeVals: string[]
        private field _classMethodTypeCount: i32
        private field _curClassKeys: string[]
        private field _curClassTokens: i32[]
        private field _curClassInstance: bool[]
        private field _curClassReturns: bool[]
        private field _curClassCount: i32
        private field _curFieldKeys: string[]
        private field _curFieldTokens: i32[]
        private field _curFieldTypes: string[]
        private field _curFieldCount: i32
        private field _globalTypeKeys: string[]
        private field _globalTypeVals: string[]
        private field _globalTypeCount: i32
        private field _globalFieldKeys: string[]
        private field _globalFieldVals: string[]
        private field _globalFieldCount: i32
        private field _classStaticKeys: string[]
        private field _classStaticTokens: i32[]
        private field _classStaticCount: i32
        private field _classFieldKeys: string[]
        private field _classFieldTokens: i32[]
        private field _classCtorNames: string[]
        private field _classCtorTokens: i32[]
        private field _classEntriesCount: i32
        private field _varTypes: string[]
        private field _varTypeCount: i32
        private field _arrayElemNames: string[]
        private field _arrayElemTokens: i32[]
        private field _arrayElemCount: i32
        private field _convertToken: i32
        private field _boxInt32Token: i32

        public constructor()
        {
            _assembler = null
            _paramNames = new string[16]
            _paramCount = 0
            _localNames = new string[16]
            _localCount = 0
            _labelNames = new string[16]
            _labelIndexes = new i32[16]
            _labelCount = 0
            _methodNames = new string[0]
            _methodTokens = new i32[0]
            _methodReturnsValue = new bool[0]
            _methodCount = 0
            _error = ""
            _constantNames = new string[16]
            _constantValues = new Value[16]
            _constantCount = 0
            _bclNames = new string[0]
            _bclTokens = new i32[0]
            _bclCount = 0
            _usTexts = new string[0]
            _usTokens = new i32[0]
            _usCount = 0
            _classMethodKeys = new string[0]
            _classMethodTokens = new i32[0]
            _classMethodReturns = new bool[0]
            _classMethodTypeKeys = new string[0]
            _classMethodTypeVals = new string[0]
            _classMethodTypeCount = 0
            _classStaticKeys = new string[0]
            _classStaticTokens = new i32[0]
            _classStaticCount = 0
            _curClassKeys = new string[0]
            _curClassTokens = new i32[0]
            _curClassInstance = new bool[0]
            _curClassReturns = new bool[0]
            _curClassCount = 0
            _curFieldKeys = new string[0]
            _curFieldTokens = new i32[0]
            _curFieldTypes = new string[0]
            _curFieldCount = 0
            _globalTypeKeys = new string[0]
            _globalTypeVals = new string[0]
            _globalTypeCount = 0
            _globalFieldKeys = new string[0]
            _globalFieldVals = new string[0]
            _globalFieldCount = 0
            _classFieldKeys = new string[0]
            _classFieldTokens = new i32[0]
            _classCtorNames = new string[0]
            _classCtorTokens = new i32[0]
            _classEntriesCount = 0
            _varTypes = new string[0]
            _varTypeCount = 0
            _arrayElemNames = new string[0]
            _arrayElemTokens = new i32[0]
            _arrayElemCount = 0
        }

        public function SetMethods(names: string[], tokens: i32[], returnsValue: bool[]): void
        {
            _methodNames = names
            _methodTokens = tokens
            _methodReturnsValue = returnsValue
            _methodCount = names.Length
        }

        /// <summary>BCL 静态成员调用表（驱动预解析：`Console.WriteLine` → MemberRef token 0x0A…）。</summary>
        public function SetBclMembers(names: string[], tokens: i32[], count: i32): void
        {
            _bclNames = names
            _bclTokens = tokens
            _bclCount = count
        }

        /// <summary>用户字符串 → #US token（0x70…）；Ldstr 用。</summary>
        public function SetUserStrings(texts: string[], tokens: i32[], count: i32): void
        {
            _usTexts = texts
            _usTokens = tokens
            _usCount = count
        }

        /// <summary>类实例方法表：键 `类名.方法` → MethodDef token（实例调 callvirt 用）+ 是否返回值。</summary>
        public function SetClassMethods(keys: string[], tokens: i32[], returns: bool[], count: i32): void
        {
            _classMethodKeys = keys
            _classMethodTokens = tokens
            _classMethodReturns = returns
            _classEntriesCount = count
        }

        /// <summary>类实例字段表：键 `类名.字段` → FieldDef token（ldfld/stfld 用）。</summary>
        public function SetClassFields(keys: string[], tokens: i32[], count: i32): void
        {
            _classFieldKeys = keys
            _classFieldTokens = tokens
        }

        /// <summary>类构造器表：键 `类名` → ctor MethodDef token（newobj 用）。</summary>
        public function SetClassCtors(names: string[], tokens: i32[], count: i32): void
        {
            _classCtorNames = names
            _classCtorTokens = tokens
        }

        /// <summary>每函数参数/局部类型表：前 paramCount 项=参数，其后=局部（按发射槽序）；thisslot0。</summary>
        public function SetVarTypes(types: string[], count: i32): void
        {
            _varTypes = types
            _varTypeCount = count
        }

        /// <summary>数组元素类型 → 类型 token（newarr 操作数）表。</summary>
        public function SetArrayElemTypes(names: string[], tokens: i32[], count: i32): void
        {
            _arrayElemNames = names
            _arrayElemTokens = tokens
            _arrayElemCount = count
        }

        /// <summary>string(x) 转换：Convert.ToString(object) 成员 token + i32 装箱 TypeRef token。</summary>
        public function SetStringConvert(convertToken: i32, boxInt32Token: i32): void
        {
            _convertToken = convertToken
            _boxInt32Token = boxInt32Token
        }

        private function ArrayElemToken(typeName: string): i32
        {
            var i = 0
            while i < _arrayElemCount
            {
                if _arrayElemNames[i] == typeName
                {
                    return _arrayElemTokens[i]
                }

                i = i + 1
            }

            return -1
        }

        /// <summary>数组类型 `T[]` → 元素类型 T；否则空。</summary>
        private function ArrayElemTypeOf(type: string): string
        {
            if type.IndexOf("[]") >= 0 && type.IndexOf("[]") == type.Length - 2
            {
                return type.substring(0, type.Length - 2)
            }

            return ""
        }

        /// <summary>string(x) 实参类型：变量 → 类型表；字面量 → bool/i32；其余 i32。</summary>
        private function StringArgTypeOf(arg: Node): string
        {
            let k = arg.Kind()
            if k == "VariableExpression"
            {
                return VarTypeOf(arg.Child(0).Text())
            }

            if k == "LiteralExpression"
            {
                let tk = arg.Child(0).Kind()
                if tk == "TrueKeyword" || tk == "FalseKeyword"
                {
                    return "bool"
                }

                return "i32"
            }

            return "i32"
        }

                /// <summary>静态类方法表：键 `类名.方法` → MethodDef token（静态调用 Call 用）。</summary>
        public function SetClassStaticMethods(keys: string[], tokens: i32[], count: i32): void
        {
            _classStaticKeys = keys
            _classStaticTokens = tokens
            _classStaticCount = count
        }

        /// <summary>当前类裸方法表（同类实例/静态方法裸调用无 `this.`/类名时按其类解析；key = 裸方法名）。</summary>
        public function SetCurrentClassMethods(keys: string[], tokens: i32[], instance: bool[], returns: bool[], count: i32): void
        {
            _curClassKeys = keys
            _curClassTokens = tokens
            _curClassInstance = instance
            _curClassReturns = returns
            _curClassCount = count
        }

        /// <summary>当前类字段表（名 → FieldDef token + 类型），供 `_root.ChildCount()` 字段实例方法调用解析。</summary>
        public function SetCurrentClassFields(keys: string[], tokens: i32[], types: string[], count: i32): void
        {
            _curFieldKeys = keys
            _curFieldTokens = tokens
            _curFieldTypes = types
            _curFieldCount = count
        }

        private function CurFieldIndex(name: string): i32
        {
            var i = 0
            while i < _curFieldCount
            {
                if _curFieldKeys[i] == name
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        /// <summary>全局变量类型表（名 → 类型），供顶层全局数组变量解析（X[i].方法()）。</summary>
        public function SetGlobalTypes(keys: string[], vals: string[], count: i32): void
        {
            _globalTypeKeys = keys
            _globalTypeVals = vals
            _globalTypeCount = count
        }

        /// <summary>全局类字段类型表（键 `类.字段` → 类型），供跨类字段接收者解析（p._lex.Next()）。</summary>
        public function SetGlobalFieldTypes(keys: string[], vals: string[], count: i32): void
        {
            _globalFieldKeys = keys
            _globalFieldVals = vals
            _globalFieldCount = count
        }

        private function GlobalTypeOf(name: string): string
        {
            var i = 0
            while i < _globalTypeCount
            {
                if _globalTypeKeys[i] == name
                {
                    return _globalTypeVals[i]
                }

                i = i + 1
            }

            return ""
        }

        private function GlobalFieldTypeOf(ownerDotField: string): string
        {
            var i = 0
            while i < _globalFieldCount
            {
                if _globalFieldKeys[i] == ownerDotField
                {
                    return _globalFieldVals[i]
                }

                i = i + 1
            }

            return ""
        }

        private function VarHasField(name: string): bool
        {
            var i = 0
            while i < _curFieldCount
            {
                if _curFieldKeys[i] == name
                {
                    return true
                }

                i = i + 1
            }

            return false
        }

        private function CurFieldTypeOf(name: string): string
        {
            let fi = CurFieldIndex(name)
            return fi >= 0 ? _curFieldTypes[fi] : ""
        }

        private function CurClassMethodIndex(name: string): i32
        {
            var i = 0
            while i < _curClassCount
            {
                if _curClassKeys[i] == name
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        private function ClassStaticToken(key: string): i32
        {
            var i = 0
            while i < _classStaticCount
            {
                if _classStaticKeys[i] == key
                {
                    return _classStaticTokens[i]
                }

                i = i + 1
            }

            return -1
        }

        /// <summary>类方法返回类型表（键 `Class.method` → 返回类型串），供链式实例调用 ExprTypeOf 递归解析。</summary>
        public function SetClassMethodTypes(keys: string[], vals: string[], count: i32): void
        {
            _classMethodTypeKeys = keys
            _classMethodTypeVals = vals
            _classMethodTypeCount = count
        }

        private function ClassMethodType(key: string): string
        {
            var i = 0
            while i < _classMethodTypeCount
            {
                if _classMethodTypeKeys[i] == key
                {
                    return _classMethodTypeVals[i]
                }

                i = i + 1
            }

            return ""
        }

        private function ClassMethodToken(key: string): i32
        {
            var i = 0
            while i < _classEntriesCount
            {
                if _classMethodKeys[i] == key
                {
                    return _classMethodTokens[i]
                }

                i = i + 1
            }

            return -1
        }

        private function ClassMethodReturns(key: string): bool
        {
            var i = 0
            while i < _classEntriesCount
            {
                if _classMethodKeys[i] == key
                {
                    return _classMethodReturns[i]
                }

                i = i + 1
            }

            return true
        }

        private function FieldToken(key: string): i32
        {
            var i = 0
            while i < _classFieldKeys.Length
            {
                if _classFieldKeys[i] == key
                {
                    return _classFieldTokens[i]
                }

                i = i + 1
            }

            return -1
        }

        private function CtorToken(className: string): i32
        {
            var i = 0
            while i < _classCtorNames.Length
            {
                if _classCtorNames[i] == className
                {
                    return _classCtorTokens[i]
                }

                i = i + 1
            }

            return -1
        }

        /// <summary>变量类型（参数前段 / 局部后段）；查不到返回空。</summary>
        private function VarTypeOf(name: string): string
        {
            let isParam = ParamIndex(name)
            if isParam >= 0
            {
                return isParam < _varTypeCount ? _varTypes[isParam] : ""
            }

            let li = LocalIndex(name)
            var t = ""
            if li >= 0 && isParam < 0
            {
                let ti = _paramCount + li
                if ti < _varTypeCount
                {
                    t = _varTypes[ti]
                }
            }

            return t
        }

        /// <summary>取一个子表达式节点表示的"类型"（this→当前类、变量→类型表、new→类名、字面量→基元名）；否则空。</summary>
        private function VarNameOf(expr: Node): string
        {
            let n0 = expr.ChildCount() > 0 ? expr.Child(0) : null
            if n0 != null ? n0.ChildCount() > 0 : false
            {
                return n0.Child(0).Text()
            }

            return n0 != null ? n0.Text() : ""
        }

        private function ExprTypeOf(expr: Node): string
        {
            let k = expr.Kind()
            if k == "ThisExpression"
            {
                return expr.ChildCount() > 0 ? expr.Child(0).Text() : ""
            }

            if k == "VariableExpression"
            {
                let vn = VarNameOf(expr)
                let vt = VarTypeOf(vn)
                if vt.Length > 0
                {
                    return vt
                }

                let ft = CurFieldTypeOf(vn)
                if ft.Length > 0
                {
                    return ft
                }

                return GlobalTypeOf(vn)
            }

            if k == "ObjectCreationExpression"
            {
                return expr.ChildCount() > 0 ? expr.Child(0).Text() : ""
            }

            if k == "MemberAccessExpression"
            {
                // this.字段 → 当前类字段类型（_root.ChildCount() 的接收者）；X.字段 → 全局字段类型表
                let tgt0 = expr.ChildCount() > 0 ? expr.Child(0) : null
                if tgt0 != null && expr.ChildCount() > 2
                {
                    if tgt0.Kind() == "ThisExpression"
                    {
                        return CurFieldTypeOf(expr.Child(2).Text())
                    }

                    let ownerType = ExprTypeOf(tgt0)
                    if ownerType.Length > 0
                    {
                        return GlobalFieldTypeOf(ownerType + "." + expr.Child(2).Text())
                    }
                }
            }

            if k == "MemberCallExpression"
            {
                // a.b().Text()：接收者为方法调用 → 用被调方法返回类型解析链；裸调用回退当前类
                let tgt1 = expr.ChildCount() > 0 ? expr.Child(0) : null
                if tgt1 != null && expr.ChildCount() > 2
                {
                    let recvT = ExprTypeOf(tgt1)
                    if recvT.Length > 0
                    {
                        return ClassMethodType(recvT + "." + expr.Child(2).Text())
                    }
                }

                if expr.ChildCount() > 2
                {
                    let ci3 = CurClassMethodIndex(expr.Child(2).Text())
                    if ci3 >= 0
                    {
                        return ""
                    }
                }

                return ""
            }

            if k == "ElementAccessExpression"
            {
                // _locals[i].Describe()：数组元素类型
                let arrType = expr.ChildCount() > 0 ? ExprTypeOf(expr.Child(0)) : ""
                return ArrayElemTypeOf(arrType)
            }

            if k == "MemberCallExpression"
            {
                // 链式实例调用返回类型：inner 类型 + 方法 → Class.method 返回类型
                let innerT = expr.ChildCount() > 2 ? ExprTypeOf(expr.Child(0)) : ""
                if innerT.Length > 0
                {
                    let mt = ClassMethodType(innerT + "." + expr.Child(2).Text())
                    if mt.Length > 0
                    {
                        return mt
                    }
                }

                // BCL/类静态（Parser.Create → 其返回类型表；此处保守返回空）
                return ""
            }

            return ""
        }

        private function BclToken(name: string): i32
        {
            var i = 0
            while i < _bclCount
            {
                if _bclNames[i] == name
                {
                    return _bclTokens[i]
                }

                i = i + 1
            }

            return -1
        }

        private function UsToken(text: string): i32
        {
            var i = 0
            while i < _usCount
            {
                if _usTexts[i] == text
                {
                    return _usTokens[i]
                }

                i = i + 1
            }

            return 0
        }

        public function Error(): string
        {
            return _error
        }

        /// <summary>已分配的局部变量数/名（供元数据计划经 binder 查类型构建局部变量签名）。</summary>
        public function LocalCount(): i32
        {
            return _localCount
        }

        public function LocalName(index: i32): string
        {
            return _localNames[index]
        }

        private function MethodIndex(name: string): i32
        {
            var i = 0
            while i < _methodCount
            {
                if _methodNames[i] == name
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        private function ProducesValue(expr: Node): bool
        {
            if !(expr != null)
            {
                return false
            }

            // 元素/字段赋值（stelem/stfld）不留栈值 → 语句级不弹栈
            if expr.Kind() == "ElementAssignmentExpression" || expr.Kind() == "MemberAssignmentExpression"
            {
                return false
            }

            if expr.Kind() == "CallExpression"
            {
                // 先查当前类裸方法（避免 MethodIndex 对 class 方法的副作用 _error）；再查顶层方法
                let curIdx = CurClassMethodIndex(expr.Child(0).Text())
                if curIdx >= 0 ? _curClassReturns[curIdx] : false
                {
                    return true
                }

                let index = MethodIndex(expr.Child(0).Text())
                if index >= 0
                {
                    return _methodReturnsValue[index]
                }

                return false
            }

            // 实例成员调用产生值按类方法返回值表；BCL 静态调用当前面不产生值（Console.WriteLine）
            if expr.Kind() == "MemberCallExpression"
            {
                let owner = ExprTypeOf(expr.Child(0))
                if owner != "" && ClassMethodToken(owner + "." + expr.Child(2).Text()) >= 0
                {
                    return ClassMethodReturns(owner + "." + expr.Child(2).Text())
                }

                if owner == "string"
                {
                    return true
                }

                return false
            }

            return true
        }

        /// <summary>发射函数体（body = Binder.GetFunctionBody 的 BlockStatement Node 树）。</summary>
        public function EmitFunction(assembler: IlAssembler, body: Node, paramNames: string[], paramCount: i32): void
        {
            _assembler = assembler
            _error = ""
            _paramNames = new string[16]
            _paramCount = paramCount
            _localNames = new string[16]
            _localCount = 0
            _labelNames = new string[body.ChildCount()]
            _labelIndexes = new i32[body.ChildCount()]
            _statementReachable = new bool[body.ChildCount()]
            _labelCount = 0
            _pendingBranches = new i32[body.ChildCount()]
            _pendingNames = new string[body.ChildCount()]
            _pendingCount = 0

            var p = 0
            while p < paramCount
            {
                _paramNames[p] = paramNames[p]
                p = p + 1
            }

            _constantNames = new string[body.ChildCount()]
            _constantValues = new Value[body.ChildCount()]
            _constantCount = 0
            let foldedBody = FoldBody(body)
            ComputeReachability(foldedBody)

            var i = 0
            while i < foldedBody.ChildCount()
            {
                let stmt = foldedBody.Child(i)
                if !stmt.IsToken()
                {
                    if _statementReachable[i]
                    {
                        EmitStatement(stmt)
                    }
                }

                i = i + 1
            }

            // 延迟回填前向/后向标签分支（标签在 LabelStatement 时登记真实指令槽）
            var pi = 0
            while pi < _pendingCount
            {
                let lname = _pendingNames[pi]
                var li = 0
                while li < _labelCount
                {
                    if _labelNames[li] == lname
                    {
                        _assembler.SetTarget(_pendingBranches[pi], _labelIndexes[li])
                    }

                    li = li + 1
                }

                pi = pi + 1
            }

            // 方法尾补隐式 ret（若无显式 return 终结；仅看可达语句，尾部不可达 end-label 不影响）
            var lastNonToken = -1
            i = foldedBody.ChildCount() - 1
            while i >= 0
            {
                if !foldedBody.Child(i).IsToken() && _statementReachable[i]
                {
                    lastNonToken = i
                    break
                }

                i = i - 1
            }

            if lastNonToken >= 0 && !TailEndsWithReturn(foldedBody.Child(lastNonToken))
            {
                _assembler.EmitOperand("Ret", 0, 0, -1)
            }
        }

        private function TailEndsWithReturn(stmt: Node): bool
        {
            let k = stmt.Kind()
            if k == "ReturnStatement"
            {
                return true
            }

            if k == "BlockStatement"
            {
                var i = stmt.ChildCount() - 1
                while i >= 0
                {
                    let child = stmt.Child(i)
                    if !child.IsToken()
                    {
                        return TailEndsWithReturn(child)
                    }

                    i = i - 1
                }
            }

            return false
        }

        // ── 常量折叠（对齐 C# ConstantFolding i32/bool 子集 + Lowerer 常量条件重写）──
        // 折叠在发射器内完成：预扫登记 let 常量，条件常量重写为 Goto/Nop，
        // 表达式折叠在 Count/Emit 时按同一求值核计算，保证计数与发射逐字节一致。

        private function FoldBody(body: Node): Node
        {
            var outBody = Node.MakeCompound("BlockStatement")
            var i = 0
            while i < body.ChildCount()
            {
                let stmt = body.Child(i)
                if !stmt.IsToken()
                {
                    let k = stmt.Kind()
                    if k == "VariableDeclaration"
                    {
                        RegisterConstant(stmt)
                        outBody.Add(stmt)
                    }
                    else if k == "ConditionalGotoStatement"
                    {
                        let cond = EvalConstant(stmt.Child(2))
                        if cond != null
                        {
                            let jumpIfTrue = stmt.Child(1).Text() == "True"
                            let jump = jumpIfTrue == cond.ToBool()
                            let name = stmt.Child(0).Text()
                            if jump
                            {
                                let g = Node.MakeCompound("GotoStatement")
                                g.Add(Node.MakeToken("name", name))
                                outBody.Add(g)
                            }
                            else
                            {
                                outBody.Add(Node.MakeCompound("NopStatement"))
                            }
                        }
                        else
                        {
                            outBody.Add(stmt)
                        }
                    }
                    else
                    {
                        outBody.Add(stmt)
                    }
                }

                i = i + 1
            }

            return outBody
        }

        private function RegisterConstant(stmt: Node): void
        {
            if stmt.ChildCount() < 3
            {
                return
            }

            if stmt.Child(0).Text() != "let"
            {
                return
            }

            let v = EvalConstant(stmt.Child(2))
            if v == null
            {
                return
            }

            _constantNames[_constantCount] = stmt.Child(1).Text()
            _constantValues[_constantCount] = v
            _constantCount = _constantCount + 1
        }

        private function ConstantValue(name: string): Value
        {
            var i = 0
            while i < _constantCount
            {
                if _constantNames[i] == name
                {
                    return _constantValues[i]
                }

                i = i + 1
            }

            return null
        }

        private function EvalConstant(expr: Node): Value
        {
            let k = expr.Kind()
            if k == "LiteralExpression"
            {
                let t = expr.Child(0).Kind()
                if t == "TrueKeyword"
                {
                    return Value.Bool(true)
                }

                if t == "FalseKeyword"
                {
                    return Value.Bool(false)
                }

                if t == "NumberToken"
                {
                    let text = expr.Child(0).Text()
                    if EvaluatorRuntime.HasDot(text)
                    {
                        return null
                    }

                    return Value.Int(EvaluatorRuntime.ParseInt(text))
                }

                return null
            }

            if k == "VariableExpression"
            {
                return ConstantValue(expr.Child(0).Text())
            }

            if k == "BinaryExpression"
            {
                let left = EvalConstant(expr.Child(1))
                let right = EvalConstant(expr.Child(2))
                if left != null && right != null
                {
                    return ApplyBinary(expr.Child(0).Text(), left, right)
                }

                return null
            }

            if k == "UnaryExpression"
            {
                let operand = EvalConstant(expr.Child(1))
                if operand != null
                {
                    return ApplyUnary(expr.Child(0).Text(), operand)
                }

                return null
            }

            return null
        }

        private function ApplyBinary(op: string, left: Value, right: Value): Value
        {
            if left.Kind() == "int" && right.Kind() == "int"
            {
                let l = left.ToInt()
                let r = right.ToInt()
                if op == "+" { return Value.Int(l + r) }
                if op == "-" { return Value.Int(l - r) }
                if op == "*" { return Value.Int(l * r) }
                if op == "/"
                {
                    if r == 0 { return null }
                    return Value.Int(l / r)
                }

                if op == "%"
                {
                    if r == 0 { return null }
                    return Value.Int(l % r)
                }

                if op == "==" { return Value.Bool(l == r) }
                if op == "!=" { return Value.Bool(l != r) }
                if op == "<" { return Value.Bool(l < r) }
                if op == "<=" { return Value.Bool(l <= r) }
                if op == ">" { return Value.Bool(l > r) }
                if op == ">=" { return Value.Bool(l >= r) }
                if op == "&" { return Value.Int(l & r) }
                if op == "|" { return Value.Int(l | r) }
                if op == "^" { return Value.Int(l ^ r) }
                return null
            }

            if left.Kind() == "bool" && right.Kind() == "bool"
            {
                let l = left.ToBool()
                let r = right.ToBool()
                if op == "&&" { return Value.Bool(l && r) }
                if op == "||" { return Value.Bool(l || r) }
                if op == "==" { return Value.Bool(l == r) }
                if op == "!=" { return Value.Bool(l != r) }
                return null
            }

            return null
        }

        private function ApplyUnary(op: string, v: Value): Value
        {
            if op == "+"
            {
                return v
            }

            if op == "-"
            {
                if v.Kind() == "int" { return Value.Int(-v.ToInt()) }
                return null
            }

            if op == "!"
            {
                if v.Kind() == "bool" { return Value.Bool(!v.ToBool()) }
                return null
            }

            if op == "~"
            {
                if v.Kind() == "int" { return Value.Int(~v.ToInt()) }
                return null
            }

            return null
        }

        private function EmitConstantValue(v: Value): void
        {
            if v.Kind() == "int"
            {
                _assembler.EmitOperand("Ldc_I4", 1, v.ToInt(), -1)
            }
            else if v.Kind() == "bool"
            {
                if v.ToBool()
                {
                    _assembler.EmitOperand("Ldc_I4_1", 0, 0, -1)
                }
                else
                {
                    _assembler.EmitOperand("Ldc_I4_0", 0, 0, -1)
                }
            }
        }

        private function ComputeReachability(body: Node): void
        {
            MarkReachable(0)
            var changed = true
            while changed
            {
                changed = false
                var i = 0
                while i < body.ChildCount()
                {
                    if _statementReachable[i]
                    {
                        let stmt = body.Child(i)
                        let k = stmt.Kind()
                        if k == "GotoStatement" || k == "ConditionalGotoStatement"
                        {
                            let target = GotoTargetIndex(body, stmt.Child(0).Text())
                            if MarkReachable(target)
                            {
                                changed = true
                            }
                        }

                        if k != "GotoStatement" && k != "ReturnStatement"
                        {
                            if MarkReachable(i + 1)
                            {
                                changed = true
                            }
                        }
                    }

                    i = i + 1
                }
            }
        }

        private function MarkReachable(index: i32): bool
        {
            if index < 0 || index >= _statementReachable.Length
            {
                return false
            }

            if _statementReachable[index]
            {
                return false
            }

            _statementReachable[index] = true
            return true
        }

        private function GotoTargetIndex(body: Node, name: string): i32
        {
            var i = 0
            while i < body.ChildCount()
            {
                let stmt = body.Child(i)
                if stmt.Kind() == "LabelStatement"
                {
                    if stmt.Child(0).Text() == name
                    {
                        return i
                    }
                }

                i = i + 1
            }

            return -1
        }

        private function ComputeLabels(body: Node): void
        {
            var running = 0
            var i = 0
            while i < body.ChildCount()
            {
                let stmt = body.Child(i)
                if _statementReachable[i] && !stmt.IsToken()
                {
                    let k = stmt.Kind()
                    if k == "LabelStatement"
                    {
                        _labelNames[_labelCount] = stmt.Child(0).Text()
                        _labelIndexes[_labelCount] = running
                        _labelCount = _labelCount + 1
                        running = running + 1
                    }
                    else if k == "GotoStatement"
                    {
                        running = running + 1
                    }
                    else if k == "ConditionalGotoStatement"
                    {
                        running = running + CountExpression(stmt.Child(2)) + 1
                    }
                    else if k == "NopStatement"
                    {
                        running = running + 1
                    }
                    else
                    {
                        running = running + CountStatement(stmt)
                    }
                }

                i = i + 1
            }
        }

        private function LabelIndex(name: string): i32
        {
            var i = 0
            while i < _labelCount
            {
                if _labelNames[i] == name
                {
                    return _labelIndexes[i]
                }

                i = i + 1
            }

            return -1
        }

        private function CountStatement(stmt: Node): i32
        {
            let k = stmt.Kind()
            if k == "VariableDeclaration"
            {
                return CountExpression(stmt.Child(2)) + 1
            }

            if k == "ReturnStatement"
            {
                if stmt.ChildCount() > 0
                {
                    if !stmt.Child(0).IsToken()
                    {
                        return CountExpression(stmt.Child(0)) + 1
                    }
                }

                return 1
            }

            if k == "ExpressionStatement"
            {
                let expr = stmt.Child(0)
                var count = CountExpression(expr)
                if ProducesValue(expr)
                {
                    count = count + 1
                }

                return count
            }

            return 0
        }

        private function CountExpression(expr: Node): i32
        {
            let k = expr.Kind()
            if k == "LiteralExpression" || k == "VariableExpression"
            {
                return 1
            }

            if k == "BinaryExpression"
            {
                let folded = EvalConstant(expr)
                if folded != null
                {
                    return 1
                }

                return CountExpression(expr.Child(1)) + CountExpression(expr.Child(2)) + OpCount(expr.Child(0).Text())
            }

            if k == "UnaryExpression"
            {
                let folded = EvalConstant(expr)
                if folded != null
                {
                    return 1
                }

                let op = expr.Child(0).Text()
                var count = CountExpression(expr.Child(1))
                if op == "+" { return count }
                if op == "!" { return count + 2 }
                return count + 1
            }

            if k == "AssignmentExpression"
            {
                return CountExpression(expr.Child(1)) + 2
            }

            if k == "CallExpression"
            {
                var count = 1
                var i = 1
                while i < expr.ChildCount()
                {
                    count = count + CountExpression(expr.Child(i))
                    i = i + 1
                }

                return count
            }

            if k == "MemberCallExpression"
            {
                // 实例调用（类/字符串）会发射目标 + 参数 + callvirt；BCL 静态只发射参数 + call
                var count = 1
                let owner = ExprTypeOf(expr.Child(0))
                if owner != ""
                {
                    count = count + CountExpression(expr.Child(0))
                }

                var i = 4
                while i < expr.ChildCount() - 1
                {
                    if !expr.Child(i).IsToken()
                    {
                        count = count + CountExpression(expr.Child(i))
                    }

                    i = i + 1
                }

                return count
            }

            if k == "ElementAccessExpression"
            {
                return CountExpression(expr.Child(0)) + CountExpression(expr.Child(1)) + 1
            }

            if k == "ElementAssignmentExpression"
            {
                return CountExpression(expr.Child(0)) + CountExpression(expr.Child(1)) + CountExpression(expr.Child(2)) + 1
            }

            if k == "ArrayCreationExpression"
            {
                var count = CountExpression(expr.Child(1)) + 1
                var a = 2
                while a < expr.ChildCount()
                {
                    count = count + 3 + CountExpression(expr.Child(a))
                    a = a + 1
                }

                return count
            }

            if k == "MemberAccessExpression"
            {
                // 数组 .Length → 目标 + ldlen + conv.i4；字段读 → 目标 + ldfld
                let owner = ExprTypeOf(expr.Child(0))
                if owner.IndexOf("[]") == owner.Length - 2 && expr.Child(2).Text() == "Length"
                {
                    return CountExpression(expr.Child(0)) + 2
                }

                return CountExpression(expr.Child(0)) + 1
            }

            return 1
        }

        private function OpCount(op: string): i32
        {
            if op == "!=" || op == "<=" || op == ">="
            {
                return 3
            }

            return 1
        }

        private function EmitStatement(stmt: Node): void
        {
            let k = stmt.Kind()

            if k == "VariableDeclaration"
            {
                let name = stmt.Child(1).Text()
                let slot = AllocLocal(name)
                EmitExpression(stmt.Child(2))
                _assembler.EmitOperand("Stloc", 12, slot, -1)
            }
            else if k == "ReturnStatement"
            {
                if stmt.ChildCount() > 0
                {
                    if !stmt.Child(0).IsToken()
                    {
                        EmitExpression(stmt.Child(0))
                    }
                }

                _assembler.EmitOperand("Ret", 0, 0, -1)
            }
            else if k == "ExpressionStatement"
            {
                EmitExpression(stmt.Child(0))
                if ProducesValue(stmt.Child(0))
                {
                    _assembler.EmitOperand("Pop", 0, 0, -1)
                }
            }
            else if k == "NopStatement"
            {
                _assembler.EmitOperand("Nop", 0, 0, -1)
            }
            else if k == "LabelStatement"
            {
                let slot = _assembler.EmitOperand("Nop", 0, 0, -1)
                _labelNames[_labelCount] = stmt.Child(0).Text()
                _labelIndexes[_labelCount] = slot
                _labelCount = _labelCount + 1
            }
            else if k == "GotoStatement"
            {
                let place = _assembler.EmitOperand("Br", 14, 0, -1)
                _pendingBranches[_pendingCount] = place
                _pendingNames[_pendingCount] = stmt.Child(0).Text()
                _pendingCount = _pendingCount + 1
            }
            else if k == "ConditionalGotoStatement"
            {
                EmitExpression(stmt.Child(2))
                let jumpIfTrue = stmt.Child(1).Text() == "True"
                if jumpIfTrue
                {
                    let place = _assembler.EmitOperand("Brtrue", 14, 0, -1)
                    _pendingBranches[_pendingCount] = place
                    _pendingNames[_pendingCount] = stmt.Child(0).Text()
                    _pendingCount = _pendingCount + 1
                }
                else
                {
                    let place = _assembler.EmitOperand("Brfalse", 14, 0, -1)
                    _pendingBranches[_pendingCount] = place
                    _pendingNames[_pendingCount] = stmt.Child(0).Text()
                    _pendingCount = _pendingCount + 1
                }
            }
        }

        private function EmitExpression(expr: Node): void
        {
            if !(expr != null)
            {
                _error = "EmitExpression null"
                return
            }

            let k = expr.Kind()

            if k == "LiteralExpression"
            {
                let folded = EvalConstant(expr)
                if folded != null
                {
                    EmitConstantValue(folded)
                }
                else if expr.Child(0).Kind() == "StringToken"
                {
                    // 字符串字面量 → Ldstr <#US token>（token 由驱动预注册）
                    let token = UsToken(StringLiteralValue(expr.Child(0).Text()))
                    _assembler.EmitOperand("Ldstr", 6, token, -1)
                }
                else if expr.Child(0).Kind() == "NullKeyword"
                {
                    _assembler.EmitOperand("Ldnull", 0, 0, -1)
                }
                else
                {
                    let text = expr.Child(0).Text()
                    _assembler.EmitOperand("Ldc_I4", 1, EvaluatorRuntime.ParseInt(text), -1)
                }
            }
            else if k == "VariableExpression"
            {
                let name = VarNameOf(expr)
                let isParam = ParamIndex(name)
                if isParam >= 0
                {
                    _assembler.EmitOperand("Ldarg", 12, isParam, -1)
                }
                else
                {
                    let li = LocalIndex(name)
                    if li >= 0
                    {
                        _assembler.EmitOperand("Ldloc", 12, li, -1)
                    }
                    else
                    {
                        let fldIdx = CurFieldIndex(name)
                        if fldIdx >= 0
                        {
                            _assembler.EmitOperand("Ldarg", 12, 0, -1)
                            _assembler.EmitOperand("Ldfld", 9, _curFieldTokens[fldIdx], -1)
                        }
                    }
                }
            }
            else if k == "BinaryExpression"
            {
                let folded = EvalConstant(expr)
                if folded != null
                {
                    EmitConstantValue(folded)
                }
                else if IsStringBinary(expr)
                {
                    // 字符串运算：==/!=/+/…（操作数含字符串字面量 → String.op_*/Concat MemberRef）
                    let op = expr.Child(0).Text()
                    var member = ""
                    if op == "==" { member = "String.op_Equality" }
                    else if op == "!=" { member = "String.op_Inequality" }
                    else if op == "+" { member = "String.Concat" }
                    if member.Length == 0
                    {
                        _error = "Unsupported string op: " + op
                        return
                    }

                    let token = BclToken(member)
                    if token < 0
                    {
                        _error = "Unresolved bcl member: " + member
                        return
                    }

                    EmitExpression(expr.Child(1))
                    EmitExpression(expr.Child(2))
                    let idx = _assembler.EmitOperand("Call", 7, token, -1)
                    _assembler.SetCallDelta(idx, -1)
                }
                else
                {
                    EmitExpression(expr.Child(1))
                    EmitExpression(expr.Child(2))
                    EmitBinaryOp(expr.Child(0).Text())
                }
            }
            else if k == "AssignmentExpression"
            {
                let tgt2 = expr.Child(0)
                var tgtName2 = ""
                if tgt2.Kind() == "VariableExpression"
                {
                    tgtName2 = VarNameOf(tgt2)
                }
                else if tgt2.Kind() == "MemberAccessExpression" && tgt2.ChildCount() > 2
                {
                    tgtName2 = tgt2.Child(2).Text()
                }

                let fldIdx2 = tgtName2.Length > 0 ? CurFieldIndex(tgtName2) : -1
                if fldIdx2 >= 0
                {
                    // 字段赋值：this 接收者 + 值 + dup + stfld
                    _assembler.EmitOperand("Ldarg", 12, 0, -1)
                    EmitExpression(expr.Child(1))
                    _assembler.EmitOperand("Dup", 0, 0, -1)
                    _assembler.EmitOperand("Stfld", 9, _curFieldTokens[fldIdx2], -1)
                }
                else
                {
                    EmitExpression(expr.Child(1))
                    _assembler.EmitOperand("Dup", 0, 0, -1)
                    _assembler.EmitOperand("Stloc", 12, LocalIndex(expr.Child(0).Text()), -1)
                }
            }
            else if k == "ConditionalExpression"
            {
                let c0 = expr.Child(0)
                let c1 = expr.ChildCount() > 1 ? expr.Child(1) : null
                let c2 = expr.ChildCount() > 2 ? expr.Child(2) : null
                if c0 == null || c1 == null || c2 == null
                {
                    _error = "CEX bad cc=" + string(expr.ChildCount())
                    return
                }

                // cond ? a : b → <cond> Brfalse else <a> Br end else: <b> end
                EmitExpression(c0)
                let brf = _assembler.EmitOperand("Brfalse", 14, 0, -1)
                EmitExpression(c1)
                let br = _assembler.EmitOperand("Br", 14, 0, -1)
                let elsePos = _assembler.InstructionCount()
                EmitExpression(c2)
                let endPos = _assembler.InstructionCount()
                _assembler.SetTarget(brf, elsePos)
                _assembler.SetTarget(br, endPos)
            }
            else if k == "CallExpression"
            {
                // 类型名转换：char(x)/i32(x)/f64(x)… → 发射实参 + 对应 Conv（数值已在同槽位）
                if expr.ChildCount() > 1 &&
                    (expr.Child(0).Text() == "char" || expr.Child(0).Text() == "i8" ||
                     expr.Child(0).Text() == "i16" || expr.Child(0).Text() == "i32" ||
                     expr.Child(0).Text() == "i64" || expr.Child(0).Text() == "f64" ||
                     expr.Child(0).Text() == "bool")
                {
                    EmitExpression(expr.Child(1))
                    let cname = expr.Child(0).Text()
                    if cname == "char"
                    {
                        _assembler.EmitOperand("Conv_U2", 0, 0, -1)
                    }
                    else if cname == "i8"
                    {
                        _assembler.EmitOperand("Conv_I1", 0, 0, -1)
                    }
                    else if cname == "i16"
                    {
                        _assembler.EmitOperand("Conv_I2", 0, 0, -1)
                    }
                    else if cname == "i64"
                    {
                        _assembler.EmitOperand("Conv_I8", 0, 0, -1)
                    }
                    else if cname == "f64"
                    {
                        _assembler.EmitOperand("Conv_R8", 0, 0, -1)
                    }
                }
                else if expr.ChildCount() > 0 && expr.Child(0).Text() == "string"
                {
                    if expr.ChildCount() > 1
                    {
                        EmitExpression(expr.Child(1))
                        let at = StringArgTypeOf(expr.Child(1))
                        if at != "string"
                        {
                            _assembler.EmitOperand("Box", 8, _boxInt32Token, -1)
                            let cidx = _assembler.EmitOperand("Call", 7, _convertToken, -1)
                            _assembler.SetCallDelta(cidx, 0)
                        }
                    }
                }
                else
                {
                    let curIdx = CurClassMethodIndex(expr.Child(0).Text())
                    if curIdx >= 0 ? _curClassInstance[curIdx] : false
                    {
                        _assembler.EmitOperand("Ldarg", 12, 0, -1)
                    }

                    var i = 1
                    while i < expr.ChildCount()
                    {
                        EmitExpression(expr.Child(i))
                        i = i + 1
                    }

                    let index = MethodIndex(expr.Child(0).Text())
                    if index >= 0
                    {
                        let idx = _assembler.EmitOperand("Call", 7, _methodTokens[index], -1)
                        let returnsV = _methodReturnsValue[index]
                        let delta = (returnsV ? 1 : 0) - (expr.ChildCount() - 1)
                        _assembler.SetCallDelta(idx, delta)
                    }
                    else if curIdx >= 0
                    {
                        _error = ""
                        let returnsV = _curClassReturns[curIdx]
                        if _curClassInstance[curIdx]
                        {
                            let idx = _assembler.EmitOperand("Callvirt", 7, _curClassTokens[curIdx], -1)
                            _assembler.SetCallDelta(idx, (returnsV ? 1 : 0) - (expr.ChildCount() - 1 + 1))
                        }
                        else
                        {
                            let idx2 = _assembler.EmitOperand("Call", 7, _curClassTokens[curIdx], -1)
                            _assembler.SetCallDelta(idx2, (returnsV ? 1 : 0) - (expr.ChildCount() - 1))
                        }
                    }
                    else
                    {
                        _error = "Unresolved method: " + expr.Child(0).Text() + " cc=" + string(_curClassCount)
                    }
                }
            }
            else if k == "MemberCallExpression"
            {
                let target = expr.Child(0)
                let owner = ExprTypeOf(target)
                var methodToken = -1
                if owner != ""
                {
                    methodToken = ClassMethodToken(owner + "." + expr.Child(2).Text())
                }

                if methodToken >= 0
                {
                    // 实例方法调用：this.成员() / b.成员() → callvirt（返回值按表）
                    EmitExpression(target)
                    var argCount = 0
                    var a = 4
                    while a < expr.ChildCount() - 1
                    {
                        if !expr.Child(a).IsToken()
                        {
                            EmitExpression(expr.Child(a))
                            argCount = argCount + 1
                        }

                        a = a + 1
                    }

                    let retV = ClassMethodReturns(owner + "." + expr.Child(2).Text())
                    let idx = _assembler.EmitOperand("Callvirt", 7, methodToken, -1)
                    _assembler.SetCallDelta(idx, (retV ? 1 : 0) - (argCount + 1))
                }
                else if expr.Child(2).Text() == "ToString"
                {
                    // 值类型 .ToString() → Box Convert.ToString(object)；字符串 → 恒等返回
                    EmitExpression(target)
                    if owner != "string"
                    {
                        _assembler.EmitOperand("Box", 8, _boxInt32Token, -1)
                        let cidx = _assembler.EmitOperand("Call", 7, _convertToken, -1)
                        _assembler.SetCallDelta(cidx, 0)
                    }
                }
                else if owner == "string"
                {
                    // 字符串实例成员：s.substring(i[,len]) / s.IndexOf(str) → target + args + callvirt（均返回值）
                    EmitExpression(target)
                    var argCount = 0
                    var a = 4
                    while a < expr.ChildCount() - 1
                    {
                        if !expr.Child(a).IsToken()
                        {
                            EmitExpression(expr.Child(a))
                            argCount = argCount + 1
                        }

                        a = a + 1
                    }

                    let skey = "String." + expr.Child(2).Text() + string(argCount)
                    let stok = BclToken(skey)
                    if stok < 0
                    {
                        _error = "Unresolved bcl member: " + skey
                        return
                    }

                    let idx = _assembler.EmitOperand("Callvirt", 7, stok, -1)
                    _assembler.SetCallDelta(idx, 1 - (argCount + 1))
                }
                else
                {
                    // 字段实例方法调用回退：_root.ChildCount()（target 为当前类字段，取其类型按实例成员解析）
                    let tgtName = target.Kind() == "VariableExpression" ? VarNameOf(target) : ""
                    let ftype = tgtName.Length > 0 ? CurFieldTypeOf(tgtName) : ""
                    if ftype.Length > 0
                    {
                        let mtok = ClassMethodToken(ftype + "." + expr.Child(2).Text())
                        if mtok >= 0
                        {
                            EmitExpression(target)
                            var argCount = 0
                            var a = 4
                            while a < expr.ChildCount() - 1
                            {
                                if !expr.Child(a).IsToken()
                                {
                                    EmitExpression(expr.Child(a))
                                    argCount = argCount + 1
                                }

                                a = a + 1
                            }

                            let retV = ClassMethodReturns(ftype + "." + expr.Child(2).Text())
                            let idx = _assembler.EmitOperand("Callvirt", 7, mtok, -1)
                            _assembler.SetCallDelta(idx, (retV ? 1 : 0) - (argCount + 1))
                            return
                        }
                    }

                    // 静态类方法调用（P.M() → Call，无接收者）或 BCL 静态成员（Console.WriteLine / System.Console.WriteLine）
                    var targetName = ""
                    let tgt0 = expr.Child(0)
                    if tgt0 != null
                    {
                        if tgt0.Kind() == "MemberAccessExpression" && tgt0.ChildCount() > 2
                        {
                            targetName = tgt0.Child(2).Text()
                        }
                        else if tgt0.ChildCount() > 0
                        {
                            targetName = tgt0.Child(0).Text()
                        }
                        else
                        {
                            targetName = tgt0.Text()
                        }
                    }

                    let fullName = targetName + "." + expr.Child(2).Text()
                    let staticToken = ClassStaticToken(fullName)
                    if staticToken >= 0
                    {
                        var argCount = 0
                        var a = 4
                        while a < expr.ChildCount() - 1
                        {
                            if !expr.Child(a).IsToken()
                            {
                                EmitExpression(expr.Child(a))
                                argCount = argCount + 1
                            }

                            a = a + 1
                        }

                        let idx = _assembler.EmitOperand("Call", 7, staticToken, -1)
                        _assembler.SetCallDelta(idx, 1 - argCount)
                        return
                    }

                    let token = BclToken(fullName)
                    if token < 0
                    {
                        _error = "Unresolved bcl member: " + fullName + " tk=" + expr.Child(0).Kind()
                        return
                    }

                    var argCount = 0
                    var a = 4
                    while a < expr.ChildCount() - 1
                    {
                        if !expr.Child(a).IsToken()
                        {
                            EmitExpression(expr.Child(a))
                            argCount = argCount + 1
                        }

                        a = a + 1
                    }

                    let idx = _assembler.EmitOperand("Call", 7, token, -1)
                    _assembler.SetCallDelta(idx, 0 - argCount)
                }
            }
            else if k == "ThisExpression"
            {
                _assembler.EmitOperand("Ldarg", 12, 0, -1)
            }
            else if k == "ObjectCreationExpression"
            {
                // 绑定形状：(ObjectCreationExpression type=ClassName <args>)
                let ctorToken = CtorToken(expr.Child(0).Text())
                if ctorToken < 0
                {
                    _error = "Unresolved class ctor: " + expr.Child(0).Text()
                    return
                }

                var argCount = 0
                var a = 1
                while a < expr.ChildCount()
                {
                    if !expr.Child(a).IsToken()
                    {
                        EmitExpression(expr.Child(a))
                        argCount = argCount + 1
                    }

                    a = a + 1
                }

                let idx = _assembler.EmitOperand("Newobj", 7, ctorToken, -1)
                _assembler.SetCallDelta(idx, 1 - argCount)
            }
            else if k == "MemberAccessExpression"
            {
                // 字段读：this.v / b.v → <目标> <ldfld token>；数组 .Length → <目标> ldlen conv.i4
                let owner = ExprTypeOf(expr.Child(0))
                let memberName = expr.Child(2).Text()
                if owner.IndexOf("[]") == owner.Length - 2 && memberName == "Length"
                {
                    EmitExpression(expr.Child(0))
                    _assembler.EmitOperand("Ldlen", 0, 0, -1)
                    _assembler.EmitOperand("Conv_I4", 0, 0, -1)
                }
                else if owner == "string" && memberName == "Length"
                {
                    // s.Length → callvirt instance int32 System.String::get_Length()
                    EmitExpression(expr.Child(0))
                    let stok = BclToken("String.Length")
                    if stok < 0
                    {
                        _error = "Unresolved bcl member: String.Length"
                        return
                    }

                    let idx = _assembler.EmitOperand("Callvirt", 7, stok, -1)
                    _assembler.SetCallDelta(idx, 0)
                }
                else
                {
                    if owner == ""
                    {
                        _error = "Unknown member owner"
                        return
                    }

                    let name = expr.Child(2).Text()
                    let token = FieldToken(owner + "." + name)
                    if token < 0
                    {
                        _error = "Unresolved field: " + owner + "." + name
                        return
                    }

                    EmitExpression(expr.Child(0))
                    _assembler.EmitOperand("Ldfld", 9, token, -1)
                }
            }
            else if k == "ArrayCreationExpression"
            {
                // (ArrayCreationExpression type <len> [inits...]) → <len> newarr <elemToken> [dup init stelem ...]
                let elemType = expr.Child(0).Text()
                let elemToken = ArrayElemToken(elemType)
                if elemToken < 0
                {
                    _error = "Unresolved array element type: " + elemType
                    return
                }

                EmitExpression(expr.Child(1))
                let idx = _assembler.EmitOperand("Newarr", 8, elemToken, -1)
                _assembler.SetCallDelta(idx, 0)
                var a = 2
                var initSlot = 0
                while a < expr.ChildCount()
                {
                    _assembler.EmitOperand("Dup", 0, 0, -1)
                    _assembler.EmitOperand("Ldc_I4", 1, initSlot, -1)
                    EmitExpression(expr.Child(a))
                    _assembler.EmitOperand("Stelem_Ref", 0, 0, -1)
                    a = a + 1
                    initSlot = initSlot + 1
                }
            }
            else if k == "ElementAccessExpression"
            {
                // (ElementAccessExpression <target> <index>) → <target> <index> ldelem_*
                EmitExpression(expr.Child(0))
                EmitExpression(expr.Child(1))
                let owner3 = ExprTypeOf(expr.Child(0))
                if ArrayElemTypeOf(owner3) == "i32"
                {
                    _assembler.EmitOperand("Ldelem_I4", 0, 0, -1)
                }
                else
                {
                    _assembler.EmitOperand("Ldelem_Ref", 0, 0, -1)
                }
            }
            else if k == "ElementAssignmentExpression"
            {
                // (ElementAssignmentExpression <target> <index> <value>) → <target> <index> <value> stelem_*
                EmitExpression(expr.Child(0))
                EmitExpression(expr.Child(1))
                EmitExpression(expr.Child(2))
                let owner4 = ExprTypeOf(expr.Child(0))
                if ArrayElemTypeOf(owner4) == "i32"
                {
                    _assembler.EmitOperand("Stelem_I4", 0, 0, -1)
                }
                else
                {
                    _assembler.EmitOperand("Stelem_Ref", 0, 0, -1)
                }
            }
            else if k == "MemberAssignmentExpression"
            {
                // 字段写 this.v = e / b.v = e → <目标> <值> stfld <token>
                let owner5 = ExprTypeOf(expr.Child(0))
                let fname = expr.Child(1).Text()
                let ftoken = FieldToken(owner5 + "." + fname)
                if ftoken < 0
                {
                    _error = "Unresolved field: " + owner5 + "." + fname
                    return
                }

                EmitExpression(expr.Child(0))
                EmitExpression(expr.Child(2))
                _assembler.EmitOperand("Stfld", 9, ftoken, -1)
            }
            else if k == "UnaryExpression"
            {
                let folded = EvalConstant(expr)
                if folded != null
                {
                    EmitConstantValue(folded)
                }
                else
                {
                    EmitExpression(expr.Child(1))
                    EmitUnaryOp(expr.Child(0).Text())
                }
            }
        }

        private function EmitUnaryOp(op: string): void
        {
            if op == "-"
            {
                _assembler.EmitOperand("Neg", 0, 0, -1)
            }
            else if op == "~"
            {
                _assembler.EmitOperand("Not", 0, 0, -1)
            }
            else if op == "!"
            {
                // !cond：Ldc_I4_0; Ceq
                _assembler.EmitOperand("Ldc_I4_0", 0, 0, -1)
                _assembler.EmitOperand("Ceq", 0, 0, -1)
            }
        }

        private function EmitBinaryOp(op: string): void
        {
            if op == "+" { _assembler.EmitOperand("Add", 0, 0, -1) }
            else if op == "-" { _assembler.EmitOperand("Sub", 0, 0, -1) }
            else if op == "*" { _assembler.EmitOperand("Mul", 0, 0, -1) }
            else if op == "/" { _assembler.EmitOperand("Div", 0, 0, -1) }
            else if op == "%" { _assembler.EmitOperand("Rem", 0, 0, -1) }
            else if op == "==" { _assembler.EmitOperand("Ceq", 0, 0, -1) }
            else if op == "!="
            {
                _assembler.EmitOperand("Ceq", 0, 0, -1)
                _assembler.EmitOperand("Ldc_I4_0", 0, 0, -1)
                _assembler.EmitOperand("Ceq", 0, 0, -1)
            }
            else if op == "<" { _assembler.EmitOperand("Clt", 0, 0, -1) }
            else if op == "<="
            {
                _assembler.EmitOperand("Cgt", 0, 0, -1)
                _assembler.EmitOperand("Ldc_I4_0", 0, 0, -1)
                _assembler.EmitOperand("Ceq", 0, 0, -1)
            }
            else if op == ">" { _assembler.EmitOperand("Cgt", 0, 0, -1) }
            else if op == ">="
            {
                _assembler.EmitOperand("Clt", 0, 0, -1)
                _assembler.EmitOperand("Ldc_I4_0", 0, 0, -1)
                _assembler.EmitOperand("Ceq", 0, 0, -1)
            }
        }

        // 参数 arg 索引（0..paramCount-1）；非参数返回 -1
        private function ParamIndex(name: string): i32
        {
            var p = 0
            while p < _paramCount
            {
                if _paramNames[p] == name
                {
                    return p
                }

                p = p + 1
            }

            return -1
        }

        private function AllocLocal(name: string): i32
        {
            let slot = _localCount
            if _localCount >= _localNames.Length
            {
                var bigger = new string[_localNames.Length * 2]
                var i = 0
                while i < _localCount
                {
                    bigger[i] = _localNames[i]
                    i = i + 1
                }

                _localNames = bigger
            }

            _localNames[_localCount] = name
            _localCount = _localCount + 1
            return slot
        }

        private function LocalIndex(name: string): i32
        {
            var i = 0
            while i < _localCount
            {
                if _localNames[i] == name
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        /// <summary>字符串 token 文本去外层引号（自举 StringToken.Text 含引号）。</summary>
        private static function StringLiteralValue(text: string): string
        {
            if text.Length >= 2
            {
                if i32(text[0]) == 34 && i32(text[text.Length - 1]) == 34
                {
                    return text.substring(1, text.Length - 2)
                }
            }

            return text
        }

        /// <summary>字符串运算启发式：==/!=/+ 且任一侧为字符串字面量（无类型信息时的信号）。</summary>
        private static function IsStringBinary(expr: Node): bool
        {
            let op = expr.Child(0).Text()
            if op != "==" && op != "!=" && op != "+"
            {
                return false
            }

            if IsStringLiteral(expr.Child(1))
            {
                return true
            }

            return IsStringLiteral(expr.Child(2))
        }

        private static function IsStringLiteral(expr: Node): bool
        {
            if expr.Kind() == "LiteralExpression"
            {
                return expr.Child(0).Kind() == "StringToken"
            }

            return false
        }
    }
}
