// Cocoa 自举 CodeGen · Tagged Value（阶段 7 增量五 M5-a1）——
// 值模型：kind（int/double/string/bool/null/return）规范文本。无 object 多态，
// 用 kind 分派对齐 C# Evaluator 的装箱值语义（int 整除 vs double 除法、类型推断自字面量文本）。
namespace Cocoa.CodeGen
{
    class Value
    {
        private field _kind: string
        private field _text: string
        private field _inner: Value

        public constructor()
        {
            _kind = "null"
            _text = ""
            _inner = null
        }

        public static function Int(v: i32): Value
        {
            var x = new Value()
            x._kind = "int"
            x._text = EvaluatorRuntime.IntToString(v)
            return x
        }

        public static function Double(v: f64): Value
        {
            var x = new Value()
            x._kind = "double"
            x._text = EvaluatorRuntime.DoubleToString(v)
            return x
        }

        public static function Str(s: string): Value
        {
            var x = new Value()
            x._kind = "string"
            x._text = s
            return x
        }

        public static function Bool(b: bool): Value
        {
            var x = new Value()
            x._kind = "bool"
            x._text = EvaluatorRuntime.BoolToString(b)
            return x
        }

        public static function Null(): Value
        {
            var x = new Value()
            x._kind = "null"
            x._text = ""
            return x
        }

        public static function Return(v: Value): Value
        {
            var x = new Value()
            x._kind = "return"
            x._text = ""
            x._inner = v
            return x
        }

        public function Kind(): string
        {
            return _kind
        }

        public function Text(): string
        {
            return _text
        }

        public function Inner(): Value
        {
            return _inner
        }

        public function IsReturn(): bool
        {
            return _kind == "return"
        }

        public function IsNull(): bool
        {
            return _kind == "null"
        }

        public function Format(): string
        {
            return _text
        }

        public function ToInt(): i32
        {
            if _kind == "bool"
            {
                if _text == "true"
                {
                    return 1
                }

                return 0
            }

            return EvaluatorRuntime.ParseInt(_text)
        }

        public function ToDouble(): f64
        {
            if _kind == "int" || _kind == "bool"
            {
                return ToInt() * 1.0
            }

            return EvaluatorRuntime.ParseDouble(_text)
        }

        public function ToBool(): bool
        {
            if _kind == "bool"
            {
                return _text == "true"
            }

            if _kind == "null"
            {
                return false
            }

            return ToInt() != 0
        }
    }
}
