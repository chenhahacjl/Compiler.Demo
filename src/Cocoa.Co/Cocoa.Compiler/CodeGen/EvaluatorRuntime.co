// Cocoa 自举 CodeGen · 求值运行时（阶段 7 增量五 M5-a1）——数值与字符串解析与格式化辅助。
// 注意 Cocoa 语言约束：无 object 装箱多态（object 特性另行立项），故值用 Tagged Value 类承载；
// 解析用 i32(char) ASCII 判定（char 比较运算符受限）。
namespace Cocoa.CodeGen
{
    class EvaluatorRuntime
    {
        public static function IntToString(v: i32): string
        {
            return string(v)
        }

        public static function DoubleToString(v: f64): string
        {
            return v.ToString()
        }

        public static function BoolToString(b: bool): string
        {
            if b
            {
                return "true"
            }

            return "false"
        }

        public static function HasDot(s: string): bool
        {
            var i = 0
            while i < s.Length
            {
                if i32(s[i]) == 46
                {
                    return true
                }

                i = i + 1
            }

            return false
        }

        public static function ParseInt(s: string): i32
        {
            var result = 0
            var sign = 1
            var i = 0
            if s.Length > 0
            {
                // 长度守卫独立成 if：自举路径对 && 发射为分支，但嵌套写法不依赖短路
                if i32(s[0]) == 45
                {
                    sign = -1
                    i = 1
                }
            }

            while i < s.Length
            {
                let v = i32(s[i])
                if v == 46
                {
                    break
                }

                if v >= 48 && v <= 57
                {
                    result = result * 10 + (v - 48)
                }

                i = i + 1
            }

            return result * sign
        }

        public static function ParseDouble(s: string): f64
        {
            var result = 0.0
            var sign = 1.0
            var i = 0
            if s.Length > 0
            {
                if i32(s[0]) == 45
                {
                    sign = -1.0
                    i = 1
                }
            }

            var afterDot = false
            var divisor = 1.0
            while i < s.Length
            {
                let v = i32(s[i])
                if v == 46
                {
                    afterDot = true
                }
                else if v >= 48 && v <= 57
                {
                    if afterDot
                    {
                        divisor = divisor * 10.0
                        result = result + (v - 48) / divisor
                    }
                    else
                    {
                        result = result * 10.0 + (v - 48)
                    }
                }

                i = i + 1
            }

            return result * sign
        }
    }
}
