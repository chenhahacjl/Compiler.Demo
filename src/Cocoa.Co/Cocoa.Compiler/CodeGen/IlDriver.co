// M5-a5 批 2→BCL/字符串扩展 + C-2 类支持：自举 IL → 物理 .dll 端到端驱动。
// 绑定 → 逐函数 IlEmitter/IlAssembler（方法体 hex + maxStack + 局部签名）→ 元数据计划（签名/RVA/flags/token）→
// IlMetadataBuilder（六流 hex + FieldDef + 用户 TypeDef）→ ManagedPeWriter（PE 字节）→ 返回 PE 字节 hex 或 "ERR:…"。
// 支持：多顶层函数、参数、内部调用（0x06…）、局部变量（StandAloneSig）、控制流（if/while）、
// BCL 静态调用（Console.WriteLine(i32|string)，MemberRef 0x0A…）、字符串字面量（Ldstr + #US 0x70…）、
// 字符串运算（==/!=/+ → String.op_Equality/op_Inequality/Concat，操作数含字符串字面量启发式）。
// C-2：用户类 TypeDef 行 + FieldDef 表 + 隐式 .ctor（调用 Object::.ctor）+ 实例方法
// （HAS_THIS 签名 0x86 + callvirt 发射）+ newobj 构造。
// C# 侧测试取 hex 落盘并实跑验证；批 3 由 Cli `compile` 子命令接线（File.WriteAllBytes）。

using Cocoa.CodeAnalysis.Binding
using Cocoa.CodeAnalysis.Syntax

namespace Cocoa.CodeGen
{
    class IlDriver
    {
        /// <summary>编译程序为托管 .dll（入口 = 顶层 `Main`）；返回 PE 字节 hex（小端），失败返回 "ERR:…"。</summary>
        public static function BuildDllHex(source: string): string
        {
            let binder = Cocoa.CodeAnalysis.Binding.Binder.Create(source)
            binder.BindCompilationUnit()
            if binder.DiagnosticCount() > 0
            {
                return "ERR:" + binder.DiagnosticAt(0)
            }

            let topCount = binder.GetTopLevelFunctionCount()
            let classCount = binder.GetClassCount()
            let fnCount = binder.GetFunctionCount()
            if topCount < 1
            {
                return "ERR:no functions"
            }

            // 定位顶层入口 Main（仅顶层函数）
            var mainTop = -1
            var i = 0
            while i < topCount
            {
                if binder.GetFunctionName(binder.GetTopLevelFunctionIndex(i)) == "Main"
                {
                    mainTop = i
                }

                i = i + 1
            }

            if mainTop < 0
            {
                return "ERR:no function Main"
            }

            // 不支持 非数组 类型限制已解除：数组（i32[]/string[]/类[]）→ newarr/ldelem/stelem/ldlen。
            i = 0
            while i < fnCount
            {
                var p = 0
                while p < binder.GetFunctionParamCount(i)
                {
                    p = p + 1
                }

                i = i + 1
            }

            // ---- 收集 BCL 调用 + 字符串字面量（所有函数体，含类方法）----
var bclKeys = new string[2048]
            var bclTokens = new i32[2048]
            var bclParents = new i32[2048]
            var bclSigs = new string[2048]
            var bclNames = new string[2048]
            var bclCount = new i32[1]
            bclCount[0] = 0
            var usTexts = new string[2048]
            var usTokens = new i32[2048]
            var usCount = new i32[1]
            usCount[0] = 0
            var usBytes = new i32[1]
            usBytes[0] = 1

            i = 0
            while i < fnCount
            {
                CollectNodes(binder.GetFunctionBody(i), bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                    usTexts, usTokens, usCount, usBytes)
                i = i + 1
            }

            // ---- 数组元素类型扫描（newarr 元素 TypeRef + string() 转换检测）----
            var needsInt32 = new bool[1]
            needsInt32[0] = false
            var needsStringArray = new bool[1]
            needsStringArray[0] = false
            var needsBool = new bool[1]
            needsBool[0] = false
            var needsChar = new bool[1]
            needsChar[0] = false
            var usesConvert = new bool[1]
            usesConvert[0] = false
            var classElems = new string[512]
            var classElemsCount = new i32[1]
            classElemsCount[0] = 0
            i = 0
            while i < fnCount
            {
                ScanArrayElems(binder.GetFunctionBody(i), needsInt32, needsStringArray, needsBool, needsChar, usesConvert,
                    classElems, classElemsCount)
                i = i + 1
            }

            // ---- TypeRef 布局计划（发射前定 token）：Object(1) + Debuggable(2) + [Console(3)] + [String] + [Int32] ----
            var hasConsole = false
            var hasString = false
            var brm = 0
            while brm < bclCount[0]
            {
                if bclParents[brm] == 3 { hasConsole = true }
                if bclParents[brm] == 4 { hasString = true }
                brm = brm + 1
            }

            var usesString = hasString
            if needsStringArray[0] { usesString = true }
            var usesInt32 = needsInt32[0]
            if usesConvert[0] { usesInt32 = true }
            var usesBool = needsBool[0]
            var usesChar = needsChar[0]
            var typeRefCount = 2
            if hasConsole { typeRefCount = typeRefCount + 1 }
            if usesString { typeRefCount = typeRefCount + 1 }
            if usesInt32 { typeRefCount = typeRefCount + 1 }
            if usesBool { typeRefCount = typeRefCount + 1 }
            if usesChar { typeRefCount = typeRefCount + 1 }
            if usesConvert[0] { typeRefCount = typeRefCount + 1 }
            var stringTypeRow = 2
            if hasConsole { stringTypeRow = stringTypeRow + 1 }
            stringTypeRow = stringTypeRow + 1
            var int32TypeRow = 2
            if hasConsole { int32TypeRow = int32TypeRow + 1 }
            if usesString { int32TypeRow = int32TypeRow + 1 }
            if usesInt32 { int32TypeRow = int32TypeRow + 1 }
            var boolTypeRow = 2
            if hasConsole { boolTypeRow = boolTypeRow + 1 }
            if usesString { boolTypeRow = boolTypeRow + 1 }
            if usesInt32 { boolTypeRow = boolTypeRow + 1 }
            if usesBool { boolTypeRow = boolTypeRow + 1 }
            var charTypeRow = 2
            if hasConsole { charTypeRow = charTypeRow + 1 }
            if usesString { charTypeRow = charTypeRow + 1 }
            if usesInt32 { charTypeRow = charTypeRow + 1 }
            if usesBool { charTypeRow = charTypeRow + 1 }
            if usesChar { charTypeRow = charTypeRow + 1 }
            var convertTypeRow = typeRefCount
            var convertMemberRow = 1 + bclCount[0]
            if classCount > 0 { convertMemberRow = convertMemberRow + 1 }

            // ---- 方法行规划：顶层（序数序）→ 每类（隐式 .ctor + 实例方法）。
            // 行号/令牌纯算术：顶层 t → 行 t；类 ci 的 ctor → classStartRow[ci]。
            // <CocoaTopLevel> methodList=1 覆盖行 1..topCount；用户类 methodList=ctor 行。
            var classStartRow = new i32[classCount]
            var fieldStart = new i32[classCount]
            var totalRows = topCount
            var totalClassMethods = 0
            var totalFields = 0
            var ci = 0
            while ci < classCount
            {
                classStartRow[ci] = totalRows
                fieldStart[ci] = totalFields
                totalRows = totalRows + 1 + binder.GetClassMethodCount(ci)
                totalClassMethods = totalClassMethods + binder.GetClassMethodCount(ci)
                totalFields = totalFields + binder.GetClassFieldCount(ci)
                ci = ci + 1
            }

            var mNames = new string[totalRows]
            var mSigs = new string[totalRows]
            var mRvas = new i32[totalRows]
            var mParamCounts = new i32[totalRows]
            var mFlags = new i32[totalRows]
            var mBodies = new string[totalRows]
            var mMaxStacks = new i32[totalRows]
            var mSigBlobs = new string[totalRows]
            var mSigTokens = new i32[totalRows]

            // ---- 令牌表 ----
            var classKeys = new string[totalClassMethods]
            var classTokens = new i32[totalClassMethods]
            var staticKeys = new string[totalClassMethods]
            var staticTokens = new i32[totalClassMethods]
            var classReturns = new bool[totalClassMethods]
            var classCtorNames = new string[classCount]
            var classCtorTokens = new i32[classCount]
            var fieldNames = new string[totalFields]
            var fieldSigs = new string[totalFields]
            var fieldFlags = new i32[totalFields]
            var fieldKeys = new string[totalFields]
            var fieldTokens = new i32[totalFields]
            var userTypeNames = new string[classCount]
            var userTypeFieldLists = new i32[classCount]
            var userTypeMethodLists = new i32[classCount]

            var cmc = 0
            var sc = 0
            ci = 0
            while ci < classCount
            {
                let className = binder.GetClassName(ci)
                userTypeNames[ci] = className
                userTypeMethodLists[ci] = classStartRow[ci] + 1
                userTypeFieldLists[ci] = totalFields > 0 ? fieldStart[ci] + 1 : 1
                classCtorNames[ci] = className
                classCtorTokens[ci] = 0x06000000 + classStartRow[ci] + 1

                var fi = 0
                while fi < binder.GetClassFieldCount(ci)
                {
                    let fr = fieldStart[ci] + fi
                    fieldNames[fr] = binder.GetClassFieldName(ci, fi)
                    fieldSigs[fr] = MetadataEncode.EncodeFieldSignatureHex(LocalTypeForSig(binder, binder.GetClassFieldType(ci, fi)))
                    fieldFlags[fr] = 0x0006
                    fieldKeys[fr] = className + "." + fieldNames[fr]
                    fieldTokens[fr] = 0x04000001 + fr
                    fi = fi + 1
                }

                var mi = 0
                while mi < binder.GetClassMethodCount(ci)
                {
                    let fidx = binder.GetClassMethodIndex(ci, mi)
                    if binder.GetClassMethodIsStatic(ci, mi)
                    {
                        staticKeys[sc] = className + "." + binder.GetClassMethodName(ci, mi)
                        staticTokens[sc] = 0x06000000 + classStartRow[ci] + 2 + mi
                        sc = sc + 1
                    }
                    else
                    {
                        classKeys[cmc] = className + "." + binder.GetClassMethodName(ci, mi)
                        classTokens[cmc] = 0x06000000 + classStartRow[ci] + 2 + mi
                        classReturns[cmc] = binder.GetFunctionReturnType(fidx) != "void"
                        cmc = cmc + 1
                    }

                    mi = mi + 1
                }

                ci = ci + 1
            }

            var emitter = new IlEmitter()
            var topNames = new string[topCount]
            var topTokens = new i32[topCount]
            var topReturns = new bool[topCount]
            var t0 = 0
            while t0 < topCount
            {
                topNames[t0] = binder.GetFunctionName(binder.GetTopLevelFunctionIndex(t0))
                topTokens[t0] = 0x06000000 + t0 + 1
                topReturns[t0] = binder.GetFunctionReturnType(binder.GetTopLevelFunctionIndex(t0)) != "void"
                t0 = t0 + 1
            }

            emitter.SetMethods(topNames, topTokens, topReturns)
            var elemCount = 0
            var elemNames = new string[516]
            var elemTokens = new i32[516]
            if usesInt32
            {
                elemNames[elemCount] = "i32"
                elemTokens[elemCount] = 0x01000000 + int32TypeRow
                elemCount = elemCount + 1
            }

            if usesString
            {
                elemNames[elemCount] = "string"
                elemTokens[elemCount] = 0x01000000 + stringTypeRow
                elemCount = elemCount + 1
            }

            if usesBool
            {
                elemNames[elemCount] = "bool"
                elemTokens[elemCount] = 0x01000000 + boolTypeRow
                elemCount = elemCount + 1
            }

            if usesChar
            {
                elemNames[elemCount] = "char"
                elemTokens[elemCount] = 0x01000000 + charTypeRow
                elemCount = elemCount + 1
            }

            var cec = 0
            while cec < classElemsCount[0]
            {
                let cname = classElems[cec]
                var cii = 0
                while cii < classCount
                {
                    if binder.GetClassName(cii) == cname
                    {
                        elemNames[elemCount] = cname
                        elemTokens[elemCount] = 0x02000000 + 3 + cii
                        elemCount = elemCount + 1
                    }

                    cii = cii + 1
                }

                cec = cec + 1
            }

            if elemCount > 0
            {
                emitter.SetArrayElemTypes(elemNames, elemTokens, elemCount)
            }

            if usesConvert[0]
            {
                emitter.SetStringConvert(0x0A000000 + convertMemberRow + 1, 0x01000000 + int32TypeRow)
            }
            if totalClassMethods > 0
            {
                emitter.SetClassMethods(classKeys, classTokens, classReturns, totalClassMethods)
            }

            if sc > 0
            {
                emitter.SetClassStaticMethods(staticKeys, staticTokens, sc)
            }

            if totalFields > 0
            {
                emitter.SetClassFields(fieldKeys, fieldTokens, totalFields)
            }

            if classCount > 0
            {
                emitter.SetClassCtors(classCtorNames, classCtorTokens, classCount)
            }

            if bclCount[0] > 0
            {
                let keys = new string[bclCount[0]]
                let toks = new i32[bclCount[0]]
                var bi = 0
                while bi < bclCount[0]
                {
                    keys[bi] = bclKeys[bi]
                    toks[bi] = bclTokens[bi]
                    bi = bi + 1
                }

                emitter.SetBclMembers(keys, toks, bclCount[0])
            }

            if usCount[0] > 0
            {
                let texts = new string[usCount[0]]
                let toks = new i32[usCount[0]]
                var ui = 0
                while ui < usCount[0]
                {
                    texts[ui] = usTexts[ui]
                    toks[ui] = usTokens[ui]
                    ui = ui + 1
                }

                emitter.SetUserStrings(texts, toks, usCount[0])
            }

            // ---- 逐行发射（RVA / 局部签名计数器贯穿所有行）----
            let objectCtorToken = 0x0A000000 + 2 + bclCount[0]
            var rvaState = new i32[1]
            rvaState[0] = 0x1048
            var sigState = new i32[1]
            sigState[0] = 0

            // 顶层静态方法
            var tt = 0
            while tt < topCount
            {
                let idx = binder.GetTopLevelFunctionIndex(tt)
                mNames[tt] = binder.GetFunctionName(idx)
                mFlags[tt] = 0x96
                mParamCounts[tt] = binder.GetFunctionParamCount(idx)
                mSigs[tt] = MethodSig(binder, idx, true, 0)
                let err = EmitBody(idx, binder, emitter, rvaState, sigState,
                    mBodies, mMaxStacks, mRvas, mSigBlobs, mSigTokens, tt)
                if err.Length > 0
                {
                    return err
                }

                tt = tt + 1
            }

            // 类：隐式 .ctor + 实例方法
            ci = 0
            while ci < classCount
            {
                let ctorRow = classStartRow[ci]
                mNames[ctorRow] = ".ctor"
                mFlags[ctorRow] = 0x1886
                mParamCounts[ctorRow] = 0
                mSigs[ctorRow] = MetadataEncode.EncodeMethodSignatureHex("void", new string[0], 0, false)
                let ctorAsm = new IlAssembler()
                ctorAsm.EmitOperand("Ldarg", 12, 0, -1)
                let ccall = ctorAsm.EmitOperand("Call", 7, objectCtorToken, -1)
                ctorAsm.SetCallDelta(ccall, 0 - 1)
                ctorAsm.EmitOperand("Ret", 0, 0, -1)
                mBodies[ctorRow] = ctorAsm.Assemble()
                mMaxStacks[ctorRow] = ctorAsm.ComputeMaxStack()
                mRvas[ctorRow] = rvaState[0]
                rvaState[0] = rvaState[0] + Align4(12 + mBodies[ctorRow].Length / 2)
                mSigBlobs[ctorRow] = ""
                mSigTokens[ctorRow] = 0

                var mi2 = 0
                while mi2 < binder.GetClassMethodCount(ci)
                {
                    let r = classStartRow[ci] + 1 + mi2
                    let fidx = binder.GetClassMethodIndex(ci, mi2)
                    let isStat = binder.GetClassMethodIsStatic(ci, mi2)
                    mNames[r] = binder.GetClassMethodName(ci, mi2)
                    if isStat
                    {
                        mFlags[r] = 0x96
                        mParamCounts[r] = binder.GetFunctionParamCount(fidx)
                        mSigs[r] = MethodSig(binder, fidx, true, 0)
                    }
                    else
                    {
                        mFlags[r] = 0x86
                        mParamCounts[r] = binder.GetFunctionParamCount(fidx) - 1
                        mSigs[r] = MethodSig(binder, fidx, false, 1)
                    }

                    let err2 = EmitBody(fidx, binder, emitter, rvaState, sigState,
                        mBodies, mMaxStacks, mRvas, mSigBlobs, mSigTokens, r)
                    if err2.Length > 0
                    {
                        return err2
                    }

                    mi2 = mi2 + 1
                }

                ci = ci + 1
            }

            // ---- 元数据计划 ----
            // AssemblyRef：System.Private.CoreLib（行 1）+ [System.Console（行 2，Console 成员用）]
            var asmRefCount = hasConsole ? 2 : 1
            var asmRefNames = new string[asmRefCount]
            var asmRefMajor = new i32[asmRefCount]
            var asmRefMinor = new i32[asmRefCount]
            var asmRefBuild = new i32[asmRefCount]
            var asmRefRev = new i32[asmRefCount]
            var asmRefFlags = new i32[asmRefCount]
            var asmRefPk = new string[asmRefCount]
            var asmRefCulture = new string[asmRefCount]
            asmRefNames[0] = "System.Private.CoreLib"
            asmRefMajor[0] = 9
            asmRefMinor[0] = 0
            asmRefBuild[0] = 0
            asmRefRev[0] = 0
            asmRefFlags[0] = 0
            asmRefPk[0] = "7cec85d7bea7798e"
            asmRefCulture[0] = ""
            if hasConsole
            {
                asmRefNames[1] = "System.Console"
                asmRefMajor[1] = 9
                asmRefMinor[1] = 0
                asmRefBuild[1] = 0
                asmRefRev[1] = 0
                asmRefFlags[1] = 0
                asmRefPk[1] = "7cec85d7bea7798e"
                asmRefCulture[1] = ""
            }

            // TypeRef：System.Object（1）+ DebuggableAttribute（2）+ [Console（3）] + [String] + [Int32]
            var typeRefScope = new i32[typeRefCount]
            var typeRefNs = new string[typeRefCount]
            var typeRefName = new string[typeRefCount]
            typeRefScope[0] = 1
            typeRefNs[0] = "System"
            typeRefName[0] = "Object"
            typeRefScope[1] = 1
            typeRefNs[1] = "System.Diagnostics"
            typeRefName[1] = "DebuggableAttribute"
            var typeRow = 2
            if hasConsole
            {
                typeRefScope[typeRow] = 2
                typeRefNs[typeRow] = "System"
                typeRefName[typeRow] = "Console"
                typeRow = typeRow + 1
            }

            if usesString
            {
                typeRefScope[typeRow] = 1
                typeRefNs[typeRow] = "System"
                typeRefName[typeRow] = "String"
                typeRow = typeRow + 1
            }

            if usesInt32
            {
                typeRefScope[typeRow] = 1
                typeRefNs[typeRow] = "System"
                typeRefName[typeRow] = "Int32"
                typeRow = typeRow + 1
            }

            if usesBool
            {
                typeRefScope[typeRow] = 1
                typeRefNs[typeRow] = "System"
                typeRefName[typeRow] = "Boolean"
                typeRow = typeRow + 1
            }

            if usesChar
            {
                typeRefScope[typeRow] = 1
                typeRefNs[typeRow] = "System"
                typeRefName[typeRow] = "Char"
                typeRow = typeRow + 1
            }

            if usesConvert[0]
            {
                typeRefScope[typeRow] = 1
                typeRefNs[typeRow] = "System"
                typeRefName[typeRow] = "Convert"
            }

            // MemberRef：DebuggableAttribute..ctor(bool,bool)（行 1）+ BCL 成员（行 2..）
            // + [Object::.ctor（末行，类存在时）；BclToken 行序不受影响]
            var memberRefCount = 1 + bclCount[0]
            if classCount > 0 { memberRefCount = memberRefCount + 1 }
            if usesConvert[0] { memberRefCount = memberRefCount + 1 }
            var memberRefParent = new i32[memberRefCount]
            var memberRefName = new string[memberRefCount]
            var memberRefSig = new string[memberRefCount]
            memberRefParent[0] = 2
            memberRefName[0] = ".ctor"
            var boolParams = new string[2]
            boolParams[0] = "bool"
            boolParams[1] = "bool"
            memberRefSig[0] = MetadataEncode.EncodeMethodSignatureHex("void", boolParams, 2, false)
            brm = 0
            while brm < bclCount[0]
            {
                // 实际 TypeRef 行：Console=3（若用）；String= hasConsole ? 4 : 3（无 Console 时前移）
                memberRefParent[1 + brm] = (bclParents[brm] == 4 && !hasConsole) ? 3 : bclParents[brm]
                memberRefName[1 + brm] = bclNames[brm]
                memberRefSig[1 + brm] = bclSigs[brm]
                brm = brm + 1
            }

            if classCount > 0
            {
                memberRefParent[1 + bclCount[0]] = 1
                memberRefName[1 + bclCount[0]] = ".ctor"
                memberRefSig[1 + bclCount[0]] = MetadataEncode.EncodeMethodSignatureHex("void", new string[0], 0, false)
            }

            if (usesConvert[0])
            {
                let objP = new string[1]
                objP[0] = "object"
                memberRefParent[convertMemberRow] = convertTypeRow
                memberRefName[convertMemberRow] = "ToString"
                memberRefSig[convertMemberRow] = MetadataEncode.EncodeMethodSignatureHex("string", objP, 1, true)
            }

            // #US 堆：种子 0 + 各字符串 Utf16Blob
            var usHex = "00"
            var us = 0
            while us < usCount[0]
            {
                usHex = usHex + MetadataEncode.UsBlobHex(usTexts[us])
                us = us + 1
            }

            var emptyInts = new i32[0]

            let builder = new IlMetadataBuilder("Min", "Min",
                typeRefScope, typeRefNs, typeRefName,
                memberRefParent, memberRefName, memberRefSig,
                mNames, mSigs, mRvas, mParamCounts, mFlags,
                asmRefNames, asmRefMajor, asmRefMinor, asmRefBuild, asmRefRev, asmRefFlags, asmRefPk, asmRefCulture,
                1, emptyInts, emptyInts, new string[0],
                "0102030405060708090a0b0c0d0e0f10", usHex,
                mSigBlobs,
                fieldNames, fieldSigs, fieldFlags,
                userTypeNames, userTypeFieldLists, userTypeMethodLists)
            let tables = builder.TablesHex()
            let strings = builder.StringsHex()
            let usStream = builder.UsHex()
            let guid = builder.GuidHex()
            let blob = builder.BlobHex()

            // ---- ManagedPeWriter ----
            let pe = ManagedPeWriter.Build("Min", mBodies, totalRows, mSigTokens, mMaxStacks,
                tables, strings, usStream, guid, blob, 0x06000000 + mainTop + 1)

            var hex = ""
            var b = 0
            while b < pe.Length
            {
                hex = hex + HexCodec.HexByte(pe[b])
                b = b + 1
            }

            return hex
        }

        /// <summary>发射单个方法体行（顶层静态/类实例共用）。rvaState/sigState 为 1 格状态单元
        /// （.co 数组传引用，标量状态改格内元素以持久化）。</summary>
        private static function EmitBody(
            fn: i32,
            binder: Binder,
            emitter: IlEmitter,
            rvaState: i32[], sigState: i32[],
            bodies: string[], maxStacks: i32[], rvas: i32[], sigBlobs: string[], sigTokens: i32[],
            row: i32): string
        {
            let asm = new IlAssembler()
            let paramCount = binder.GetFunctionParamCount(fn)
            let paramNames = new string[paramCount]
            var types = new string[paramCount + binder.GetFunctionLocalCount(fn)]
            var p = 0
            while p < paramCount
            {
                paramNames[p] = binder.GetFunctionParamName(fn, p)
                types[p] = binder.GetFunctionParamType(fn, p)
                p = p + 1
            }

            var lc = 0
            while lc < binder.GetFunctionLocalCount(fn)
            {
                types[paramCount + lc] = binder.GetFunctionLocalType(fn, lc)
                lc = lc + 1
            }

            emitter.SetVarTypes(types, types.Length)

            // 当前类裸方法表：同类裸调用（无 `this.`/类名）按其类解析；fn 非类方法 → 空表
            var cfn = -1
            var cfi = 0
            while cfi < binder.GetClassCount() && cfn < 0
            {
                var cfj = 0
                while cfj < binder.GetClassMethodCount(cfi)
                {
                    if binder.GetClassMethodIndex(cfi, cfj) == fn
                    {
                        cfn = cfi
                    }

                    cfj = cfj + 1
                }

                cfi = cfi + 1
            }

            if cfn >= 0
            {
                var csr = binder.GetTopLevelFunctionCount()
                var csl = 0
                while csl < cfn
                {
                    csr = csr + 1 + binder.GetClassMethodCount(csl)
                    csl = csl + 1
                }

                let mcnt = binder.GetClassMethodCount(cfn)
                var ck = new string[mcnt]
                var ct = new i32[mcnt]
                var ci2 = new bool[mcnt]
                var cr = new bool[mcnt]
                var cm4 = 0
                while cm4 < mcnt
                {
                    ck[cm4] = binder.GetClassMethodName(cfn, cm4)
                    ct[cm4] = 0x06000000 + csr + 2 + cm4
                    ci2[cm4] = !binder.GetClassMethodIsStatic(cfn, cm4)
                    cr[cm4] = binder.GetFunctionReturnType(binder.GetClassMethodIndex(cfn, cm4)) != "void"
                    cm4 = cm4 + 1
                }

                emitter.SetCurrentClassMethods(ck, ct, ci2, cr, mcnt)

                // 当前类字段表（名 → FieldDef token + 类型）
                var fstart = 0
                var fsl = 0
                while fsl < cfn
                {
                    fstart = fstart + binder.GetClassFieldCount(fsl)
                    fsl = fsl + 1
                }

                let fcnt = binder.GetClassFieldCount(cfn)
                var fk = new string[fcnt]
                var ft2 = new i32[fcnt]
                var fty = new string[fcnt]
                var fm4 = 0
                while fm4 < fcnt
                {
                    fk[fm4] = binder.GetClassFieldName(cfn, fm4)
                    ft2[fm4] = 0x04000001 + fstart + fm4
                    fty[fm4] = binder.GetClassFieldType(cfn, fm4)
                    fm4 = fm4 + 1
                }

                emitter.SetCurrentClassFields(fk, ft2, fty, fcnt)
            }
            else
            {
                emitter.SetCurrentClassMethods(new string[0], new i32[0], new bool[0], new bool[0], 0)
                emitter.SetCurrentClassFields(new string[0], new i32[0], new string[0], 0)
            }

            emitter.EmitFunction(asm, binder.GetFunctionBody(fn), paramNames, paramCount)
            if emitter.Error().Length > 0
            {
                var mstr = cfn >= 0 ? string(binder.GetClassMethodCount(cfn)) : "-1"
                return "ERR:[cfn=" + string(cfn) + ":m=" + mstr + "] " + emitter.Error()
            }

            bodies[row] = asm.Assemble()
            maxStacks[row] = asm.ComputeMaxStack()
            rvas[row] = rvaState[0]
            rvaState[0] = rvaState[0] + Align4(12 + bodies[row].Length / 2)

            let localCount = emitter.LocalCount()
            var blob = ""
            if localCount > 0
            {
                let localDescs = new string[localCount]
                var lq = 0
                while lq < localCount
                {
                    localDescs[lq] = LocalTypeForSig(binder, binder.GetFunctionLocalType(fn, lq))
                    lq = lq + 1
                }

                blob = MetadataEncode.EncodeLocalVarSignatureHex(localDescs, localCount)
                sigState[0] = sigState[0] + 1
                sigTokens[row] = 0x11000000 + sigState[0]
            }
            else
            {
                sigTokens[row] = 0
            }

            sigBlobs[row] = blob
            return ""
        }

        /// <summary>签名用类型描述：用户类名 → `class:<TypeDef行>:0`；`T[]` → `szarray:T`（递归）；其余原样。</summary>
        private static function LocalTypeForSig(binder: Binder, typeName: string): string
        {
            if typeName.IndexOf("[]") >= 0 && typeName.IndexOf("[]") == typeName.Length - 2
            {
                return "szarray:" + LocalTypeForSig(binder, typeName.substring(0, typeName.Length - 2))
            }

            var ci = 0
            while ci < binder.GetClassCount()
            {
                if binder.GetClassName(ci) == typeName
                {
                    // TypeDefOrRef coded：TypeDef tag = 0 → "class:<行>:0"
                    return "class:" + string(3 + ci) + ":0"
                }

                ci = ci + 1
            }

            return typeName
        }

        /// <summary>方法签名：isStatic → 静态 cconv；skipThis>0 → 去掉 param 0（`this`）转实例 HAS_THIS。</summary>
        private static function MethodSig(
            binder: Binder, fn: i32, isStatic: bool, skipThis: i32): string
        {
            let total = binder.GetFunctionParamCount(fn)
            let realCount = total - skipThis
            let params2 = new string[realCount]
            var k = skipThis
            var q = 0
            while q < realCount
            {
                params2[q] = LocalTypeForSig(binder, binder.GetFunctionParamType(fn, k))
                q = q + 1
                k = k + 1
            }

            return MetadataEncode.EncodeMethodSignatureHex(
                LocalTypeForSig(binder, binder.GetFunctionReturnType(fn)), params2, realCount, isStatic)
        }

        /// <summary>递归收集数组创建的元素类型（i32 → Int32 TypeRef；string → String TypeRef）。</summary>
        private static function ScanArrayElems(node: Node, needsInt32: bool[], needsStringArray: bool[], needsBool: bool[], needsChar: bool[], usesConvert: bool[],
            classElems: string[], classElemsCount: i32[]): void
        {
            if node.Kind() == "ArrayCreationExpression"
            {
                let elemType = node.Child(0).Text()
                if elemType == "i32"
                {
                    needsInt32[0] = true
                }
                else if elemType == "string"
                {
                    needsStringArray[0] = true
                }
                else if elemType == "bool"
                {
                    needsBool[0] = true
                }
                else if elemType == "char"
                {
                    needsChar[0] = true
                }
                else if elemType.Length > 0
                {
                    var found = false
                    var ce = 0
                    while ce < classElemsCount[0]
                    {
                        if classElems[ce] == elemType
                        {
                            found = true
                        }

                        ce = ce + 1
                    }

                    if !found && classElemsCount[0] < classElems.Length
                    {
                        classElems[classElemsCount[0]] = elemType
                        classElemsCount[0] = classElemsCount[0] + 1
                    }
                }
            }
            else if node.Kind() == "CallExpression"
            {
                if node.Child(0).Text() == "string"
                {
                    usesConvert[0] = true
                }
            }

            var c = 0
            while c < node.ChildCount()
            {
                if !node.Child(c).IsToken()
                {
                    ScanArrayElems(node.Child(c), needsInt32, needsStringArray, needsBool, needsChar, usesConvert,
                    classElems, classElemsCount)
                }

                c = c + 1
            }
        }

        /// <summary>递归收集：BCL 静态调用（Console.WriteLine(i32|string) + 字符串运算 ==/!=/+）+ 字符串字面量（去重）。</summary>
        private static function CollectNodes(
            node: Node,
            bclKeys: string[], bclTokens: i32[], bclParents: i32[], bclSigs: string[], bclNames: string[], bclCount: i32[],
            usTexts: string[], usTokens: i32[], usCount: i32[], usBytes: i32[]): void
        {
            let k = node.Kind()

            if k == "MemberCallExpression"
            {
                let targetName = node.Child(0).ChildCount() > 0 ? node.Child(0).Child(0).Text() : ""
                let methodName = node.Child(2).Text()
                if targetName == "Console" && methodName == "WriteLine"
                {
                    let argType = FirstArgType(node)
                    let argParams = new string[1]
                    argParams[0] = argType
                    EnsureBcl(bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                        "Console.WriteLine", 3, "WriteLine",
                        MetadataEncode.EncodeMethodSignatureHex("void", argParams, 1, true))
                }
                else if methodName == "substring"
                {
                    // s.substring(i) / s.substring(i, len) → String::Substring(int32[, int32])（实例）
                    let argc = ArgCountOf(node)
                    let sp = new string[argc]
                    var sq = 0
                    while sq < argc
                    {
                        sp[sq] = "i32"
                        sq = sq + 1
                    }

                    EnsureBcl(bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                        "String.substring" + string(argc), 4, "Substring",
                        MetadataEncode.EncodeMethodSignatureHex("string", sp, argc, false))
                }
                else if methodName == "IndexOf"
                {
                    // s.IndexOf(str) → String::IndexOf(string)（实例，返回 i32；语料以字符串实参为主）
                    let cp = new string[1]
                    let argType2 = FirstArgType(node)
                    cp[0] = argType2 == "i32" ? "char" : "string"
                    EnsureBcl(bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                        "String.IndexOf1", 4, "IndexOf",
                        MetadataEncode.EncodeMethodSignatureHex("i32", cp, 1, false))
                }
            }
            else if k == "BinaryExpression"
            {
                let op = node.Child(0).Text()
                if op == "==" || op == "!=" || op == "+"
                {
                    if IsStringLiteralNode(node.Child(1)) || IsStringLiteralNode(node.Child(2))
                    {
                        let stringParams = new string[2]
                        stringParams[0] = "string"
                        stringParams[1] = "string"
                        if op == "=="
                        {
                            EnsureBcl(bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                                "String.op_Equality", 4, "op_Equality",
                                MetadataEncode.EncodeMethodSignatureHex("bool", stringParams, 2, true))
                        }
                        else if op == "!="
                        {
                            EnsureBcl(bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                                "String.op_Inequality", 4, "op_Inequality",
                                MetadataEncode.EncodeMethodSignatureHex("bool", stringParams, 2, true))
                        }
                        else
                        {
                            EnsureBcl(bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                                "String.Concat", 4, "Concat",
                                MetadataEncode.EncodeMethodSignatureHex("string", stringParams, 2, true))
                        }
                    }
                }
            }
            else if k == "LiteralExpression"
            {
                if node.Child(0).Kind() == "StringToken"
                {
                    let text = StripQuotes(node.Child(0).Text())
                    var found = -1
                    var u = 0
                    while u < usCount[0]
                    {
                        if usTexts[u] == text
                        {
                            found = u
                        }

                        u = u + 1
                    }

                    if found < 0
                    {
                        usTexts[usCount[0]] = text
                        usTokens[usCount[0]] = 0x70000000 + usBytes[0]
                        usBytes[0] = usBytes[0] + MetadataEncode.UsBlobHex(text).Length / 2
                        usCount[0] = usCount[0] + 1
                    }
                }
            }

            var c = 0
            while c < node.ChildCount()
            {
                if !node.Child(c).IsToken()
                {
                    CollectNodes(node.Child(c), bclKeys, bclTokens, bclParents, bclSigs, bclNames, bclCount,
                        usTexts, usTokens, usCount, usBytes)
                }

                c = c + 1
            }
        }

        /// <summary>去重登记 BCL 成员：token = 0x0A000000 + 行号（行 = 登记序 + 1）。</summary>
        private static function EnsureBcl(
            bclKeys: string[], bclTokens: i32[], bclParents: i32[], bclSigs: string[], bclNames: string[], bclCount: i32[],
            key: string, parentRow: i32, memberName: string, sig: string): void
        {
            var i = 0
            while i < bclCount[0]
            {
                if bclKeys[i] == key
                {
                    return
                }

                i = i + 1
            }

            bclKeys[bclCount[0]] = key
            bclTokens[bclCount[0]] = 0x0A000000 + bclCount[0] + 2
            bclParents[bclCount[0]] = parentRow
            bclSigs[bclCount[0]] = sig
            bclNames[bclCount[0]] = memberName
            bclCount[0] = bclCount[0] + 1
        }

        /// <summary>MemberCall 实参数（跳过 `(`/`)` 等 token）。</summary>
        private static function ArgCountOf(node: Node): i32
        {
            var n = 0
            var a = 4
            while a < node.ChildCount() - 1
            {
                if !node.Child(a).IsToken()
                {
                    n = n + 1
                }

                a = a + 1
            }

            return n
        }

        /// <summary>BCL 调用首个实参类型：字符串字面量/字符串拼接 → string；其余 → i32。</summary>
        private static function FirstArgType(node: Node): string
        {
            var a = 4
            while a < node.ChildCount() - 1
            {
                if !node.Child(a).IsToken()
                {
                    let arg = node.Child(a)
                    if arg.Kind() == "LiteralExpression"
                    {
                        if arg.Child(0).Kind() == "StringToken"
                        {
                            return "string"
                        }

                        return "i32"
                    }

                    if arg.Kind() == "BinaryExpression"
                    {
                        let op = arg.Child(0).Text()
                        if op == "+" && (IsStringLiteralNode(arg.Child(1)) || IsStringLiteralNode(arg.Child(2)))
                        {
                            return "string"
                        }

                        return "i32"
                    }

                    return "i32"
                }

                a = a + 1
            }

            return "i32"
        }

        private static function IsStringLiteralNode(expr: Node): bool
        {
            if expr.Kind() == "LiteralExpression"
            {
                return expr.Child(0).Kind() == "StringToken"
            }

            return false
        }

        private static function StripQuotes(text: string): string
        {
            if text.Length >= 2
            {
                if i32(text[0]) == 34 && i32(text[text.Length - 1]) == 34
                {
                    return text.substring(1, text.Length - 2)
                }
            }

            return text
        }

        private static function Align4(value: i32): i32
        {
            return (value + 3) & ~3
        }
    }
}