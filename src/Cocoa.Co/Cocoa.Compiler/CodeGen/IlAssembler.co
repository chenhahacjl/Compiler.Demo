// Cocoa 自举 CodeGen · IL 编码器（Phase 2 重写）——
// 对齐 C# IlAssembler：Emit(name, operand, target) 模型，operandType 从操作码表派生。
// 两遍 Assemble（遍 1 逐指令偏移，遍 2 逐 OperandType 编码）+ 分支按其目标指令槽回填。
// 分支目标 = 指令槽索引（发射器 LabelStatement 登记真实指令槽 → 消灭预算估值偏差）。
// ComputeMaxStack：逐操作码净栈增量；Call/Callvirt/Newobj 用 SetCallDelta 覆盖。

namespace Cocoa.CodeGen
{
    class IlAssembler
    {
        private field _names: string[]
        private field _opTypes: i32[]
        private field _operands: i32[]
        private field _targets: i32[]
        private field _callDeltas: i32[]
        private field _count: i32

        public constructor()
        {
            _names = new string[16]
            _opTypes = new i32[16]
            _operands = new i32[16]
            _targets = new i32[16]
            _callDeltas = new i32[16]
            _count = 0
        }

        /// <summary>兼容旧名（差分驱动调用面）。</summary>
        public function Add(name: string, operandType: i32, operand: i32, targetIndex: i32): i32
        {
            return EmitOperand(name, operandType, operand, targetIndex)
        }

        /// <summary>附加 instruction（operandType 从表派生；branch 目标 = 目标指令槽索引，其余 -1）。</summary>
        public function EmitOperand(name: string, operandType: i32, operand: i32, targetIndex: i32): i32
        {
            if _count >= _names.Length
            {
                var nn = new string[_names.Length * 2]
                var no = new i32[_names.Length * 2]
                var nv = new i32[_names.Length * 2]
                var nt = new i32[_names.Length * 2]
                var nd = new i32[_names.Length * 2]
                var i = 0
                while i < _count
                {
                    nn[i] = _names[i]
                    no[i] = _opTypes[i]
                    nv[i] = _operands[i]
                    nt[i] = _targets[i]
                    nd[i] = _callDeltas[i]
                    i = i + 1
                }

                _names = nn
                _opTypes = no
                _operands = nv
                _targets = nt
                _callDeltas = nd
            }

            _names[_count] = name
            _opTypes[_count] = IlOpCodeTable.OpCodeOperandType(name)
            _operands[_count] = operand
            _targets[_count] = targetIndex
            let idx = _count
            _count = _count + 1
            return idx
        }

        /// <summary>回填分支指令的目标指令槽（标签延迟解析用）。</summary>
        public function SetTarget(index: i32, targetSlot: i32): void
        {
            _targets[index] = targetSlot
        }

        /// <summary>Call/Callvirt/Newobj 指令净栈增量，由发射器按目标设置。</summary>
        public function SetCallDelta(index: i32, delta: i32): void
        {
            _callDeltas[index] = delta
        }

        public function InstructionCount(): i32
        {
            return _count
        }

        /// <summary>线性扫描净栈增量峰值（Fat 头 MaxStack；Ret 后按 0 基线重算）。</summary>
        public function ComputeMaxStack(): i32
        {
            var max = 0
            var depth = 0
            var i = 0
            while i < _count
            {
                depth = depth + StackDelta(i, _names[i])
                if depth > max
                {
                    max = depth
                }

                if _names[i] == "Ret"
                {
                    depth = 0
                }

                i = i + 1
            }

            return max
        }

        /// <summary>单条指令净栈增量（发射子集；Call 用发射器登记的增量）。</summary>
        private function StackDelta(index: i32, name: string): i32
        {
            if name == "Ldc_I4" || name == "Ldc_I4_0" || name == "Ldc_I4_1" || name == "Ldarg" ||
               name == "Ldloc" || name == "Dup" || name == "Ldstr" || name == "Ldlen" ||
               name == "Ldc_I4_M1" || name == "Ldc_I4_2" || name == "Ldc_I4_3" || name == "Ldc_I4_4" ||
               name == "Ldc_I4_5" || name == "Ldc_I4_6" || name == "Ldc_I4_7" || name == "Ldc_I4_8" ||
               name == "Ldarg_0" || name == "Ldarg_1" || name == "Ldarg_2" || name == "Ldarg_3" ||
               name == "Ldloc_0" || name == "Ldloc_1" || name == "Ldloc_2" || name == "Ldloc_3"
            {
                return 1
            }

            if name == "Stloc" || name == "Stloc_0" || name == "Stloc_1" || name == "Stloc_2" || name == "Stloc_3" ||
               name == "Pop" || name == "Ret" || name == "Brtrue" || name == "Brfalse" || name == "Brtrue_S" || name == "Brfalse_S"
            {
                return -1
            }

            if name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Rem" ||
               name == "Ceq" || name == "Clt" || name == "Cgt" || name == "Neg" ||
               name == "And" || name == "Or" || name == "Xor" || name == "Shl" || name == "Shr" || name == "Shr_Un" ||
               name == "Div_Un" || name == "Rem_Un" || name == "Not"
            {
                return -1
            }

            if name == "Ldelem_I4" || name == "Ldelem_Ref" || name == "Ldelem_I1" || name == "Ldelem_U1" ||
               name == "Ldelem_I2" || name == "Ldelem_U2" || name == "Ldelem_I8" || name == "Ldelem_R4" || name == "Ldelem_R8"
            {
                return -1
            }

            if name == "Stelem_I4" || name == "Stelem_Ref" || name == "Stelem_I1" || name == "Stelem_I2" ||
               name == "Stelem_I8" || name == "Stelem_R4" || name == "Stelem_R8"
            {
                return -3
            }

            if name == "Call" || name == "Callvirt" || name == "Newobj"
            {
                return _callDeltas[index]
            }

            return 0
        }

        /// <summary>编码为小端十六进制字符串（分支按其目标指令槽偏移回填）。</summary>
        public function Assemble(): string
        {
            var offsets = new i32[_count]
            var total = 0
            var i = 0
            while i < _count
            {
                offsets[i] = total
                let v = IlOpCodeTable.OpCodeValue(_names[i])
                total = total + OpSize(v) + OpndSize(i, _names[i], _operands[i])
                i = i + 1
            }

            var sb = ""
            i = 0
            while i < _count
            {
                let v = IlOpCodeTable.OpCodeValue(_names[i])
                if v >= 0xFE00
                {
                    sb = sb + "fe" + HexCodec.HexByte(v & 0xFF)
                }
                else
                {
                    sb = sb + HexCodec.HexByte(v)
                }

                sb = EmitOperand(sb, i, _names[i], offsets)
                i = i + 1
            }

            return sb
        }

        private function OpSize(v: i32): i32
        {
            return v >= 0xFE00 ? 2 : 1
        }

        /// <summary>操作数字节尺寸（Switch 需计数）。</summary>
        private function OpndSize(index: i32, name: string, operand: i32): i32
        {
            let t = IlOpCodeTable.OpCodeOperandType(name)
            if t == 0 { return 0 }
            if t == 1 || t == 6 || t == 7 || t == 8 || t == 9 || t == 10 || t == 14 { return 4 }
            if t == 2 || t == 3 { return 8 }
            if t == 4 { return 4 }
            if t == 5 || t == 13 || t == 15 { return 1 }
            if t == 12 { return 2 }
            if t == 16 { return 4 + 4 * operand }
            return 4
        }

        private function EmitOperand(sb: string, index: i32, name: string, offsets: i32[]): string
        {
            let t = IlOpCodeTable.OpCodeOperandType(name)
            let v = IlOpCodeTable.OpCodeValue(name)
            let startOffset = offsets[index] + OpSize(v)
            if t == 1 || t == 7 || t == 8 || t == 9 || t == 6 || t == 10
            {
                if _operands[index] == 0 && (t == 6 || t == 7 || t == 8 || t == 9)
                {
                    return sb + "ffffffff"
                }

                return sb + HexCodec.HexI32(_operands[index])
            }

            if t == 12
            {
                return sb + HexCodec.HexI16(_operands[index])
            }

            if t == 13 || t == 5
            {
                return sb + HexCodec.HexByte(_operands[index])
            }

            if t == 2 || t == 3 || t == 4
            {
                return sb + HexCodec.HexI32(_operands[index]) + HexCodec.HexI32(0)
            }

            if t == 14
            {
                let dist = offsets[_targets[index]] - (startOffset + 4)
                return sb + HexCodec.HexI32(dist)
            }

            if t == 15
            {
                let dist = offsets[_targets[index]] - (startOffset + 1)
                return sb + HexCodec.HexByte(dist)
            }

            if t == 16
            {
                let count = _operands[index]
                let baseOffset = startOffset + 4 + 4 * count
                var s = sb + HexCodec.HexI32(count)
                var k = 0
                while k < count
                {
                    let dist = offsets[_targets[index] + k] - baseOffset
                    s = s + HexCodec.HexI32(dist)
                    k = k + 1
                }

                return s
            }

            return sb
        }
    }
}