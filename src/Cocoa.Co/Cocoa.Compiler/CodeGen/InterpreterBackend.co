?// Cocoa 自举 CodeGen · Interpreter 后端入口（阶。7 增量。M5-a1）—。// 自举 Binder 。Interpreter 装配（对。C# InterpreterBackend.Register 模式的自举侧形态）。
using Cocoa.CodeAnalysis.Binding

namespace Cocoa.CodeGen
{
    class InterpreterBackend
    {
        public static function FromBinder(binder: Binder): Interpreter
        {
            var interp = new Interpreter()
            var i = 0
            while i < binder.GetFunctionCount()
            {
                interp.BeginFunction(binder.GetFunctionName(i), binder.GetFunctionBody(i), binder.GetFunctionParamCount(i))
                var j = 0
                while j < binder.GetFunctionParamCount(i)
                {
                    interp.AddParamName(binder.GetFunctionParamName(i, j))
                    j = j + 1
                }

                i = i + 1
            }

            return interp
        }
    }
}
