namespace Cocoa.CodeAnalysis.Syntax
{
    class Node
    {
        private field _kind: string
        private field _text: string
        private field _isToken: bool
        private field _items: Node[]
        private field _count: i32

        public static function MakeToken(kind: string, text: string): Node
        {
            var n = new Node()
            n._kind = kind
            n._text = text
            n._isToken = true
            n._items = new Node[0]
            n._count = 0
            return n
        }

        public static function MakeCompound(kind: string): Node
        {
            var n = new Node()
            n._kind = kind
            n._text = ""
            n._isToken = false
            n._items = new Node[16]
            n._count = 0
            return n
        }

        public function Add(child: Node): void
        {
            if _count >= _items.Length
            {
                var bigger = new Node[_items.Length * 2]
                var i = 0
                while i < _count
                {
                    bigger[i] = _items[i]
                    i = i + 1
                }

                _items = bigger
            }

            _items[_count] = child
            _count = _count + 1
        }

        public function Kind(): string
        {
            return _kind
        }

        public function IsToken(): bool
        {
            return _isToken
        }

        public function Text(): string
        {
            return _text
        }

        public function ChildCount(): i32
        {
            return _count
        }

        public function Child(index: i32): Node
        {
            return _items[index]
        }

        public function Dump(): string
        {
            var sb = "(" + _kind
            if _isToken
            {
                return sb + " \"" + Escape(_text) + "\")"
            }

            if _count == 0
            {
                return sb + ")"
            }

            var i = 0
            while i < _count
            {
                sb = sb + " " + _items[i].Dump()
                i = i + 1
            }

            return sb + ")"
        }

        private static function Escape(text: string): string
        {
            var sb = ""
            var i = 0
            while i < text.Length
            {
                let c = text[i]
                if c == '\\'
                {
                    sb = sb + "\\\\"
                }
                else if c == '"'
                {
                    sb = sb + "\\\""
                }
                else if c == '\n'
                {
                    sb = sb + "\\n"
                }
                else if c == '\r'
                {
                    sb = sb + "\\r"
                }
                else if c == '\t'
                {
                    sb = sb + "\\t"
                }
                else
                {
                    sb = sb + string(c)
                }

                i = i + 1
            }

            return sb
        }
    }
}
