namespace Cocoa.CodeAnalysis.Syntax
{
    class Token
    {
        private field _kind: string
        private field _text: string
        private field _line: i32
        private field _col: i32
        private field _offset: i32

        public constructor()
        {
            _kind = "EOF"
            _text = ""
            _line = 0
            _col = 0
            _offset = 0
        }

        public static function Create(kind: string, text: string, line: i32, col: i32, offset: i32): Token
        {
            var t = new Token()
            t._kind = kind
            t._text = text
            t._line = line
            t._col = col
            t._offset = offset
            return t
        }

        public function Kind(): string
        {
            return _kind
        }

        public function Text(): string
        {
            return _text
        }

        public function Line(): i32
        {
            return _line
        }

        public function Column(): i32
        {
            return _col
        }

        public function Offset(): i32
        {
            return _offset
        }

        public function Describe(): string
        {
            return _kind + " " + _text + " " + string(_line) + ":" + string(_col)
        }

        /// <summary>差分协议：`KIND offset len line:col`（不含 text，规避 text 含换行的传输歧义）。</summary>
        public function DescribeDetail(): string
        {
            return _kind + " " + string(_offset) + " " + string(_text.Length) + " " + string(_line) + ":" + string(_col)
        }
    }
}
