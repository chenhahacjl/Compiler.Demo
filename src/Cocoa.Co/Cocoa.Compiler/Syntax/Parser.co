// Cocoa 自举 Parser —— 阶段 7 增量二（M8-a1）：
// Token 流（复用 MiniLexer）→ 递归下降 → 自举 Node 树，Dump() 与 C# ParserDifferentialTests.TreeDump
// 规范格式逐字节一致：token → `(Kind "text")`；复合 → `(Kind child1 child2 ...)`（trivia 不入 dump）。
// M8-a1 语法子集：顶层 function 声明（参数/返回类型/块体）、var/let 声明、return、表达式语句、
//   二元/一元/字面量/名字/调用/成员访问/lambda。
// 依赖：MiniLexer（Token/Lexer）、string 成员、System.Console。

using Cocoa.CodeAnalysis.Syntax

namespace Cocoa.CodeAnalysis.Syntax
{
    class Parser
    {
        private field _lex: Lexer
        private field _cur: Token
        private field _look: Token
        private field _look2: Token
        private field _look3: Token
        private field _diags: string[]
        private field _diagCount: i32

        public static function Create(source: string): Parser
        {
            var p = new Parser()
            p._lex = Lexer.Create(source)
            p._cur = p._lex.Next()
            p._look = p._lex.Next()
            p._look2 = p._lex.Next()
            p._look3 = p._lex.Next()
            p._diags = new string[16]
            p._diagCount = 0
            return p
        }

        /// <summary>推进一个 token（_cur 取 _look，_look 取 _look2，_look2 取 _look3，_look3 取新 token）。</summary>
        private function Advance(): void
        {
            _cur = _look
            _look = _look2
            _look2 = _look3
            _look3 = _lex.Next()
        }

        /// <summary>当前 token 的 SyntaxKind 名（对齐 C# SyntaxKind 配置名）。</summary>
        private function KindName(): string
        {
            return TokenKindName(_cur)
        }

        private function LookKindName(): string
        {
            return TokenKindName(_look)
        }

        private function Look2KindName(): string
        {
            return TokenKindName(_look2)
        }

        private function Look3KindName(): string
        {
            return TokenKindName(_look3)
        }

        private function Text(): string
        {
            return _cur.Text()
        }

        private function Match(kind: string): Node
        {
            if KindName() != kind
            {
                ReportError("error: L" + string(_cur.Line()) + ":C" + string(_cur.Column()) +
                    " expected " + kind + ", found " + KindName() + " \"" + _cur.Text() + "\"")
            }

            let node = Node.MakeToken(kind, _cur.Text())
            Advance()
            return node
        }

        /// <summary>记录语法错误（自举侧诊断面：消息文本不与 C# 逐字对齐，仅要求无效程序非空可报告）。</summary>
        private function ReportError(message: string): void
        {
            if _diagCount >= _diags.Length
            {
                var bigger = new string[_diags.Length * 2]
                var i = 0
                while i < _diagCount
                {
                    bigger[i] = _diags[i]
                    i = i + 1
                }

                _diags = bigger
            }

            _diags[_diagCount] = message
            _diagCount = _diagCount + 1
        }

        /// <summary>诊断条数（差分测试经此断言无效程序双方言同报错；有效程序必须为 0）。</summary>
        public function DiagnosticCount(): i32
        {
            return _diagCount
        }

        public function DiagnosticAt(index: i32): string
        {
            return _diags[index]
        }

        /// <summary>当前是否关键字 kind（仅用于语句/成员分派）。</summary>
        private function IsKeywordText(text: string): bool
        {
            return _cur.Kind() == "Keyword" && _cur.Text() == text
        }

        public function ParseCompilationUnit(): Node
        {
            let root = Node.MakeCompound("CompilationUnit")
            while _cur.Kind() != "EOF"
            {
                root.Add(ParseMember())
            }

            root.Add(Node.MakeToken("EndOfFileToken", ""))
            return root
        }

        private function ParseMember(): Node
        {
            if IsKeywordText("using")
            {
                return ParseUsingDirective()
            }

            if IsKeywordText("namespace")
            {
                return ParseNamespaceDeclaration()
            }

            let attrs = ParseOptionalAttributeList()

            let mods = new Node[8]
            var modCount = 0
            while IsModifier()
            {
                mods[modCount] = Match(KindName())
                modCount = modCount + 1
            }

            if IsKeywordText("class") || IsKeywordText("struct")
            {
                return ParseClassDeclaration(attrs, mods, modCount)
            }

            if IsKeywordText("interface")
            {
                return ParseInterfaceDeclaration(mods, modCount)
            }

            if IsKeywordText("enum")
            {
                return ParseEnumDeclaration(attrs, mods, modCount)
            }

            if IsKeywordText("function")
            {
                return ParseFunctionDeclaration(attrs, mods, modCount)
            }

            if IsKeywordText("field") || IsKeywordText("property") || IsKeywordText("constructor")
            {
                return ParseClassMemberCore(attrs, mods, modCount)
            }

            let stmt = ParseStatement()
            let gs = Node.MakeCompound("GlobalStatement")
            gs.Add(stmt)
            return gs
        }

        private function IsModifier(): bool
        {
            let k = KindName()
            return k == "PublicKeyword" || k == "PrivateKeyword" || k == "InternalKeyword" ||
                k == "ProtectedKeyword" || k == "StaticKeyword" || k == "ReadonlyKeyword" ||
                k == "SealedKeyword" || k == "VirtualKeyword" || k == "OverrideKeyword" ||
                k == "AbstractKeyword" || k == "PartialKeyword" ||
                k == "CdeclKeyword" || k == "StdcallKeyword" || k == "SyscallKeyword"
        }

        /// <summary>命名空间声明：`namespace A.B { members }`（名 token 含点号，成员递归 ParseMember）。</summary>
        private function ParseNamespaceDeclaration(): Node
        {
            let node = Node.MakeCompound("NamespaceDeclaration")
            node.Add(Match("NamespaceKeyword"))
            node.Add(Match("IdentifierToken"))
            while KindName() == "DotToken"
            {
                node.Add(Match("DotToken"))
                node.Add(Match("IdentifierToken"))
            }

            node.Add(Match("OpenBraceToken"))
            while KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
            {
                node.Add(ParseMember())
            }

            node.Add(Match("CloseBraceToken"))
            return node
        }

        /// <summary>枚举声明：`enum E { A, B = 5 }`（成员以逗号分隔，逗号入 dump）。</summary>
        private function ParseEnumDeclaration(attrs: Node, mods: Node[], modCount: i32): Node
        {
            let node = Node.MakeCompound("EnumDeclaration")
            if attrs.ChildCount() > 0
            {
                node.Add(attrs)
            }

            var i = 0
            while i < modCount
            {
                node.Add(mods[i])
                i = i + 1
            }

            node.Add(Match("EnumKeyword"))
            node.Add(Match("IdentifierToken"))
            node.Add(Match("OpenBraceToken"))
            while KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
            {
                let member = Node.MakeCompound("EnumMember")
                member.Add(Match("IdentifierToken"))
                if KindName() == "EqualsToken"
                {
                    member.Add(Match("EqualsToken"))
                    member.Add(ParseExpression())
                }

                node.Add(member)
                if KindName() == "CommaToken"
                {
                    node.Add(Match("CommaToken"))
                }
                else
                {
                    break
                }
            }

            node.Add(Match("CloseBraceToken"))
            return node
        }

        private function ParseClassDeclaration(attrs: Node, mods: Node[], modCount: i32): Node
        {
            let cls = Node.MakeCompound("ClassDeclaration")
            if attrs.ChildCount() > 0
            {
                cls.Add(attrs)
            }

            var mi = 0
            while mi < modCount
            {
                cls.Add(mods[mi])
                mi = mi + 1
            }

            if IsKeywordText("class")
            {
                cls.Add(Match("ClassKeyword"))
            }
            else
            {
                cls.Add(Match("StructKeyword"))
            }

            cls.Add(Match("IdentifierToken"))

            if KindName() == "ExtendsKeyword"
            {
                let first = Node.MakeCompound("TypeClause")
                first.Add(Match("ExtendsKeyword"))
                first.Add(Match("IdentifierToken"))
                cls.Add(first)

                while KindName() == "CommaToken"
                {
                    Advance() // 消费逗号（C# 侧合成空文本 ColonToken）
                    let next = Node.MakeCompound("TypeClause")
                    next.Add(Node.MakeToken("ColonToken", ""))
                    next.Add(Match("IdentifierToken"))
                    cls.Add(next)
                }
            }

            cls.Add(Match("OpenBraceToken"))
            while KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
            {
                cls.Add(ParseClassMember())
            }

            cls.Add(Match("CloseBraceToken"))
            return cls
        }

        private function ParseInterfaceDeclaration(mods: Node[], modCount: i32): Node
        {
            let iface = Node.MakeCompound("InterfaceDeclaration")
            var mi = 0
            while mi < modCount
            {
                iface.Add(mods[mi])
                mi = mi + 1
            }

            iface.Add(Match("InterfaceKeyword"))
            iface.Add(Match("IdentifierToken"))
            iface.Add(Match("OpenBraceToken"))
            while KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
            {
                iface.Add(ParseClassMember())
            }

            iface.Add(Match("CloseBraceToken"))
            return iface
        }

        private function ParseUsingDirective(): Node
        {
            let node = Node.MakeCompound("UsingDirective")
            node.Add(Match("UsingKeyword"))
            node.Add(Match("IdentifierToken"))
            while KindName() == "DotToken"
            {
                node.Add(Match("DotToken"))
                node.Add(Match("IdentifierToken"))
            }

            return node
        }

        private function ParseClassMember(): Node
        {
            if IsKeywordText("import")
            {
                return ParseImportBlock()
            }

            let attrs = ParseOptionalAttributeList()

            let mods = new Node[8]
            var modCount = 0
            while IsModifier()
            {
                mods[modCount] = Match(KindName())
                modCount = modCount + 1
            }

            if IsKeywordText("function")
            {
                return ParseFunctionDeclaration(attrs, mods, modCount)
            }

            return ParseClassMemberCore(attrs, mods, modCount)
        }

        /// <summary>6e-M32 Tier-2：声明前 attribute 列表（`[Name(...)]`/`[Name]`，可多个）。节点形如
        /// (AttributeList (Attribute name (arg...)) ...)，实参为字面量 token。</summary>
        private function ParseOptionalAttributeList(): Node
        {
            let list = Node.MakeCompound("AttributeList")
            while KindName() == "OpenBracketToken"
            {
                Match("OpenBracketToken")
                let attr = Node.MakeCompound("Attribute")
                attr.Add(Match("IdentifierToken"))
                if KindName() == "OpenParenthesisToken"
                {
                    Match("OpenParenthesisToken")
                    while KindName() != "CloseParenthesisToken" && _cur.Kind() != "EOF"
                    {
                        let k = KindName()
                        if k == "StringToken" || k == "NumberToken" || k == "TrueKeyword" ||
                            k == "FalseKeyword" || k == "CharToken"
                        {
                            attr.Add(Match(k))
                        }
                        else
                        {
                            Advance()
                        }

                        if KindName() == "CommaToken"
                        {
                            attr.Add(Match("CommaToken"))
                        }
                        else
                        {
                            break
                        }
                    }

                    Match("CloseParenthesisToken")
                }

                Match("CloseBracketToken")
                list.Add(attr)
            }

            return list
        }

        /// <summary>类内 import 块：`import kernel32.dll { static stdcall function ... }`（DLL 名 token 含点号）。</summary>
        private function ParseImportBlock(): Node
        {
            let node = Node.MakeCompound("ImportBlock")
            node.Add(Match("ImportKeyword"))
            node.Add(Match("IdentifierToken"))
            while KindName() == "DotToken"
            {
                node.Add(Match("DotToken"))
                node.Add(Match("IdentifierToken"))
            }

            node.Add(Match("OpenBraceToken"))
            while KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
            {
                node.Add(ParseClassMember())
            }

            node.Add(Match("CloseBraceToken"))
            return node
        }

        private function ParseClassMemberCore(attrs: Node, mods: Node[], modCount: i32): Node
        {
            if IsKeywordText("field")
            {
                Advance() // field 关键字不入节点（C# 侧）
                let f = Node.MakeCompound("ClassFieldDeclaration")
                if attrs.ChildCount() > 0
                {
                    f.Add(attrs)
                }

                var i = 0
                while i < modCount
                {
                    f.Add(mods[i])
                    i = i + 1
                }

                f.Add(Match("IdentifierToken"))
                if KindName() == "ColonToken"
                {
                    f.Add(ParseTypeClause())
                }

                if KindName() == "EqualsToken"
                {
                    f.Add(Match("EqualsToken"))
                    f.Add(ParseExpression())
                }

                return f
            }

            if IsKeywordText("property")
            {
                let p = Node.MakeCompound("PropertyDeclaration")
                if attrs.ChildCount() > 0
                {
                    p.Add(attrs)
                }

                var i = 0
                while i < modCount
                {
                    p.Add(mods[i])
                    i = i + 1
                }

                p.Add(Match("PropertyKeyword"))
                p.Add(Match("IdentifierToken"))
                if KindName() == "ColonToken"
                {
                    p.Add(ParseTypeClause())
                }

                p.Add(Match("OpenBraceToken"))
                while KindName() == "GetKeyword" || KindName() == "SetKeyword"
                {
                    let acc = Node.MakeCompound("PropertyAccessor")
                    acc.Add(Match(KindName()))
                    p.Add(acc)
                }

                p.Add(Match("CloseBraceToken"))
                if KindName() == "EqualsToken"
                {
                    p.Add(Match("EqualsToken"))
                    p.Add(ParseExpression())
                }

                return p
            }

            if IsKeywordText("constructor")
            {
                let c = Node.MakeCompound("ConstructorDeclaration")
                if attrs.ChildCount() > 0
                {
                    c.Add(attrs)
                }

                var i = 0
                while i < modCount
                {
                    c.Add(mods[i])
                    i = i + 1
                }

                c.Add(Match("ConstructorKeyword"))
                c.Add(Match("OpenParenthesisToken"))
                if KindName() != "CloseParenthesisToken"
                {
                    c.Add(ParseParameter())
                    while KindName() == "CommaToken"
                    {
                        c.Add(Match("CommaToken"))
                        c.Add(ParseParameter())
                    }
                }

                c.Add(Match("CloseParenthesisToken"))
                if KindName() == "OpenBraceToken"
                {
                    c.Add(ParseBlockStatement())
                }

                return c
            }

            // 兜底：按语句解析（GlobalStatement 由调用方决定）
            return ParseStatement()
        }

        private function ParseFunctionDeclaration(attrs: Node, mods: Node[], modCount: i32): Node
        {
            let fn = Node.MakeCompound("FunctionDeclaration")
            if attrs.ChildCount() > 0
            {
                fn.Add(attrs)
            }

            var mi = 0
            while mi < modCount
            {
                fn.Add(mods[mi])
                mi = mi + 1
            }

            fn.Add(Match("FunctionKeyword"))
            fn.Add(Match("IdentifierToken"))
            fn.Add(Match("OpenParenthesisToken"))

            if KindName() != "CloseParenthesisToken"
            {
                fn.Add(ParseParameter())
                while KindName() == "CommaToken"
                {
                    fn.Add(Match("CommaToken"))
                    fn.Add(ParseParameter())
                }
            }

            fn.Add(Match("CloseParenthesisToken"))

            if KindName() == "ColonToken"
            {
                fn.Add(ParseTypeClause())
            }

            if KindName() == "OpenBraceToken"
            {
                fn.Add(ParseBlockStatement())
            }

            return fn
        }

        private function ParseParameter(): Node
        {
            let p = Node.MakeCompound("Parameter")
            if KindName() == "OutKeyword" || KindName() == "RefKeyword"
            {
                p.Add(Match(KindName()))
            }

            p.Add(Match("IdentifierToken"))
            if KindName() == "ColonToken"
            {
                p.Add(ParseTypeClause())
            }

            return p
        }

        private function ParseTypeClause(): Node
        {
            let colon = Match("ColonToken")
            let name = Match("IdentifierToken")
            if KindName() == "LessToken"
            {
                let gt = Node.MakeCompound("GenericTypeClause")
                gt.Add(colon)
                gt.Add(name)
                gt.Add(Match("LessToken"))
                let arg = Node.MakeCompound("TypeClause")
                arg.Add(Match("IdentifierToken"))
                gt.Add(arg)
                gt.Add(Match("GreaterToken"))
                return gt
            }

            let tc = Node.MakeCompound("TypeClause")
            tc.Add(colon)
            tc.Add(name)
            if KindName() == "OpenBracketToken"
            {
                let atc = Node.MakeCompound("ArrayTypeClause")
                atc.Add(colon)
                atc.Add(name)
                atc.Add(tc)
                atc.Add(Match("OpenBracketToken"))
                atc.Add(Match("CloseBracketToken"))
                return atc
            }

            return tc
        }

        private function ParseBlockStatement(): Node
        {
            let block = Node.MakeCompound("BlockStatement")
            block.Add(Match("OpenBraceToken"))
            while KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
            {
                block.Add(ParseStatement())
            }

            block.Add(Match("CloseBraceToken"))
            return block
        }

        private function ParseStatement(): Node
        {
            if KindName() == "OpenBraceToken"
            {
                return ParseBlockStatement()
            }

            if IsKeywordText("var") || IsKeywordText("let")
            {
                return ParseVariableDeclaration()
            }

            if IsKeywordText("return")
            {
                let ret = Node.MakeCompound("ReturnStatement")
                ret.Add(Match("ReturnKeyword"))
                if KindName() != "CloseBraceToken" && _cur.Kind() != "EOF"
                {
                    ret.Add(ParseExpression())
                }

                return ret
            }

            if IsKeywordText("if")
            {
                return ParseIfStatement()
            }

            if IsKeywordText("while")
            {
                return ParseWhileStatement()
            }

            if IsKeywordText("do")
            {
                return ParseDoWhileStatement()
            }

            if IsKeywordText("for")
            {
                if LookKindName() == "OpenParenthesisToken"
                {
                    return ParseForStatement()
                }

                return ParseForRangeStatement()
            }

            if IsKeywordText("try")
            {
                return ParseTryStatement()
            }

            if IsKeywordText("foreach")
            {
                return ParseForeachStatement()
            }

            if IsKeywordText("break")
            {
                let b = Node.MakeCompound("BreakStatement")
                b.Add(Match("BreakKeyword"))
                return b
            }

            if IsKeywordText("continue")
            {
                let c = Node.MakeCompound("ContinueStatement")
                c.Add(Match("ContinueKeyword"))
                return c
            }

            let es = Node.MakeCompound("ExpressionStatement")
            es.Add(ParseExpression())
            return es
        }

        private function ParseIfStatement(): Node
        {
            let node = Node.MakeCompound("IfStatement")
            node.Add(Match("IfKeyword"))
            node.Add(ParseExpression())
            node.Add(ParseStatement())
            if IsKeywordText("else")
            {
                let ec = Node.MakeCompound("ElseClause")
                ec.Add(Match("ElseKeyword"))
                ec.Add(ParseStatement())
                node.Add(ec)
            }

            return node
        }

        private function ParseWhileStatement(): Node
        {
            let node = Node.MakeCompound("WhileStatement")
            node.Add(Match("WhileKeyword"))
            node.Add(ParseExpression())
            node.Add(ParseStatement())
            return node
        }

        private function ParseDoWhileStatement(): Node
        {
            let node = Node.MakeCompound("DoWhileStatement")
            node.Add(Match("DoKeyword"))
            node.Add(ParseStatement())
            node.Add(Match("WhileKeyword"))
            node.Add(ParseExpression())
            return node
        }

        private function ParseTryStatement(): Node
        {
            let node = Node.MakeCompound("TryStatement")
            node.Add(Match("TryKeyword"))
            node.Add(ParseBlockStatement())
            while IsKeywordText("catch")
            {
                let cc = Node.MakeCompound("CatchClause")
                cc.Add(Match("CatchKeyword"))
                cc.Add(Match("IdentifierToken"))
                if KindName() == "ColonToken"
                {
                    cc.Add(ParseTypeClause())
                }

                cc.Add(ParseBlockStatement())
                node.Add(cc)
            }

            if IsKeywordText("finally")
            {
                let fc = Node.MakeCompound("FinallyClause")
                fc.Add(Match("FinallyKeyword"))
                fc.Add(ParseBlockStatement())
                node.Add(fc)
            }

            return node
        }

        private function ParseForeachStatement(): Node
        {
            let node = Node.MakeCompound("ForeachStatement")
            node.Add(Match("ForeachKeyword"))
            node.Add(Match("OpenParenthesisToken"))
            if IsKeywordText("var")
            {
                node.Add(Match("VarKeyword"))
            }
            else
            {
                node.Add(Match("LetKeyword"))
            }

            node.Add(Match("IdentifierToken"))
            node.Add(Match("InKeyword"))
            node.Add(ParseExpression())
            node.Add(Match("CloseParenthesisToken"))
            node.Add(ParseStatement())
            return node
        }

        private function ParseForStatement(): Node
        {
            let node = Node.MakeCompound("ForStatement")
            node.Add(Match("ForKeyword"))
            node.Add(Match("OpenParenthesisToken"))
            if KindName() != "SemicolonToken"
            {
                node.Add(ParseStatement())
            }

            node.Add(Match("SemicolonToken"))
            if KindName() != "SemicolonToken"
            {
                node.Add(ParseExpression())
            }

            node.Add(Match("SemicolonToken"))
            if KindName() != "CloseParenthesisToken"
            {
                node.Add(ParseExpression())
            }

            node.Add(Match("CloseParenthesisToken"))
            node.Add(ParseStatement())
            return node
        }

        private function ParseForRangeStatement(): Node
        {
            let node = Node.MakeCompound("ForRangeStatement")
            node.Add(Match("ForKeyword"))
            if IsKeywordText("var")
            {
                node.Add(Match("VarKeyword"))
            }
            else if IsKeywordText("let")
            {
                node.Add(Match("LetKeyword"))
            }

            node.Add(Match("IdentifierToken"))
            node.Add(Match("EqualsToken"))
            node.Add(ParseExpression())
            node.Add(Match("ToKeyword"))
            node.Add(ParseExpression())
            if IsKeywordText("step")
            {
                node.Add(Match("StepKeyword"))
                node.Add(ParseExpression())
            }

            node.Add(ParseStatement())
            return node
        }

        private function ParseVariableDeclaration(): Node
        {
            let vd = Node.MakeCompound("VariableDeclaration")
            if IsKeywordText("var")
            {
                vd.Add(Match("VarKeyword"))
            }
            else
            {
                vd.Add(Match("LetKeyword"))
            }

            vd.Add(Match("IdentifierToken"))
            if KindName() == "ColonToken"
            {
                vd.Add(ParseTypeClause())
            }

            if KindName() == "EqualsToken"
            {
                vd.Add(Match("EqualsToken"))
                vd.Add(ParseExpression())
            }

            return vd
        }

        // ────────── 表达式（precedence climbing）──────────

        private function ParseExpression(): Node
        {
            let left = ParseBinary(0)
            if KindName() == "EqualsToken"
            {
                let asgn = Node.MakeCompound("AssignmentExpression")
                asgn.Add(left)
                asgn.Add(Match("EqualsToken"))
                asgn.Add(ParseExpression())
                return asgn
            }

            return left
        }

        private function BinaryPrecedence(): i32
        {
            let k = KindName()
            if k == "StarToken" || k == "SlashToken" || k == "PercentToken"
            {
                return 5
            }

            if k == "PlusToken" || k == "MinusToken" || k == "ShiftLeftToken" || k == "ShiftRightToken"
            {
                return 4
            }

            if k == "EqualsEqualsToken" || k == "BangEqualsToken" || k == "LessToken" ||
                k == "LessOrEqualsToken" || k == "GreaterToken" || k == "GreaterOrEqualsToken" ||
                k == "IsKeyword" || k == "AsKeyword"
            {
                return 3
            }

            if k == "AmpersandToken" || k == "AmpersandAmpersandToken" || k == "QuestionQuestionToken"
            {
                return 2
            }

            if k == "PipeToken" || k == "PipePipeToken" || k == "HatToken"
            {
                return 1
            }

            return 0
        }

        private function ParseBinary(parentPrec: i32): Node
        {
            var left = ParseUnary()
            while true
            {
                let prec = BinaryPrecedence()
                if prec <= parentPrec
                {
                    break
                }

                let opKind = KindName()
                let op = Node.MakeToken(opKind, _cur.Text())
                Advance()
                if opKind == "IsKeyword" || opKind == "AsKeyword"
                {
                    // is/as 右侧为裸类型标识符
                    let typeNode = Node.MakeCompound(opKind == "IsKeyword" ? "IsExpression" : "AsExpression")
                    typeNode.Add(left)
                    typeNode.Add(op)
                    typeNode.Add(Match("IdentifierToken"))
                    left = typeNode
                }
                else
                {
                    let right = ParseBinary(prec)
                    let bin = Node.MakeCompound("BinaryExpression")
                    bin.Add(left)
                    bin.Add(op)
                    bin.Add(right)
                    left = bin
                }
            }

            return left
        }

        private function IsUnaryOperator(): bool
        {
            let k = KindName()
            return k == "PlusToken" || k == "MinusToken" || k == "BangToken" ||
                k == "TildeToken" || k == "HatToken" || k == "PlusPlusToken" || k == "MinusMinusToken"
        }

        private function ParseUnary(): Node
        {
            if IsUnaryOperator()
            {
                let opKind = KindName()
                let op = Node.MakeToken(opKind, _cur.Text())
                Advance()
                let operand = ParseUnary()
                let un = Node.MakeCompound("UnaryExpression")
                un.Add(op)
                un.Add(operand)
                return un
            }

            return ParsePrimary()
        }

        private function ParsePrimary(): Node
        {
            let k = KindName()
            if k == "NumberToken" || k == "DoubleToken" || k == "StringToken" || k == "VerbatimStringToken" ||
                k == "RawStringToken" || k == "InterpolatedStringToken" || k == "CharToken"
            {
                let lit = Node.MakeCompound("LiteralExpression")
                lit.Add(Match(k))
                return lit
            }

            if IsKeywordText("true") || IsKeywordText("false") || IsKeywordText("null")
            {
                let lit = Node.MakeCompound("LiteralExpression")
                lit.Add(Match(KindName()))
                return lit
            }

            if KindName() == "IdentifierToken"
            {
                return ParseIdentifierPostfix()
            }

            if KindName() == "OpenParenthesisToken"
            {
                return ParseParenthesizedOrLambda()
            }

            if IsKeywordText("new")
            {
                return ParseNewExpression()
            }

            // 兜底：单 token 原样消费（非表达式起始 token → 报告后继续错误恢复）
            ReportError("error: L" + string(_cur.Line()) + ":C" + string(_cur.Column()) +
                " unexpected token " + k + " \"" + _cur.Text() + "\"")
            let any = Node.MakeToken(k, _cur.Text())
            Advance()
            return any
        }

        private function ParseNewExpression(): Node
        {
            let newTok = Match("NewKeyword")
            let name = Match("IdentifierToken")

            if KindName() == "OpenBracketToken"
            {
                // 数组创建 `new T[...] {...}`
                let node = Node.MakeCompound("ArrayCreationExpression")
                node.Add(newTok)
                node.Add(name)
                node.Add(Match("OpenBracketToken"))
                if KindName() != "CloseBracketToken"
                {
                    node.Add(ParseExpression())
                }

                node.Add(Match("CloseBracketToken"))
                if KindName() == "OpenBraceToken"
                {
                    node.Add(Match("OpenBraceToken"))
                    if KindName() != "CloseBraceToken"
                    {
                        node.Add(ParseExpression())
                        while KindName() == "CommaToken"
                        {
                            node.Add(Match("CommaToken"))
                            node.Add(ParseExpression())
                        }
                    }

                    node.Add(Match("CloseBraceToken"))
                }

                return node
            }

            // 对象创建 `new T()` / `new T<...>(...)`
            let node = Node.MakeCompound("ObjectCreationExpression")
            node.Add(newTok)
            node.Add(name)
            if KindName() == "LessToken"
            {
                let tal = Node.MakeCompound("TypeArgumentList")
                tal.Add(Match("LessToken"))
                let arg = Node.MakeCompound("TypeClause")
                arg.Add(Match("IdentifierToken"))
                tal.Add(arg)
                tal.Add(Match("GreaterToken"))
                node.Add(tal)
            }

            node.Add(Match("OpenParenthesisToken"))
            if KindName() != "CloseParenthesisToken"
            {
                node.Add(ParseExpression())
                while KindName() == "CommaToken"
                {
                    node.Add(Match("CommaToken"))
                    node.Add(ParseExpression())
                }
            }

            node.Add(Match("CloseParenthesisToken"))
            return node
        }

        private function ParseIdentifierPostfix(): Node
        {
            let ident = Match("IdentifierToken")
            var result: Node
            if KindName() == "OpenParenthesisToken"
            {
                // 基调用：CallExpression 首子为 IdentifierToken（C# 语义）
                let call = Node.MakeCompound("CallExpression")
                call.Add(ident)
                call.Add(Match("OpenParenthesisToken"))
                if KindName() != "CloseParenthesisToken"
                {
                    call.Add(ParseExpression())
                    while KindName() == "CommaToken"
                    {
                        call.Add(Match("CommaToken"))
                        call.Add(ParseExpression())
                    }
                }

                call.Add(Match("CloseParenthesisToken"))
                result = call
            }
            else
            {
                let name = Node.MakeCompound("NameExpression")
                name.Add(ident)
                result = name
            }

            // 后缀链（左结合）：`.成员` / `.成员(...)` / `[...]`，receiver 即累积结果
            while true
            {
                if KindName() == "DotToken"
                {
                    let dot = Match("DotToken")
                    let member = Match("IdentifierToken")
                    if KindName() == "OpenParenthesisToken"
                    {
                        let mcall = Node.MakeCompound("MemberCallExpression")
                        mcall.Add(result)
                        mcall.Add(dot)
                        mcall.Add(member)
                        mcall.Add(Match("OpenParenthesisToken"))
                        if KindName() != "CloseParenthesisToken"
                        {
                            mcall.Add(ParseExpression())
                            while KindName() == "CommaToken"
                            {
                                mcall.Add(Match("CommaToken"))
                                mcall.Add(ParseExpression())
                            }
                        }

                        mcall.Add(Match("CloseParenthesisToken"))
                        result = mcall
                    }
                    else
                    {
                        let ma = Node.MakeCompound("MemberAccessExpression")
                        ma.Add(result)
                        ma.Add(dot)
                        ma.Add(member)
                        result = ma
                    }
                }
                else if KindName() == "OpenBracketToken"
                {
                    let ea = Node.MakeCompound("ElementAccessExpression")
                    ea.Add(result)
                    ea.Add(Match("OpenBracketToken"))
                    if KindName() != "CloseBracketToken"
                    {
                        ea.Add(ParseExpression())
                        while KindName() == "CommaToken"
                        {
                            ea.Add(Match("CommaToken"))
                            ea.Add(ParseExpression())
                        }
                    }

                    ea.Add(Match("CloseBracketToken"))
                    result = ea
                }
                else
                {
                    break
                }
            }

            if KindName() == "PlusPlusToken" || KindName() == "MinusMinusToken"
            {
                let isPlus = KindName() == "PlusPlusToken"
                let post = Node.MakeCompound(isPlus ? "PostfixIncrementExpression" : "PostfixDecrementExpression")
                post.Add(result)
                post.Add(Match(KindName()))
                return post
            }

            return result
        }

        private function ParseParenthesizedOrLambda(): Node
        {
            // lambda 判别（三 token 前瞻）：`(` 后为 `)`（空参）或 `标识符 :`（类型标注参数）
            var isLambda = LookKindName() == "CloseParenthesisToken"
            if LookKindName() == "IdentifierToken" && Look2KindName() == "ColonToken"
            {
                isLambda = true
            }

            if isLambda
            {
                return ParseLambda()
            }

            // cast 判别：`( 类型 )` 后跟表达式起始 token
            if IsCastStart()
            {
                return ParseCastExpression()
            }

            let paren = Node.MakeCompound("ParenthesizedExpression")
            paren.Add(Match("OpenParenthesisToken"))
            paren.Add(ParseExpression())
            paren.Add(Match("CloseParenthesisToken"))
            return paren
        }

        private function IsCastStart(): bool
        {
            if LookKindName() != "IdentifierToken" || Look2KindName() != "CloseParenthesisToken"
            {
                return false
            }

            let k = Look3KindName()
            return k == "IdentifierToken" || k == "NumberToken" || k == "DoubleToken" ||
                   k == "StringToken" || k == "VerbatimStringToken" || k == "RawStringToken" ||
                   k == "InterpolatedStringToken" || k == "CharToken" ||
                   k == "OpenParenthesisToken" || k == "NewKeyword" || k == "TrueKeyword" ||
                   k == "FalseKeyword" || k == "NullKeyword" || k == "BangToken" ||
                   k == "MinusToken" || k == "PlusToken" || k == "TildeToken"
        }

        private function ParseCastExpression(): Node
        {
            let cast = Node.MakeCompound("CastExpression")
            cast.Add(Match("OpenParenthesisToken"))
            cast.Add(Match("IdentifierToken"))
            cast.Add(Match("CloseParenthesisToken"))
            // 操作数为 unary 级（对齐 C# ParseBinaryExpression(6)，`+` 等低优先级不吞入）
            cast.Add(ParseBinary(6))
            return cast
        }

        private function ParseLambda(): Node
        {
            let lambda = Node.MakeCompound("LambdaExpression")
            lambda.Add(Match("OpenParenthesisToken"))
            if KindName() != "CloseParenthesisToken"
            {
                lambda.Add(ParseParameter())
                while KindName() == "CommaToken"
                {
                    lambda.Add(Match("CommaToken"))
                    lambda.Add(ParseParameter())
                }
            }

            lambda.Add(Match("CloseParenthesisToken"))
            lambda.Add(Match("FatArrowToken"))
            if KindName() == "OpenBraceToken"
            {
                // 块体 lambda：`() => { statements }`（对齐 C# ParseLambdaExpression：`{` → ParseBlockStatement）
                lambda.Add(ParseBlockStatement())
            }
            else
            {
                lambda.Add(ParseExpression())
            }

            return lambda
        }

        // ────────── token kind → C# SyntaxKind 名 ──────────

        private static function TokenKindName(t: Token): string
        {
            let k = t.Kind()
            if k == "Keyword"
            {
                return KeywordKindName(t.Text())
            }

            if k == "Identifier"
            {
                return "IdentifierToken"
            }

            if k == "Number"
            {
                return "NumberToken"
            }

            if k == "Double"
            {
                return "DoubleToken"
            }

            if k == "String"
            {
                return "StringToken"
            }

            if k == "VerbatimString"
            {
                return "VerbatimStringToken"
            }

            if k == "RawString"
            {
                return "RawStringToken"
            }

            if k == "InterpolatedString"
            {
                return "InterpolatedStringToken"
            }

            if k == "Char"
            {
                return "CharToken"
            }

            if k == "EOF"
            {
                return "EndOfFileToken"
            }

            if k == "Error"
            {
                return "BadToken"
            }

            return SymbolKindName(t.Text())
        }

        private static function KeywordKindName(text: string): string
        {
            if text == "abstract" { return "AbstractKeyword" }
            if text == "as" { return "AsKeyword" }
            if text == "base" { return "BaseKeyword" }
            if text == "break" { return "BreakKeyword" }
            if text == "case" { return "CaseKeyword" }
            if text == "cdecl" { return "CdeclKeyword" }
            if text == "continue" { return "ContinueKeyword" }
            if text == "default" { return "DefaultKeyword" }
            if text == "else" { return "ElseKeyword" }
            if text == "false" { return "FalseKeyword" }
            if text == "for" { return "ForKeyword" }
            if text == "foreach" { return "ForeachKeyword" }
            if text == "get" { return "GetKeyword" }
            if text == "set" { return "SetKeyword" }
            if text == "property" { return "PropertyKeyword" }
            if text == "class" { return "ClassKeyword" }
            if text == "struct" { return "StructKeyword" }
            if text == "event" { return "EventKeyword" }
            if text == "delegate" { return "DelegateKeyword" }
            if text == "const" { return "ConstKeyword" }
            if text == "constructor" { return "ConstructorKeyword" }
            if text == "function" { return "FunctionKeyword" }
            if text == "if" { return "IfKeyword" }
            if text == "import" { return "ImportKeyword" }
            if text == "in" { return "InKeyword" }
            if text == "interface" { return "InterfaceKeyword" }
            if text == "is" { return "IsKeyword" }
            if text == "internal" { return "InternalKeyword" }
            if text == "new" { return "NewKeyword" }
            if text == "null" { return "NullKeyword" }
            if text == "nameof" { return "NameofKeyword" }
            if text == "out" { return "OutKeyword" }
            if text == "namespace" { return "NamespaceKeyword" }
            if text == "override" { return "OverrideKeyword" }
            if text == "partial" { return "PartialKeyword" }
            if text == "params" { return "ParamsKeyword" }
            if text == "protected" { return "ProtectedKeyword" }
            if text == "readonly" { return "ReadonlyKeyword" }
            if text == "ref" { return "RefKeyword" }
            if text == "sealed" { return "SealedKeyword" }
            if text == "static" { return "StaticKeyword" }
            if text == "step" { return "StepKeyword" }
            if text == "switch" { return "SwitchKeyword" }
            if text == "this" { return "ThisKeyword" }
            if text == "using" { return "UsingKeyword" }
            if text == "virtual" { return "VirtualKeyword" }
            if text == "when" { return "WhenKeyword" }
            if text == "while" { return "WhileKeyword" }
            if text == "let" { return "LetKeyword" }
            if text == "return" { return "ReturnKeyword" }
            if text == "stdcall" { return "StdcallKeyword" }
            if text == "syscall" { return "SyscallKeyword" }
            if text == "to" { return "ToKeyword" }
            if text == "true" { return "TrueKeyword" }
            if text == "var" { return "VarKeyword" }
            if text == "do" { return "DoKeyword" }
            if text == "enum" { return "EnumKeyword" }
            if text == "extends" { return "ExtendsKeyword" }
            if text == "extern" { return "ExternKeyword" }
            if text == "public" { return "PublicKeyword" }
            if text == "private" { return "PrivateKeyword" }
            if text == "where" { return "WhereKeyword" }
            if text == "throw" { return "ThrowKeyword" }
            if text == "try" { return "TryKeyword" }
            if text == "catch" { return "CatchKeyword" }
            if text == "finally" { return "FinallyKeyword" }
            if text == "and" { return "AndKeyword" }
            if text == "or" { return "OrKeyword" }
            if text == "not" { return "NotKeyword" }
            if text == "lock" { return "LockKeyword" }
            if text == "checked" { return "CheckedKeyword" }
            if text == "unchecked" { return "UncheckedKeyword" }
            if text == "yield" { return "YieldKeyword" }
            if text == "field" { return "FieldKeyword" }
            return "IdentifierToken"
        }

        private static function SymbolKindName(text: string): string
        {
            if text == "(" { return "OpenParenthesisToken" }
            if text == ")" { return "CloseParenthesisToken" }
            if text == "[" { return "OpenBracketToken" }
            if text == "]" { return "CloseBracketToken" }
            if text == "{" { return "OpenBraceToken" }
            if text == "}" { return "CloseBraceToken" }
            if text == ":" { return "ColonToken" }
            if text == "," { return "CommaToken" }
            if text == "." { return "DotToken" }
            if text == ".." { return "DotDotToken" }
            if text == ";" { return "SemicolonToken" }
            if text == "~" { return "TildeToken" }
            if text == "^" { return "HatToken" }
            if text == "^=" { return "HatEqualsToken" }
            if text == "&" { return "AmpersandToken" }
            if text == "&&" { return "AmpersandAmpersandToken" }
            if text == "&=" { return "AmpersandEqualsToken" }
            if text == "|" { return "PipeToken" }
            if text == "||" { return "PipePipeToken" }
            if text == "|=" { return "PipeEqualsToken" }
            if text == "=" { return "EqualsToken" }
            if text == "==" { return "EqualsEqualsToken" }
            if text == "=>" { return "FatArrowToken" }
            if text == "!" { return "BangToken" }
            if text == "!=" { return "BangEqualsToken" }
            if text == "<" { return "LessToken" }
            if text == "<=" { return "LessOrEqualsToken" }
            if text == "<<" { return "ShiftLeftToken" }
            if text == "<<=" { return "ShiftLeftEqualsToken" }
            if text == ">" { return "GreaterToken" }
            if text == ">=" { return "GreaterOrEqualsToken" }
            if text == ">>" { return "ShiftRightToken" }
            if text == ">>=" { return "ShiftRightEqualsToken" }
            if text == "%" { return "PercentToken" }
            if text == "%=" { return "PercentEqualsToken" }
            if text == "?" { return "QuestionToken" }
            if text == "??" { return "QuestionQuestionToken" }
            if text == "??=" { return "QuestionQuestionEqualsToken" }
            if text == "?." { return "QuestionDotToken" }
            if text == "+" { return "PlusToken" }
            if text == "++" { return "PlusPlusToken" }
            if text == "+=" { return "PlusEqualsToken" }
            if text == "-" { return "MinusToken" }
            if text == "--" { return "MinusMinusToken" }
            if text == "-=" { return "MinusEqualsToken" }
            if text == "->" { return "ArrowToken" }
            if text == "*" { return "StarToken" }
            if text == "*=" { return "StarEqualsToken" }
            if text == "/" { return "SlashToken" }
            if text == "/=" { return "SlashEqualsToken" }
            return "BadToken"
        }
    }
}
