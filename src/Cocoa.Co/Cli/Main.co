// B0 骨架（阶段 7 增量一 M7-a4 建立、增量二 M8 扩展）：自举词法器 + 自举解析器可执行程序。
// 用 C# 编译器把 src/Cocoa.Co 构建为可运行二进制（native 与 IL），
// 读入文件 → 自举 Lexer 逐 token Describe() 输出 → 自举 Parser 打印规范树 dump 与诊断。
// 用法：cocoa-co <file.co>

using MiniLexer
using MiniParser
using System
using System.IO

function Main(args: string[]): i32
{
    if args.Length < 1
    {
        Console.WriteLine("usage: cocoa-co <file.co>")
        return 1
    }

    let source = File.ReadAllText(args[0])
    let lex = MiniLexer.Lexer.Create(source)
    while true
    {
        let t = lex.Next()
        Console.WriteLine(t.Describe())
        if t.Kind() == "EOF"
        {
            break
        }
    }

    let parser = MiniParser.Parser.Create(source)
    let root = parser.ParseCompilationUnit()
    Console.WriteLine("--- tree ---")
    Console.WriteLine(root.Dump())
    var i = 0
    while i < parser.DiagnosticCount()
    {
        Console.WriteLine(parser.DiagnosticAt(i))
        i = i + 1
    }

    let binder = MiniBinder.Binder.Create(source)
    binder.BindCompilationUnit()
    Console.WriteLine("--- symbols ---")
    Console.WriteLine(binder.DescribeSymbols())
    var d = 0
    while d < binder.DiagnosticCount()
    {
        Console.WriteLine(binder.DiagnosticAt(d))
        d = d + 1
    }

    return 0
}
