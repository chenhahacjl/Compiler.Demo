// Cocoa 系统标准库（核心程序集）：namespace System 下 Runtime 容器类 + Console/Math/String/Array 静态类。
//
// 分层（见 docs/标准库设计.md）：
//   - 内部调用层：class Runtime —— syscall 声明（编译器内部原语，三后端按 BuiltinKind 分发；
//     完整名 System.Runtime，供本库封装层与用户 syscall 声明复用）
//   - 封装层：class Console —— WriteLine/ReadLine（调 Runtime.Print/Input），C# 同构静态类
//   - 逻辑层：class Math/String/Array —— 纯 Cocoa 源码静态类，只依赖语言核心（算术/字符串/数组/控制流/char↔int 转换）
//   - 功能层：print/input/random/sleep/now/exit 等编译器内置原语（BuiltinKind 规格表，三后端按 kind 分发）
//
// 6e-M18：Console/Math/String/Array 由命名空间改为静态容器类（C# 同构）；配合 `using static <类>` / `using 别名`。
//
// 交付：`tools/build-stdlib.cmd` 用已构建的 cocoa 编本文件 → System.Core.cod（核心程序集，仿 .NET
// System.Private.CoreLib；目录内 `System*.cod` 自动发现加载，未来大模块 System.Net.cod 等各配 .coproj 追加），
// 编译期隐式注入每次编译，函数命名空间限定访问（using System; + Math.Max / using static System.Math; + Max）。

namespace System
{
    class Runtime
    {
        syscall function Print(text: any): void
        syscall function Input(): string
        syscall function Random(max: int): int
        syscall function Sleep(ms: int): void
        syscall function Now(): int
        syscall function Exit(code: int): void
    }

    class Console
    {
        static function WriteLine(text: string): void
        {
            Runtime.Print(text)
        }

        static function WriteLine(text: int): void
        {
            Runtime.Print(text)
        }

        static function WriteLine(text: double): void
        {
            Runtime.Print(text)
        }

        static function WriteLine(text: bool): void
        {
            Runtime.Print(text)
        }

        static function WriteLine(text: char): void
        {
            Runtime.Print(text)
        }

        static function WriteLine(text: byte): void
        {
            Runtime.Print(text)
        }

        static function ReadLine(): string
        {
            return Runtime.Input()
        }
    }

    class Math
    {
        static function Max(a: int, b: int): int
        {
            if (a > b) return a
            return b
        }

        static function Max(a: double, b: double): double
        {
            if (a > b) return a
            return b
        }

        static function Min(a: int, b: int): int
        {
            if (a < b) return a
            return b
        }

        static function Min(a: double, b: double): double
        {
            if (a < b) return a
            return b
        }

        static function Abs(x: int): int
        {
            if (x < 0) return -x
            return x
        }

        static function Abs(x: double): double
        {
            if (x < 0) return -x
            return x
        }

        static function Clamp(v: int, lo: int, hi: int): int
        {
            if (v < lo) return lo
            if (v > hi) return hi
            return v
        }

        static function Clamp(v: double, lo: double, hi: double): double
        {
            if (v < lo) return lo
            if (v > hi) return hi
            return v
        }

        static function Sign(x: int): int
        {
            if (x < 0) return -1
            if (x > 0) return 1
            return 0
        }

        static function Sign(x: double): int
        {
            if (x < 0) return -1
            if (x > 0) return 1
            return 0
        }

        static function IsEven(n: int): bool
        {
            return n % 2 == 0
        }

        static function IsOdd(n: int): bool
        {
            return n % 2 == 1
        }

        static function Pow(x: int, exp: int): int
        {
            var result = 1
            var i = 0
            while i < exp
            {
                result = result * x
                i = i + 1
            }
            return result
        }

        static function Factorial(n: int): int
        {
            var result = 1
            var i = 1
            while i <= n
            {
                result = result * i
                i = i + 1
            }
            return result
        }

        static function Gcd(a: int, b: int): int
        {
            var x = Abs(a)
            var y = Abs(b)
            while y > 0
            {
                var t = x % y
                x = y
                y = t
            }
            return x
        }

        static function Lcm(a: int, b: int): int
        {
            if a == 0 || b == 0
            {
                return 0
            }
            return Abs(a * b) / Gcd(a, b)
        }
    }

    class String
    {
        static function ToUpper(s: string): string
        {
            var result = ""
            var i = 0
            while i < s.Length
            {
                var v = int(s[i])
                if v >= 97 && v <= 122
                {
                    result = result + string(char(v - 32))
                }
                else
                {
                    result = result + string(s[i])
                }
                i = i + 1
            }
            return result
        }

        static function ToLower(s: string): string
        {
            var result = ""
            var i = 0
            while i < s.Length
            {
                var v = int(s[i])
                if v >= 65 && v <= 90
                {
                    result = result + string(char(v + 32))
                }
                else
                {
                    result = result + string(s[i])
                }
                i = i + 1
            }
            return result
        }

        static function StartsWith(s: string, prefix: string): bool
        {
            if prefix.Length > s.Length
            {
                return false
            }
            return s.substring(0, prefix.Length) == prefix
        }

        static function EndsWith(s: string, suffix: string): bool
        {
            if suffix.Length > s.Length
            {
                return false
            }
            return s.substring(s.Length - suffix.Length, suffix.Length) == suffix
        }

        static function Contains(s: string, sub: string): bool
        {
            if sub.Length == 0
            {
                return true
            }
            var i = 0
            while i <= s.Length - sub.Length
            {
                if s.substring(i, sub.Length) == sub
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        static function IndexOf(s: string, sub: string): int
        {
            if sub.Length == 0
            {
                return 0
            }
            var i = 0
            while i <= s.Length - sub.Length
            {
                if s.substring(i, sub.Length) == sub
                {
                    return i
                }
                i = i + 1
            }
            return -1
        }

        static function Reverse(s: string): string
        {
            var result = ""
            var i = s.Length - 1
            while i >= 0
            {
                result = result + string(s[i])
                i = i - 1
            }
            return result
        }

        static function Replicate(s: string, n: int): string
        {
            var result = ""
            var i = 0
            while i < n
            {
                result = result + s
                i = i + 1
            }
            return result
        }

        static function CountChar(s: string, c: char): int
        {
            var count = 0
            var i = 0
            while i < s.Length
            {
                if s[i] == c
                {
                    count = count + 1
                }
                i = i + 1
            }
            return count
        }

        static function IsPalindrome(s: string): bool
        {
            var lo = 0
            var hi = s.Length - 1
            while lo < hi
            {
                if s[lo] != s[hi]
                {
                    return false
                }
                lo = lo + 1
                hi = hi - 1
            }
            return true
        }

        static function Trim(s: string): string
        {
            var start = 0
            var end = s.Length
            var first = char(0)
            var last = char(0)
            while start < end
            {
                first = s[start]
                if first == ' '
                {
                    start = start + 1
                }
                else
                {
                    break
                }
            }
            while end > start
            {
                last = s[end - 1]
                if last == ' '
                {
                    end = end - 1
                }
                else
                {
                    break
                }
            }
            if start >= end
            {
                return ""
            }
            return s.substring(start, end - start)
        }
    }

    class Array
    {
        static function Sum(a: int[]): int
        {
            var sum = 0
            var i = 0
            while i < a.Length
            {
                sum = sum + a[i]
                i = i + 1
            }
            return sum
        }

        static function Sum(a: double[]): double
        {
            var sum = 0.0
            var i = 0
            while i < a.Length
            {
                sum = sum + a[i]
                i = i + 1
            }
            return sum
        }

        static function Min(a: int[]): int
        {
            if a.Length == 0
            {
                return 0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] < m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Min(a: double[]): double
        {
            if a.Length == 0
            {
                return 0.0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] < m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Max(a: int[]): int
        {
            if a.Length == 0
            {
                return 0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] > m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Max(a: double[]): double
        {
            if a.Length == 0
            {
                return 0.0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] > m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function AverageD(a: int[]): double
        {
            if a.Length == 0
            {
                return 0.0
            }
            return Sum(a) / a.Length
        }

        static function AverageD(a: double[]): double
        {
            if a.Length == 0
            {
                return 0.0
            }
            return Sum(a) / a.Length
        }

        static function Contains(a: int[], v: int): bool
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        static function Contains(a: double[], v: double): bool
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        static function IndexOf(a: int[], v: int): int
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return i
                }
                i = i + 1
            }
            return -1
        }

        static function IndexOf(a: double[], v: double): int
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return i
                }
                i = i + 1
            }
            return -1
        }

        static function Reverse(a: int[]): int[]
        {
            var n = a.Length
            var result = new int[n]
            var i = 0
            while i < n
            {
                result[i] = a[n - 1 - i]
                i = i + 1
            }
            return result
        }

        static function Reverse(a: double[]): double[]
        {
            var n = a.Length
            var result = new double[n]
            var i = 0
            while i < n
            {
                result[i] = a[n - 1 - i]
                i = i + 1
            }
            return result
        }

        static function Sort(a: int[]): int[]
        {
            var n = a.Length
            var result = new int[n]
            var i = 0
            while i < n
            {
                result[i] = a[i]
                i = i + 1
            }
            var j = 0
            while j < n - 1
            {
                var k = 0
                while k < n - 1 - j
                {
                    if result[k] > result[k + 1]
                    {
                        var t = result[k]
                        result[k] = result[k + 1]
                        result[k + 1] = t
                    }
                    k = k + 1
                }
                j = j + 1
            }
            return result
        }

        static function Sort(a: double[]): double[]
        {
            var n = a.Length
            var result = new double[n]
            var i = 0
            while i < n
            {
                result[i] = a[i]
                i = i + 1
            }
            var j = 0
            while j < n - 1
            {
                var k = 0
                while k < n - 1 - j
                {
                    if result[k] > result[k + 1]
                    {
                        var t = result[k]
                        result[k] = result[k + 1]
                        result[k + 1] = t
                    }
                    k = k + 1
                }
                j = j + 1
            }
            return result
        }
    }
}
