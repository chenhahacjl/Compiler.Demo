// Cocoa 系统标准库 · System.Core 封装层（namespace System）
// class Console —— Write/WriteLine/ReadLine/ReadKey（调 Runtime.WriteLine/Write/ReadLine/ReadKey），C# 同构静态类
// 详细分层设计见 docs/标准库设计.md

namespace System
{
    class Console
    {
        static function WriteLine(): void
        {
            Runtime.WriteLine("")
        }

        static function WriteLine(text: string): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: int): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: double): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: bool): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: char): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: byte): void
        {
            Runtime.WriteLine(text)
        }

        static function Write(text: string): void
        {
            Runtime.Write(text)
        }

        static function Write(text: int): void
        {
            Runtime.Write(text)
        }

        static function Write(text: double): void
        {
            Runtime.Write(text)
        }

        static function Write(text: bool): void
        {
            Runtime.Write(text)
        }

        static function Write(text: char): void
        {
            Runtime.Write(text)
        }

        static function Write(text: byte): void
        {
            Runtime.Write(text)
        }

        static function ReadLine(): string
        {
            return Runtime.ReadLine()
        }

        static function ReadKey(intercept: bool): char
        {
            return Runtime.ReadKey(intercept)
        }

        static function Beep(frequency: int, duration: int): void
        {
            Runtime.Beep(frequency, duration)
        }
    }
}
