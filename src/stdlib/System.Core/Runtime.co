// Cocoa 系统标准库 · System.Core 内部调用层（namespace System）
// class Runtime —— syscall 声明（编译器内部原语，三后端按 BuiltinKind 分发；完整名 System.Runtime）
// 详细分层设计见 docs/标准库设计.md

namespace System
{
    class Runtime
    {
        syscall function WriteLine(text: any): void
        syscall function Write(text: any): void
        syscall function ReadLine(): string
        syscall function ReadKey(intercept: bool): char
        syscall function Random(max: int): int
        syscall function Sleep(ms: int): void
        syscall function TickCount(): int
        syscall function Exit(code: int): void
        syscall function Sqrt(x: double): double
        syscall function Floor(x: double): double
        syscall function Ceiling(x: double): double
        syscall function Truncate(x: double): double
        syscall function Round(x: double): double
        syscall function Beep(frequency: int, duration: int): void
    }
}
