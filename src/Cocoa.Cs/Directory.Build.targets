<Project>

	<!-- 涓ぎ搴撲粨 libs\ 鈫?鍚勯」鐩緭鍑虹洰褰曡嚜鍔ㄥ垎鍙戯紙婧愮敱 tools\build-sdk.cmd 鏀堕泦锛?
	     SkipUnchangedFiles 淇濊瘉澧為噺鏋勫缓闆跺紑閿€锛涜繍琛屾湡 SystemLibrary 鍙︽湁鍚戜笂鎺㈡祴鍏滃簳锛夈€?
	     娉ㄦ剰锛氬彧鍒嗗彂 .cod鈥斺€斿姩鎬侀摼鎺ョ殑 CocoaStd.Core.dll 鐢辨秷璐规柟鏋勫缓鏃?CopyLocal
	     浠庡簱婧愮洰褰曪紙SourcePath 鍚岀洰褰曪級钀界洏锛涙澶勫垎鍙戜細涓庡紩鎿庣▼搴忛泦閲嶅悕瑕嗙洊锛屼弗绂佹坊鍔?-->
	<Target Name="DeployStdLib" AfterTargets="Build"
			Condition="Exists('$(MSBuildThisFileDirectory)libs\System.Core.cod')">
		<Copy SourceFiles="@(StdLibCod)"
				DestinationFolder="$(OutDir)"
				SkipUnchangedFiles="true" />
	</Target>

<ItemGroup>
		<StdLibCod Include="$(MSBuildThisFileDirectory)libs\*.cod" />
	</ItemGroup>
</Project>
