<Project>

	<!-- 中央库仓 libs\ → 各项目输出目录自动分发（源由 tools\build-stdlib.cmd 收集；
	     SkipUnchangedFiles 保证增量构建零开销；运行期 SystemLibrary 另有向上探测兜底）。
	     注意：只分发 .cod——动态链接的 CocoaStd.Core.dll 由消费方构建时 CopyLocal
	     从库源目录（SourcePath 同目录）落盘；此处分发会与引擎程序集重名覆盖，严禁添加 -->
	<Target Name="DeployStdLib" AfterTargets="Build"
			Condition="Exists('$(MSBuildThisFileDirectory)libs\System.Core.cod')">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)libs\System.Core.cod"
				DestinationFolder="$(OutDir)"
				SkipUnchangedFiles="true" />
	</Target>

</Project>
