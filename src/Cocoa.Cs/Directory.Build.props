<Project>

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
			P0 警告棘轮：TreatWarningsAsErrors 开启，NoWarn 只保留跨项目共性的既定豁免编号；
			任何新增警告编号都会让构建失败（逐批偿还时从 NoWarn 移除对应编号即可纳入棘轮）。
			历史 nullable 债务（原 866 个）已逐项目清零——Cli 的 8 个压制编号已于 2026-09 移除。
		-->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);CS0108;CA1416;xUnit2013;xUnit1026</NoWarn>
	</PropertyGroup>

</Project>
