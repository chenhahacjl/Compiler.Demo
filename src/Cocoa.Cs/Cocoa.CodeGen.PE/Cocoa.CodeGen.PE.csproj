<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nullable 已清零（5.3 首个项目），无 NoWarn 覆盖：任何 nullable 警告都会构建失败（棘轮） -->
  <PropertyGroup>
    <RootNamespace>Cocoa.CodeGen.PE</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cocoa.CodeAnalysis" />
    <InternalsVisibleTo Include="Cocoa.ProjectSystem" />
    <InternalsVisibleTo Include="Cocoa.CodeGen.IL" />
    <InternalsVisibleTo Include="Cocoa.CodeGen.Native" />
    <InternalsVisibleTo Include="cocoa" />
    <InternalsVisibleTo Include="Cocoa.Tests" />
  </ItemGroup>
</Project>
