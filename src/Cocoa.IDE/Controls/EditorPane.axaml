<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cocoa.IDE.Controls"
             xmlns:vm="using:Cocoa.IDE.ViewModels"
             x:Class="Cocoa.IDE.Controls.EditorPane">

    <DockPanel>
        <!-- 标签栏 -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1">
            <ListBox x:Name="TabList"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,5"
                                Background="#1E1E1E"
                                CornerRadius="3,3,0,0"
                                Margin="1,0"
                                PointerPressed="OnTabPointerPressed"
                                PointerMoved="OnTabPointerMoved"
                                PointerReleased="OnTabPointerReleased">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding FileName}" FontSize="12"
                                           Foreground="#CCCCCC" VerticalAlignment="Center" />
                                <TextBlock Text="●" FontSize="8" Foreground="#4EC9B0"
                                           IsVisible="{Binding IsModified}"
                                           VerticalAlignment="Center" />
                                <Button Content="✕" FontSize="9" Padding="3,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#999"
                                        Command="{Binding CloseCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 编辑器区 -->
        <Grid>
            <controls:EditorView x:Name="EditorHost" />
            <TextBlock Text="打开文件或解决方案开始编辑"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#666" FontSize="16"
                       x:Name="EmptyStateText" />
        </Grid>
    </DockPanel>
</UserControl>