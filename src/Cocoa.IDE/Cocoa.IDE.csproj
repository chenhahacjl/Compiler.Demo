<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<OutputType>Exe</OutputType>
		<AssemblyName>Cocoa.IDE</AssemblyName>
		<RootNamespace>Cocoa.IDE</RootNamespace>
		<ApplicationIcon />
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia"        Version="11.2.3" />
		<PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
		<PackageReference Include="Avalonia.Fonts.Inter"   Version="11.2.3" />
		<PackageReference Include="Avalonia.AvaloniaEdit"  Version="11.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm"   Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cocoa.Cs\Cocoa.Build\Cocoa.Build.csproj" />
		<ProjectReference Include="..\Cocoa.Cs\Compiler\Cocoa.Dialects.Cocoa\Cocoa.Dialects.Cocoa.csproj" />
		<ProjectReference Include="..\Cocoa.Cs\Compiler\Cocoa.Dialects.CSharp\Cocoa.Dialects.CSharp.csproj" />
		<ProjectReference Include="..\Cocoa.Cs\CodeGen\Cocoa.CodeGen.Interpreter\Cocoa.CodeGen.Interpreter.csproj" />
		<ProjectReference Include="..\Cocoa.Cs\CodeGen\Cocoa.CodeGen.Native\Cocoa.CodeGen.Native.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Themes\**\*.axaml" />
		<AvaloniaResource Include="Themes\**\*.axaml" />
		<EmbeddedResource Include="Themes\**\*.xshd" />
	</ItemGroup>

	<ItemGroup>
		<!-- 新建项目模板：仅作为内容复制到输出目录，不参与编译（{{Name}} 占位符非法 C# 标识符） -->
		<Content Include="Templates\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
		<Compile Remove="Templates\**\*" />
		<None Remove="Templates\**\*" />
		<EmbeddedResource Remove="Templates\**\*" />
		<AvaloniaResource Remove="Templates\**\*" />
	</ItemGroup>

</Project>
