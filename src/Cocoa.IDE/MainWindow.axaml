<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocoa.IDE.ViewModels"
        xmlns:controls="using:Cocoa.IDE.Controls"
        x:Class="Cocoa.IDE.MainWindow"
        Title="Cocoa IDE"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="Ctrl+O"  Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenSolutionPickerCommand}" />
        <KeyBinding Gesture="Ctrl+S"  Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+W"  Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+F"  Command="{Binding FindCommand}" />
        <KeyBinding Gesture="F6"      Command="{Binding BuildCommand}" />
        <KeyBinding Gesture="F5"      Command="{Binding DebugStartCommand}" />
        <KeyBinding Gesture="Ctrl+F5" Command="{Binding RunCommand}" />
        <KeyBinding Gesture="F10"     Command="{Binding DebugStepOverCommand}" />
        <KeyBinding Gesture="F11"     Command="{Binding DebugStepIntoCommand}" />
        <KeyBinding Gesture="Shift+F11" Command="{Binding DebugStepOutCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- ═══ ① 菜单栏 ═══ -->
        <Menu DockPanel.Dock="Top" Background="#2D2D30">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…"        Command="{Binding NewProjectCommand}" InputGesture="Ctrl+Shift+N" />
                <Separator />
                <MenuItem Header="打开文件…"        Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="打开解决方案…"    Command="{Binding OpenSolutionPickerCommand}" InputGesture="Ctrl+Shift+O" />
                <Separator />
                <MenuItem Header="保存"             Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="全部保存"         Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="剪切" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                <MenuItem Header="复制" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                <MenuItem Header="粘贴" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                <Separator />
                <MenuItem Header="全选" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
                <Separator />
                <MenuItem Header="查找…" Command="{Binding FindCommand}" InputGesture="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem x:Name="ViewExplorerItem" Header="解决方案资源管理器" ToggleType="CheckBox" IsChecked="True" Click="OnToggleExplorer" />
                <MenuItem x:Name="ViewPropertiesItem" Header="属性窗口" ToggleType="CheckBox" IsChecked="True" Click="OnToggleProperties" />
                <MenuItem x:Name="ViewErrorItem" Header="错误列表" ToggleType="CheckBox" IsChecked="True" Click="OnToggleErrors" />
                <MenuItem x:Name="ViewOutputItem" Header="输出" ToggleType="CheckBox" IsChecked="True" Click="OnToggleOutput" />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="添加现有文件…" Click="OnProjectAddExistingFile" IsEnabled="{Binding SolutionTree.HasSolution}" />
                <MenuItem Header="从项目中移除" Click="OnProjectRemoveFile" IsEnabled="{Binding SolutionTree.HasSolution}" />
            </MenuItem>
            <MenuItem Header="生成(_B)">
                <MenuItem Header="生成"             Command="{Binding BuildCommand}" InputGesture="F6" />
                <MenuItem Header="重新生成"         Command="{Binding RebuildCommand}" />
                <MenuItem Header="清理"             Command="{Binding CleanCommand}" />
                <Separator />
                <MenuItem Header="运行(不调试)"      Command="{Binding RunCommand}" InputGesture="Ctrl+F5" />
            </MenuItem>
            <MenuItem Header="调试(_D)">
                <MenuItem Header="开始调试" Command="{Binding DebugStartCommand}" InputGesture="F5" />
                <MenuItem Header="开始执行(不调试)" Command="{Binding RunCommand}" InputGesture="Ctrl+F5" />
                <Separator />
                <MenuItem Header="继续" Command="{Binding DebugContinueCommand}" />
                <MenuItem Header="停止调试" Command="{Binding DebugStopCommand}" />
                <Separator />
                <MenuItem Header="逐过程" Command="{Binding DebugStepOverCommand}" InputGesture="F10" />
                <MenuItem Header="逐语句" Command="{Binding DebugStepIntoCommand}" InputGesture="F11" />
                <MenuItem Header="跳出" Command="{Binding DebugStepOutCommand}" InputGesture="Shift+F11" />
            </MenuItem>
            <MenuItem Header="工具(_T)" IsEnabled="False">
                <MenuItem Header="选项" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 Cocoa IDE" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- ═══ ② 工具栏 ═══ -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="➕" ToolTip.Tip="新建项目" Command="{Binding NewProjectCommand}" />
                <Button Content="📂" ToolTip.Tip="打开文件" Command="{Binding OpenFileCommand}" />
                <Button Content="📁" ToolTip.Tip="打开解决方案" Command="{Binding OpenSolutionPickerCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="↩" ToolTip.Tip="撤销 (Ctrl+Z)" Command="{Binding UndoCommand}" />
                <Button Content="↪" ToolTip.Tip="重做 (Ctrl+Y)" Command="{Binding RedoCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="✂" ToolTip.Tip="剪切 (Ctrl+X)" Command="{Binding CutCommand}" />
                <Button Content="📋" ToolTip.Tip="复制 (Ctrl+C)" Command="{Binding CopyCommand}" />
                <Button Content="📥" ToolTip.Tip="粘贴 (Ctrl+V)" Command="{Binding PasteCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="🔨" ToolTip.Tip="生成 (F6)" Command="{Binding BuildCommand}" />
                <Button Content="▶"  ToolTip.Tip="运行 (Ctrl+F5)" Command="{Binding RunCommand}" />
                <Button Content="🐞" ToolTip.Tip="调试 (F5)" Command="{Binding DebugStartCommand}" />
                <Button Content="⏹"  ToolTip.Tip="停止运行/调试" Command="{Binding StopCommand}" />
            </StackPanel>
        </Border>

        <!-- ═══ ⑤ 状态栏 ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="#007ACC"
                Padding="8,2">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBar.StatusText}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding SolutionTree.SolutionName}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.CursorPosition}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Language}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Encoding}"
                               Foreground="White" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ShellGrid" RowDefinitions="*,180">
            <!-- ═══ ③ 主内容区 ═══ -->
            <Grid x:Name="MainContentGrid" Grid.Row="0" ColumnDefinitions="280,4,*,4,300">
                <!-- 左：解决方案资源管理器（VS 风格） -->
                <Border Grid.Column="0" x:Name="ExplorerPanel"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="解决方案资源管理器"
                                   FontSize="12" FontWeight="SemiBold"
                                   Padding="8,6" Foreground="#CCCCCC"
                                   Background="#333337" />
                        <!-- 工具栏 -->
                        <Border DockPanel.Dock="Top"
                                Background="#2D2D30"
                                BorderBrush="#3F3F46"
                                BorderThickness="0,0,0,1"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="⟳" FontSize="11" Padding="6,1" ToolTip.Tip="刷新" Click="OnTreeRefresh" />
                                <Button Content="⌄" FontSize="11" Padding="6,1" ToolTip.Tip="折叠全部" Click="OnTreeCollapseAll" />
                                <ToggleButton Content="⇄" FontSize="11" Padding="6,1" ToolTip.Tip="与活动文档同步" IsChecked="{Binding SolutionTree.AutoSync}" />
                                <ToggleButton Content="👁" FontSize="11" Padding="6,1" ToolTip.Tip="显示所有文件" IsChecked="{Binding SolutionTree.ShowAllFiles}" />
                                <Button Content="ⓘ" FontSize="11" Padding="6,1" ToolTip.Tip="属性" Click="OnTreeProperties" />
                            </StackPanel>
                        </Border>
                        <TreeView x:Name="SolutionTree"
                                  ItemsSource="{Binding SolutionTree.RootNodes}"
                                  SelectedItem="{Binding SolutionTree.SelectedNode, Mode=TwoWay}"
                                  Background="Transparent" Foreground="#CCCCCC"
                                  BorderThickness="0" Padding="4"
                                  SelectionChanged="OnTreeSelectionChanged"
                                  DoubleTapped="OnTreeDoubleTapped">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{Binding Icon}" Foreground="{Binding IconBrush}"
                                                  Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Caption}" FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开" Click="OnCtxOpen" IsVisible="{Binding IsSource}" />
                                                <MenuItem Header="在资源管理器中显示" Click="OnCtxShowInExplorer" IsVisible="{Binding HasPath}" />
                                                <Separator />
                                                <MenuItem Header="新建文件…" Click="OnCtxNewFile" IsVisible="{Binding CanCreateFile}" />
                                                <MenuItem Header="添加引用…" Click="OnCtxAddReference" IsVisible="{Binding IsProject}" />
                                                <MenuItem Header="从项目中移除" Click="OnCtxRemove" IsVisible="{Binding IsSource}" />
                                                <MenuItem Header="移除引用" Click="OnCtxRemoveReference" IsVisible="{Binding IsReferenceNode}" />
                                                <Separator />
                                                <MenuItem Header="复制完整路径" Click="OnCtxCopyPath" IsVisible="{Binding HasPath}" />
                                                <MenuItem Header="属性" Click="OnCtxProperties" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" x:Name="ExplorerSplitter" Background="#3F3F46" Width="4" />

                <!-- 中央：编辑器（EditorPane 内嵌标签栏 + 编辑器） -->
                <controls:EditorPane Grid.Column="2" x:Name="Pane" />

                <GridSplitter Grid.Column="3" x:Name="PropertiesSplitter" Background="#3F3F46" Width="4" />

                <!-- 右：属性窗口（VS 风格，选中自动填充） -->
                <Border Grid.Column="4" x:Name="PropertiesPanel"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="1,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="属性"
                                   FontSize="12" FontWeight="SemiBold"
                                   Padding="8,6" Foreground="#CCCCCC"
                                   Background="#333337" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Properties.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="110,*"
                                              Margin="4,2" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="12" Foreground="#9CDCFE"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontSize="12" Foreground="#CCCCCC"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ═══ ④ 底部面板：输出 / 错误列表 ═══ -->
            <Border Grid.Row="1" x:Name="BottomPanel"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,1,0,0">
                <TabControl x:Name="BottomTabs" Padding="0">
                    <TabItem Header="输出">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#2D2D30"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,2">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Content="复制" FontSize="11" Padding="8,2"
                                            Command="{Binding Output.CopyCommand}" />
                                    <Button Content="清空" FontSize="11" Padding="8,2"
                                            Command="{Binding Output.ClearOutputCommand}" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="OutputList"
                                     ItemsSource="{Binding Output.Lines}"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="错误列表">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#2D2D30"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,2">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="错误" FontSize="11" IsChecked="{Binding ErrorList.ShowErrors}" />
                                    <CheckBox Content="警告" FontSize="11" IsChecked="{Binding ErrorList.ShowWarnings}" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="ErrorListBox"
                                     ItemsSource="{Binding ErrorList.FilteredItems}"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     BorderThickness="0"
                                     DoubleTapped="OnErrorDoubleTapped"
                                     SelectionChanged="OnErrorSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="24,*,110">
                                            <TextBlock Grid.Column="0" Text="{Binding SeverityIcon}"
                                                       Foreground="Red" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Location}" FontSize="12"
                                                       Foreground="#999" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="局部变量">
                        <ListBox ItemsSource="{Binding DebugLocals}"
                                 Background="Transparent" Foreground="#CCCCCC"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="160,120,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="#9CDCFE" />
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" Foreground="#4EC9B0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="调用栈">
                        <ListBox ItemsSource="{Binding DebugCallStack}"
                                 Background="Transparent" Foreground="#CCCCCC"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="200,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Function}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding FilePath}" FontSize="12" Foreground="#999" />
                                        <TextBlock Grid.Column="2" Text="{Binding Line}" FontSize="12" Foreground="#999" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>