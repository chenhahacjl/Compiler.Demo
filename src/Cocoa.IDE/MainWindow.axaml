<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocoa.IDE.ViewModels"
        xmlns:controls="using:Cocoa.IDE.Controls"
        x:Class="Cocoa.IDE.MainWindow"
        Title="Cocoa IDE"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="Ctrl+O"  Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenSolutionPickerCommand}" />
        <KeyBinding Gesture="Ctrl+S"  Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+W"  Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="F6"      Command="{Binding BuildCommand}" />
        <KeyBinding Gesture="F5"      Command="{Binding RunCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- ═══ ① 菜单栏 ═══ -->
        <Menu DockPanel.Dock="Top" Background="#2D2D30">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…"        Command="{Binding NewProjectCommand}" InputGesture="Ctrl+Shift+N" />
                <Separator />
                <MenuItem Header="打开文件…"        Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="打开解决方案…"    Command="{Binding OpenSolutionPickerCommand}" InputGesture="Ctrl+Shift+O" />
                <Separator />
                <MenuItem Header="保存"             Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="全部保存"         Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="退出" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="剪切" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                <MenuItem Header="复制" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                <MenuItem Header="粘贴" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                <Separator />
                <MenuItem Header="全选" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="解决方案资源管理器" />
                <MenuItem Header="属性窗口" />
                <MenuItem Header="错误列表" />
                <MenuItem Header="输出" />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="添加文件…" />
                <MenuItem Header="添加现有文件…" />
                <MenuItem Header="从项目中排除" />
            </MenuItem>
            <MenuItem Header="生成(_B)">
                <MenuItem Header="生成"             Command="{Binding BuildCommand}" InputGesture="F6" />
                <MenuItem Header="重新生成"         Command="{Binding BuildCommand}" />
                <MenuItem Header="清理" />
                <Separator />
                <MenuItem Header="运行(不调试)"      Command="{Binding RunCommand}" InputGesture="F5" />
            </MenuItem>
            <MenuItem Header="调试(_D)">
                <MenuItem Header="开始调试" InputGesture="F5" />
                <MenuItem Header="开始执行(不调试)" InputGesture="Ctrl+F5" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="选项" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 Cocoa IDE" />
            </MenuItem>
        </Menu>

        <!-- ═══ ② 工具栏 ═══ -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="➕" ToolTip.Tip="新建项目" Command="{Binding NewProjectCommand}" />
                <Button Content="📂" ToolTip.Tip="打开文件" Command="{Binding OpenFileCommand}" />
                <Button Content="📁" ToolTip.Tip="打开解决方案" Command="{Binding OpenSolutionPickerCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="↩" ToolTip.Tip="撤销 (Ctrl+Z)" Command="{Binding UndoCommand}" />
                <Button Content="↪" ToolTip.Tip="重做 (Ctrl+Y)" Command="{Binding RedoCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="✂" ToolTip.Tip="剪切 (Ctrl+X)" Command="{Binding CutCommand}" />
                <Button Content="📋" ToolTip.Tip="复制 (Ctrl+C)" Command="{Binding CopyCommand}" />
                <Button Content="📥" ToolTip.Tip="粘贴 (Ctrl+V)" Command="{Binding PasteCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="🔨" ToolTip.Tip="生成 (F6)" Command="{Binding BuildCommand}" />
                <Button Content="▶"  ToolTip.Tip="运行 (F5)" Command="{Binding RunCommand}" />
            </StackPanel>
        </Border>

        <!-- ═══ ⑤ 状态栏 ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="#007ACC"
                Padding="8,2">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBar.StatusText}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding StatusBar.CursorPosition}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Language}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Encoding}"
                               Foreground="White" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid RowDefinitions="*,180">
            <!-- ═══ ③ 主内容区 ═══ -->
            <Grid Grid.Row="0" ColumnDefinitions="280,4,*,4,300">
                <!-- 左：解决方案资源管理器 -->
                <Border Grid.Column="0"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="解决方案资源管理器"
                                   FontSize="12" FontWeight="SemiBold"
                                   Padding="8,6" Foreground="#CCCCCC"
                                   Background="#333337" />
                        <TreeView x:Name="SolutionTree"
                                  ItemsSource="{Binding SolutionTree.RootNodes}"
                                  Background="Transparent" Foreground="#CCCCCC"
                                  BorderThickness="0" Padding="4"
                                  SelectionChanged="OnTreeSelectionChanged"
                                  DoubleTapped="OnTreeDoubleTapped">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开" Click="OnCtxOpen" />
                                                <MenuItem Header="在资源管理器中显示" Click="OnCtxShowInExplorer" />
                                                <Separator />
                                                <MenuItem Header="新建文件…" Click="OnCtxNewFile" />
                                                <MenuItem Header="从项目中移除" Click="OnCtxRemove" />
                                                <Separator />
                                                <MenuItem Header="复制完整路径" Click="OnCtxCopyPath" />
                                                <MenuItem Header="属性" Click="OnCtxProperties" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Background="#3F3F46" Width="4" />

                <!-- 中央：编辑器（EditorPane 内嵌标签栏 + 编辑器） -->
                <controls:EditorPane Grid.Column="2" x:Name="Pane" />

                <GridSplitter Grid.Column="3" Background="#3F3F46" Width="4" />

                <!-- 右：属性窗口（VS 风格，选中自动填充） -->
                <Border Grid.Column="4"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="1,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="属性"
                                   FontSize="12" FontWeight="SemiBold"
                                   Padding="8,6" Foreground="#CCCCCC"
                                   Background="#333337" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Properties.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="110,*"
                                              Margin="4,2" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="12" Foreground="#9CDCFE"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontSize="12" Foreground="#CCCCCC"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ═══ ④ 底部面板：输出 / 错误列表 ═══ -->
            <Border Grid.Row="1"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,1,0,0">
                <TabControl Padding="0">
                    <TabItem Header="输出">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#2D2D30"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,2">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Content="复制" FontSize="11" Padding="8,2"
                                            Command="{Binding Output.CopyCommand}" />
                                    <Button Content="清空" FontSize="11" Padding="8,2"
                                            Command="{Binding Output.ClearOutputCommand}" />
                                </StackPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding Output.Lines}"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="错误列表">
                        <ListBox ItemsSource="{Binding ErrorList.FilteredItems}"
                                 Background="Transparent"
                                 Foreground="#CCCCCC"
                                 BorderThickness="0"
                                 DoubleTapped="OnErrorDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="24,*,110">
                                        <TextBlock Grid.Column="0" Text="{Binding SeverityIcon}"
                                                   Foreground="Red" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Location}" FontSize="12"
                                                   Foreground="#999" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>