<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocoa.IDE.ViewModels"
        xmlns:controls="using:Cocoa.IDE.Controls"
        x:Class="Cocoa.IDE.MainWindow"
        Title="Cocoa IDE"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O"  Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenSolutionPickerCommand}" />
        <KeyBinding Gesture="Ctrl+S"  Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+W"  Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="F6"      Command="{Binding BuildCommand}" />
        <KeyBinding Gesture="F5"      Command="{Binding RunCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- ═══ ① 菜单栏 ═══ -->
        <Menu DockPanel.Dock="Top" Background="#2D2D30">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开文件…"        Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="打开解决方案…"    Command="{Binding OpenSolutionPickerCommand}" InputGesture="Ctrl+Shift+O" />
                <Separator />
                <MenuItem Header="保存"             Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="全部保存"         Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="退出" />
            </MenuItem>
            <MenuItem Header="生成(_B)">
                <MenuItem Header="生成"             Command="{Binding BuildCommand}" InputGesture="F6" />
                <MenuItem Header="运行(不调试)"      Command="{Binding RunCommand}" InputGesture="F5" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 Cocoa IDE" />
            </MenuItem>
        </Menu>

        <!-- ═══ ② 工具栏 ═══ -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="📂" ToolTip.Tip="打开文件" Command="{Binding OpenFileCommand}" />
                <Button Content="📁" ToolTip.Tip="打开解决方案" Command="{Binding OpenSolutionPickerCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="🔨" ToolTip.Tip="生成 (F6)" Command="{Binding BuildCommand}" />
                <Button Content="▶"  ToolTip.Tip="运行 (F5)" Command="{Binding RunCommand}" />
            </StackPanel>
        </Border>

        <!-- ═══ ⑤ 状态栏 ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="#007ACC"
                Padding="8,2">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBar.StatusText}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding StatusBar.CursorPosition}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Language}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Encoding}"
                               Foreground="White" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid RowDefinitions="*,180">
            <!-- ═══ ③ 主内容区 ═══ -->
            <Grid Grid.Row="0" ColumnDefinitions="280,4,*">
                <!-- 左：解决方案资源管理器 -->
                <Border Grid.Column="0"
                        Background="#252526"
                        BorderBrush="#3F3F46"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="解决方案资源管理器"
                                   FontSize="12" FontWeight="SemiBold"
                                   Padding="8,6" Foreground="#CCCCCC"
                                   Background="#333337" />
                        <TreeView x:Name="SolutionTree"
                                  ItemsSource="{Binding SolutionTree.RootNodes}"
                                  Background="Transparent" Foreground="#CCCCCC"
                                  BorderThickness="0" Padding="4"
                                  DoubleTapped="OnTreeDoubleTapped">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Background="#3F3F46" Width="4" />

                <!-- 中央：编辑器标签 + 编辑器 -->
                <Grid Grid.Column="2">
                    <DockPanel>
                        <!-- 标签栏 -->
                        <Border DockPanel.Dock="Top"
                                Background="#2D2D30"
                                BorderBrush="#3F3F46"
                                BorderThickness="0,0,0,1">
                            <ListBox x:Name="TabList"
                                     ItemsSource="{Binding EditorTabs.Tabs}"
                                     SelectedItem="{Binding EditorTabs.ActiveTab, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,5"
                                                Background="#1E1E1E"
                                                CornerRadius="3,3,0,0"
                                                Margin="1,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding FileName}" FontSize="12"
                                                           Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <TextBlock Text="●" FontSize="8" Foreground="#4EC9B0"
                                                           IsVisible="{Binding IsModified}"
                                                           VerticalAlignment="Center" />
                                                <Button Content="✕" FontSize="9" Padding="3,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#999"
                                                        Command="{Binding DataContext.CloseTabItemCommand, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- 编辑器区 -->
                        <Grid>
                            <controls:EditorView x:Name="EditorHost" />
                            <TextBlock Text="打开文件或解决方案开始编辑"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#666" FontSize="16"
                                       x:Name="EmptyStateText" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ═══ ④ 底部面板：输出 / 错误列表 ═══ -->
            <Border Grid.Row="1"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,1,0,0">
                <TabControl Padding="0">
                    <TabItem Header="输出">
                        <ListBox ItemsSource="{Binding Output.Lines}"
                                 Background="Transparent"
                                 Foreground="#CCCCCC"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="错误列表">
                        <ListBox ItemsSource="{Binding ErrorList.FilteredItems}"
                                 Background="Transparent"
                                 Foreground="#CCCCCC"
                                 BorderThickness="0"
                                 DoubleTapped="OnErrorDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="24,*,110">
                                        <TextBlock Grid.Column="0" Text="{Binding SeverityIcon}"
                                                   Foreground="Red" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Location}" FontSize="12"
                                                   Foreground="#999" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>