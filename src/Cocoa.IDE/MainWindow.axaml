<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cocoa.IDE.ViewModels"
        x:Class="Cocoa.IDE.MainWindow"
        Title="Cocoa IDE"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O"  Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenSolutionPickerCommand}" />
        <KeyBinding Gesture="Ctrl+S"  Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+W"  Command="{Binding CloseTabCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- ═══ ① 菜单栏 ═══ -->
        <Menu DockPanel.Dock="Top" Background="#2D2D30">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开文件…"        Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="打开解决方案…"    Command="{Binding OpenSolutionPickerCommand}" InputGesture="Ctrl+Shift+O" />
                <Separator />
                <MenuItem Header="保存"             Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="全部保存"         Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="退出" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销"  InputGesture="Ctrl+Z" />
                <MenuItem Header="重做"  InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="剪切"  InputGesture="Ctrl+X" />
                <MenuItem Header="复制"  InputGesture="Ctrl+C" />
                <MenuItem Header="粘贴"  InputGesture="Ctrl+V" />
                <Separator />
                <MenuItem Header="查找"  InputGesture="Ctrl+F" />
                <MenuItem Header="替换"  InputGesture="Ctrl+H" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="解决方案资源管理器" />
                <MenuItem Header="错误列表" />
                <MenuItem Header="输出" />
            </MenuItem>
            <MenuItem Header="生成(_B)">
                <MenuItem Header="生成解决方案" InputGesture="Ctrl+Shift+B" />
                <MenuItem Header="清理" />
            </MenuItem>
            <MenuItem Header="调试(_D)">
                <MenuItem Header="启动(不调试)" InputGesture="Ctrl+F5" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 Cocoa IDE" />
            </MenuItem>
        </Menu>

        <!-- ═══ ② 工具栏 ═══ -->
        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="📂" ToolTip.Tip="打开文件" Command="{Binding OpenFileCommand}" />
                <Button Content="📁" ToolTip.Tip="打开解决方案" Command="{Binding OpenSolutionPickerCommand}" />
                <Border Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="🔨" ToolTip.Tip="生成" />
                <Button Content="▶"  ToolTip.Tip="运行" />
            </StackPanel>
        </Border>

        <!-- ═══ ⑤ 状态栏 ═══ -->
        <Border DockPanel.Dock="Bottom"
                Background="#007ACC"
                Padding="8,2">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBar.StatusText}"
                           Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding StatusBar.CursorPosition}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Language}"
                               Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding StatusBar.Encoding}"
                               Foreground="White" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 主内容区 ═══ -->
        <Grid ColumnDefinitions="280,4,*">
            <!-- ③ 左：解决方案资源管理器 -->
            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="解决方案资源管理器"
                               FontSize="12" FontWeight="SemiBold"
                               Padding="8,6" Foreground="#CCCCCC"
                               Background="#333337" />
                    <TreeView ItemsSource="{Binding SolutionTree.RootNodes}"
                              Background="Transparent" Foreground="#CCCCCC"
                              BorderThickness="0" Padding="4">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- ④ 中央：编辑器标签 + 编辑器 -->
            <Grid Grid.Column="2">
                <DockPanel>
                    <!-- 标签栏 -->
                    <Border DockPanel.Dock="Top"
                            Background="#2D2D30"
                            BorderBrush="#3F3F46"
                            BorderThickness="0,0,0,1">
                        <ItemsControl ItemsSource="{Binding EditorTabs.Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,5"
                                            Background="#1E1E1E"
                                            CornerRadius="3,3,0,0"
                                            Margin="1,0"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                                       Foreground="#CCCCCC" VerticalAlignment="Center" />
                                            <TextBlock Text="●" FontSize="8" Foreground="#4EC9B0"
                                                       IsVisible="{Binding IsModified}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 编辑器区（无标签时的空状态） -->
                    <Panel>
                        <TextBlock Text="打开文件或解决方案开始编辑"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#666" FontSize="16"
                                   IsVisible="{Binding !EditorTabs.Tabs.Count}" />
                    </Panel>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
