<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cocoa.IDE.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ═══ 深色（VS Dark 风）═══ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
                    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#333337" />
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="TextBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#999999" />
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#858585" />
                    <SolidColorBrush x:Key="EmptyStateTextBrush" Color="#666666" />
                    <SolidColorBrush x:Key="TabActiveBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="TabInactiveBrush" Color="#252526" />
                    <SolidColorBrush x:Key="TabActiveTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StatusBarBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IdentifierBrush" Color="#9CDCFE" />
                    <SolidColorBrush x:Key="TypeBrush" Color="#4EC9B0" />
                    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#569CD6" />
                    <SolidColorBrush x:Key="SyntaxIdentifierBrush" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8" />
                    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#D69D85" />
                    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#57A64A" />
                    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="SyntaxTextBrush" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#E51400" />
                    <SolidColorBrush x:Key="IconDefaultBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="IconFolderBrush" Color="#DCDCAA" />
                    <SolidColorBrush x:Key="IconDependencyBrush" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="IconCocoaBrush" Color="#E37933" />
                    <SolidColorBrush x:Key="IconReferenceBrush" Color="#4EC9B0" />
                </ResourceDictionary>

                <!-- ═══ 浅色（VS Light 风）═══ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="TextBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6A6A6A" />
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#237893" />
                    <SolidColorBrush x:Key="EmptyStateTextBrush" Color="#999999" />
                    <SolidColorBrush x:Key="TabActiveBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TabInactiveBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="TabActiveTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="StatusBarBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IdentifierBrush" Color="#001080" />
                    <SolidColorBrush x:Key="TypeBrush" Color="#267F99" />
                    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#0000FF" />
                    <SolidColorBrush x:Key="SyntaxIdentifierBrush" Color="#001080" />
                    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#098658" />
                    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A31515" />
                    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#008000" />
                    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SyntaxTextBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#E51400" />
                    <SolidColorBrush x:Key="IconDefaultBrush" Color="#555555" />
                    <SolidColorBrush x:Key="IconFolderBrush" Color="#8A6D1B" />
                    <SolidColorBrush x:Key="IconDependencyBrush" Color="#777777" />
                    <SolidColorBrush x:Key="IconCocoaBrush" Color="#B85C00" />
                    <SolidColorBrush x:Key="IconReferenceBrush" Color="#267F99" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Application.Styles>

</Application>
