<?xml version="1.0" encoding="utf-8"?>
<!-- Cocoa IDE 新建项目模板配置
     每个 Template 一个子目录（TemplatesRoot/<Key>/），File 列出目录内模板文件：
       Source = 模板目录内相对路径（固定文件名）
       Target = 生成到目标项目的文件名，支持 {Name} 占位（= 项目驼峰名）
     文件内容占位符：{{Name}}（项目驼峰名）、{{Tfm}}（TargetFramework，默认 net48）
     新增模板 = 建子目录放文件 + 在此注册规则即可。 -->
<Templates>
  <Template Key="console"
            Label="Console (Cocoa Language)"
            Description="控制台应用：可执行、.co 源码、入口 main.co">
    <File Source="main.co"          Target="main.co" />
    <File Source="Project.coproj"   Target="{Name}.coproj" />
  </Template>

  <Template Key="csharp"
            Label="Console (C# Language)"
            Description="控制台应用：C# 方言（.cs）可执行">
    <File Source="Class1.cs"        Target="{Name}.cs" />
    <File Source="Project.coproj"   Target="{Name}.coproj" />
  </Template>

  <Template Key="library"
            Label="Class Library"
            Description=".NET 类库：dll、.co 源码">
    <File Source="Class1.co"        Target="{Name}.co" />
    <File Source="Project.coproj"   Target="{Name}.coproj" />
  </Template>

  <Template Key="cocoa"
            Label="Cocoa Assembly"
            Description="Cocoa 程序集库：.coa 输出、.co 源码">
    <File Source="Class1.co"        Target="{Name}.co" />
    <File Source="Project.coproj"   Target="{Name}.coproj" />
  </Template>

  <Template Key="solution"
            Label="Solution"
            Description="解决方案：含一个 console 子项目"
            Special="Solution">
    <File Source="Project.cosln"    Target="{Name}.cosln" />
  </Template>
</Templates>
