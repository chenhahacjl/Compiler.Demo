// Cocoa UI 库 · System.UI（namespace System.UI）
// ImGui —— 立即模式门面**核心**（实例上下文，规避静态字段）：NewFrame → Begin/控件 → End → Render。
// 控件实现见 Widgets/*.co（同一 `partial class ImGui`，每控件一个文件）。

using System.Syscall

namespace System.UI
{
    public partial class ImGui
    {
        private field _drawList: ImGuiDrawList
        private field _style: ImGuiStyle
        private field _storage: ImGuiStorage
        private field _window: ImGuiWindow
        private field _io: ImGuiIO
        private field _mouseWasDown: bool
        private field _lastHovered: bool
        private field _indent: i32

        private field _textIds: i32[]
        private field _textLens: i32[]
        private field _textChars: char[]
        private field _textCapacity: i32
        private field _textMaxLen: i32
        private field _focusId: i32

        private field _parentWindow: ImGuiWindow
        private field _inChild: bool
        private field _childW: f32
        private field _childH: f32

        private field _colorStackIdx: i32[]
        private field _colorStackVal: i32[]
        private field _colorStackCount: i32
        private field _colorStackCapacity: i32
        private field _varStackIdx: i32[]
        private field _varStackVal: f32[]
        private field _varStackCount: i32
        private field _varStackCapacity: i32

        public constructor(capacity: i32, storageCapacity: i32)
        {
            _drawList = new ImGuiDrawList(capacity)
            _style = new ImGuiStyle()
            _style.MakeDark()
            _storage = new ImGuiStorage(storageCapacity)
            _window = new ImGuiWindow("", f32(0.0), f32(0.0), f32(1.0), f32(1.0))
            _mouseWasDown = false
            _lastHovered = false
            _indent = 0

            _textCapacity = 16
            _textMaxLen = 64
            _textIds = new i32[_textCapacity]
            _textLens = new i32[_textCapacity]
            _textChars = new char[_textCapacity * _textMaxLen]
            _focusId = 0
            _inChild = false
            _childW = f32(0.0)
            _childH = f32(0.0)

            _colorStackCapacity = 32
            _colorStackIdx = new i32[_colorStackCapacity]
            _colorStackVal = new i32[_colorStackCapacity]
            _colorStackCount = 0
            _varStackCapacity = 32
            _varStackIdx = new i32[_varStackCapacity]
            _varStackVal = new f32[_varStackCapacity]
            _varStackCount = 0
        }

        public property Style: ImGuiStyle
        {
            get
            {
                return _style
            }
        }

        public property DrawList: ImGuiDrawList
        {
            get
            {
                return _drawList
            }
        }

        public property Storage: ImGuiStorage
        {
            get
            {
                return _storage
            }
        }

        /// <summary>临时覆盖某颜色（须成对 PopStyleColor）。</summary>
        public function PushStyleColor(idx: i32, color: i32): void
        {
            if _colorStackCount >= _colorStackCapacity
            {
                return
            }

            _colorStackIdx[_colorStackCount] = idx
            _colorStackVal[_colorStackCount] = color
            _colorStackCount = _colorStackCount + 1
        }

        public function PopStyleColor(): void
        {
            if _colorStackCount > 0
            {
                _colorStackCount = _colorStackCount - 1
            }
        }

        /// <summary>临时覆盖某样式变量（须成对 PopStyleVar）。</summary>
        public function PushStyleVar(idx: ImGuiStyleVar, value: f32): void
        {
            if _varStackCount >= _varStackCapacity
            {
                return
            }

            _varStackIdx[_varStackCount] = i32(idx)
            _varStackVal[_varStackCount] = value
            _varStackCount = _varStackCount + 1
        }

        public function PopStyleVar(): void
        {
            if _varStackCount > 0
            {
                _varStackCount = _varStackCount - 1
            }
        }

        public function NewFrame(io: ImGuiIO): void
        {
            _io = io
            _drawList.Clear()
            _lastHovered = false
        }

        public function Render(): ImGuiDrawList
        {
            _mouseWasDown = _io.IsMouseDown(0)
            if _io != null
            {
                _io.MouseWheel = f32(0.0)
            }

            return _drawList
        }

        public function Begin(title: string, x: f32, y: f32, w: f32, h: f32): bool
        {
            _window = new ImGuiWindow(title, x, y, w, h)
            _indent = 0
            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(1))
            _drawList.AddRect(x, y, x + w, y + h, ColorOf(2))
            _window.CursorX = VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX)
            _window.CursorY = VarOf(ImGuiStyleVar.FramePaddingY, _style.FramePaddingY)
            return true
        }

        public function End(): void
        {
        }

        /// <summary>开始水平布局：后续控件持续同行（HStack）。</summary>
        public function BeginHorizontal(): void
        {
            _window.Horizontal = true
        }

        /// <summary>结束水平布局；下一个控件换行。</summary>
        public function EndHorizontal(): void
        {
            _window.Horizontal = false
        }

        /// <summary>子区域：独立裁剪 + 滚轮滚动（滚动量经 storage 持久）。</summary>
        public function BeginPanel(id: i32, w: f32, h: f32): bool
        {
            let x = _window.X + _window.CursorX
            let y = _window.Y + _window.CursorY
            _parentWindow = _window
            _childW = w
            _childH = h
            _inChild = true
            var scroll = _storage.GetFloat(id, f32(0.0))

            if _io != null && HitTest(x, y, w, h)
            {
                scroll = scroll - _io.MouseWheel * f32(24.0)
                if scroll < f32(0.0)
                {
                    scroll = f32(0.0)
                }

                _storage.SetFloat(id, scroll)
            }

            _window = new ImGuiWindow("", x, y - scroll, w, h)
            _window.CursorX = VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX)
            _window.CursorY = VarOf(ImGuiStyleVar.FramePaddingY, _style.FramePaddingY)
            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(7))
            _drawList.SetClipRect(x, y, x + w, y + h)
            return true
        }

        public function EndPanel(): void
        {
            _drawList.ClearClip()
            _inChild = false
            _window = _parentWindow
            ImGuiLayout.ItemSize(_window, _childW, _childH + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
        }

        /// <summary>当前 item 是否被鼠标悬停（上一个控件）。</summary>
        public function IsItemHovered(): bool
        {
            return _lastHovered
        }

        /// <summary>粗略文本宽度（等宽近似：8px/字符）。</summary>
        public function MeasureText(text: string): f32
        {
            return f32(text.Length) * f32(8.0)
        }

        // ─── 内部（供各控件 partial 段共享） ───

        private function ItemX(): f32
        {
            return _window.X + _window.CursorX + f32(_indent)
        }

        private function ItemY(): f32
        {
            return _window.Y + _window.CursorY
        }

        private function Clicked(hovered: bool): bool
        {
            return hovered && _io.IsMouseDown(0) && !_mouseWasDown
        }

        private function Fraction(value: f32, min: f32, max: f32): f32
        {
            if max <= min
            {
                return f32(0.0)
            }

            return (value - min) / (max - min)
        }

        private function DrawTrack(x: f32, y: f32, w: f32, h: f32, fraction: f32): void
        {
            var f = fraction
            if f < f32(0.0)
            {
                f = f32(0.0)
            }

            if f > f32(1.0)
            {
                f = f32(1.0)
            }

            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(7))
            _drawList.AddRectFilled(x, y, x + w * f, y + h, ColorOf(8))
            _drawList.AddRect(x, y, x + w, y + h, ColorOf(2))
        }

        private function ColorOf(idx: i32): i32
        {
            var i = _colorStackCount - 1
            while i >= 0
            {
                if _colorStackIdx[i] == idx
                {
                    return _colorStackVal[i]
                }

                i = i - 1
            }

            return _style.GetColor(idx)
        }

        private function VarOf(idx: ImGuiStyleVar, fallback: f32): f32
        {
            var i = _varStackCount - 1
            while i >= 0
            {
                if _varStackIdx[i] == i32(idx)
                {
                    return _varStackVal[i]
                }

                i = i - 1
            }

            return fallback
        }

        private function TextFind(id: i32): i32
        {
            var i: i32 = 0
            while i < _textCapacity
            {
                if _textIds[i] == id
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        private function TextCreate(id: i32): i32
        {
            var i: i32 = 0
            while i < _textCapacity
            {
                if _textIds[i] == 0
                {
                    _textIds[i] = id
                    _textLens[i] = 0
                    return i
                }

                i = i + 1
            }

            return 0
        }

        private function TextSlice(slot: i32, len: i32): string
        {
            var buf = new char[len]
            var i: i32 = 0
            while i < len
            {
                buf[i] = _textChars[slot * _textMaxLen + i]
                i = i + 1
            }

            return StringSyscall.StringFromChars(buf)
        }

        private function HitTest(x: f32, y: f32, w: f32, h: f32): bool
        {
            if _io == null
            {
                return false
            }

            if _io.MouseX < x
            {
                return false
            }

            if _io.MouseY < y
            {
                return false
            }

            if _io.MouseX > x + w
            {
                return false
            }

            if _io.MouseY > y + h
            {
                return false
            }

            return true
        }
    }
}
