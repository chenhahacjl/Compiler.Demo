// Cocoa UI 库 · System.UI（namespace System.UI）
// ImGui —— 立即模式门面（实例上下文，规避静态字段）：NewFrame → Begin/Widgets → End → Render。
// 布局：窗口局部 cursor 由 ImGuiLayout 推进 + 缩进 `_indent`；持久状态经 ImGuiStorage（id 键）。

using System.Syscall

namespace System.UI
{
    public class ImGui
    {
        private field _drawList: ImGuiDrawList
        private field _style: ImGuiStyle
        private field _storage: ImGuiStorage
        private field _window: ImGuiWindow
        private field _io: ImGuiIO
        private field _mouseWasDown: bool
        private field _lastHovered: bool
        private field _indent: i32

        private field _textIds: i32[]
        private field _textLens: i32[]
        private field _textChars: char[]
        private field _textCapacity: i32
        private field _textMaxLen: i32
        private field _focusId: i32

        private field _parentWindow: ImGuiWindow
        private field _inChild: bool
        private field _childW: f32
        private field _childH: f32

        private field _colorStackIdx: i32[]
        private field _colorStackVal: i32[]
        private field _colorStackCount: i32
        private field _colorStackCapacity: i32
        private field _varStackIdx: i32[]
        private field _varStackVal: f32[]
        private field _varStackCount: i32
        private field _varStackCapacity: i32

        public constructor(capacity: i32, storageCapacity: i32)
        {
            _drawList = new ImGuiDrawList(capacity)
            _style = new ImGuiStyle()
            _style.MakeDark()
            _storage = new ImGuiStorage(storageCapacity)
            _window = new ImGuiWindow("", f32(0.0), f32(0.0), f32(1.0), f32(1.0))
            _mouseWasDown = false
            _lastHovered = false
            _indent = 0

            _textCapacity = 16
            _textMaxLen = 64
            _textIds = new i32[_textCapacity]
            _textLens = new i32[_textCapacity]
            _textChars = new char[_textCapacity * _textMaxLen]
            _focusId = 0
            _inChild = false
            _childW = f32(0.0)
            _childH = f32(0.0)

            _colorStackCapacity = 32
            _colorStackIdx = new i32[_colorStackCapacity]
            _colorStackVal = new i32[_colorStackCapacity]
            _colorStackCount = 0
            _varStackCapacity = 32
            _varStackIdx = new i32[_varStackCapacity]
            _varStackVal = new f32[_varStackCapacity]
            _varStackCount = 0
        }

        public property Style: ImGuiStyle
        {
            get
            {
                return _style
            }
        }

        public property DrawList: ImGuiDrawList
        {
            get
            {
                return _drawList
            }
        }

        public property Storage: ImGuiStorage
        {
            get
            {
                return _storage
            }
        }

        /// <summary>临时覆盖某颜色（须成对 PopStyleColor）。</summary>
        public function PushStyleColor(idx: i32, color: i32): void
        {
            if _colorStackCount >= _colorStackCapacity
            {
                return
            }

            _colorStackIdx[_colorStackCount] = idx
            _colorStackVal[_colorStackCount] = color
            _colorStackCount = _colorStackCount + 1
        }

        public function PopStyleColor(): void
        {
            if _colorStackCount > 0
            {
                _colorStackCount = _colorStackCount - 1
            }
        }

        /// <summary>临时覆盖某样式变量（须成对 PopStyleVar）。</summary>
        public function PushStyleVar(idx: ImGuiStyleVar, value: f32): void
        {
            if _varStackCount >= _varStackCapacity
            {
                return
            }

            _varStackIdx[_varStackCount] = i32(idx)
            _varStackVal[_varStackCount] = value
            _varStackCount = _varStackCount + 1
        }

        public function PopStyleVar(): void
        {
            if _varStackCount > 0
            {
                _varStackCount = _varStackCount - 1
            }
        }

        public function NewFrame(io: ImGuiIO): void
        {
            _io = io
            _drawList.Clear()
            _lastHovered = false
        }

        public function Render(): ImGuiDrawList
        {
            _mouseWasDown = _io.IsMouseDown(0)
            if _io != null
            {
                _io.MouseWheel = f32(0.0)
            }

            return _drawList
        }

        public function Begin(title: string, x: f32, y: f32, w: f32, h: f32): bool
        {
            _window = new ImGuiWindow(title, x, y, w, h)
            _indent = 0
            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(1))
            _drawList.AddRect(x, y, x + w, y + h, ColorOf(2))
            _window.CursorX = VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX)
            _window.CursorY = VarOf(ImGuiStyleVar.FramePaddingY, _style.FramePaddingY)
            return true
        }

        public function End(): void
        {
        }

        /// <summary>子区域：独立裁剪 + 滚轮滚动（滚动量经 storage 持久）。</summary>
        public function BeginPanel(id: i32, w: f32, h: f32): bool
        {
            let x = _window.X + _window.CursorX
            let y = _window.Y + _window.CursorY
            _parentWindow = _window
            _childW = w
            _childH = h
            _inChild = true
            var scroll = _storage.GetFloat(id, f32(0.0))

            if _io != null && HitTest(x, y, w, h)
            {
                scroll = scroll - _io.MouseWheel * f32(24.0)
                if scroll < f32(0.0)
                {
                    scroll = f32(0.0)
                }

                _storage.SetFloat(id, scroll)
            }

            _window = new ImGuiWindow("", x, y - scroll, w, h)
            _window.CursorX = VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX)
            _window.CursorY = VarOf(ImGuiStyleVar.FramePaddingY, _style.FramePaddingY)
            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(7))
            _drawList.SetClipRect(x, y, x + w, y + h)
            return true
        }

        public function EndPanel(): void
        {
            _drawList.ClearClip()
            _inChild = false
            _window = _parentWindow
            ImGuiLayout.ItemSize(_window, _childW, _childH + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
        }

        /// <summary>当前 item 是否被鼠标悬停（上一个控件）。</summary>
        public function IsItemHovered(): bool
        {
            return _lastHovered
        }

        public function Indent(): void
        {
            _indent = _indent + 16
        }

        public function Unindent(): void
        {
            _indent = _indent - 16
            if _indent < 0
            {
                _indent = 0
            }
        }

        public function Label(text: string): void
        {
            let x = ItemX()
            let y = ItemY()
            _drawList.AddText(x, y, ColorOf(0), text)
            ImGuiLayout.ItemSize(_window, MeasureText(text), f32(18.0))
        }

        public function LabelColored(text: string, color: i32): void
        {
            let x = ItemX()
            let y = ItemY()
            _drawList.AddText(x, y, color, text)
            ImGuiLayout.ItemSize(_window, MeasureText(text), f32(18.0))
        }

        public function Separator(): void
        {
            let x = ItemX()
            let y = ItemY() + f32(4.0)
            let x2 = _window.X + _window.Width - VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX)
            _drawList.AddRectFilled(x, y, x2, y + f32(1.0), ColorOf(11))
            ImGuiLayout.ItemSize(_window, _window.Width - VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX) * f32(2.0), f32(9.0))
        }

        public function Spacing(): void
        {
            ImGuiLayout.ItemSize(_window, f32(0.0), VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
        }

        public function Dummy(w: f32, h: f32): void
        {
            ImGuiLayout.ItemSize(_window, w, h)
        }

        /// <summary>单行文本输入（点击聚焦；消费本帧 io 字符）。返回当前文本。</summary>
        public function TextBox(label: string, id: i32, maxLen: i32): string
        {
            var slot = TextFind(id)
            if slot < 0
            {
                slot = TextCreate(id)
            }

            var len = _textLens[slot]
            let x = ItemX()
            let y = ItemY()
            let w = f32(200.0)
            let h = f32(20.0)
            let hovered = HitTest(x, y, w, h)
            _lastHovered = hovered
            if Clicked(hovered)
            {
                _focusId = id
            }

            if _focusId == id && _io != null
            {
                var i: i32 = 0
                while i < _io.CharCount
                {
                    let c = _io.CharAt(i)
                    if c == 8
                    {
                        if len > 0
                        {
                            len = len - 1
                        }
                    }
                    else if c >= 32 && c < 127
                    {
                        if len < maxLen && len < _textMaxLen
                        {
                            _textChars[slot * _textMaxLen + len] = (char)c
                            len = len + 1
                        }
                    }

                    i = i + 1
                }

                _io.ClearChars()
            }

            _textLens[slot] = len
            var border = ColorOf(2)
            if _focusId == id
            {
                border = ColorOf(5)
            }

            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(7))
            _drawList.AddRect(x, y, x + w, y + h, border)
            _drawList.AddText(x + f32(4.0), y + f32(3.0), ColorOf(0), TextSlice(slot, len))
            _drawList.AddText(x + w + f32(8.0), y + f32(3.0), ColorOf(0), label)
            ImGuiLayout.ItemSize(_window, w + f32(8.0) + MeasureText(label), h + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
            return TextSlice(slot, len)
        }

        public function SameLine(): void
        {
            ImGuiLayout.SameLine(_window)
        }

        public function Button(label: string): bool
        {
            let x = ItemX()
            let y = ItemY()
            let w = MeasureText(label) + VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX) * f32(2.0)
            let h = f32(22.0)
            let hovered = HitTest(x, y, w, h)
            _lastHovered = hovered

            var col = ColorOf(3)
            if hovered
            {
                col = ColorOf(4)
            }

            _drawList.AddRectFilled(x, y, x + w, y + h, col)
            _drawList.AddRect(x, y, x + w, y + h, ColorOf(2))
            _drawList.AddText(x + VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX), y + VarOf(ImGuiStyleVar.FramePaddingY, _style.FramePaddingY), ColorOf(0), label)
            ImGuiLayout.ItemSize(_window, w, h + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
            return Clicked(hovered)
        }

        public function CheckBox(label: string, id: i32): bool
        {
            let x = ItemX()
            let y = ItemY()
            let box = f32(14.0)
            let hovered = HitTest(x, y, box, box)
            _lastHovered = hovered

            var value = _storage.GetBool(id, false)
            if Clicked(hovered)
            {
                value = !value
                _storage.SetBool(id, value)
            }

            _drawList.AddRectFilled(x, y, x + box, y + box, ColorOf(7))
            _drawList.AddRect(x, y, x + box, y + box, ColorOf(2))
            if value
            {
                _drawList.AddRectFilled(x + f32(3.0), y + f32(3.0), x + box - f32(3.0), y + box - f32(3.0), ColorOf(6))
            }

            _drawList.AddText(x + box + f32(6.0), y, ColorOf(0), label)
            ImGuiLayout.ItemSize(_window, box + f32(6.0) + MeasureText(label), box + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
            return value
        }

        public function TrackBarFloat(label: string, id: i32, min: f32, max: f32): f32
        {
            let x = ItemX()
            let y = ItemY()
            let w = f32(180.0)
            let h = f32(18.0)
            let hovered = HitTest(x, y, w, h)
            _lastHovered = hovered

            var value = _storage.GetFloat(id, min)
            if hovered && _io.IsMouseDown(0)
            {
                var t = (_io.MouseX - x) / w
                if t < f32(0.0)
                {
                    t = f32(0.0)
                }

                if t > f32(1.0)
                {
                    t = f32(1.0)
                }

                value = min + t * (max - min)
                _storage.SetFloat(id, value)
            }

            DrawTrack(x, y, w, h, Fraction(value, min, max))
            _drawList.AddText(x + w + f32(8.0), y, ColorOf(0), label)
            ImGuiLayout.ItemSize(_window, w + f32(8.0) + MeasureText(label), h + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
            return value
        }

        public function TrackBar(label: string, id: i32, min: i32, max: i32): i32
        {
            let x = ItemX()
            let y = ItemY()
            let w = f32(180.0)
            let h = f32(18.0)
            let hovered = HitTest(x, y, w, h)
            _lastHovered = hovered

            var value = _storage.GetInt(id, min)
            if hovered && _io.IsMouseDown(0)
            {
                var t = (_io.MouseX - x) / w
                if t < f32(0.0)
                {
                    t = f32(0.0)
                }

                if t > f32(1.0)
                {
                    t = f32(1.0)
                }

                value = min + i32(t * f32(max - min))
                if value < min
                {
                    value = min
                }

                if value > max
                {
                    value = max
                }

                _storage.SetInt(id, value)
            }

            DrawTrack(x, y, w, h, Fraction(f32(value), f32(min), f32(max)))
            _drawList.AddText(x + w + f32(8.0), y, ColorOf(0), label)
            ImGuiLayout.ItemSize(_window, w + f32(8.0) + MeasureText(label), h + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
            return value
        }

        public function ProgressBar(fraction: f32): void
        {
            let x = ItemX()
            let y = ItemY()
            let w = f32(200.0)
            let h = f32(16.0)
            var f = fraction
            if f < f32(0.0)
            {
                f = f32(0.0)
            }

            if f > f32(1.0)
            {
                f = f32(1.0)
            }

            DrawTrack(x, y, w, h, f)
            ImGuiLayout.ItemSize(_window, w, h + VarOf(ImGuiStyleVar.ItemSpacingY, _style.ItemSpacingY))
        }

        /// <summary>可折叠标题栏；返回 true 表示展开（状态经 storage 持久）。</summary>
        public function GroupBox(label: string, id: i32): bool
        {
            var open = _storage.GetBool(id, true)
            let x = ItemX()
            let y = ItemY()
            let w = _window.Width - VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX) * f32(2.0) - f32(_indent)
            let h = f32(20.0)
            let hovered = HitTest(x, y, w, h)
            _lastHovered = hovered
            if Clicked(hovered)
            {
                open = !open
                _storage.SetBool(id, open)
            }

            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(10))
            var arrow = "> "
            if open
            {
                arrow = "v "
            }

            _drawList.AddText(x + f32(4.0), y + f32(3.0), ColorOf(0), arrow + label)
            ImGuiLayout.ItemSize(_window, w, h + f32(2.0))
            return open
        }

        /// <summary>树节点（展开时自动缩进；须配对 TreePop）。</summary>
        public function TreeView(label: string, id: i32): bool
        {
            var open = _storage.GetBool(id, false)
            let x = ItemX()
            let y = ItemY()
            let w = _window.Width - VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX) * f32(2.0) - f32(_indent)
            let h = f32(18.0)
            let hovered = HitTest(x, y, w, h)
            _lastHovered = hovered
            if Clicked(hovered)
            {
                open = !open
                _storage.SetBool(id, open)
            }

            var arrow = "> "
            if open
            {
                arrow = "v "
            }

            _drawList.AddText(x, y, ColorOf(0), arrow + label)
            ImGuiLayout.ItemSize(_window, w, h)
            if open
            {
                Indent()
            }

            return open
        }

        public function EndTreeView(): void
        {
            Unindent()
        }

        /// <summary>粗略文本宽度（等宽近似：8px/字符）。</summary>
        public function MeasureText(text: string): f32
        {
            return f32(text.Length) * f32(8.0)
        }

        // ─── 内部 ───

        private function ItemX(): f32
        {
            return _window.X + _window.CursorX + f32(_indent)
        }

        private function ItemY(): f32
        {
            return _window.Y + _window.CursorY
        }

        private function Clicked(hovered: bool): bool
        {
            return hovered && _io.IsMouseDown(0) && !_mouseWasDown
        }

        private function Fraction(value: f32, min: f32, max: f32): f32
        {
            if max <= min
            {
                return f32(0.0)
            }

            return (value - min) / (max - min)
        }

        private function DrawTrack(x: f32, y: f32, w: f32, h: f32, fraction: f32): void
        {
            var f = fraction
            if f < f32(0.0)
            {
                f = f32(0.0)
            }

            if f > f32(1.0)
            {
                f = f32(1.0)
            }

            _drawList.AddRectFilled(x, y, x + w, y + h, ColorOf(7))
            _drawList.AddRectFilled(x, y, x + w * f, y + h, ColorOf(8))
            _drawList.AddRect(x, y, x + w, y + h, ColorOf(2))
        }

        private function ColorOf(idx: i32): i32
        {
            var i = _colorStackCount - 1
            while i >= 0
            {
                if _colorStackIdx[i] == idx
                {
                    return _colorStackVal[i]
                }

                i = i - 1
            }

            return _style.GetColor(idx)
        }

        private function VarOf(idx: ImGuiStyleVar, fallback: f32): f32
        {
            var i = _varStackCount - 1
            while i >= 0
            {
                if _varStackIdx[i] == i32(idx)
                {
                    return _varStackVal[i]
                }

                i = i - 1
            }

            return fallback
        }

        private function TextFind(id: i32): i32
        {
            var i: i32 = 0
            while i < _textCapacity
            {
                if _textIds[i] == id
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        private function TextCreate(id: i32): i32
        {
            var i: i32 = 0
            while i < _textCapacity
            {
                if _textIds[i] == 0
                {
                    _textIds[i] = id
                    _textLens[i] = 0
                    return i
                }

                i = i + 1
            }

            return 0
        }

        private function TextSlice(slot: i32, len: i32): string
        {
            var buf = new char[len]
            var i: i32 = 0
            while i < len
            {
                buf[i] = _textChars[slot * _textMaxLen + i]
                i = i + 1
            }

            return StringSyscall.StringFromChars(buf)
        }

        private function HitTest(x: f32, y: f32, w: f32, h: f32): bool
        {
            if _io == null
            {
                return false
            }

            if _io.MouseX < x
            {
                return false
            }

            if _io.MouseY < y
            {
                return false
            }

            if _io.MouseX > x + w
            {
                return false
            }

            if _io.MouseY > y + h
            {
                return false
            }

            return true
        }
    }
}
