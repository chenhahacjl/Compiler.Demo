// Cocoa UI 库 · System.UI · 控件：Separator（分隔线）
namespace System.UI
{
    public partial class ImGui
    {
        public function Separator(): void
        {
            let x = ItemX()
            let y = ItemY() + f32(4.0)
            let x2 = _window.X + _window.Width - VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX)
            _drawList.AddRectFilled(x, y, x2, y + f32(1.0), ColorOf(11))
            ImGuiLayout.ItemSize(_window, _window.Width - VarOf(ImGuiStyleVar.FramePaddingX, _style.FramePaddingX) * f32(2.0), f32(9.0))
        }
    }
}
