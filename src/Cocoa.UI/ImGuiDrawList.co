// Cocoa UI �?· System.UI（namespace System.UI�?// ImGuiDrawList —�?顶点/索引并行数组（模�?vector，无 struct 数组依赖）�?// 顶点：pos(x,y) + uv(u,v) + col(packed ABGR i32)；索引三角形列表�?
namespace System.UI
{
    public class ImGuiDrawList
    {
        private field _posX: f32[]
        private field _posY: f32[]
        private field _uvX: f32[]
        private field _uvY: f32[]
        private field _col: i32[]
        private field _idx: i32[]
        private field _vtxCount: i32
        private field _idxCount: i32

        private field _textX: f32[]
        private field _textY: f32[]
        private field _textColor: i32[]
        private field _texts: string[]
        private field _textCount: i32
        private field _textCapacity: i32

        private field _hasClip: bool
        private field _clipX0: f32
        private field _clipY0: f32
        private field _clipX1: f32
        private field _clipY1: f32

        public constructor(capacity: i32)
        {
            var cap: i32 = capacity
            if cap < 16
            {
                cap = 16
            }

            _posX = new f32[cap]
            _posY = new f32[cap]
            _uvX = new f32[cap]
            _uvY = new f32[cap]
            _col = new i32[cap]
            _idx = new i32[cap * 3]
            _vtxCount = 0
            _idxCount = 0

            _textCapacity = cap
            _textX = new f32[cap]
            _textY = new f32[cap]
            _textColor = new i32[cap]
            _texts = new string[cap]
            _textCount = 0

            _hasClip = false
            _clipX0 = f32(0.0)
            _clipY0 = f32(0.0)
            _clipX1 = f32(0.0)
            _clipY1 = f32(0.0)
        }

        /// <summary>设置裁剪矩形（后续图元按此裁剪；用于子区域滚动）。</summary>
        public function SetClipRect(x0: f32, y0: f32, x1: f32, y1: f32): void
        {
            _hasClip = true
            _clipX0 = x0
            _clipY0 = y0
            _clipX1 = x1
            _clipY1 = y1
        }

        public function ClearClip(): void
        {
            _hasClip = false
        }

        public function Clear(): void
        {
            _vtxCount = 0
            _idxCount = 0
            _textCount = 0
        }

        public property TextCount: i32
        {
            get
            {
                return _textCount
            }
        }

        /// <summary>登记一段文本（渲染后端延迟消费）。</summary>
        public function AddText(x: f32, y: f32, color: i32, text: string): void
        {
            if _hasClip
            {
                if y > _clipY1
                {
                    return
                }

                if y + f32(16.0) < _clipY0
                {
                    return
                }

                if x > _clipX1
                {
                    return
                }
            }

            if _textCount >= _textCapacity
            {
                return
            }

            _textX[_textCount] = x
            _textY[_textCount] = y
            _textColor[_textCount] = color
            _texts[_textCount] = text
            _textCount = _textCount + 1
        }

        public function TextX(i: i32): f32
        {
            return _textX[i]
        }

        public function TextY(i: i32): f32
        {
            return _textY[i]
        }

        public function TextColor(i: i32): i32
        {
            return _textColor[i]
        }

        public function Text(i: i32): string
        {
            return _texts[i]
        }

        public property VertexCount: i32
        {
            get
            {
                return _vtxCount
            }
        }

        public property IndexCount: i32
        {
            get
            {
                return _idxCount
            }
        }

        public function AddVertex(x: f32, y: f32, u: f32, v: f32, col: i32): void
        {
            _posX[_vtxCount] = x
            _posY[_vtxCount] = y
            _uvX[_vtxCount] = u
            _uvY[_vtxCount] = v
            _col[_vtxCount] = col
            _vtxCount = _vtxCount + 1
        }

        public function AddIndex(i: i32): void
        {
            _idx[_idxCount] = i
            _idxCount = _idxCount + 1
        }

        /// <summary>实心矩形�? 顶点 + 6 索引）�?/summary>
        public function AddRectFilled(minX: f32, minY: f32, maxX: f32, maxY: f32, col: i32): void
        {
            var loX = minX
            var loY = minY
            var hiX = maxX
            var hiY = maxY
            if _hasClip
            {
                if loX < _clipX0
                {
                    loX = _clipX0
                }

                if loY < _clipY0
                {
                    loY = _clipY0
                }

                if hiX > _clipX1
                {
                    hiX = _clipX1
                }

                if hiY > _clipY1
                {
                    hiY = _clipY1
                }

                if hiX <= loX || hiY <= loY
                {
                    return
                }
            }

            let zero: f32 = f32(0.0)
            let one: f32 = f32(1.0)
            let start = _vtxCount

            AddVertex(loX, loY, zero, zero, col)
            AddVertex(hiX, loY, one, zero, col)
            AddVertex(hiX, hiY, one, one, col)
            AddVertex(loX, hiY, zero, one, col)

            AddIndex(start)
            AddIndex(start + 1)
            AddIndex(start + 2)
            AddIndex(start)
            AddIndex(start + 2)
            AddIndex(start + 3)
        }

        /// <summary>矩形边框（四�?1px 实心边）�?/summary>
        public function AddRect(minX: f32, minY: f32, maxX: f32, maxY: f32, col: i32): void
        {
            let one: f32 = f32(1.0)

            AddRectFilled(minX, minY, maxX, minY + one, col)
            AddRectFilled(minX, maxY - one, maxX, maxY, col)
            AddRectFilled(minX, minY, minX + one, maxY, col)
            AddRectFilled(maxX - one, minY, maxX, maxY, col)
        }

        /// <summary>gdi 翻译输出：顶�?x/y/color 读取（供后端遍历，见 Win32GDIBackend）�?/summary>
        public function PosX(i: i32): f32
        {
            return _posX[i]
        }

        public function PosY(i: i32): f32
        {
            return _posY[i]
        }

        public function Color(i: i32): i32
        {
            return _col[i]
        }

        public function Index(i: i32): i32
        {
            return _idx[i]
        }
    }
}
