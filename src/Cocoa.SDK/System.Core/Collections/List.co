// Cocoa 系统标准库 · System.Collections 模块
// List<T> 动态数组（6e-M22 C8，6e-G7 ③b 对齐 C# System.Collections.Generic.List<T>）
// 基于原生数组 + 扩容策略（容量 ×2）。
// 实现 IList<T>/ICollection<T>/IEnumerable<T>/IReadOnlyList<T>/IReadOnlyCollection<T>。

namespace System.Collections.Generic
{
    public class List<T> extends IList<T>, ICollection<T>, IEnumerable<T>, IReadOnlyList<T>, IReadOnlyCollection<T>
    {
        private _items: T[]
        private _count: i32

        public constructor()
        {
            _items = new T[4]
            _count = 0
        }

        // ------------------------------------------------------------------
        // 属性
        // ------------------------------------------------------------------

        public property Count: i32
        {
            get
            {
                return _count
            }
        }

        /// <summary>BCL ICollection&lt;T&gt;.IsReadOnly——List 始终可变，返回 false。</summary>
        public property IsReadOnly: bool
        {
            get
            {
                return false
            }
        }

        /// <summary>当前容量（含未使用槽位）。</summary>
        public property Capacity: i32
        {
            get
            {
                return _items.Length
            }
        }

        // ------------------------------------------------------------------
        // 元素访问
        // ------------------------------------------------------------------

        public property this[index: i32]: T
        {
            get
            {
                return _items[index]
            }
            set
            {
                _items[index] = value
            }
        }

        // ------------------------------------------------------------------
        // 增删
        // ------------------------------------------------------------------

        /// <summary>尾部追加——摊还 O(1)；BCL ICollection&lt;T&gt;.Add 返回 true。</summary>
        public function Add(item: T): bool
        {
            EnsureCapacity(_count + 1)
            _items[_count] = item
            _count = _count + 1
            return true
        }

        /// <summary>清空全部元素（缓冲保留复用）。</summary>
        public function Clear(): void
        {
            _count = 0
        }

        /// <summary>在 index 处插入；其后元素整体后移。</summary>
        public function Insert(index: i32, item: T): void
        {
            EnsureCapacity(_count + 1)
            var i = _count
            while i > index
            {
                _items[i] = _items[i - 1]
                i = i - 1
            }

            _items[index] = item
            _count = _count + 1
        }

        /// <summary>移除 index 处元素；其后元素整体前移。</summary>
        public function RemoveAt(index: i32): void
        {
            var i = index
            while i < _count - 1
            {
                _items[i] = _items[i + 1]
                i = i + 1
            }

            _count = _count - 1
        }

        /// <summary>首次出现 item 的下标；未找到返回 -1。</summary>
        public function IndexOf(item: T): i32
        {
            var i = 0
            while i < _count
            {
                if SameItem(_items[i], item)
                {
                    return i
                }

                i = i + 1
            }

            return -1
        }

        private function SameItem(a: T, b: T): bool
        {
            return a.GetHashCode() == b.GetHashCode() && a.Equals(b)
        }

        /// <summary>BCL ICollection&lt;T&gt;.Contains——是否存在等于 item 的元素。</summary>
        public function Contains(item: T): bool
        {
            return IndexOf(item) >= 0
        }

        /// <summary>BCL ICollection&lt;T&gt;.Remove——移除首个匹配项，成功返回 true。</summary>
        public function Remove(item: T): bool
        {
            var index = IndexOf(item)
            if index >= 0
            {
                RemoveAt(index)
                return true
            }

            return false
        }

        // ------------------------------------------------------------------
        // 导出
        // ------------------------------------------------------------------

        /// <summary>导出定长副本。</summary>
        public function ToArray(): T[]
        {
            var copy = new T[_count]
            var i = 0
            while i < _count
            {
                copy[i] = _items[i]
                i = i + 1
            }

            return copy
        }

        /// <summary>BCL ICollection&lt;T&gt;.CopyTo——将元素复制到 array 自 arrayIndex 起。</summary>
        public function CopyTo(array: T[], arrayIndex: i32): void
        {
            var i = 0
            while i < _count
            {
                array[arrayIndex + i] = _items[i]
                i = i + 1
            }
        }

        // ------------------------------------------------------------------
        // 枚举（支持 foreach）
        // ------------------------------------------------------------------

        /// <summary>返回快照数组 + 长度（与 HashSet/Queue/Stack 枚举器同构——传快照数组而非 this 引用，物化期签名稳定）。</summary>
        public function GetEnumerator(): ListEnumerator<T>
        {
            return new ListEnumerator<T>(_items, _count)
        }

        // ------------------------------------------------------------------
        // 内部
        // ------------------------------------------------------------------

        private function EnsureCapacity(required: i32): void
        {
            if required <= _items.Length
            {
                return
            }

            var newLen = _items.Length * 2
            while newLen < required
            {
                newLen = newLen * 2
            }

            var grown = new T[newLen]
            var i = 0
            while i < _count
            {
                grown[i] = _items[i]
                i = i + 1
            }

            _items = grown
        }
    }

/// <summary>List&lt;T&gt; 的前向枚举器（支撑 foreach），实现 IEnumerator&lt;T&gt;。</summary>
public class ListEnumerator<T> extends IEnumerator<T>
{
    private _items: T[]
    private _count: i32
    private _index: i32

    public constructor(items: T[], count: i32)
    {
        _items = items
        _count = count
        _index = -1
    }

    /// <summary>推进到下一元素，越界返回 false。</summary>
    public function MoveNext(): bool
    {
        _index = _index + 1
        return _index < _count
    }

    /// <summary>当前元素（只读）。</summary>
    public property Current: T
    {
        get
        {
            return _items[_index]
        }
    }
}
}
