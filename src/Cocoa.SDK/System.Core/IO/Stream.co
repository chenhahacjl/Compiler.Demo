// Cocoa 系统标准库 · System.IO 模块（6e-G7 全面门面化的建坯）
// Stream：纯接口（不连 BCL 抽象类；native 执行具体实现体）。属性经 accessor + props 序列化。
// 说明：BCL 对应物为 `public abstract partial class Stream : IDisposable`；本库侧以接口等形仿真
// （6f 暂以接口实现跨后端口一致；抽象基类 + facade 组合在编译器侧仍有 NRE，见后续 #stream-facade）。

namespace System.IO
{
    public interface Stream
    {
        property CanRead: bool { get; }
        property CanWrite: bool { get; }
        property CanSeek: bool { get; }
        property Length: i64 { get; }
        property Position: i64 { get; set; }

        function Read(data: u8[], offset: i32, count: i32): i32
        function Write(data: u8[], offset: i32, count: i32): void
        function Flush(): void
        function Close(): void
        function Dispose(): void
        function Seek(offset: i64, origin: i32): i64
    }
}