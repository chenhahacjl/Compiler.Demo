// Cocoa 系统标准库 · System.Core 封装层（namespace System）
// class Console —— Write/WriteLine/ReadLine/ReadKey（调 Runtime.WriteLine/Write/ReadLine/ReadKey），C# 同构静态类
// 详细分层设计见 docs-dev/标准库设计.md

namespace System
{
    class Console
    {
        static function WriteLine(): void
        {
            Runtime.WriteLine("")
        }

        static function WriteLine(text: string): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: i32): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: f64): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: bool): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: char): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: u8): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: i64): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: i8): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: i16): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: u16): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: u32): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: u64): void
        {
            Runtime.WriteLine(text)
        }

        static function WriteLine(text: f32): void
        {
            Runtime.WriteLine(text)
        }

        static function Write(text: string): void
        {
            Runtime.Write(text)
        }

        static function Write(text: i32): void
        {
            Runtime.Write(text)
        }

        static function Write(text: f64): void
        {
            Runtime.Write(text)
        }

        static function Write(text: bool): void
        {
            Runtime.Write(text)
        }

        static function Write(text: char): void
        {
            Runtime.Write(text)
        }

        static function Write(text: u8): void
        {
            Runtime.Write(text)
        }

        static function Write(text: i64): void
        {
            Runtime.Write(text)
        }

        static function Write(text: i8): void
        {
            Runtime.Write(text)
        }

        static function Write(text: i16): void
        {
            Runtime.Write(text)
        }

        static function Write(text: u16): void
        {
            Runtime.Write(text)
        }

        static function Write(text: u32): void
        {
            Runtime.Write(text)
        }

        static function Write(text: u64): void
        {
            Runtime.Write(text)
        }

        static function Write(text: f32): void
        {
            Runtime.Write(text)
        }

        static function ReadLine(): string
        {
            return Runtime.ReadLine()
        }

        static function ReadKey(intercept: bool): char
        {
            return Runtime.ReadKey(intercept)
        }

        static function Beep(frequency: i32, duration: i32): void
        {
            Runtime.Beep(frequency, duration)
        }
    }
}
