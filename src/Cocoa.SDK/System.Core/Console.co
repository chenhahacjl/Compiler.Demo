// Cocoa 系统标准库 · System.Core（namespace System）——BCL 存在类型即 facade（Console/Environment 因 IL 后端未覆盖其程序集引用层级，保持真实类+syscall 转发，见 docs-dev/标准库设计.md）
// facade class Console —— facade：IL 直连 System.Console；native/Evaluator 转发 System.Syscall.ConsoleSyscall
using System.Syscall

namespace System
{
    facade class Console
    {
        static function WriteLine(): void
        {
            ConsoleSyscall.WriteLine("")
        }

        static function WriteLine(text: string): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: i32): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: f64): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: bool): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: char): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: i64): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: u32): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: u64): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function WriteLine(text: f32): void
        {
            ConsoleSyscall.WriteLine(text)
        }

        static function Write(text: string): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: i32): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: f64): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: bool): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: char): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: i64): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: u32): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: u64): void
        {
            ConsoleSyscall.Write(text)
        }

        static function Write(text: f32): void
        {
            ConsoleSyscall.Write(text)
        }

        static function ReadLine(): string
        {
            return ConsoleSyscall.ReadLine()
        }

        static function ReadKey(intercept: bool): char
        {
            return ConsoleSyscall.ReadKey(intercept)
        }

        static function Beep(frequency: i32, duration: i32): void
        {
            ConsoleSyscall.Beep(frequency, duration)
        }
    }
}