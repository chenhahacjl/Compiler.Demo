// Cocoa system standard library . Syscall collection (namespace System.Syscall)
// - StringFromBytes/StringToBytes: UTF-8 <-> UTF-16 implemented in Cocoa (three backends identical)
// - StringFromChars: char[] -> string (runtime primitive, no encoding logic)

namespace System.Syscall
{
    public static class StringSyscall
    {
        public static function StringFromBytes(data: u8[]): string
        {
            var chars = new char[data.Length]
            var o = 0
            var i = 0
            while i < data.Length
            {
                var b0: i32 = data[i]
                if b0 < 0x80
                {
                    chars[o] = (char)b0
                    o = o + 1
                    i = i + 1
                }
                else if (b0 & 0xE0) == 0xC0
                {
                    var b1: i32 = data[i + 1]
                    chars[o] = (char)(((b0 & 0x1F) << 6) | (b1 & 0x3F))
                    o = o + 1
                    i = i + 2
                }
                else if (b0 & 0xF0) == 0xE0
                {
                    var b1: i32 = data[i + 1]
                    var b2: i32 = data[i + 2]
                    chars[o] = (char)(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
                    o = o + 1
                    i = i + 3
                }
                else
                {
                    var b1: i32 = data[i + 1]
                    var b2: i32 = data[i + 2]
                    var b3: i32 = data[i + 3]
                    var cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                    var t = cp - 0x10000
                    chars[o] = (char)(0xD800 | (t >> 10))
                    chars[o + 1] = (char)(0xDC00 | (t & 0x3FF))
                    o = o + 2
                    i = i + 4
                }
            }
            var result = new char[o]
            var k = 0
            while k < o
            {
                result[k] = chars[k]
                k = k + 1
            }
            return StringFromChars(result)
        }

        public static function StringToBytes(text: string): u8[]
        {
            var len = text.Length
            var n = 0
            var i = 0
            while i < len
            {
                var cp = i32(text[i])
                if cp < 0x80
                {
                    n = n + 1
                    i = i + 1
                }
                else if cp < 0x800
                {
                    n = n + 2
                    i = i + 1
                }
                else if cp >= 0xD800 && cp < 0xDC00
                {
                    n = n + 4
                    i = i + 2
                }
                else
                {
                    n = n + 3
                    i = i + 1
                }
            }
            var bytes = new u8[n]
            var o = 0
            var j = 0
            while j < len
            {
                var cp = i32(text[j])
                if cp < 0x80
                {
                    bytes[o] = (u8)cp
                    o = o + 1
                    j = j + 1
                }
                else if cp < 0x800
                {
                    bytes[o] = (u8)(0xC0 | (cp >> 6))
                    bytes[o + 1] = (u8)(0x80 | (cp & 0x3F))
                    o = o + 2
                    j = j + 1
                }
                else if cp >= 0xD800 && cp < 0xDC00
                {
                    var lo = i32(text[j + 1])
                    var c = 0x10000 | ((cp - 0xD800) << 10) | (lo - 0xDC00)
                    bytes[o] = (u8)(0xF0 | (c >> 18))
                    bytes[o + 1] = (u8)(0x80 | ((c >> 12) & 0x3F))
                    bytes[o + 2] = (u8)(0x80 | ((c >> 6) & 0x3F))
                    bytes[o + 3] = (u8)(0x80 | (c & 0x3F))
                    o = o + 4
                    j = j + 2
                }
                else
                {
                    bytes[o] = (u8)(0xE0 | (cp >> 12))
                    bytes[o + 1] = (u8)(0x80 | ((cp >> 6) & 0x3F))
                    bytes[o + 2] = (u8)(0x80 | (cp & 0x3F))
                    o = o + 3
                    j = j + 1
                }
            }
            return bytes
        }

        public static syscall function StringFromChars(chars: char[]): string
    }
}