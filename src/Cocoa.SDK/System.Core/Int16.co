// Cocoa 系统标准库 · System.Core 基元 facade（namespace System，6e-M19 M2-b）

namespace System
{
    public facade class Int16
    {
        public function ToString(): string
        {
            return Runtime.Int32ToString(i32(this))
        }
        public function CompareTo(value: i16): i32
        {
            if this < value { return -1 }
            if this > value { return 1 }
            return 0
        }
        public static function Parse(s: string): i16
        {
            return i16(Runtime.ParseInt64(s))
        }
        public function Equals(value: i16): bool
        {
            return this == value
        }

        public function GetHashCode(): i32
        {
            return 0
        }

        public function ToString(format: string): string
        {
            return this.ToString()
        }

        public static function TryParse(s: string, out result: i16): bool
        {
            result = 0
            return false
        }

    }
}

