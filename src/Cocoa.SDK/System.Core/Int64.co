// Cocoa 系统标准库 · System.Core 基元 facade（namespace System）
// class Int64 —— i64 的成员面载体（6e-M19 M2-b，对齐 C# System.Int64）。

namespace System
{
    public facade class Int64
    {
        public function ToString(): string
        {
            return Runtime.Int64ToString(this)
        }

        public function CompareTo(value: i64): i32
        {
            if this < value
            {
                return -1
            }
            if this > value
            {
                return 1
            }
            return 0
        }

        public static function Parse(s: string): i64
        {
            return Runtime.ParseInt64(s)
        }
        public function Equals(value: i64): bool
        {
            return this == value
        }

        public function GetHashCode(): i32
        {
            return 0
        }

        public function ToString(format: string): string
        {
            return this.ToString()
        }

        public static function TryParse(s: string, out result: i64): bool
        {
            result = 0
            let len = s.Length
            if len == 0
            {
                return false
            }

            var index = 0
            var negative = false
            let first = s[0]
            if first == '+'
            {
                index = 1
            }
            else if first == '-'
            {
                negative = true
                index = 1
            }

            if index >= len
            {
                return false
            }

            // 幅值用 u64 累积（可容纳 |long.MinValue| = 2^63），逐位防溢出。
            var acc: u64 = 0
            while index < len
            {
                let c = s[index]
                if Char.IsDigit(c)
                {
                    let d: u64 = u64(i32(c) - 48)
                    if acc > (9223372036854775808ul - d) / 10ul
                    {
                        return false
                    }

                    acc = acc * 10ul + d
                }
                else
                {
                    return false
                }

                index = index + 1
            }

            if negative
            {
                if acc == 9223372036854775808ul
                {
                    result = -9223372036854775807l - 1l
                    return true
                }

                if acc > 9223372036854775807ul
                {
                    return false
                }

                result = -i64(acc)
                return true
            }

            if acc > 9223372036854775807ul
            {
                return false
            }

            result = i64(acc)
            return true
        }

    }
}
