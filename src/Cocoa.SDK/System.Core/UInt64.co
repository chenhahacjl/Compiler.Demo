// Cocoa 系统标准库 · System.Core 基元 facade（namespace System，6e-M19 M2-b）

namespace System
{
    public facade class UInt64
    {
        public function ToString(): string
        {
            return Runtime.UInt64ToString(this)
        }
        public function CompareTo(value: u64): i32
        {
            if this < value { return -1 }
            if this > value { return 1 }
            return 0
        }
        public function Equals(value: u64): bool
        {
            return this == value
        }

        public function GetHashCode(): i32
        {
            return 0
        }

        public function ToString(format: string): string
        {
            return this.ToString()
        }

        public static function TryParse(s: string, out result: u64): bool
        {
            result = 0
            let len = s.Length
            if len == 0
            {
                return false
            }

            var index = 0
            let first = s[0]
            if first == '+'
            {
                index = 1
            }
            else if first == '-'
            {
                return false
            }

            if index >= len
            {
                return false
            }

            // u64 累积，逐位防溢出（上限 2^64-1）。
            var acc: u64 = 0
            while index < len
            {
                let c = s[index]
                if Char.IsDigit(c)
                {
                    let d: u64 = u64(i32(c) - 48)
                    if acc > (18446744073709551615ul - d) / 10ul
                    {
                        return false
                    }

                    acc = acc * 10ul + d
                }
                else
                {
                    return false
                }

                index = index + 1
            }

            result = acc
            return true
        }

    }
}
