// Cocoa 系统标准库 · System.Core 基元 facade（namespace System）
// class Boolean —— bool 的成员面载体（6e-M19 M2-b，对齐 C# System.Boolean）。

namespace System
{
    public facade class Boolean
    {
        public function ToString(): string
        {
            return Runtime.BooleanToString(this)
        }

        public static function Parse(s: string): bool
        {
            return s == "True"
        }

        public static function Parse(s: string, ignoreCase: bool): bool
        {
            if ignoreCase
            {
                return s.ToLower() == "true"
            }
            return s == "True"
        }
        public function Equals(value: bool): bool
        {
            return this == value
        }

        public function GetHashCode(): i32
        {
            return 0
        }

        public function ToString(format: string): string
        {
            return this.ToString()
        }

        public static function TryParse(s: string, out result: bool): bool
        {
            result = false
            return false
        }

    }
}
