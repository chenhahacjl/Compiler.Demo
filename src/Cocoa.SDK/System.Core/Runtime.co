// Cocoa 系统标准库 · System.Core 内部调用层（namespace System）
// class Runtime —— syscall 声明（编译器内部原语，三后端按 BuiltinKind 分发；完整名 System.Runtime）
// 详细分层设计见 docs-dev/标准库设计.md

namespace System
{
    class Runtime
    {
        syscall function WriteLine(text: any): void
        syscall function Write(text: any): void
        syscall function ReadLine(): string
        syscall function ReadKey(intercept: bool): char
        syscall function Random(max: i32): i32
        syscall function Sleep(ms: i32): void
        syscall function TickCount(): i32
        syscall function Exit(code: i32): void
        syscall function Sqrt(x: f64): f64
        syscall function Floor(x: f64): f64
        syscall function Ceiling(x: f64): f64
        syscall function Truncate(x: f64): f64
        syscall function Round(x: f64): f64
        syscall function Beep(frequency: i32, duration: i32): void
        syscall function Int32ToString(value: i32): string
        syscall function Int64ToString(value: i64): string
        syscall function DoubleToString(value: f64): string
        syscall function BooleanToString(value: bool): string
        syscall function CharToString(value: char): string
        syscall function ParseInt64(s: string): i64
        syscall function UInt64ToString(value: u64): string
    }
}
