// Cocoa 系统标准库 · System.Core 内部调用层（namespace System）
// class Runtime —— syscall 声明（编译器内部原语，三后端按 BuiltinKind 分发；完整名 System.Runtime）
// 可下沉的原语改为带体 static 方法（纯 Cocoa，6e-M18 带体静态方法已放行 .coa），调用点签名不变。
// 详细分层设计见 docs-dev/标准库设计.md

namespace System
{
    class Runtime
    {
        syscall function WriteLine(text: any): void
        syscall function Write(text: any): void
        syscall function ReadLine(): string
        syscall function ReadKey(intercept: bool): char
        syscall function Random(max: i32): i32
        syscall function Sleep(ms: i32): void
        syscall function TickCount(): i32
        syscall function Exit(code: i32): void
        syscall function Sqrt(x: f64): f64
        public static function Floor(x: f64): f64
        {
            var t = i64(x)
            if x < f64(t) return f64(t - 1)
            return f64(t)
        }

        public static function Ceiling(x: f64): f64
        {
            var t = i64(x)
            if x > f64(t) return f64(t + 1)
            return f64(t)
        }

        public static function Truncate(x: f64): f64
        {
            return f64(i64(x))
        }
        public static function Round(x: f64): f64
        {
            var t = i64(x)
            var f = x - f64(t)
            var af = f
            if af < 0
            {
                af = -af
            }

            if af < 0.5 return f64(t)
            if af > 0.5
            {
                if f > 0 return f64(t + 1)
                return f64(t - 1)
            }

            // af == 0.5：banker's rounding，向最近偶数
            var mod2 = t % 2
            if mod2 == 0 return f64(t)
            if f > 0 return f64(t + 1)
            return f64(t - 1)
        }
        syscall function Beep(frequency: i32, duration: i32): void
        public static function Int32ToString(value: i32): string
        {
            if value == 0 return "0"

            var v: i64 = i64(value)
            var negative = v < 0
            if negative
            {
                v = -v
            }

            const DIGITS = "0123456789"
            var buf = new char[21]
            var i: i32 = 20
            while v > 0
            {
                buf[i] = DIGITS[i32(v % 10)]
                v = v / 10
                i = i - 1
            }

            var len: i32 = 20 - i
            if negative
            {
                len = len + 1
                buf[i] = '-'
                i = i - 1
            }

            var chars = new char[len]
            var j: i32 = 0
            while j < len
            {
                chars[j] = buf[i + 1 + j]
                j = j + 1
            }

            return StringFromChars(chars)
        }

        public static function Int64ToString(value: i64): string
        {
            if value == 0 return "0"
            if value == -9223372036854775807l - 1l return "-9223372036854775808"

            var v: i64 = value
            var negative = v < 0
            if negative
            {
                v = -v
            }

            const DIGITS = "0123456789"
            var buf = new char[21]
            var i: i32 = 20
            while v > 0
            {
                buf[i] = DIGITS[i32(v % 10)]
                v = v / 10
                i = i - 1
            }

            var len: i32 = 20 - i
            if negative
            {
                len = len + 1
                buf[i] = '-'
                i = i - 1
            }

            var chars = new char[len]
            var j: i32 = 0
            while j < len
            {
                chars[j] = buf[i + 1 + j]
                j = j + 1
            }

            return StringFromChars(chars)
        }

        syscall function DoubleToString(value: f64): string
        public static function BooleanToString(value: bool): string
        {
            if value return "True"
            return "False"
        }

        public static function CharToString(value: char): string
        {
            var chars = new char[1]
            chars[0] = value
            return StringFromChars(chars)
        }

        // 数字判断走 i32 字符码（'0'=48, '9'=57）而非 u64 数字值 < / <=：
        // native windows-x86 上 u64 的 < / <= 比较恒为假（预先存在的后端缺陷，
        // 见 Cocoa.Tests/CodeAnalysis/NativeX86U64CompareKnownIssueTests.cs）。
        public static function ParseInt64(s: string): i64
        {
            let len = s.Length
            if len == 0 return 0

            var index = 0
            var negative = false
            let first = s[0]
            if first == '+'
            {
                index = 1
            }
            else if first == '-'
            {
                negative = true
                index = 1
            }

            var acc: u64 = 0
            while index < len
            {
                let ch: i32 = i32(s[index])
                if ch < 48
                {
                    index = index + 1
                }
                else if ch > 57
                {
                    index = index + 1
                }
                else
                {
                    acc = acc * 10ul + u64(ch - 48)
                    index = index + 1
                }
            }

            if negative return -i64(acc)
            return i64(acc)
        }

        public static function UInt64ToString(value: u64): string
        {
            if value == 0ul return "0"

            var v: u64 = value
            const DIGITS = "0123456789"
            var buf = new char[21]
            var i: i32 = 20
            while v > 0ul
            {
                buf[i] = DIGITS[i32(i64(v % 10ul))]
                v = v / 10ul
                i = i - 1
            }

            var len: i32 = 20 - i
            var chars = new char[len]
            var j: i32 = 0
            while j < len
            {
                chars[j] = buf[i + 1 + j]
                j = j + 1
            }

            return StringFromChars(chars)
        }
        syscall function StringFromChars(chars: char[]): string
        syscall function Sha256Hash(data: u8[]): u8[]
        syscall function LaunchProcess(path: string, args: string): i32
    }
}
