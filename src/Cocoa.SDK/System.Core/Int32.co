// Cocoa 系统标准库 · System.Core 基元 facade（namespace System）
// class Int32 —— i32 的成员面载体（6e-M19 M2-b，对齐 C# System.Int32）。
// 6e-M23 R9：新增 TryParse（语言级 out 参数的 stdlib 旗舰消费者）；
// Parse 复用底层 ParseInt64 原语 + i32 值域校验（失败沿原语语义）。

using System.Syscall

namespace System
{
    /// <summary>Represents a 32-bit signed integer and provides conversion and comparison methods.</summary>
    public facade class Int32
    {
        /// <summary>Converts this integer to its string representation.</summary>
        /// <returns>The string representation of this integer.</returns>
        public function ToString(): string
        {
            return Runtime.Int32ToString(this)
        }

        /// <summary>Compares this integer to another integer.</summary>
        /// <param name="value">The integer to compare to.</param>
        /// <returns>A value indicating the relative order (-1, 0, or 1).</returns>
        public function CompareTo(value: i32): i32
        {
            if this < value
            {
                return -1
            }
            if this > value
            {
                return 1
            }
            return 0
        }

        /// <summary>Converts the string representation of a number to its 32-bit signed integer equivalent.</summary>
        /// <param name="s">A string containing a number to convert.</param>
        /// <returns>The 32-bit signed integer equivalent of the number in s.</returns>
        public static function Parse(s: string): i32
        {
            let v = Runtime.ParseInt64(s)
            if v < -2147483648 || v > 2147483647
            {
                ConsoleSyscall.Exit(1)
            }

            return i32(v)
        }

        /// <summary>Converts the string representation of a number to a 32-bit signed integer, and returns a value indicating whether the conversion succeeded.</summary>
        /// <param name="s">A string containing a number to convert.</param>
        /// <param name="result">When this method returns, contains the 32-bit signed integer value equivalent of the number in s, or zero if the conversion failed.</param>
        /// <returns>true if s was converted successfully; otherwise, false.</returns>
        public static function TryParse(s: string, out result: i32): bool
        {
            result = 0
            let len = s.Length
            if len == 0
            {
                return false
            }

            var index = 0
            var negative = false
            let first = s[0]
            if first == '+'
            {
                index = 1
            }
            else if first == '-'
            {
                negative = true
                index = 1
            }

            if index >= len
            {
                return false
            }

            var acc: i64 = 0
            while index < len
            {
                let c = s[index]
                if Char.IsDigit(c)
                {
                    acc = acc * 10 + i64(i32(c) - 48)
                }
                else
                {
                    return false
                }

                // 上界预检：正数上限 2147483647，负数允许 2147483648（= int.MinValue）
                if acc > 2147483648
                {
                    return false
                }

                index = index + 1
            }

            if negative
            {
                if acc == 2147483648
                {
                    result = -2147483647 - 1
                    return true
                }
            }
            else if acc > 2147483647
            {
                return false
            }

            result = i32(acc)
            return true
        }
        /// <summary>Determines whether this integer equals the specified integer.</summary>
        /// <param name="value">The integer to compare to.</param>
        /// <returns>true if value equals this integer; otherwise, false.</returns>
        public function Equals(value: i32): bool
        {
            return this == value
        }

        /// <summary>Returns the hash code for this integer.</summary>
        /// <returns>A 32-bit signed integer hash code.</returns>
        public function GetHashCode(): i32
        {
            return 0
        }

        /// <summary>Converts this integer to its string representation using the specified format.</summary>
        /// <param name="format">A format string (currently unused; same as parameterless ToString).</param>
        /// <returns>The string representation of this integer.</returns>
        public function ToString(format: string): string
        {
            return this.ToString()
        }

    }
}
