// Cocoa 绯荤粺鏍囧噯搴?路 System.Core 鍩哄厓 facade锛坣amespace System锛?// class Char 鈥斺€?char 鐨勬垚鍛橀潰杞戒綋锛?e-M19 M2-b锛屽榻?C# System.Char锛夈€?// 娉細char 鏃犲叧绯昏繍绠楃锛屽垽瀹?姣旇緝缁熶竴缁?i32 杞崲锛?0'=48 '9'=57 'A'=65 'Z'=90 'a'=97 'z'=122锛夈€?
namespace System
{
    public facade class Char
    {
        public function ToString(): string
        {
            return Runtime.CharToString(this)
        }

        public static function Parse(s: string): char
        {
            return s[0]
        }

        public function CompareTo(value: char): i32
        {
            var a = i32(this)
            var b = i32(value)
            if a < b
            {
                return -1
            }
            if a > b
            {
                return 1
            }
            return 0
        }

        public static function IsDigit(c: char): bool
        {
            var v = i32(c)
            return v >= 48 && v <= 57
        }

        public static function IsLetter(c: char): bool
        {
            var v = i32(c)
            return (v >= 97 && v <= 122) || (v >= 65 && v <= 90)
        }

        public static function IsWhiteSpace(c: char): bool
        {
            return c == ' ' || c == '\t' || c == '\n' || c == '\r'
        }

        public static function ToUpper(c: char): char
        {
            var v = i32(c)
            if v >= 97 && v <= 122
            {
                return char(v - 32)
            }
            return c
        }

        public static function ToLower(c: char): char
        {
            var v = i32(c)
            if v >= 65 && v <= 90
            {
                return char(v + 32)
            }
            return c
        }
    }
}

