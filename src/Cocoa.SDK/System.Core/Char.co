// Cocoa System.Core standard library
namespace System
{
    [Facade("System.Char")]
    public class Char
    {
        public function ToString(): string
        {
            return Runtime.CharToString(this)
        }

        public static function Parse(s: string): char
        {
            return s[0]
        }

        public function CompareTo(value: char): i32
        {
            var a = i32(this)
            var b = i32(value)
            if a < b
            {
                return -1
            }
            if a > b
            {
                return 1
            }
            return 0
        }

        public static function IsDigit(c: char): bool
        {
            var v = i32(c)
            return v >= 48 && v <= 57
        }

        public static function IsLetter(c: char): bool
        {
            var v = i32(c)
            return (v >= 97 && v <= 122) || (v >= 65 && v <= 90)
        }

        public static function IsWhiteSpace(c: char): bool
        {
            return c == ' ' || c == '\t' || c == '\n' || c == '\r'
        }

        public static function ToUpper(c: char): char
        {
            var v = i32(c)
            if v >= 97 && v <= 122
            {
                return char(v - 32)
            }
            return c
        }

        public static function ToLower(c: char): char
        {
            var v = i32(c)
            if v >= 65 && v <= 90
            {
                return char(v + 32)
            }
            return c
        }

        /// <summary>字母或数字（Lexer 标识符判定）。</summary>
        public static function IsLetterOrDigit(c: char): bool
        {
            return IsLetter(c) || IsDigit(c)
        }

        /// <summary>控制字符（CoaSerializer 转义判断）。</summary>
        public static function IsControl(c: char): bool
        {
            var v = i32(c)
            return v < 32 || v == 127
        }

        /// <summary>十六进制数字（0-9 A-F a-f）。</summary>
        public static function IsHexDigit(c: char): bool
        {
            var v = i32(c)
            return (v >= 48 && v <= 57) || (v >= 65 && v <= 70) || (v >= 97 && v <= 102)
        }

        public static function IsUpper(c: char): bool
        {
            var v = i32(c)
            return v >= 65 && v <= 90
        }

        public static function IsLower(c: char): bool
        {
            var v = i32(c)
            return v >= 97 && v <= 122
        }
        public function Equals(value: char): bool
        {
            return this == value
        }

        public function GetHashCode(): i32
        {
            return 0
        }

        public function ToString(format: string): string
        {
            return this.ToString()
        }

        public static function TryParse(s: string, out result: char): bool
        {
            result = '\0'
            return false
        }

    }
}

