// Cocoa 系统标准库 · System.Core（namespace System）——BCL 存在类型即 facade
// class Math —— facade：IL 直连 System.Math.*；native/Evaluator 走纯体，Sqrt 走 System.Syscall.MathSyscall
using System.Syscall

namespace System
{
    facade class Math
    {
        static function Max(a: i32, b: i32): i32
        {
            if (a > b) return a
            return b
        }

        static function Max(a: f64, b: f64): f64
        {
            if (a > b) return a
            return b
        }

        static function Min(a: i32, b: i32): i32
        {
            if (a < b) return a
            return b
        }

        static function Min(a: f64, b: f64): f64
        {
            if (a < b) return a
            return b
        }

        static function Abs(x: i32): i32
        {
            if (x < 0) return -x
            return x
        }

        static function Abs(x: f64): f64
        {
            if (x < 0) return -x
            return x
        }

        static function Clamp(v: i32, lo: i32, hi: i32): i32
        {
            if (v < lo) return lo
            if (v > hi) return hi
            return v
        }

        static function Clamp(v: f64, lo: f64, hi: f64): f64
        {
            if (v < lo) return lo
            if (v > hi) return hi
            return v
        }

        static function Sign(x: i32): i32
        {
            if (x < 0) return -1
            if (x > 0) return 1
            return 0
        }

        static function Sign(x: f64): i32
        {
            if (x < 0) return -1
            if (x > 0) return 1
            return 0
        }

        static function IsEven(n: i32): bool
        {
            return n % 2 == 0
        }

        static function IsOdd(n: i32): bool
        {
            return n % 2 == 1
        }

static function Pow(x: i32, exp: i32): i32
        {
            var result = 1
            var i = 0
            while i < exp
            {
                result = result * x
                i = i + 1
            }
            return result
        }

        static function Factorial(n: i32): i32
        {
            var result = 1
            var i = 1
            while i <= n
            {
                result = result * i
                i = i + 1
            }
            return result
        }

        static function Gcd(a: i32, b: i32): i32
        {
            var x = Abs(a)
            var y = Abs(b)
            while y > 0
            {
                var t = x % y
                x = y
                y = t
            }
            return x
        }

        static function Lcm(a: i32, b: i32): i32
        {
            if a == 0 || b == 0
            {
                return 0
            }
            return Abs(a * b) / Gcd(a, b)
        }

        static function Sqrt(x: f64): f64
        {
            return MathSyscall.Sqrt(x)
        }

        static function Floor(x: f64): f64
        {
            return Runtime.Floor(x)
        }

        static function Ceiling(x: f64): f64
        {
            return Runtime.Ceiling(x)
        }

        static function Truncate(x: f64): f64
        {
            return Runtime.Truncate(x)
        }

        static function Round(x: f64): f64
        {
            return Runtime.Round(x)
        }
    }
}