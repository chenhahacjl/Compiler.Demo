// Cocoa 系统标准库 · System.Core 基元 facade（namespace System，6e-M19 M2-b）

namespace System
{
    public facade class UInt16
    {
        public function ToString(): string
        {
            return Runtime.Int32ToString(i32(this))
        }
        public function CompareTo(value: u16): i32
        {
            var a = i32(this)
            var b = i32(value)
            if a < b { return -1 }
            if a > b { return 1 }
            return 0
        }
        public static function Parse(s: string): u16
        {
            return u16(Runtime.ParseInt64(s))
        }
    }
}

