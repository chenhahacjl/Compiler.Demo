// Cocoa 系统标准库 · 元组值类型（ValueTuple<T1..Tn>，对齐 BCL System.ValueTuple）

namespace System
{
    public struct ValueTuple<T1>
    {
        public Item1: T1

        public constructor(p1: T1)
        {
            Item1 = p1
        }
    }

    public struct ValueTuple<T1, T2>
    {
        public Item1: T1
        public Item2: T2

        public constructor(p1: T1, p2: T2)
        {
            Item1 = p1
            Item2 = p2
        }
    }

    public struct ValueTuple<T1, T2, T3>
    {
        public Item1: T1
        public Item2: T2
        public Item3: T3

        public constructor(p1: T1, p2: T2, p3: T3)
        {
            Item1 = p1
            Item2 = p2
            Item3 = p3
        }
    }

    public struct ValueTuple<T1, T2, T3, T4>
    {
        public Item1: T1
        public Item2: T2
        public Item3: T3
        public Item4: T4

        public constructor(p1: T1, p2: T2, p3: T3, p4: T4)
        {
            Item1 = p1
            Item2 = p2
            Item3 = p3
            Item4 = p4
        }
    }

    public struct ValueTuple<T1, T2, T3, T4, T5>
    {
        public Item1: T1
        public Item2: T2
        public Item3: T3
        public Item4: T4
        public Item5: T5

        public constructor(p1: T1, p2: T2, p3: T3, p4: T4, p5: T5)
        {
            Item1 = p1
            Item2 = p2
            Item3 = p3
            Item4 = p4
            Item5 = p5
        }
    }

    public struct ValueTuple<T1, T2, T3, T4, T5, T6>
    {
        public Item1: T1
        public Item2: T2
        public Item3: T3
        public Item4: T4
        public Item5: T5
        public Item6: T6

        public constructor(p1: T1, p2: T2, p3: T3, p4: T4, p5: T5, p6: T6)
        {
            Item1 = p1
            Item2 = p2
            Item3 = p3
            Item4 = p4
            Item5 = p5
            Item6 = p6
        }
    }

    public struct ValueTuple<T1, T2, T3, T4, T5, T6, T7>
    {
        public Item1: T1
        public Item2: T2
        public Item3: T3
        public Item4: T4
        public Item5: T5
        public Item6: T6
        public Item7: T7

        public constructor(p1: T1, p2: T2, p3: T3, p4: T4, p5: T5, p6: T6, p7: T7)
        {
            Item1 = p1
            Item2 = p2
            Item3 = p3
            Item4 = p4
            Item5 = p5
            Item6 = p6
            Item7 = p7
        }
    }
}
