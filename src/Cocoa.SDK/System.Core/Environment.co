// Cocoa 系统标准库 · System.Core 逻辑层（namespace System）
// class Environment —— 环境访问 syscall 声明（6e-G7 ④）

namespace System
{
    class Environment
    {
        /// <summary>获取环境变量——未定义返回空串。</summary>
        syscall function GetEnvironmentVariable(name: string): string

        /// <summary>当前工作目录。</summary>
        syscall function GetCurrentDirectory(): string

        /// <summary>设置当前工作目录。</summary>
        syscall function SetCurrentDirectory(path: string): void

        /// <summary>当前可执行文件完整路径。</summary>
        syscall function GetExecutablePath(): string
    }
}
