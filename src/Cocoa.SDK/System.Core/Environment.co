// Cocoa 系统标准库 · System.Core（namespace System）——BCL 存在类型即 facade（Console/Environment 因 IL 后端未覆盖其程序集引用层级，保持真实类+syscall 转发，见 docs-dev/标准库设计.md）
// class Environment —— facade：IL 直连 System.Environment；native/Evaluator 走 System.Syscall.EnvironmentSyscall
using System.Syscall

namespace System
{
    class Environment
    {
        public static function GetEnvironmentVariable(name: string): string
        {
            return EnvironmentSyscall.GetEnvironmentVariable(name)
        }

        public static function GetCurrentDirectory(): string
        {
            return EnvironmentSyscall.GetCurrentDirectory()
        }

        public static function SetCurrentDirectory(path: string): void
        {
            EnvironmentSyscall.SetCurrentDirectory(path)
        }

        public static function GetExecutablePath(): string
        {
            return EnvironmentSyscall.GetExecutablePath()
        }
    }
}