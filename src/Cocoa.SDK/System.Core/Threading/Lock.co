// Cocoa 系统标准库 · System.Threading.Lock（互斥锁）
// 对齐 BCL System.Threading.Lock（sealed class，非 facade）
// 解释器回退：内部使用 Monitor；IL 后端直接使用 BCL Lock
// 注：BCL 的 EnterScope/Scope 模式依赖 ref struct，Cocoa 解析器暂不支持，待语言能力补齐后对齐

namespace System.Threading
{
    public sealed facade class Lock
    {
        private field _owner: object = new object()

        public constructor()
        {
        }

        public function Enter(): void
        {
            System.Threading.Monitor.Enter(_owner)
        }

        public function Exit(): void
        {
            System.Threading.Monitor.Exit(_owner)
        }

        public function TryEnter(): bool
        {
            // 简化实现：直接进入
            Enter()
            return true
        }

        public function TryEnter(millisecondsTimeout: i32): bool
        {
            return TryEnter()
        }

        public property IsHeldByCurrentThread: bool
        {
            get
            {
                return System.Threading.Monitor.IsEntered(_owner)
            }
        }

        public static property ContentionCount: i64
        {
            get
            {
                return 0
            }
        }
    }
}

