// Cocoa 系统标准库 · System.Range（范围）

namespace System
{
    public facade struct Range
    {
        public field _start: Index
        public field _end: Index

        public constructor(start: Index, end: Index)
        {
            _start = start
            _end = end
        }

        public property Start: Index
        {
            get
            {
                return _start
            }
        }

        public property End: Index
        {
            get
            {
                return _end
            }
        }

        public function GetOffsetAndLength(length: i32): ValueTuple<i32, i32>
        {
            var start = _start.GetOffset(length)
            var end = _end.GetOffset(length)
            return new ValueTuple<i32, i32>(start, end - start)
        }

        public static property All: Range
        {
            get
            {
                return new Range(new Index(0, false), new Index(0, true))
            }
        }

        public static function StartAt(start: Index): Range
        {
            return new Range(start, new Index(0, true))
        }

        public static function EndAt(end: Index): Range
        {
            return new Range(new Index(0, false), end)
        }
    }
}
