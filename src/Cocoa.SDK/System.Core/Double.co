// Cocoa 系统标准库 · System.Core 基元 facade（namespace System）
// class Double —— f64 的成员面载体（6e-M19 M2-b，对齐 C# System.Double）。

namespace System
{
    public facade class Double
    {
        public function ToString(): string
        {
            return Runtime.DoubleToString(this)
        }

        public function CompareTo(value: f64): i32
        {
            if this < value
            {
                return -1
            }
            if this > value
            {
                return 1
            }
            return 0
        }
        public function Equals(value: f64): bool
        {
            return this == value
        }

        public function GetHashCode(): i32
        {
            return 0
        }

        public function ToString(format: string): string
        {
            return this.ToString()
        }

        public static function TryParse(s: string, out result: f64): bool
        {
            result = 0
            let len = s.Length
            if len == 0
            {
                return false
            }

            var index = 0
            var negative = false
            let first = s[0]
            if first == '+'
            {
                index = 1
            }
            else if first == '-'
            {
                negative = true
                index = 1
            }

            if index >= len
            {
                return false
            }

            // 十进制 + 可选指数：先按“整数+小数连读”累积有效数字，再按（指数 − 小数位数）缩放。
            // 注意：三后端 `&&`/`||` 均非短路，扫描一律用单条件 + break，避免越界读 s[index]。
            var value: f64 = 0
            var fracDigits = 0
            var exp10 = 0
            var hasDigit = false

            while index < len
            {
                let c = s[index]
                if !Char.IsDigit(c)
                {
                    break
                }

                value = value * 10 + f64(i32(c) - 48)
                hasDigit = true
                index = index + 1
            }

            if index < len
            {
                let dot = s[index] == '.'
                if dot
                {
                    index = index + 1
                    while index < len
                    {
                        let c = s[index]
                        if !Char.IsDigit(c)
                        {
                            break
                        }

                        value = value * 10 + f64(i32(c) - 48)
                        fracDigits = fracDigits + 1
                        hasDigit = true
                        index = index + 1
                    }
                }
            }

            var hasExponent = false
            if index < len
            {
                let c = s[index]
                hasExponent = c == 'e' || c == 'E'
            }

            if hasExponent
            {
                index = index + 1
                var expNegative = false
                if index < len
                {
                    let c = s[index]
                    let sign = c == '+' || c == '-'
                    if sign
                    {
                        if c == '-'
                        {
                            expNegative = true
                        }

                        index = index + 1
                    }
                }

                var expValue = 0
                var hasExpDigits = false
                while index < len
                {
                    let c = s[index]
                    if !Char.IsDigit(c)
                    {
                        break
                    }

                    expValue = expValue * 10 + (i32(c) - 48)
                    hasExpDigits = true
                    index = index + 1
                }

                if !hasExpDigits
                {
                    return false
                }

                if expNegative
                {
                    exp10 = exp10 - expValue
                }
                else
                {
                    exp10 = exp10 + expValue
                }
            }

            if !hasDigit
            {
                return false
            }

            if index != len
            {
                return false
            }

            // 缩放：单次乘/除 10^|finalExp|（k≤22 时 10^k 在 f64 中精确），由 IEEE 正确舍入到最近值，
            // 避免逐位乘除累积舍入（如 3.14 逐位除法会得到 3.1399999999999997 而单除得精确 3.14）。
            let finalExp = exp10 - fracDigits
            var scaled = value
            if finalExp != 0
            {
                var pow: f64 = 1
                var i = 0
                if finalExp > 0
                {
                    while i < finalExp
                    {
                        pow = pow * 10.0
                        i = i + 1
                    }

                    scaled = value * pow
                }
                else
                {
                    while i > finalExp
                    {
                        pow = pow * 10.0
                        i = i - 1
                    }

                    scaled = value / pow
                }
            }

            if negative
            {
                scaled = -scaled
            }

            result = scaled
            return true
        }

        public static function Parse(s: string): f64
        {
            var r: f64 = 0
            if !Double.TryParse(s, out r)
            {
                Runtime.Exit(1)
            }

            return r
        }

        public static function IsNaN(x: f64): bool
        {
            return x != x
        }

        public static function IsInfinity(x: f64): bool
        {
            return x > 1.7976931348623157e308 || x < -1.7976931348623157e308
        }

        public static function IsFinite(x: f64): bool
        {
            return x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308
        }

    }
}
