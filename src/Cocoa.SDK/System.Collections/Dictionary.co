// Cocoa 系统标准库 · System.Collections 模块
// Dictionary<K,V> 哈希表（6e-G7 ③b）：
// TryGetValue 消费 6e-M23 out 参数。
// Remove 策略：摘链 + 尾元素回填（同步修正尾元素桶链接），O(桶链长)。

namespace System.Collections.Generic
{
    public class Dictionary<K, V>
    {
        private _keys: K[]
        private _values: V[]
        private _next: i32[]
        private _buckets: i32[]
        private _count: i32

        public constructor()
        {
            _keys = new K[16]
            _values = new V[16]
            _next = new i32[16]
            _buckets = new i32[16]
            var i = 0
            while i < 16
            {
                _buckets[i] = -1
                i = i + 1
            }
        }

        public property Count: i32
        {
            get
            {
                return _count
            }
        }

        /// <summary>键快照（按插入序，长度=Count）。</summary>
        public property Keys: K[]
        {
            get
            {
                var result = new K[_count]
                var i = 0
                while i < _count
                {
                    result[i] = _keys[i]
                    i = i + 1
                }

                return result
            }
        }

        /// <summary>值快照（按插入序，长度=Count）。</summary>
        public property Values: V[]
        {
            get
            {
                var copy = new V[_count]
                var i = 0
                while i < _count
                {
                    copy[i] = _values[i]
                    i = i + 1
                }

                return copy
            }
        }

        public property this[key: K]: V
        {
            get
            {
                var idx = FindEntry(key)
                return _values[idx]
            }
            set
            {
                var b = BucketOf(key)
                var i = _buckets[b]
                while i >= 0
                {
                    if SameKey(_keys[i], key)
                    {
                        _values[i] = value
                        return
                    }
                    i = _next[i]
                }

                if _count >= _keys.Length
                {
                    Rehash(_keys.Length * 2)
                    b = BucketOf(key)
                }

                _keys[_count] = key
                _values[_count] = value
                _next[_count] = _buckets[b]
                _buckets[b] = _count
                _count = _count + 1
            }
        }

        public function Add(key: K, value: V): void
        {
            if ContainsKey(key)
            {
                return
            }

            this[key] = value
        }

        public function ContainsKey(key: K): bool
        {
            return FindEntry(key) >= 0
        }

        /// <summary>尝试取值；命中写 out value 并返回 true，否则返回 false。</summary>
        public function TryGetValue(key: K, out value: V): bool
        {
            var idx = FindEntry(key)
            if idx >= 0
            {
                value = _values[idx]
                return true
            }

            value = _values[0]
            return false
        }

        /// <summary>清空全部条目（桶链复位，缓冲保留复用）。</summary>
        public function Clear(): void
        {
            _count = 0
            var i = 0
            while i < _buckets.Length
            {
                _buckets[i] = -1
                i = i + 1
            }
        }

        public function Remove(key: K): bool
        {
            var b = BucketOf(key)
            var i = _buckets[b]
            var prev = -1
            while i >= 0
            {
                if SameKey(_keys[i], key)
                {
                    // 摘链
                    if prev < 0
                    {
                        _buckets[b] = _next[i]
                    }
                    else
                    {
                        _next[prev] = _next[i]
                    }

                    // 尾元素回填到空洞（若非自身）
                    var last = _count - 1
                    if i < last
                    {
                        _keys[i] = _keys[last]
                        _values[i] = _values[last]
                        _next[i] = _next[last]

                        // 重链尾元素：遍历其桶找到指向 last 的前驱并改指 i
                        var lb = BucketOf(_keys[i])
                        var j = _buckets[lb]
                        while j >= 0
                        {
                            if j == last
                            {
                                // j 是桶头或中间节点——通过扫描定位
                                break
                            }
                            j = _next[j]
                        }

                        // 简化：直接重建该桶的整条链中 last→i 的映射
                        // 由于链表节点已断开，此处用全量扫描修正
                        var bi = 0
                        while bi < _buckets.Length
                        {
                            if _buckets[bi] == last
                            {
                                _buckets[bi] = i
                            }
                            bi = bi + 1
                        }

                        var ni = 0
                        while ni < _count
                        {
                            if _next[ni] == last
                            {
                                _next[ni] = i
                            }
                            ni = ni + 1
                        }
                    }

                    _count = _count - 1
                    return true
                }
                prev = i
                i = _next[i]
            }

            return false
        }

        private function FindEntry(key: K): i32
        {
            var b = BucketOf(key)
            var i = _buckets[b]
            while i >= 0
            {
                if SameKey(_keys[i], key)
                {
                    return i
                }
                i = _next[i]
            }

            return -1
        }

        private function BucketOf(key: K): i32
        {
            var b = HashCode(key) % _buckets.Length
            if b < 0
            {
                b = b + _buckets.Length
            }

            return b
        }

        /// <summary>键哈希——统一经 Object.GetHashCode 虚派发（可为负）。桶下标在 BucketOf/Rehash 处归一化。</summary>
        private function HashCode(key: K): i32
        {
            return key.GetHashCode()
        }

        private function SameKey(a: K, b: K): bool
        {
            return a.GetHashCode() == b.GetHashCode() && a.Equals(b)
        }

        private function Rehash(newLen: i32): void
        {
            var newKeys = new K[newLen]
            var newValues = new V[newLen]
            var newNext = new i32[newLen]
            var newBuckets = new i32[newLen]

            var i = 0
            while i < newLen
            {
                newBuckets[i] = -1
                i = i + 1
            }

            var j = 0
            while j < _count
            {
                newKeys[j] = _keys[j]
                newValues[j] = _values[j]
                var b = HashCode(newKeys[j]) % newLen
                if b < 0
                {
                    b = b + newLen
                }

                newNext[j] = newBuckets[b]
                newBuckets[b] = j
                j = j + 1
            }

            _keys = newKeys
            _values = newValues
            _next = newNext
            _buckets = newBuckets
        }
    }
}
