// Cocoa 系统标准库 · System.Collections 模块
// Stack<T> 栈（6e-M22 C8 / 6e-G7 ③b，对齐 C# System.Collections.Generic.Stack<T>）
// 基于原生数组 + 扩容策略（容量 ×2）。

namespace System.Collections.Generic
{
    public class Stack<T>
    {
        private _items: T[]
        private _count: i32

        public constructor()
        {
            _items = new T[4]
            _count = 0
        }

        public property Count: i32
        {
            get
            {
                return _count
            }
        }

        /// <summary>压栈。</summary>
        public function Push(item: T): void
        {
            if _count >= _items.Length
            {
                var newItems = new T[_items.Length * 2]
                var i = 0
                while i < _count
                {
                    newItems[i] = _items[i]
                    i = i + 1
                }

                _items = newItems
            }

            _items[_count] = item
            _count = _count + 1
        }

        /// <summary>弹栈（返回并移除栈顶）。</summary>
        public function Pop(): T
        {
            _count = _count - 1
            return _items[_count]
        }

        /// <summary>查看栈顶（不移除）。</summary>
        public function Peek(): T
        {
            return _items[_count - 1]
        }

        public function Clear(): void
        {
            _count = 0
        }
    }
}
