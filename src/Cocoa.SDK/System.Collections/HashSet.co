// Cocoa 系统标准库 · System.Collections 模块
// HashSet<T> 集合（6e-M22 C8 / 6e-G7 ③b，对齐 C# System.Collections.Generic.HashSet<T>）
// 基于原生数组 + 线性探测式去重（SameItem 用 GetHashCode/Equals，避免泛型 == 限制 G6）。

namespace System.Collections.Generic
{
    public class HashSet<T>
    {
        private _items: T[]
        private _count: i32

        public constructor()
        {
            _items = new T[4]
            _count = 0
        }

        public property Count: i32
        {
            get
            {
                return _count
            }
        }

        /// <summary>加入元素；已存在则忽略并返回 false。</summary>
        public function Add(item: T): bool
        {
            if Contains(item)
            {
                return false
            }

            if _count >= _items.Length
            {
                EnsureCapacity(_items.Length * 2)
            }

            _items[_count] = item
            _count = _count + 1
            return true
        }

        public function Contains(item: T): bool
        {
            var i = 0
            while i < _count
            {
                if SameItem(_items[i], item)
                {
                    return true
                }

                i = i + 1
            }

            return false
        }

        /// <summary>移除元素；成功返回 true，不存在返回 false。</summary>
        public function Remove(item: T): bool
        {
            var i = 0
            while i < _count
            {
                if SameItem(_items[i], item)
                {
                    // 尾元素回填到空洞
                    var last = _count - 1
                    if i < last
                    {
                        _items[i] = _items[last]
                    }

                    _count = _count - 1
                    return true
                }

                i = i + 1
            }

            return false
        }

        public function Clear(): void
        {
            _count = 0
        }

        private function EnsureCapacity(cap: i32): void
        {
            var newItems = new T[cap]
            var i = 0
            while i < _count
            {
                newItems[i] = _items[i]
                i = i + 1
            }

            _items = newItems
        }

        private function SameItem(a: T, b: T): bool
        {
            return a.GetHashCode() == b.GetHashCode() && a.Equals(b)
        }
    }
}
