// Cocoa 系统标准库 · System.Collections 模块
// Queue<T> 先进先出（对齐 C# System.Collections.Generic.Queue<T>）

namespace System.Collections.Generic
{
    public class Queue<T>
    {
        private _items: List<T>

        public constructor()
        {
            _items = new List<T>()
        }

        /// <summary>队列内元素数。</summary>
        public property Count: i32
        {
            get
            {
                return _items.Count
            }
        }

        /// <summary>入队。</summary>
        public function Enqueue(item: T): void
        {
            _items.Add(item)
        }

        /// <summary>出队——空队为运行时错误。</summary>
        public function Dequeue(): T
        {
            var front = Peek()
            _items.RemoveAt(0)
            return front
        }

        /// <summary>查看队首不移除。</summary>
        public function Peek(): T
        {
            return _items[0]
        }

        /// <summary>清空。</summary>
        public function Clear(): void
        {
            _items.Clear()
        }
    }
}
