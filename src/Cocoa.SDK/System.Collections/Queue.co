// Cocoa 系统标准库 · System.Collections 模块
// Queue<T> 队列（6e-M22 C8 / 6e-G7 ③b，对齐 C# System.Collections.Generic.Queue<T>）
// 基于原生数组 + 环形缓冲；SameItem 仅用于相等判断（本类型未暴露比较接口）。

namespace System.Collections.Generic
{
    public class Queue<T> extends IReadOnlyCollection<T>
    {
        private _items: T[]
        private _count: i32
        private _head: i32
        private _capacity: i32

        public constructor()
        {
            _capacity = 4
            _items = new T[4]
            _count = 0
            _head = 0
        }

        public property Count: i32
        {
            get
            {
                return _count
            }
        }

        /// <summary>入队（队尾）。</summary>
        public function Enqueue(item: T): void
        {
            if _count >= _capacity
            {
                var newCap = _capacity * 2
                var newItems = new T[newCap]
                var i = 0
                while i < _count
                {
                    newItems[i] = _items[(_head + i) % _capacity]
                    i = i + 1
                }

                _items = newItems
                _capacity = newCap
                _head = 0
            }

            var tail = (_head + _count) % _capacity
            _items[tail] = item
            _count = _count + 1
        }

        /// <summary>出队（队首）。</summary>
        public function Dequeue(): T
        {
            var item = _items[_head]
            _head = (_head + 1) % _capacity
            _count = _count - 1
            return item
        }

        /// <summary>查看队首（不出队）。</summary>
        public function Peek(): T
        {
            return _items[_head]
        }

        public function Clear(): void
        {
            _count = 0
            _head = 0
        }

        public function GetEnumerator(): QueueEnumerator<T>
        {
            return new QueueEnumerator<T>(_items, _head, _count, _capacity)
        }
    }

    public class QueueEnumerator<T> extends IEnumerator<T>
    {
        private _items: T[]
        private _head: i32
        private _count: i32
        private _capacity: i32
        private _index: i32

        public constructor(items: T[], head: i32, count: i32, capacity: i32)
        {
            _items = items
            _head = head
            _count = count
            _capacity = capacity
            _index = -1
        }

        public property Current: T
        {
            get
            {
                return _items[(_head + _index) % _capacity]
            }
        }

        public function MoveNext(): bool
        {
            _index = _index + 1
            return _index < _count
        }

        public function Reset(): void
        {
            _index = 0
        }
    }
}
