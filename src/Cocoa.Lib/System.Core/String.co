// Cocoa 系统标准库 · System.Core 逻辑层（namespace System）
// class String —— string 的成员面载体（6e-M19 M2-b 全面 facade，对齐 C# System.String）：
// 实例方法编译期降级为静态（隐藏首参 this: string，声明参数 ordinal 整体 +1），
// 旧静态调用形态签名不变、天然兼容。设计见 docs-dev/对象模型设计.md §4.4/§5

namespace System
{
    public class String
    {
        public static function IsNullOrEmpty(s: string): bool
        {
            return s == ""
        }

        public function ToUpper(): string
        {
            var result = ""
            var i = 0
            while i < this.Length
            {
                var v = i32(this[i])
                if v >= 97 && v <= 122
                {
                    result = result + string(char(v - 32))
                }
                else
                {
                    result = result + string(this[i])
                }
                i = i + 1
            }
            return result
        }

        public function ToLower(): string
        {
            var result = ""
            var i = 0
            while i < this.Length
            {
                var v = i32(this[i])
                if v >= 65 && v <= 90
                {
                    result = result + string(char(v + 32))
                }
                else
                {
                    result = result + string(this[i])
                }
                i = i + 1
            }
            return result
        }

        public function StartsWith(prefix: string): bool
        {
            if prefix.Length > this.Length
            {
                return false
            }
            return this.substring(0, prefix.Length) == prefix
        }

        public function EndsWith(suffix: string): bool
        {
            if suffix.Length > this.Length
            {
                return false
            }
            return this.substring(this.Length - suffix.Length, suffix.Length) == suffix
        }

        public function Contains(sub: string): bool
        {
            if sub.Length == 0
            {
                return true
            }
            var i = 0
            while i <= this.Length - sub.Length
            {
                if this.substring(i, sub.Length) == sub
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        public function IndexOf(sub: string): i32
        {
            if sub.Length == 0
            {
                return 0
            }
            var i = 0
            while i <= this.Length - sub.Length
            {
                if this.substring(i, sub.Length) == sub
                {
                    return i
                }
                i = i + 1
            }
            return -1
        }

        public function Reverse(): string
        {
            var result = ""
            var i = this.Length - 1
            while i >= 0
            {
                result = result + string(this[i])
                i = i - 1
            }
            return result
        }

        public function Replicate(n: i32): string
        {
            var result = ""
            var i = 0
            while i < n
            {
                result = result + this
                i = i + 1
            }
            return result
        }

        public function CountChar(c: char): i32
        {
            var count = 0
            var i = 0
            while i < this.Length
            {
                if this[i] == c
                {
                    count = count + 1
                }
                i = i + 1
            }
            return count
        }

        public function IsPalindrome(): bool
        {
            var lo = 0
            var hi = this.Length - 1
            while lo < hi
            {
                if this[lo] != this[hi]
                {
                    return false
                }
                lo = lo + 1
                hi = hi - 1
            }
            return true
        }

        public function Trim(): string
        {
            var start = 0
            var end = this.Length
            var first = char(0)
            var last = char(0)
            while start < end
            {
                first = this[start]
                if first == ' '
                {
                    start = start + 1
                }
                else
                {
                    break
                }
            }
            while end > start
            {
                last = this[end - 1]
                if last == ' '
                {
                    end = end - 1
                }
                else
                {
                    break
                }
            }
            if start >= end
            {
                return ""
            }
            return this.substring(start, end - start)
        }

        public function Replace(old: string, replacement: string): string
        {
            if old.Length == 0
            {
                return this
            }
            var result = ""
            var i = 0
            while i < this.Length
            {
                if i > this.Length - old.Length
                {
                    result = result + string(this[i])
                    i = i + 1
                }
                else if this.substring(i, old.Length) == old
                {
                    result = result + replacement
                    i = i + old.Length
                }
                else
                {
                    result = result + string(this[i])
                    i = i + 1
                }
            }
            return result
        }

        public function CountSubstring(sub: string): i32
        {
            if sub.Length == 0
            {
                return 0
            }
            var count = 0
            var i = 0
            while i <= this.Length - sub.Length
            {
                if this.substring(i, sub.Length) == sub
                {
                    count = count + 1
                    i = i + sub.Length
                }
                else
                {
                    i = i + 1
                }
            }
            return count
        }

        public function PadLeft(totalWidth: i32, padChar: char): string
        {
            var result = this
            while result.Length < totalWidth
            {
                result = string(padChar) + result
            }
            return result
        }

        public function PadLeft(totalWidth: i32): string
        {
            return this.PadLeft(totalWidth, ' ')
        }

        public function PadRight(totalWidth: i32, padChar: char): string
        {
            var result = this
            while result.Length < totalWidth
            {
                result = result + string(padChar)
            }
            return result
        }

        public function PadRight(totalWidth: i32): string
        {
            return this.PadRight(totalWidth, ' ')
        }

        public function Split(sep: char): string[]
        {
            var count = this.CountChar(sep) + 1
            var result = new string[count]
            var start = 0
            var index = 0
            var i = 0
            while i < this.Length
            {
                if this[i] == sep
                {
                    result[index] = this.substring(start, i - start)
                    index = index + 1
                    start = i + 1
                }
                i = i + 1
            }
            result[index] = this.substring(start, this.Length - start)
            return result
        }
    }
}
