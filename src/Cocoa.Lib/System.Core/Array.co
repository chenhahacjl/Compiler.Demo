// Cocoa 系统标准库 · System.Core 逻辑层（namespace System）
// class Array —— 纯 Cocoa 源码静态类，只依赖语言核心（数组/控制流）
// 详细分层设计见 docs-dev/标准库设计.md

namespace System
{
    class Array
    {
        static function Sum(a: i32[]): i32
        {
            var sum = 0
            var i = 0
            while i < a.Length
            {
                sum = sum + a[i]
                i = i + 1
            }
            return sum
        }

        static function Sum(a: f64[]): f64
        {
            var sum = 0.0
            var i = 0
            while i < a.Length
            {
                sum = sum + a[i]
                i = i + 1
            }
            return sum
        }

        static function Min(a: i32[]): i32
        {
            if a.Length == 0
            {
                return 0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] < m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Min(a: f64[]): f64
        {
            if a.Length == 0
            {
                return 0.0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] < m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Max(a: i32[]): i32
        {
            if a.Length == 0
            {
                return 0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] > m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Max(a: f64[]): f64
        {
            if a.Length == 0
            {
                return 0.0
            }
            var m = a[0]
            var i = 1
            while i < a.Length
            {
                if a[i] > m
                {
                    m = a[i]
                }
                i = i + 1
            }
            return m
        }

        static function Average(a: i32[]): f64
        {
            if a.Length == 0
            {
                return 0.0
            }
            return Sum(a) / a.Length
        }

        static function Average(a: f64[]): f64
        {
            if a.Length == 0
            {
                return 0.0
            }
            return Sum(a) / a.Length
        }

        static function Contains(a: i32[], v: i32): bool
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        static function Contains(a: f64[], v: f64): bool
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return true
                }
                i = i + 1
            }
            return false
        }

        static function IndexOf(a: i32[], v: i32): i32
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return i
                }
                i = i + 1
            }
            return -1
        }

        static function IndexOf(a: f64[], v: f64): i32
        {
            var i = 0
            while i < a.Length
            {
                if a[i] == v
                {
                    return i
                }
                i = i + 1
            }
            return -1
        }

        static function Reverse(a: i32[]): i32[]
        {
            var n = a.Length
            var result = new i32[n]
            var i = 0
            while i < n
            {
                result[i] = a[n - 1 - i]
                i = i + 1
            }
            return result
        }

        static function Reverse(a: f64[]): f64[]
        {
            var n = a.Length
            var result = new f64[n]
            var i = 0
            while i < n
            {
                result[i] = a[n - 1 - i]
                i = i + 1
            }
            return result
        }

        static function Sort(a: i32[]): i32[]
        {
            var n = a.Length
            var result = new i32[n]
            var i = 0
            while i < n
            {
                result[i] = a[i]
                i = i + 1
            }
            var j = 0
            while j < n - 1
            {
                var k = 0
                while k < n - 1 - j
                {
                    if result[k] > result[k + 1]
                    {
                        var t = result[k]
                        result[k] = result[k + 1]
                        result[k + 1] = t
                    }
                    k = k + 1
                }
                j = j + 1
            }
            return result
        }

        static function Sort(a: f64[]): f64[]
        {
            var n = a.Length
            var result = new f64[n]
            var i = 0
            while i < n
            {
                result[i] = a[i]
                i = i + 1
            }
            var j = 0
            while j < n - 1
            {
                var k = 0
                while k < n - 1 - j
                {
                    if result[k] > result[k + 1]
                    {
                        var t = result[k]
                        result[k] = result[k + 1]
                        result[k + 1] = t
                    }
                    k = k + 1
                }
                j = j + 1
            }
            return result
        }
    }
}
