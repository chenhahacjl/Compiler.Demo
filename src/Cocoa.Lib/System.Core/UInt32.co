// Cocoa 系统标准库 · System.Core 基元 facade（namespace System，6e-M19 M2-b）

namespace System
{
    public class UInt32
    {
        public function ToString(): string
        {
            return Runtime.UInt64ToString(u64(this))
        }

        public function CompareTo(value: u32): i32
        {
            var a = i64(this)
            var b = i64(value)
            if a < b
            {
                return -1
            }
            if a > b
            {
                return 1
            }
            return 0
        }

        public static function Parse(s: string): u32
        {
            return u32(Runtime.ParseInt64(s))
        }
    }
}
