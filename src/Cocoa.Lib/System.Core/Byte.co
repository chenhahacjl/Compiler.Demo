// Cocoa 系统标准库 · System.Core 基元 facade（namespace System）
// class Byte —— u8 的成员面载体（6e-M19 M2-b，对齐 C# System.Byte）。
// ToString 复用 Int32 原语（十进制输出一致）。

namespace System
{
    public class Byte
    {
        public function ToString(): string
        {
            return Runtime.Int32ToString(i32(this))
        }
    }
}
