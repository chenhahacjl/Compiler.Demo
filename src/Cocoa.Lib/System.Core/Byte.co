// Cocoa 系统标准库 · System.Core 基元 facade（namespace System）
// class Byte —— u8 的成员面载体（6e-M19 M2-b，对齐 C# System.Byte）。
// ToString 复用 Int32 原语（十进制输出一致）；比较经 i32 转换。

namespace System
{
    public facade class Byte
    {
        public function ToString(): string
        {
            return Runtime.Int32ToString(i32(this))
        }

        public function CompareTo(value: u8): i32
        {
            var a = i32(this)
            var b = i32(value)
            if a < b
            {
                return -1
            }
            if a > b
            {
                return 1
            }
            return 0
        }

        public static function Parse(s: string): u8
        {
            return u8(Runtime.ParseInt64(s))
        }
    }
}
