namespace MyLib
{
    public class Point
    {
        private _x: i32
        private _y: i32

        public constructor(x: i32, y: i32)
        {
            _x = x
            _y = y
        }

        public function X(): i32
        {
            return _x
        }

        public function Y(): i32
        {
            return _y
        }

        public function Area(): i32
        {
            return _x * _y
        }
    }
}
