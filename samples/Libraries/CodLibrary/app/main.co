using System
using MathLib
// 消费 .cod 库：`[references]` 引用 mylib 的 .cod → 编译期 IR 合并 → 独立 exe
//
// 引用库的命名空间需显式 using（与 C# 一致）：`using MathLib` 后库函数裸名调用即可；
// 枚举已注入作用域，Day.Sat 可直接解析。

function Main()
{
    Console.WriteLine(Add(2, 3))                        // 5
    Console.WriteLine(Mul(3, 4))                        // 12
    Console.WriteLine(Factorial(5))                     // 120
    if IsWeekend(Day.Sat) { Console.WriteLine("weekend") } else { Console.WriteLine("weekday") }
    Console.WriteLine(Greet("Cocoa"))                   // Hello, Cocoa
}
