using System
using System.UI
using System.UI.Backends

// 6e-M25 阶段 1 BasicUI：System.UI 立即模式最小示例（IL 后端）。
// 窗口经内建 "STATIC" 类创建（轮询架构）；GDI 双缓冲自绘。ESC 退出。

function Main(): i32
{
    var gui = new ImGui(4096, 64)
    var io = new ImGuiIO()

    let hwnd = Win32Window.Create("Cocoa.UI BasicUI", 640, 420)
    if hwnd == 0
    {
        Console.WriteLine("failed to create window")
        return 1
    }

    let memDC = Win32GDIBackend.CreateBuffer(hwnd, 640, 420)
    var running = true
    while running
    {
        running = Win32Window.Pump(io, hwnd)
        io.NewFrame(f32(0.016))

        gui.NewFrame(io)
        if gui.Begin("Cocoa.UI Demo", f32(10.0), f32(10.0), f32(620.0), f32(400.0))
        {
            gui.Label("Welcome to Cocoa.UI!")
            gui.Separator()
            if gui.Button("Click Me")
            {
                Console.WriteLine("Button clicked!")
            }

            gui.SameLine()
            gui.CheckBox("Enable", 1)
            gui.TrackBarFloat("Value", 2, f32(0.0), f32(100.0))
            gui.TrackBar("Count", 3, 0, 20)
            gui.ProgressBar(f32(0.35))
            var name = gui.TextBox("Name", 20, 32)
            gui.Label("Hello, " + name)

            if gui.GroupBox("Advanced", 10)
            {
                if gui.TreeView("Options", 11)
                {
                    gui.CheckBox("Option A", 12)
                    gui.CheckBox("Option B", 13)
                    gui.EndTreeView()
                }

                if gui.BeginPanel(30, f32(300.0), f32(70.0))
                {
                    gui.Label("scroll line 1")
                    gui.Label("scroll line 2")
                    gui.Label("scroll line 3")
                    gui.Label("scroll line 4")
                    gui.Label("scroll line 5")
                    gui.Label("scroll line 6")
                    gui.Label("scroll line 7")
                    gui.Label("scroll line 8")
                }

                gui.EndPanel()
            }
        }

        gui.End()

        let drawList = gui.Render()
        Win32GDIBackend.Present(hwnd, memDC, drawList, 640, 420, ImGuiStyle.Abgr(30, 30, 30, 255))
        Win32Window.Sleep(16)
    }

    Win32GDIBackend.DestroyBuffer(memDC)
    Win32Window.Destroy(hwnd)
    return 0
}
