using System
using System.UI
using System.UI.Backends

// 6e-M25 阶段 4 NativeUI：System.UI 在 native 后端的最小组件集示例。
// 依赖 native extern 参数编组（string→LPCWSTR、i32[]→元素指针）。ESC 退出。

function Main(): i32
{
    var gui = new ImGui(4096, 64)
    var io = new ImGuiIO()

    let hwnd = Win32Window.Create("Cocoa.UI NativeUI", 640, 420)
    if hwnd == 0
    {
        Console.WriteLine("failed to create window")
        return 1
    }

    let memDC = Win32GDIBackend.CreateBuffer(hwnd, 640, 420)
    var running = true
    var clicks = 0

    while running
    {
        running = Win32Window.Pump(io, hwnd)
        io.NewFrame(f32(0.016))
        gui.NewFrame(io)

        if gui.Begin("NativeUI", f32(10.0), f32(10.0), f32(620.0), f32(400.0))
        {
            gui.Label("System.UI on native backend")
            gui.Separator()

            if gui.Button("Click Me")
            {
                clicks = clicks + 1
            }

            gui.SameLine()
            gui.Label("clicks: " + clicks.ToString())

            gui.CheckBox("Enable", 1)
            gui.TrackBar("Count", 2, 0, 20)
            gui.TrackBarFloat("Value", 3, f32(0.0), f32(100.0))
            gui.ProgressBar(f32(clicks) / f32(10.0))

            if gui.GroupBox("Details", 10)
            {
                if gui.BeginPanel(11, f32(300.0), f32(80.0))
                {
                    gui.Label("scroll line 1")
                    gui.Label("scroll line 2")
                    gui.Label("scroll line 3")
                    gui.Label("scroll line 4")
                    gui.Label("scroll line 5")
                    gui.Label("scroll line 6")
                }

                gui.EndPanel()
            }
        }

        gui.End()

        let drawList = gui.Render()
        Win32GDIBackend.Present(hwnd, memDC, drawList, 640, 420, ImGuiStyle.Abgr(30, 30, 30, 255))
        Win32Window.Sleep(16)
    }

    Win32GDIBackend.DestroyBuffer(memDC)
    Win32Window.Destroy(hwnd)
    return 0
}
