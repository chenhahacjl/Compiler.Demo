using System
using System.UI
using System.UI.Backends

// 6e-M25 阶段 2 AdvancedUI：System.UI 综合示例（IL 后端）�?// 左侧导航（树/折叠�? 右侧内容（控�?+ 可滚动列表）；运行期切换�?浅主题；ESC 退出�?
function Main(): i32
{
    var gui = new ImGui(8192, 128)
    var io = new ImGuiIO()

    let hwnd = Win32Window.Create("Cocoa.UI AdvancedUI", 900, 640)
    if hwnd == 0
    {
        Console.WriteLine("failed to create window")
        return 1
    }

    let memDC = Win32GDIBackend.CreateBuffer(hwnd, 900, 640)
    var running = true
    var theme = 0
    var counter = 0
    var status = "Ready."

    while running
    {
        running = Win32Window.Pump(io, hwnd)
        io.NewFrame(f32(0.016))
        gui.NewFrame(io)

        if gui.Begin("AdvancedUI", f32(10.0), f32(10.0), f32(880.0), f32(620.0))
        {
            if gui.Button("+1")
            {
                counter = counter + 1
                status = "Incremented to " + counter.ToString()
            }

            gui.SameLine()
            if gui.Button("Reset")
            {
                counter = 0
                status = "Reset."
            }

            gui.SameLine()
            if gui.Button("Theme")
            {
                theme = theme + 1
                if theme > 2
                {
                    theme = 0
                }

                if theme == 0
                {
                    gui.Style.MakeDark()
                }
                else if theme == 1
                {
                    gui.Style.MakeLight()
                }
                else
                {
                    gui.Style.MakeClassic()
                }

                status = "Theme switched."
            }

            gui.SameLine()
            gui.Label(status)
            gui.Separator()

            if gui.BeginPanel(100, f32(240.0), f32(430.0))
            {
                gui.Label("Navigation")
                gui.Separator()
                if gui.TreeView("Inputs", 200)
                {
                    gui.Label("Buttons")
                    gui.Label("Sliders")
                    gui.EndTreeView()
                }

                if gui.TreeView("Display", 201)
                {
                    gui.Label("Progress")
                    gui.Label("Lists")
                    gui.EndTreeView()
                }

                if gui.GroupBox("Advanced", 202)
                {
                    gui.Label("Theme")
                    gui.Label("Diagnostics")
                }
            }

            gui.EndPanel()
            gui.SameLine()

            if gui.BeginPanel(101, f32(600.0), f32(430.0))
            {
                if counter > 0
                {
                    gui.PushStyleColor(0, ImGuiStyle.Abgr(230, 120, 60, 255))
                    gui.Label("Counter: " + counter.ToString())
                    gui.PopStyleColor()
                }
                else
                {
                    gui.Label("Counter: " + counter.ToString())
                }

                gui.ProgressBar(f32(counter) / f32(20.0))
                gui.CheckBox("Verbose", 300)
                gui.TrackBarFloat("Volume", 301, f32(0.0), f32(1.0))
                gui.TrackBar("Items", 302, 0, 100)
                var note = gui.TextBox("Note", 303, 48)
                gui.Separator()
                gui.Label("Log:")
                var k = 0
                while k < 12
                {
                    gui.Label("entry " + k.ToString() + "  |  note = " + note)
                    k = k + 1
                }
            }

            gui.EndPanel()
        }

        gui.End()

        let drawList = gui.Render()
        Win32GDIBackend.Present(hwnd, memDC, drawList, 900, 640, ImGuiStyle.Abgr(30, 30, 30, 255))
        Win32Window.Sleep(16)
    }

    Win32GDIBackend.DestroyBuffer(memDC)
    Win32Window.Destroy(hwnd)
    return 0
}
