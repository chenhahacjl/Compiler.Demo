using System
using System.UI
using System.UI.Backends

// 6e-M25 阶段 2 AdvancedUI：System.UI 综合示例（IL 后端）�?// 左侧导航（树/折叠�? 右侧内容（控�?+ 可滚动列表）；运行期切换�?浅主题；ESC 退出�?
function Main(): i32
{
    var gui = new ImGui(8192, 128)
    var io = new ImGuiIO()

    let hwnd = Win32Window.Create("Cocoa.UI AdvancedUI", 900, 640)
    if hwnd == 0
    {
        Console.WriteLine("failed to create window")
        return 1
    }

    let memDC = Win32GDIBackend.CreateBuffer(hwnd, 900, 640)
    var running = true
    var dark = true
    var counter = 0
    var status = "Ready."

    while running
    {
        running = Win32Window.Pump(io, hwnd)
        io.NewFrame(f32(0.016))
        gui.NewFrame(io)

        if gui.Begin("AdvancedUI", f32(10.0), f32(10.0), f32(880.0), f32(620.0))
        {
            if gui.Button("+1")
            {
                counter = counter + 1
                status = "Incremented to " + counter.ToString()
            }

            gui.SameLine()
            if gui.Button("Reset")
            {
                counter = 0
                status = "Reset."
            }

            gui.SameLine()
            if gui.Button("Toggle Theme")
            {
                if dark
                {
                    dark = false
                    gui.Style.MakeLight()
                }
                else
                {
                    dark = true
                    gui.Style.MakeDark()
                }

                status = "Theme toggled."
            }

            gui.SameLine()
            gui.Text(status)
            gui.Separator()

            if gui.BeginChild(100, f32(240.0), f32(430.0))
            {
                gui.Text("Navigation")
                gui.Separator()
                if gui.TreeNode("Inputs", 200)
                {
                    gui.Text("Buttons")
                    gui.Text("Sliders")
                    gui.TreePop()
                }

                if gui.TreeNode("Display", 201)
                {
                    gui.Text("Progress")
                    gui.Text("Lists")
                    gui.TreePop()
                }

                if gui.CollapsingHeader("Advanced", 202)
                {
                    gui.Text("Theme")
                    gui.Text("Diagnostics")
                }
            }

            gui.EndChild()
            gui.SameLine()

            if gui.BeginChild(101, f32(600.0), f32(430.0))
            {
                gui.Text("Counter: " + counter.ToString())
                gui.ProgressBar(f32(counter) / f32(20.0))
                gui.Checkbox("Verbose", 300)
                gui.SliderFloat("Volume", 301, f32(0.0), f32(1.0))
                gui.SliderInt("Items", 302, 0, 100)
                var note = gui.InputText("Note", 303, 48)
                gui.Separator()
                gui.Text("Log:")
                var k = 0
                while k < 12
                {
                    gui.Text("entry " + k.ToString() + "  |  note = " + note)
                    k = k + 1
                }
            }

            gui.EndChild()
        }

        gui.End()

        let drawList = gui.Render()
        Win32GDIBackend.Present(hwnd, memDC, drawList, 900, 640, ImGuiStyle.Abgr(30, 30, 30, 255))
        Win32Window.Sleep(16)
    }

    Win32GDIBackend.DestroyBuffer(memDC)
    Win32Window.Destroy(hwnd)
    return 0
}
