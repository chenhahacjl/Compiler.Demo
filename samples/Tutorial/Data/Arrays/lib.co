function Sum(items: i32[]): i32
{
    var total = 0
    for var i = 0 to items.Length - 1
    {
        total = total + items[i]
    }
    return total
}

function Contains(items: i32[], target: i32): bool
{
    for var i = 0 to items.Length - 1
    {
        if items[i] == target
        {
            return true
        }
    }
    return false
}