using System
function Main()
{
    var c = Color.Green
    Console.WriteLine(AsInt(Color.Red))
    Console.WriteLine(AsInt(Color.Green))
    Console.WriteLine(AsInt(Color.Blue))
    Console.WriteLine(IsGreen(c))
    Console.WriteLine(c == Color.Red)
    Console.WriteLine(int(HttpStatus.NotFound))
    Console.WriteLine(int(Color(99)))
    Console.WriteLine(AsInt(Color.Green) == int(c))
}