// 6e-M17 Step 4：extern 强制进类 import 块（`import <dll> { static extern ... }`，声明式归属）
class Kernel32
{
    import kernel32.dll
    {
        static stdcall function GetTickCount(): i32
    }
}

function IsRunning(): bool
{
    var ticks = Kernel32.GetTickCount()
    if ticks > 0
    {
        return true
    }
    return false
}

function InRange(value: i32, max: i32): bool
{
    if value >= 0 && value < max
    {
        return true
    }
    return false
}
