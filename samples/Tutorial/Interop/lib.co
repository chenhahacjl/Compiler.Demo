import kernel32.dll

stdcall function GetTickCount(): int

function IsRunning(): bool
{
    var ticks = GetTickCount()
    if ticks > 0
    {
        return true
    }
    return false
}

function InRange(value: int, max: int): bool
{
    if value >= 0 && value < max
    {
        return true
    }
    return false
}