// Cocoa 式参数 + Cocoa 式体
function Add(a: int, b: int): int
{
    var sum = a + b
    return sum
}

// Cocoa 式参数 + Cocoa 式体
function Square(x: int): int
{
    return x * x
}

// Cocoa 式参数 + Cocoa 式体
function Factorial(n: int): int
{
    if n <= 1
    {
        return 1
    }
    return n * Factorial(n - 1)
}

// Cocoa 式参数 + Cocoa 式体
function Greet(name: string): string
{
    var prefix = "Hello, "
    return prefix + name + "!"
}
