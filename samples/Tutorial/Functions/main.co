function Run(args: string[])
{
    print(Add(20, 22))
    print(Square(Add(1, 2)))
    print(Factorial(5))
    print(Greet("Cocoa"))
    print(args.Length)
    if args.Length > 0
    {
        print(args[0])
    }
    if args.Length > 1
    {
        print(args[1])
    }
}

function Main()
{
    print("not used when entry = run")
}