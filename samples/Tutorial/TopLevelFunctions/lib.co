// 顶层函数（function 关键字，类型后置）
function Add(a: int, b: int): int
{
    return a + b
}

// 顶层函数：数组返回类型
function GetNumbers(): int[]
{
    return new int[] { 7, 8, 9 }
}

// 顶层函数：字符串参数与返回
function Repeat(s: string, n: int): string
{
    var result = ""
    for var i = 0 to n
    {
        result = result + s
    }
    return result
}
