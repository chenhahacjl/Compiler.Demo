// 入口函数
function Main()
{
    System.Console.WriteLine(Add(2, 3))
    System.Console.WriteLine(Add(10, 20))

    var nums = GetNumbers()
    System.Console.WriteLine(nums.Length)
    System.Console.WriteLine(nums[0] + nums[1] + nums[2])

    System.Console.WriteLine(Repeat("ab", 3))

    System.Console.WriteLine(Double(21))
}

// 顶层函数（类型后置 + 冒号返回类型）
function Double(x: int): int
{
    return x * 2
}
