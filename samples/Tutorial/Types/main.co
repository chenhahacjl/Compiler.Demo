using System
function Main()
{
    let x = 42
    var y = 10
    y = y + 1
    Console.WriteLine(x)
    Console.WriteLine(y)
    Console.WriteLine(x + y)
    let name: string = "Alice"
    let pi: f64 = 3.14
    let flag: bool = true
    Console.WriteLine(name)
    Console.WriteLine(pi)
    Console.WriteLine(flag)
    Console.WriteLine(Plus(x, y))
    Console.WriteLine(ConcatName("Cocoa", "Lang"))
}