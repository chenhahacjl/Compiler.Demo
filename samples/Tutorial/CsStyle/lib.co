// Cocoa 式参数（类型后置）+ Cocoa 式体
function Add(a: i32, b: i32): i32
{
    var sum = a + b
    return sum
}

// Cocoa 式参数（类型后置）+ 无分号语句
function Square(x: i32): i32
{
    return x * x
}

// Cocoa 式参数（数组参数 i32[]）+ Cocoa 式方法体
function SumArray(values: i32[]): i32
{
    var total = 0
    var i = 0
    while i < values.Length
    {
        total = total + values[i]
        i = i + 1
    }
    return total
}

// Cocoa 式参数 + var 类型推断
function Describe(name: string, age: i32): string
{
    var greeting = "Hi, " + name
    var years = age * 1
    return greeting + " (" + (string)years + ")"
}
