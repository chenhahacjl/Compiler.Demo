function Main()
{
    // Cocoa 式局部变量（类型推断，无分号）
    var a = 10
    var b = 32
    var msg = "C# style"

    // Cocoa 式局部变量（类型后置 / 推断，无分号）
    var c = 5
    let d: int = 1

    System.Console.WriteLine(Add(a, b))
    System.Console.WriteLine(Square(c))
    System.Console.WriteLine(SumArray(new int[] {1, 2, 3, 4}))
    System.Console.WriteLine(Describe("Cocoa", 3))
    System.Console.WriteLine(msg)
    System.Console.WriteLine(d)
}
