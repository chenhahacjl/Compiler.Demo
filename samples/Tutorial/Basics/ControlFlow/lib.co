function Plus(a: i32, b: i32): i32
{
    return a + b
}

function Classify(x: i32): string
{
    if x > 0
    {
        return "positive"
    }
    else if x == 0
    {
        return "zero"
    }
    return "negative"
}

function SumUpTo(n: i32): i32
{
    var total = 0
    for var i = 1 to n
    {
        total = total + i
    }
    return total
}

function Countdown(n: i32): i32
{
    var steps = 0
    var current = n
    while current > 0
    {
        steps = steps + 1
        current = current - 1
    }
    return steps
}

function DoOnce(): i32
{
    var i = 0
    do
    {
        i = i + 1
    } while i < 0
    return i
}