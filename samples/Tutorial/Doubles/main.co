function Main()
{
    var d: double = 3.14
    print(d)
    print(Add(1.5, 2.25))
    print(Divide(10.0, 4))
    print(2.5 * 2)
    print(7 - 1.5)
    print(IsBigger(1.5, 2.5))
    print(Truncated(3.9))
    print((double)3)

    var arr: double[] = new double[2] {1.5, 2.5}
    print(arr[0])
    print(arr[1])
    print(Add(arr[0], arr[1]))
}