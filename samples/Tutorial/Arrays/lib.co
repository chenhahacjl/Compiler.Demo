function Sum(items: int[]): int
{
    var total = 0
    for i = 0 to items.Length - 1
    {
        total = total + items[i]
    }
    return total
}

function Contains(items: int[], target: int): bool
{
    for i = 0 to items.Length - 1
    {
        if items[i] == target
        {
            return true
        }
    }
    return false
}