function Main()
{
    var nums = new int[3] {10, 20, 30}
    nums[1] = 99
    System.Console.WriteLine(nums[0])
    System.Console.WriteLine(nums[1])
    System.Console.WriteLine(nums[2])
    System.Console.WriteLine(nums.Length)
    System.Console.WriteLine(Sum(nums))
    System.Console.WriteLine(Contains(nums, 99))
    System.Console.WriteLine(Contains(nums, 7))

    var flags = new bool[2]
    flags[0] = true
    System.Console.WriteLine(flags[0])
    System.Console.WriteLine(flags[1])
}