using System
function Main()
{
    var b1: u8 = 65
    Console.WriteLine(b1)
    Console.WriteLine(AsInt(b1))

    var buf: u8[] = new u8[3]
    buf[0] = 200
    buf[1] = 0xFF
    Console.WriteLine(buf[0])
    Console.WriteLine(buf[1])
    Console.WriteLine(FirstElement(buf))
    Console.WriteLine(LastElement(buf))

    Console.WriteLine(Wrap(300))
    Console.WriteLine(Wrap(200) == Wrap(200))
    Console.WriteLine(0xFF)
}