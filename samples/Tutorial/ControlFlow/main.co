function main()
{
    print(classify(5))
    print(classify(0))
    print(classify(-3))
    print(sumUpTo(5))
    print(countdown(3))
    print(doOnce())

    var total = 0
    for i = 1 to 5
    {
        if i == 3
        {
            continue
        }
        total = total + i
    }
    print(total)

    var j = 0
    while j < 3
    {
        print(j)
        j = j + 1
    }
}