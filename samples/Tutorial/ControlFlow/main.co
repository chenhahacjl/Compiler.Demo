function Main()
{
    print(Classify(5))
    print(Classify(0))
    print(Classify(-3))
    print(SumUpTo(5))
    print(Countdown(3))
    print(DoOnce())

    var total = 0
    for i = 1 to 5
    {
        if i == 3
        {
            continue
        }
        total = total + i
    }
    print(total)

    var j = 0
    while j < 3
    {
        print(j)
        j = j + 1
    }
}