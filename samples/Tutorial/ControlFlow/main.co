function Main()
{
    System.Console.WriteLine(Classify(5))
    System.Console.WriteLine(Classify(0))
    System.Console.WriteLine(Classify(-3))
    System.Console.WriteLine(SumUpTo(5))
    System.Console.WriteLine(Countdown(3))
    System.Console.WriteLine(DoOnce())

    var total = 0
    for var i = 1 to 5
    {
        if i == 3
        {
            continue
        }
        total = total + i
    }
    System.Console.WriteLine(total)

    var j = 0
    while j < 3
    {
        System.Console.WriteLine(j)
        j = j + 1
    }
}