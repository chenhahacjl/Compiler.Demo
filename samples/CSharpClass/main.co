using System
// Cocoa 式类语法（IL 后端）：类成员 function/property/constructor 关键字 + 类型后置
//
// Cocoa 语法：字段 `name: Type`、方法 `function`、属性 `property`、构造 `constructor`。

public class Person
{
    // Cocoa 式字段
    private _name: string
    private _age: int
    // Cocoa 式静态字段 + 初始化器（合成 .cctor）
    public static Count: int = 0

    // Cocoa 式构造函数（constructor 关键字）+ Cocoa 式参数
    public constructor(name: string, age: int)
    {
        _name = name
        _age = age
        Count = Count + 1
    }

    // Cocoa 式自动属性
    public property Name: string { get set }

    // Cocoa 式自动属性 + 初始化器（作用于后备字段 _Age，构造链之后执行）
    public property Age: int { get set } = 18

    // Cocoa 式方法（function 关键字 + 类型后置）
    public function NextAge(): int
    {
        return Age + 1
    }

    public function Greet(): string
    {
        return "Hello, " + _name
    }
}

function Main()
{
    var p = new Person("Alice", 30)
    p.Name = "Bob"
    Console.WriteLine(p.Name)
    Console.WriteLine(p.Age)
    Console.WriteLine(p.NextAge())
    Console.WriteLine(p.Greet())
    Console.WriteLine(Person.Count)

    var q = new Person("Carol", 40)
    Console.WriteLine(Person.Count)
}
