<?xml version="1.0" encoding="Windows-1252"?>
<!-- ======================================================================
     Cocoa 语言 Notepad++ 用户自定义语言 (UDL 2.1)
     生成依据: src/Cocoa.Cs/Cocoa.CodeAnalysis/Syntax/SyntaxFacts.cs
               src/Cocoa.Cs/Cocoa.CodeAnalysis/Syntax/LexerBase.cs
               src/Cocoa.Cs/Cocoa.CodeAnalysis/Symbols/BuiltinFunctions.cs
     导入方法见同目录 README.md
     ====================================================================== -->
<NotepadPlus>
    <UserLang name="Cocoa" ext="co" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="no" allowFoldOfComments="yes" foldCompact="no" forcePureLC="0" decimalSeparator="0" />
            <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00// 01 02/* 03*/ 04</Keywords>
            <Keywords name="Numbers, prefix1">0x 0X</Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, suffix1">L l u U f F ul uL Ul UL lu lU Lu LU</Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range"></Keywords>
            <Keywords name="Operators1">&gt;&gt;= &lt;&lt;= =&gt; -&gt; ++ -- += -= *= /= %= &amp;= |= ^= == != &lt;= &gt;= &amp;&amp; || &lt;&lt; &gt;&gt; + - * / % ! ~ &amp; | ^ = &lt; &gt; ( ) [ ] { } , ; : . ?</Keywords>
            <Keywords name="Operators2"></Keywords>
            <Keywords name="Folders in code1, open">{</Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close">}</Keywords>
            <Keywords name="Folders in code2, open"></Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close"></Keywords>
            <Keywords name="Folders in code3, open"></Keywords>
            <Keywords name="Folders in code3, middle"></Keywords>
            <Keywords name="Folders in code3, close"></Keywords>
            <Keywords name="Folders in code4, open"></Keywords>
            <Keywords name="Folders in code4, middle"></Keywords>
            <Keywords name="Folders in code4, close"></Keywords>
            <Keywords name="Folders in comment, open">/*</Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close">*/</Keywords>
            <!-- Keywords1: 控制流与表达式关键字 -->
            <Keywords name="Keywords1">as break case continue default do else for foreach if in is new return step switch to when while</Keywords>
            <!-- Keywords2: 声明、修饰符与结构关键字 -->
            <Keywords name="Keywords2">abstract base cdecl class const constructor delegate enum event extends extern facade function get import interface internal let namespace out override partial property private protected public readonly ref sealed set static stdcall syscall this using var virtual where</Keywords>
            <!-- Keywords3: 内置类型名（CO 方言 + C# 方言 + 两方言共享）-->
            <Keywords name="Keywords3">i8 u8 i16 u16 i32 u32 i64 u64 i128 u128 f32 f64 f128 sbyte byte short ushort int uint long ulong float double bool char string void any</Keywords>
            <!-- Keywords4: 常量字面量 -->
            <Keywords name="Keywords4">true false null</Keywords>
            <!-- Keywords5: 内置函数 -->
            <Keywords name="Keywords5">WriteLine Write ReadLine ReadKey Random Sleep TickCount Exit Sqrt Floor Ceiling Truncate Round Beep Int32ToString Int64ToString DoubleToString BooleanToString CharToString ParseInt64 UInt64ToString</Keywords>
            <Keywords name="Keywords6"></Keywords>
            <Keywords name="Keywords7"></Keywords>
            <Keywords name="Keywords8"></Keywords>
            <!-- Delimiters 组: 1=普通字符串(转义\) 2=插值字符串$"..."(转义\) 3=Verbatim @"..."(无转义) 4=字符字面量'...'(转义\) -->
            <Keywords name="Delimiters">00&quot; 01\ 02&quot; 03$&quot; 04\ 05&quot; 06@&quot; 07 08&quot; 09&apos; 10\ 11&apos;</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" styleID="11" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="COMMENTS" styleID="1" fgColor="008000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="COMMENT LINES" styleID="2" fgColor="008000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="NUMBER" styleID="4" fgColor="FF8000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="KEYWORD1" styleID="5" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="KEYWORD2" styleID="6" fgColor="0000FF" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="KEYWORD3" styleID="7" fgColor="2B91AF" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="KEYWORD4" styleID="8" fgColor="800080" bgColor="FFFFFF" fontName="" fontStyle="1" />
            <WordsStyle name="KEYWORD5" styleID="9" fgColor="795E26" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="OPERATORS" styleID="10" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="DELIMITERS1" styleID="15" fgColor="800000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="DELIMITERS2" styleID="16" fgColor="800000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="DELIMITERS3" styleID="17" fgColor="800000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="DELIMITERS4" styleID="18" fgColor="800000" bgColor="FFFFFF" fontName="" fontStyle="0" />
            <WordsStyle name="FOLDER IN CODE1" styleID="20" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
